{
  "schema_version": 1,
  "version": "tome-1.7.6",
  "locale": "zh_hans",
  "repositories": {
    "engine": {
      "env": "TOME_ENGINE_ROOT",
      "default": "../t-engine4",
      "commit": "624a67329fe2ad440c5b344785a9c73fcf22ae63",
      "required": true
    },
    "addon": {
      "env": "TOME_ADDON_ROOT",
      "default": "../tome-chn-mod",
      "commit": "8dd657d5c95d8c4313ae07fa2a4d404f7648207f",
      "required": false
    }
  },
  "protected_source_roots": {
    "dlc": {
      "env": "TOME_DLC_ROOT",
      "repository": "engine",
      "relative_path": "game/dlcs",
      "access": "lua-extractor-only"
    }
  },
  "runtime": {
    "luajit_env": "TOME_LUAJIT",
    "luarocks_root_env": "TOME_LUAROCKS_ROOT",
    "luarocks_root_default": "~/.local/share/tome4-luarocks",
    "lua_version": "Lua 5.1",
    "lpeg_runtime_version": "0.10",
    "lpeg_rock_version": "0.10.2-1",
    "required_modules": [
      "lfs",
      "lpeg",
      "rex_pcre"
    ]
  },
  "extractor": {
    "repository": "engine",
    "commit": "bdc19d22862f7a6cfbe71d7136145720ecea7bf7",
    "git_path": "i18n_tools",
    "max_stack": 100000,
    "preserve_duplicate_occurrences": true
  },
  "manual_definitions": [
    "_tdef_append.lua"
  ],
  "addon_external_requirements": [
    {
      "id": "legacy-lore-overlay",
      "reason": "optional external layer; no standalone legacy-lore entity found in tome-chn-mod or engine public sources as of 2026-08-04 (investigated: addon repo history, engine game tree); source and canonical component remain unpinned"
    },
    {
      "id": "nullpackreloaded",
      "reason": "optional external layer; translation snapshot pinned at tome-chn-mod 8dd657d (data/null_translation.lua: 464 t() entries, section nullpackreloaded; runtime hooks in hooks/load.lua for /data-nullpackreloaded artifacts); upstream addon source/version unpinned"
    }
  ],
  "release_layers": [
    {
      "id": "core-addon",
      "artifact_profile": "addon",
      "components": [
        "tome"
      ],
      "external_requirements": [],
      "status": "releaseable",
      "notes": "Core release layer. It is built only against the pinned official tome locale and excludes DLC and external overlays."
    },
    {
      "id": "dlc-addon",
      "artifact_profile": "addon",
      "components": [
        "ashes-urhrok",
        "cults",
        "orcs"
      ],
      "external_requirements": [],
      "status": "baseline-pending",
      "notes": "Optional DLC layer for Ashes of Urh'Rok, Cults of Entropy, and Embers of Rage. Items Vault and Possessors are temporarily ignored: their canonical translations remain in the repository, but they have no active source mapping or addon eligibility."
    },
    {
      "id": "legacy-lore-addon",
      "artifact_profile": "addon",
      "components": [],
      "external_requirements": [
        "legacy-lore-overlay"
      ],
      "status": "optional",
      "notes": "Optional external overlay kept separate from the core addon until its source and component ownership are pinned."
    },
    {
      "id": "nullpack-addon",
      "artifact_profile": "addon",
      "components": [],
      "external_requirements": [
        "nullpackreloaded"
      ],
      "status": "optional",
      "notes": "Optional Nullpackreloaded overlay kept separate from the core addon until its source and version are pinned."
    }
  ],
  "terminology": "terminology.tsv",
  "policy": "i18n/policy.json",
  "components": [
    {
      "id": "engine",
      "translation": "engine.lua",
      "copy_fragment": "engine.copy.lua",
      "source_repository": "engine",
