{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-preregistration-v2",
  "title": "Facts-study preregistration v2 (offline-frozen; never externally executable)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-facts-study-preregistration-v2"},
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pool_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "purpose": {"const": "facts-causal-study-only-no-holdout-clearance"},
    "status": {"const": "offline-frozen"},
    "sample_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "neutral_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gold_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "harness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pi_executable": {"type": "object"},
    "arm_prompt_sha256s": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "item_order": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "schedule": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": {"$ref": "#/$defs/slot"}
    },
    "contrasts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decision_rule": {"type": "object"},
    "max_external_slots": {"const": 33},
    "cache_policy": {"const": "disabled"},
    "replacement_policy": {"const": "forbidden"},
    "preregistration_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "contract", "schema_version", "study_id", "pool_id", "purpose", "status",
    "sample_sha256", "facts_sha256", "neutral_sha256", "gold_sha256",
    "protocol_sha256", "harness_sha256", "pi_executable", "arm_prompt_sha256s",
    "item_order", "schedule", "contrasts", "decision_rule", "max_external_slots",
    "cache_policy", "replacement_policy", "preregistration_id"
  ],
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot_id": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "evaluator_id": {"type": "string", "enum": ["luna", "deepseek"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "thinking": {"type": "string", "minLength": 1},
        "arm": {"type": "string", "enum": ["A", "B", "C", "D", "N", "L", "F"]},
        "replicate": {"type": "integer", "minimum": 1, "maximum": 3},
        "seed": {"type": "string", "minLength": 1},
        "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "shard_count": {"const": 1},
        "cache": {"const": "disabled"},
        "retry_policy": {"const": "none"}
      },
      "required": [
        "slot_id", "ordinal", "evaluator_id", "provider", "model", "thinking",
        "arm", "replicate", "seed", "bundle_id", "bundle_sha256",
        "prompt_sha256", "shard_count", "cache", "retry_policy"
      ]
    }
  }
}
