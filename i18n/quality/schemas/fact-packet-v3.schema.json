{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-fact-packet-v3",
  "title": "Supplemental-only Facts packet v3 (curation)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-fact-packet-v3"},
    "schema_version": {"const": 1},
    "pool_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_kind": {"type": "string", "enum": ["facts", "neutral"]},
    "status": {"const": "frozen"},
    "non_exhaustive": {"const": true},
    "supplemental_only": {"const": true},
    "language": {"const": "english-metalanguage"},
    "authoring_lineage": {"$ref": "#/$defs/authoringLineage"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/packetItem"}
    }
  },
  "required": [
    "contract", "schema_version", "pool_id", "packet_kind", "status",
    "non_exhaustive", "supplemental_only", "language", "authoring_lineage", "items"
  ],
  "$defs": {
    "authoringLineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "enum": ["facts-author", "host-neutral-generator"]},
        "actor_id": {"type": "string", "minLength": 1},
        "target_defects_seen": {"const": false},
        "gold_seen": {"const": false},
        "curator_assessments_seen": {"type": "boolean"},
        "common_input_restatements_excluded": {"const": true},
        "source_inputs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": [
        "role", "actor_id", "target_defects_seen", "gold_seen",
        "curator_assessments_seen", "common_input_restatements_excluded",
        "source_inputs_sha256"
      ]
    },
    "packetItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "facts": {
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "quality-common-v1.schema.json#/$defs/fact"}
        }
      },
      "required": ["revision_id", "facts"]
    }
  }
}
