{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-sample-v2",
  "title": "Facts-study curation sample v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-facts-study-sample-v2"},
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pool_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "seed": {"type": "string", "minLength": 1},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "excluded_revision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "exclusion_revision_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/sampleItem"}
    }
  },
  "required": [
    "contract", "schema_version", "study_id", "pool_id", "seed",
    "inventory_sha256", "excluded_revision_ids",
    "exclusion_revision_ids_sha256", "items"
  ],
  "$defs": {
    "boundedContextEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_index": {"type": "integer"},
        "source": {"type": "string"},
        "target": {"type": "string"}
      },
      "required": ["relative_index", "source", "target"]
    },
    "mutationLineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {"const": "tome4-quality-controlled-mutation-v1"},
        "base_revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "variant_target": {"type": "string", "minLength": 1},
        "mutation_kind": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["contract", "base_revision_id", "variant_target", "mutation_kind", "digest"]
    },
    "sampleItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "item_kind": {"type": "string", "enum": ["semantic", "term", "mechanics", "ui", "localization"]},
        "source_tag": {"type": "string"},
        "section": {"type": "string"},
        "bounded_context": {"type": "array", "items": {"$ref": "#/$defs/boundedContextEntry"}},
        "stratum": {
          "type": "string",
          "enum": ["term-proper-name", "mechanism-condition-number", "entity-relation", "ui-role", "general-semantic-clean-control"]
        },
        "origin": {"type": "string", "enum": ["natural", "controlled"]},
        "selection_classification": {
          "type": "string",
          "enum": ["fact-dependent-defect", "surface-defect", "clean", "acceptable-localization"]
        },
        "mutation_lineage": {
          "type": ["object", "null"],
          "$ref": "#/$defs/mutationLineage"
        }
      },
      "required": [
        "index", "revision_id", "source", "target", "item_kind", "source_tag",
        "section", "bounded_context", "stratum", "origin",
        "selection_classification", "mutation_lineage"
      ]
    }
  }
}
