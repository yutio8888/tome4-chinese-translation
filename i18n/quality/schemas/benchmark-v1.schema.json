{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tome4-quality-benchmark-v1",
  "title": "ToME4 quality pilot benchmark (approved, immutable)",
  "description": "Only human-confirmed, strictly validated adjudication data that passed phase-1 acceptance may be written as an immutable pilot benchmark. It must not contain run paths or unresolved content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "quality_contract", "sample_id", "taxonomy_sha256",
    "policy_sha256", "manifest_sha256", "inventory_sha256", "items"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "quality_contract": {"const": "tome4-quality-benchmark-v1"},
    "sample_id": {"type": "string"},
    "taxonomy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approval_note": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/item"}
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id", "component", "section", "source", "target",
        "source_tag", "profile", "resolved_findings", "quality_vector",
        "confidence", "grade", "reuse_scope"
      ],
      "properties": {
        "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "component": {"type": "string"},
        "section": {"type": "string"},
        "source": {"type": "string"},
        "target": {"type": "string"},
        "source_tag": {"type": ["string", "null"]},
        "profile": {"type": "string"},
        "resolved_findings": {"type": "array"},
        "quality_vector": {"type": "object"},
        "confidence": {"type": "string"},
        "grade": {"type": "string"},
        "reuse_scope": {"type": "string"}
      }
    }
  }
}
