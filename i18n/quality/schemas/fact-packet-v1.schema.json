{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-fact-packet-v1",
  "additionalProperties": false,
  "properties": {
    "authoring_lineage": {"type": "object"},
    "contract": {"const": "tome4-quality-fact-packet-v1"},
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "facts": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "fact_id": {"pattern": "^fact-[0-9a-f]{16}$", "type": "string"},
                "fact_type": {"type": "string"},
                "provenance": {"type": "object"},
                "statement": {"type": "string"}
              },
              "required": ["fact_id", "fact_type", "statement", "provenance"],
              "type": "object"
            },
            "maxItems": 4,
            "minItems": 1,
            "type": "array"
          },
          "revision_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
        },
        "required": ["revision_id", "facts"],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 20,
      "type": "array"
    },
    "non_exhaustive": {"const": true},
    "packet_kind": {"enum": ["facts", "neutral"]},
    "schema_version": {"const": 1},
    "status": {"enum": ["draft", "frozen"]},
    "study_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["contract", "schema_version", "study_id", "packet_kind", "status", "non_exhaustive", "authoring_lineage", "items"],
  "title": "Fact or byte-matched neutral packet v1",
  "type": "object"
}
