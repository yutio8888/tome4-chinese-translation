{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-preregistration-v1",
  "additionalProperties": false,
  "properties": {
    "arm_prompt_sha256s": {"type": "object"},
    "cache_policy": {"const": "disabled"},
    "contract": {"const": "tome4-quality-facts-study-preregistration-v1"},
    "contrasts": {"type": "array"},
    "decision_rule": {"type": "object"},
    "facts_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "gold_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "harness_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "item_order": {"maxItems": 20, "minItems": 20, "type": "array"},
    "max_external_slots": {"const": 33},
    "neutral_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "pi_executable": {
      "additionalProperties": false,
      "properties": {
        "node_path": {"minLength": 1, "type": "string"},
        "node_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "node_tree": {"type": "object"},
        "package_tree": {"type": "object"},
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["path", "sha256", "package_tree", "node_path", "node_sha256", "node_tree"],
      "type": "object"
    },
    "preregistration_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "protocol_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "purpose": {"const": "facts-causal-study-only-no-holdout-clearance"},
    "replacement_policy": {"const": "forbidden"},
    "sample_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "schedule": {"maxItems": 33, "minItems": 33, "type": "array"},
    "schema_version": {"const": 1},
    "study_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["contract", "schema_version", "study_id", "purpose", "sample_sha256", "facts_sha256", "neutral_sha256", "gold_sha256", "protocol_sha256", "harness_sha256", "pi_executable", "arm_prompt_sha256s", "item_order", "schedule", "contrasts", "decision_rule", "max_external_slots", "cache_policy", "replacement_policy", "preregistration_id"],
  "title": "Exact 33-slot Facts study preregistration v1",
  "type": "object"
}
