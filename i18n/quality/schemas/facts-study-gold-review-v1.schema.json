{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-gold-review-v1",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-facts-study-gold-review-v1"},
    "independent": {"const": true},
    "items": {"maxItems": 20, "minItems": 20, "type": "array"},
    "reviewer_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1},
    "study_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["contract", "schema_version", "study_id", "reviewer_id", "independent", "items"],
  "type": "object"
}
