{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-author-bundle-v2",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "contract": {"const": "tome4-quality-facts-author-bundle-v2"},
    "fact_policy": {
      "additionalProperties": false,
      "properties": {
        "addressed_definition": {"const": "claim-cites-directly-supporting-supplemental-fact"},
        "allowed_provenance_kinds": {
          "const": ["public-source", "terminology", "versioned-context"]
        },
        "common_input_restatements": {"const": "forbidden"},
        "max_facts_per_item": {"const": 4},
        "min_facts_per_item": {"const": 0},
        "supplemental_only": {"const": true}
      },
      "required": ["min_facts_per_item", "max_facts_per_item", "supplemental_only", "common_input_restatements", "allowed_provenance_kinds", "addressed_definition"],
      "type": "object"
    },
    "items": {"maxItems": 20, "minItems": 20, "type": "array"},
    "schema_version": {"const": 1},
    "study_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["contract", "schema_version", "study_id", "fact_policy", "items", "bundle_id"],
  "type": "object"
}
