{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-reviewer-comparison-preregistration-v1",
  "type": "object",
  "required": [
    "contract", "schema_version", "tool_version", "version", "policy_sha256",
    "implementation_sha256", "candidate_pool_id",
    "gold_id", "gold", "gold_sha256", "fallback_stage", "prompt_sha256",
    "translation_review_contract", "models", "bundles", "slots",
    "planned_content_slots", "maximum_external_transfers",
    "replace_content_failures", "holdout_sealed", "preregistration_id"
  ],
  "properties": {
    "contract": {"const": "tome4-reviewer-comparison-preregistration-v1"},
    "schema_version": {"const": 1},
    "translation_review_contract": {"const": "tome4-translation-review-bundle-v2"},
    "replace_content_failures": {"const": false},
    "holdout_sealed": {"const": true},
    "models": {"type": "array", "minItems": 2, "maxItems": 2},
    "bundles": {"type": "array", "minItems": 1},
    "slots": {"type": "array", "minItems": 1},
    "planned_content_slots": {"type": "integer", "minimum": 1},
    "maximum_external_transfers": {"type": "integer", "minimum": 1},
    "preregistration_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
