{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-assessment-v3",
  "description": "Strict structural contract. The host additionally verifies sample coverage/order, evaluator-owned frozen hashes and bundle identities, evidence occurrence resolution, compatibility-matrix membership, global finding-id uniqueness, anchors and canonical assessment_id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quality_contract", "sample_id", "assessment_id", "evaluator", "items"],
  "properties": {
    "schema_version": {"const": 3},
    "quality_contract": {"const": "tome4-quality-assessment-v3"},
    "sample_id": {"$ref": "#/$defs/sha"},
    "assessment_id": {"$ref": "#/$defs/sha"},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "method_version", "provider", "model", "thinking", "prompt_sha256", "policy_sha256", "severity_matrix_sha256", "anchors_sha256", "bundle_ids", "bundle_sha256s"],
      "properties": {
        "kind": {"const": "model"}, "id": {"enum": ["reviewer-a", "reviewer-b"]},
        "method_version": {"const": "mqm-pilot-v3"},
        "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
        "thinking": {"type": "string", "minLength": 1}, "prompt_sha256": {"$ref": "#/$defs/sha"},
        "policy_sha256": {"$ref": "#/$defs/sha"}, "severity_matrix_sha256": {"$ref": "#/$defs/sha"},
        "anchors_sha256": {"$ref": "#/$defs/sha"},
        "bundle_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
        "bundle_sha256s": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}}
      }
    },
    "items": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["quote", "occurrence"],
      "properties": {"quote": {"type": "string"}, "occurrence": {"type": "integer", "minimum": 0}, "whole_item": {"const": true}}
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["finding_id", "error_code", "phenomenon", "meaning_change", "source_evidence", "target_evidence", "explanation"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "error_code": {"enum": ["ACC_MISTRANSLATION", "ACC_OMISSION", "ACC_ADDITION", "ACC_UNTRANSLATED", "ACC_POLARITY", "ACC_CONDITION", "ACC_NUMBER_UNIT", "ACC_ENTITY_ROLE", "TERM_PREFERRED", "TERM_PROPER_NAME", "TERM_INCONSISTENT", "FLU_AMBIGUITY", "UI_CLARITY"]},
        "phenomenon": {"enum": ["number", "number-range", "unit", "condition", "polarity", "entity-role", "scope", "trigger-timing", "omission", "addition", "terminology", "proper-name", "ambiguity", "other"]},
        "meaning_change": {"enum": ["omitted", "added", "weakened", "strengthened", "reversed", "reassigned", "made-ambiguous", "unknown"]},
        "source_evidence": {"$ref": "#/$defs/evidence"}, "target_evidence": {"$ref": "#/$defs/evidence"},
        "explanation": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["revision_id", "assessment_state", "findings"],
      "properties": {
        "revision_id": {"$ref": "#/$defs/sha"},
        "assessment_state": {"enum": ["assessed", "context-insufficient"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
      }
    }
  }
}
