{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-gold-review-v2",
  "title": "Independent Facts-study gold review v2 (curation)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-facts-study-gold-review-v2"},
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "items": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "facts-study-gold-v2.schema.json#/$defs/goldItem"}
    }
  },
  "required": ["contract", "schema_version", "study_id", "reviewer_id", "independent", "items"]
}
