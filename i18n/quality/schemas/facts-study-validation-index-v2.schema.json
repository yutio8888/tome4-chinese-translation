{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-validation-index-v2",
  "title": "Facts-study validation index v2 (curation; offline replay only)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "tome4-quality-facts-study-validation-index-v2"
    },
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preregistration_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "offline-fake-replay",
        "external-assessments"
      ]
    },
    "structure_validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "const": 33
        },
        "denominator": {
          "const": 33
        },
        "value": {
          "const": 1.0
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value"
      ]
    },
    "evidence_validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "const": 33
        },
        "denominator": {
          "const": 33
        },
        "value": {
          "const": 1.0
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value"
      ]
    },
    "inputs": {
      "type": "object"
    },
    "assessments": {
      "type": "object"
    },
    "validation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runner_reports": {
      "type": "object"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "study_id",
    "preregistration_id",
    "mode",
    "structure_validity",
    "evidence_validity",
    "inputs",
    "assessments",
    "validation_id"
  ]
}