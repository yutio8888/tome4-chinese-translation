{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-gold-adjudication-v2",
  "title": "Facts-study gold adjudication v2 (curation)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-facts-study-gold-adjudication-v2"},
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "frozen"},
    "adjudicator_id": {"type": "string", "minLength": 1},
    "review_artifact_sha256s": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "items": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "facts-study-gold-v2.schema.json#/$defs/goldItem"}
    }
  },
  "required": [
    "contract", "schema_version", "study_id", "status", "adjudicator_id",
    "review_artifact_sha256s", "items"
  ]
}
