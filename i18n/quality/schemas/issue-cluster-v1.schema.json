{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "tome4-quality-issue-cluster-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "quality_contract", "sample_id", "sample_size", "assessment_ids", "match_id", "issues", "manual_queue"],
  "properties": {
    "schema_version": {"const": 1}, "quality_contract": {"const": "tome4-quality-issue-cluster-v1"},
    "sample_id": {"type": "string"}, "sample_size": {"type": "integer", "minimum": 1}, "assessment_ids": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "match_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issues": {"type": "array", "items": {"$ref": "#/definitions/issue"}},
    "manual_queue": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "member": {"type": "object", "additionalProperties": false, "required": ["side", "finding_id", "normalized"], "properties": {"side": {"enum": ["left", "right"]}, "finding_id": {"type": "string"}, "normalized": {"type": "object"}}},
    "issue": {"type": "object", "additionalProperties": false, "required": ["issue_id", "revision_id", "cluster_type", "members", "fact_state", "derivation"], "properties": {
      "issue_id": {"type": "string", "pattern": "^QI-[0-9]{4}$"}, "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "cluster_type": {"enum": ["full-match", "partial-match", "split-merge", "left-only", "right-only", "ambiguous"]},
      "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/member"}},
      "fact_state": {"enum": ["agreed", "conflict", "single-sided", "needs-adjudication"]},
      "derivation": {"type": "object"}
    }}
  }
}
