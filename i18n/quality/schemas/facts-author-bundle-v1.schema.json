{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-author-bundle-v1",
  "additionalProperties": false,
  "properties": {
    "bundle_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "contract": {"const": "tome4-quality-facts-author-bundle-v1"},
    "items": {"maxItems": 20, "minItems": 20, "type": "array"},
    "schema_version": {"const": 1},
    "study_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": ["contract", "schema_version", "study_id", "items", "bundle_id"],
  "type": "object"
}
