{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-curator-bundle-v1",
  "title": "Target-visible curator bundle v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-curator-bundle-v1"},
    "schema_version": {"const": 1},
    "pool_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "curator_bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "facts_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/curatorItem"}
    }
  },
  "required": ["contract", "schema_version", "pool_id", "curator_bundle_id", "facts_packet_sha256", "items"],
  "$defs": {
    "boundedContextEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_index": {"type": "integer"},
        "source": {"type": "string"},
        "target": {"type": "string"}
      },
      "required": ["relative_index", "source", "target"]
    },
    "curatorItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "source_tag": {"type": "string"},
        "section": {"type": "string"},
        "item_kind": {"type": "string", "enum": ["semantic", "term", "mechanics", "ui", "localization"]},
        "stratum": {
          "type": "string",
          "enum": ["term-proper-name", "mechanism-condition-number", "entity-relation", "ui-role", "general-semantic-clean-control"]
        },
        "bounded_context": {"type": "array", "items": {"$ref": "#/$defs/boundedContextEntry"}},
        "facts": {
          "type": "array",
          "maxItems": 4,
          "items": {"$ref": "quality-common-v1.schema.json#/$defs/fact"}
        }
      },
      "required": [
        "revision_id", "source", "target", "source_tag", "section", "item_kind",
        "stratum", "bounded_context", "facts"
      ]
    }
  }
}
