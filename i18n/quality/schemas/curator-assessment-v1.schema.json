{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-curator-assessment-v1",
  "title": "Target-visible curator assessment v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-curator-assessment-v1"},
    "schema_version": {"const": 1},
    "pool_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "curator_id": {"type": "string", "minLength": 1},
    "status": {"const": "frozen"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "language_declaration": {"$ref": "#/$defs/languageDeclaration"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assessmentItem"}
    },
    "assessment_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": [
    "contract", "schema_version", "pool_id", "curator_id", "status",
    "lineage", "language_declaration", "items", "assessment_id"
  ],
  "$defs": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "curator_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "controlled_mutations_seen": {"const": false},
        "gold_seen": {"const": false}
      },
      "required": ["facts_packet_sha256", "curator_bundle_sha256", "controlled_mutations_seen", "gold_seen"]
    },
    "languageDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts_statements_language": {"const": "english-metalanguage"},
        "verified": {"const": true}
      },
      "required": ["facts_statements_language", "verified"]
    },
    "assessmentItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "classification": {
          "type": "string",
          "enum": ["fact-dependent-defect", "surface-defect", "clean", "acceptable-localization", "unsuitable-uncertain"]
        },
        "fact_trap": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "required": ["revision_id", "classification", "fact_trap", "notes"]
    }
  }
}
