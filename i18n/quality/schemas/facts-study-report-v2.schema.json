{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-report-v2",
  "title": "Facts-study causal report v2 (curation; non-evidentiary offline replay)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "tome4-quality-facts-study-report-v2"
    },
    "schema_version": {
      "const": 1
    },
    "study_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preregistration_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "holdout_clearance": {
      "const": false
    },
    "evidence_mode": {
      "type": "string",
      "enum": [
        "non-evidentiary-offline-replay",
        "external-assessments"
      ]
    },
    "external_evidence": {
      "type": "boolean"
    },
    "schema_validity": {
      "$ref": "#/$defs/ratio"
    },
    "evidence_validity": {
      "$ref": "#/$defs/ratio"
    },
    "run_metrics": {
      "type": "object"
    },
    "two_stage_metrics": {
      "type": "object"
    },
    "two_stage_composition": {
      "type": "object"
    },
    "pooled_metrics": {
      "type": "object"
    },
    "natural_pooled_metrics": {
      "type": "object"
    },
    "controlled_pooled_metrics": {
      "type": "object"
    },
    "contrasts": {
      "type": "object"
    },
    "paired_item_bootstrap": {
      "type": "object"
    },
    "claim_detection_frequencies": {
      "type": "object"
    },
    "incremental_true_claims": {
      "type": "object"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {
          "type": "string",
          "minLength": 1
        },
        "criteria": {
          "type": "object"
        }
      },
      "required": [
        "result",
        "criteria"
      ]
    },
    "report_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contract",
    "schema_version",
    "study_id",
    "preregistration_id",
    "holdout_clearance",
    "evidence_mode",
    "external_evidence",
    "schema_validity",
    "evidence_validity",
    "run_metrics",
    "two_stage_metrics",
    "two_stage_composition",
    "pooled_metrics",
    "natural_pooled_metrics",
    "controlled_pooled_metrics",
    "contrasts",
    "paired_item_bootstrap",
    "claim_detection_frequencies",
    "incremental_true_claims",
    "decision",
    "report_id"
  ],
  "$defs": {
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value"
      ]
    }
  }
}