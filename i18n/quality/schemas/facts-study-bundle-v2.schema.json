{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-bundle-v2",
  "title": "Blinded Facts-study evaluator bundle v2 (curation)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-facts-study-bundle-v2"},
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arm": {"type": "string", "enum": ["A", "B", "C", "D", "N", "L", "F"]},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/bundleItem"}
    },
    "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["contract", "schema_version", "study_id", "arm", "prompt_sha256", "items", "bundle_id"],
  "$defs": {
    "boundedContextEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relative_index": {"type": "integer"},
        "source": {"type": "string"},
        "target": {"type": "string"}
      },
      "required": ["relative_index", "source", "target"]
    },
    "contentBlock": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "block_type": {"const": "translation"},
            "source": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1}
          },
          "required": ["block_type", "source", "target"]
        },
        {
          "additionalProperties": false,
          "properties": {
            "block_type": {"const": "supplemental"},
            "packet": {
              "type": "array",
              "maxItems": 4,
              "items": {"$ref": "quality-common-v1.schema.json#/$defs/fact"}
            }
          },
          "required": ["block_type", "packet"]
        }
      ]
    },
    "bundleItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "item_kind": {"type": "string", "enum": ["semantic", "term", "mechanics", "ui", "localization"]},
        "source_tag": {"type": "string"},
        "bounded_context": {"type": "array", "items": {"$ref": "#/$defs/boundedContextEntry"}},
        "content_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/contentBlock"}
        }
      },
      "required": ["index", "revision_id", "item_kind", "source_tag", "bounded_context", "content_blocks"]
    }
  }
}
