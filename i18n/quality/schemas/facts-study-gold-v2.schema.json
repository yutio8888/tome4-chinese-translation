{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tome4-quality-facts-study-gold-v2",
  "title": "Exhaustive adjudicated Facts-study gold v2 (curation)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {"const": "tome4-quality-facts-study-gold-v2"},
    "schema_version": {"const": 1},
    "study_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["draft", "frozen"]},
    "review_lineage": {"$ref": "#/$defs/reviewLineage"},
    "items": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/goldItem"}
    }
  },
  "required": ["contract", "schema_version", "study_id", "status", "review_lineage", "items"],
  "$defs": {
    "reviewLineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewer_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "review_artifact_sha256s": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "adjudicator_id": {"type": "string"},
        "adjudication_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "required": ["reviewer_ids", "review_artifact_sha256s", "adjudicator_id", "adjudication_artifact_sha256"]
    },
    "goldItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clean": {"type": "boolean"},
        "fact_trap": {"type": "boolean"},
        "acceptable_localization": {"type": "boolean"},
        "origin": {"type": "string", "enum": ["natural", "controlled"]},
        "claims": {
          "type": "array",
          "items": {"$ref": "quality-common-v1.schema.json#/$defs/claim"}
        }
      },
      "required": ["revision_id", "clean", "fact_trap", "acceptable_localization", "origin", "claims"]
    }
  }
}
