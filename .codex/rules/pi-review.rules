# tools/pi-review is retired (tombstone): it exits non-zero without reading
# bundles or starting any provider. This rule only matches the retired command
# to surface the tombstone/migration hint; it does not itself send any bundle
# to an external provider. Review dispatch now runs through Paseo REVIEWER
# (translation_contextual_v1 for translations, Codex for code/legacy v1).
prefix_rule(
    pattern = ["tools/pi-review"],
    decision = "prompt",
    justification = "tools/pi-review is retired (tombstone): it exits non-zero without launching a provider. This rule only surfaces the retirement/migration hint and never sends any bundle to an external provider; use Paseo REVIEWER (translation_contextual_v1 / Codex) for review dispatch.",
    match = [
        "tools/pi-review --bundle /tmp/review-bundle.json",
        "tools/pi-review --bundle /tmp/review-bundle.json --timeout 900",
    ],
    not_match = [
        "tools/pi-subagent --workset /tmp/workset.json",
        "pi --print prompt",
    ],
)
