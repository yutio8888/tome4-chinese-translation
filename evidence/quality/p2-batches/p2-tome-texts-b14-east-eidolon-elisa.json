      "section": "mod-tome/data/chats/eidolon-plane.lua",
      "source": "Just let me go please.",
      "source_tag": "_t",
      "special": null,
      "target": "请让我死吧。",
      "pinned_source_match": true,
      "revision_id": "cf30e6c39d05123e8a4f1898829ee797f7ae6670719e4bf13ca013d7f151c9cd"
