      "component": "tome",
      "entry_id": "803eadfe070b15505d7a60b584f92ea9245f77064e166ff6d8ae74fbe50d7cab",
      "line": 4983,
      "section": "mod-tome/data/chats/elisa-shop.lua",
      "source": "Let's see what have you got here...\n%s\n\nThat is very nice, @playername@!",
      "source_tag": "tformat",
      "special": null,
      "target": "让我看看你找到了什么好东西……\n%s\n\n真是不错，@playername@!",
      "pinned_source_match": true,
      "revision_id": "803eadfe070b15505d7a60b584f92ea9245f77064e166ff6d8ae74fbe50d7cab"
    },
    {
      "args_order": null,
