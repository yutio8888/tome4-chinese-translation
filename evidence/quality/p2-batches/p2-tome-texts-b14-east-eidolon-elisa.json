      "line": 4971,
      "section": "mod-tome/data/chats/elisa-orb-scrying.lua",
      "source": "Oh, hi @playername@, have you got something new to show me?",
      "source_tag": "_t",
      "special": null,
      "target": "啊，你好 @playername@ ，有什么新东西给我看么？",
      "pinned_source_match": true,
