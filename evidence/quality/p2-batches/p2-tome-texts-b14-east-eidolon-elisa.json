    },
    {
      "args_order": null,
      "component": "tome",
      "entry_id": "f66263b939025f970a657aa81cb0ceb89f5d4cd0d653790d7e8f57a38817d17a",
      "line": 4972,
      "section": "mod-tome/data/chats/elisa-orb-scrying.lua",
      "source": "Yes, Elisa, could you have a look at these objects please? [show her the items the orb could not identify]",
      "source_tag": "_t",
      "special": null,
      "target": "是的，埃莉萨，你能帮我看看这些东西么？[给她看看水晶球无法辨识的物品。]",
