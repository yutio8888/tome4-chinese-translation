      "line": 4973,
      "section": "mod-tome/data/chats/elisa-orb-scrying.lua",
      "source": "Err, no... sorry, I just wanted to hear a friendly voice.",
      "source_tag": "_t",
      "special": null,
      "target": "呃，没有……抱歉，我只想听听你甜美的声音。",
