      "entry_id": "c044d5f6f94793cd675264300ec62f6f040b722847c287ba2d26dc166cde6743",
      "line": 5256,
      "section": "mod-tome/data/chats/keepsake-caravan-destroyed.lua",
      "source": "#VIOLET#*As the last member of the caravan lies dying, you look at him and see the hate that fills his eyes.*#LAST#\nWe should have finished you off that day. You deserved no mercy!",
      "source_tag": "_t",
      "special": null,
      "target": "#VIOLET#*当商队最后一名成员垂死之际，你看着他，看到他眼中充满仇恨。*#LAST#\n我们那天应该杀了你。你不应该得到怜悯！",
      "pinned_source_match": true,
      "revision_id": "c044d5f6f94793cd675264300ec62f6f040b722847c287ba2d26dc166cde6743"
    },
    {
      "args_order": null,
      "component": "tome",
      "entry_id": "971e82071c69e7796966d53d2c6bd5e122021c838a4c646980315b92d07180f8",
      "line": 5259,
      "section": "mod-tome/data/chats/keepsake-caravan-destroyed.lua",
      "source": "And I will show you no mercy. #LIGHT_GREEN#[Kill him]#LAST#",
      "source_tag": "_t",
      "special": null,
      "target": "那就让我来告诉你什么是无情。 #LIGHT_GREEN#[杀了他]#LAST#",
      "pinned_source_match": true,
      "revision_id": "971e82071c69e7796966d53d2c6bd5e122021c838a4c646980315b92d07180f8"
    },
    {
      "args_order": null,
      "component": "tome",
      "entry_id": "6870be9c5f3d1d29f876d5382382f15f0315b1303c35853c7c5a7d13939b11c6",
      "line": 5260,
      "section": "mod-tome/data/chats/keepsake-caravan-destroyed.lua",
      "source": "I am sorry. #LIGHT_GREEN#[Help him]#LAST#",
