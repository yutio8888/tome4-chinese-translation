  "translation_entries": {
    "ashes-heart-of-fire-devouring-flames-info":{"identity":{"component":"ashes-urhrok","section":"tome-ashes-urhrok/data/talents/corruptions/heart-of-fire.lua","source_tag":"tformat"},"source":"Your connection to fire nourishes you. Whenever you strike an enemy in melee, you inflict a burning curse upon them. As long as they continue to burn, you gain %0.2f health and %0.2f vim per turn.\n\t\tEach turn they remain within 10 spaces of you, all enemies with cursed flames will spread it to other burning enemies in radius 1, causing you to heal for the same amount for each enemy, as well as dealing %d fire damage on spreading.","target":"恶魔之炎抚育你成长。每次你近战攻击命中时，你对目标施加诅咒，只要其处于燃烧状态，你每回合获得 %0.2f 生命与 %0.2f 活力。 \n\t同时，在你周围 10 码范围内，所有被诅咒火焰燃烧的敌方生物会将诅咒传播至半径 1 内的燃烧生物上，并造成 %d 火焰伤害同时给予你等量治疗。","source_tag":"tformat","placeholder_order":[1,2,3],"translation_file":"tome-ashes-urhrok.lua","section":"tome-ashes-urhrok/data/talents/corruptions/heart-of-fire.lua"},
    "ashes-torture-incinerating-blows-info":{"identity":{"component":"ashes-urhrok","section":"tome-ashes-urhrok/data/talents/corruptions/torture.lua","source_tag":"tformat"},"source":"The power of the Fearscape infuses your weapon: Your melee attacks will deal %0.2f fire damage, spread over 3 turns.\n\t\tAdditionally, every time you attack, there is a %d%% chance of releasing a burst of powerful fire that will deal %0.2f fire damage to all enemies in radius %d over %d turns.\n\t\tIf this talent is not on cooldown, the burst of fire will instead be radius %d, and stun all targets in addition to burning them.\n\t\tFor the purposes of applying the stun, you have %d bonus spellpower.\n\t\tThe damage will increase with your Spellpower.","target":"恶魔空间的力量注入你的武器：你的近战攻击会在 3 回合内造成总计 %0.2f 点火焰燃烧伤害。\n\t另外，每次攻击时有 %d%% 几率释放强力火焰爆发，造成总计 %0.2f 点火焰燃烧伤害；半径 %d 内的所有敌人都会受到此伤害，持续 %d 回合。\n\t若该技能不在冷却中，火焰爆发将改为半径 %d，并使范围内所有敌对目标同时燃烧和震慑。\n\t进行震慑判定时，你获得 %d 点额外法术强度。\n\t伤害受法术强度加成。","source_tag":"tformat","placeholder_order":[1,2,3,4,5,6,7],"translation_file":"tome-ashes-urhrok.lua","section":"tome-ashes-urhrok/data/talents/corruptions/torture.lua"},
    "ashes-timed-effects-fiery-aegis":{"identity":{"component":"ashes-urhrok","section":"tome-ashes-urhrok/data/timed_effects.lua","source_tag":"tformat"},"source":"The target is surrounded by a magical shield, absorbing %d/%d damage before it crumbles and dealing %d damage in a radius of %d when it does.","target":"目标被一层魔法护盾包围，吸收 %d/%d 伤害，护盾结束时（无论吸收耗尽还是自然到期），对周围敌方生物施加持续 3 回合的灼烧，总计造成 %d 伤害，作用半径为 %d。","source_tag":"tformat","placeholder_order":[1,2,3,4],"translation_file":"tome-ashes-urhrok.lua","section":"tome-ashes-urhrok/data/timed_effects.lua"},
    "orcs-butchery-overheat-saws-info":{"identity":{"component":"orcs","section":"tome-orcs/data/talents/steam/butchery.lua","source_tag":"tformat"},"source":"Channel hot steam around your saws, burning foes you strike in melee for %0.2f fire damage over 3 turns (which can stack)!\n\t\t#{italic}#Hot, steamy maiming!#{normal}#","target":"用蒸汽包裹链锯，对近战攻击命中的目标在 3 回合内造成 %0.2f 点火焰伤害（可以叠加）。\n\t\t#{italic}#滚烫的蒸汽，死吧！#{normal}#","source_tag":"tformat","placeholder_order":[1],"translation_file":"tome-orcs.lua","section":"tome-orcs/data/talents/steam/butchery.lua"},
    "orcs-heavy-weapons-flame-jet-info":{"identity":{"component":"orcs","section":"tome-orcs/data/talents/steam/heavy-weapons.lua","source_tag":"tformat"},"source":"Fire a jet of flame, dealing %d%% weapon damage as fire over 3 turns.","target":"发射一团火焰，在 3 回合内造成 %d%% 火焰武器伤害。","source_tag":"tformat","placeholder_order":[1],"translation_file":"tome-orcs.lua","section":"tome-orcs/data/talents/steam/heavy-weapons.lua"},
    "tome-damage-types-fire-burn":{"identity":{"component":"tome","section":"mod-tome/data/damage_types.lua","source_tag":"damage type"},"source":"fire burn","target":"火焰燃烧","source_tag":"damage type","placeholder_order":[],"translation_file":"mod-tome.lua","section":"mod-tome/data/damage_types.lua"},
    "tome-elemental-trap-damage":{"identity":{"component":"tome","section":"mod-tome/data/general/traps/elemental.lua","source_tag":"tformat"},"source":"Deals %s%d#LAST# %s damage","target":"造成%s%d#LAST#%s伤害","source_tag":"tformat","placeholder_order":[1,2,3],"translation_file":"mod-tome.lua","section":"mod-tome/data/general/traps/elemental.lua"},
    "tome-elemental-trap-radius-damage":{"identity":{"component":"tome","section":"mod-tome/data/general/traps/elemental.lua","source_tag":"tformat"},"source":"Deals %s%d#LAST# %s damage (radius %d)","target":"造成%s%d#LAST# %s伤害(范围 %d)","source_tag":"tformat","placeholder_order":[1,2,3,4],"translation_file":"mod-tome.lua","section":"mod-tome/data/general/traps/elemental.lua"},
    "tome-explosion-trap-short":{"identity":{"component":"tome","section":"mod-tome/data/talents/cunning/traps.lua","source_tag":"tformat"},"source":"Explodes (radius 2) for %0.2f fire damage over 3 turns.","target":"爆炸(范围 2) ：3回合内 %0.2f 火焰伤害。","source_tag":"tformat","placeholder_order":[1],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/cunning/traps.lua"},
    "tome-explosion-trap-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/cunning/traps.lua","source_tag":"tformat"},"source":"Lay a simple yet effective trap that explodes in a radius 2 on contact, setting those affected on fire for %0.2f fire damage over 3 turns.\n\t\tThis trap can use a primed trigger and a high level lure can trigger it.%s","target":"放置一个简单而有效的陷阱，激活后触发半径 2 的爆炸, 3 回合内造成 %0.2f 火焰伤害。\n\t\t该陷阱可以被设置为直接激活，也可以被诱饵激活。 %s","source_tag":"tformat","placeholder_order":[1,2],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/cunning/traps.lua"},
    "tome-shadow-flames-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/cursed/shadows.lua","source_tag":"tformat"},"source":"Bathes the target in flames doing %0.2f damage\n\t\tThe damage will increase with the Magic stat","target":"用火焰灼烧你的目标造成 %0.2f 伤害。\n\t\t伤害受魔力值加成。","source_tag":"tformat","placeholder_order":[1],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/cursed/shadows.lua"},
    "tome-fire-drake-fire-breath-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/gifts/fire-drake.lua","source_tag":"tformat"},"source":"You breathe fire in a frontal cone of radius %d. Any target caught in the area will take %0.2f fire damage over 3 turns.\n\t\tThe damage will increase with your Strength and the critical chance is based on your Mental crit rate.\n\t\tEach point in fire drake talents also increases your fire resistance by 1%%.","target":"你在前方 %d 码锥形范围内喷出火焰。此范围内的目标会在 3 回合内受到 %0.2f 火焰伤害。\n\t\t伤害受力量值加成，暴击几率基于你的精神暴击率。\n\t\t每点火龙系的技能可以使你增加火焰抗性 1%%。","source_tag":"tformat","placeholder_order":[1,2],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/gifts/fire-drake.lua"},
    "tome-higher-draconic-prismatic-slash-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/gifts/higher-draconic.lua","source_tag":"tformat"},"source":"Unleash raw, chaotic elemental damage upon your enemy.\n\t\tYou strike your enemy for %d%% weapon damage in one of blinding sand, disarming acid, freezing and slowing ice, dazing lightning or stunning flames, with equal odds.\n\t\tAdditionally, you will cause a burst that deals %0.2f of that damage to creatures in radius %d, regardless of if you hit with the blow.\n\t\tLevels in Prismatic Slash increase your Physical and Mental attack speeds by %d%%.\n\n\t\tThis talent will also attack with your shield, if you have one equipped.","target":"向你的敌人释放原始的混乱元素攻击。\n\t\t你会等概率地从致盲之沙、缴械酸雾、可冻结并减速的寒冰、眩晕闪电或震慑之焰中选择一种攻击敌人，造成 %d%% 对应伤害类型的武器伤害。\n\t\t此外，无论你的元素攻击是否命中敌人你都会对 %d 码半径范围内的生物造成 %0.2f 伤害。\n\t\t五灵挥击还会使你的物理和精神攻击速度提升 %d%%。\n\t\t如果你装备了盾牌，这一技能也会用你的盾牌攻击。","source_tag":"tformat","placeholder_order":[1,3,2,4],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/gifts/higher-draconic.lua"},
    "tome-inscriptions-heat-beam-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/misc/inscriptions.lua","source_tag":"tformat"},"source":"Activate the rune to fire a beam of heat, doing %0.2f fire damage over 5 turns\n\t\tThe intensity of the heat will also remove one random detrimental physical effect from you.","target":"激活这个符文发射一束射线，造成 %0.2f 火焰伤害持续 5 回合。\n\t\t高温同时会解除你受到的一个负面物理状态。","source_tag":"tformat","placeholder_order":[1],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/misc/inscriptions.lua"},
    "tome-inscriptions-fire-damage-short":{"identity":{"component":"tome","section":"mod-tome/data/talents/misc/inscriptions.lua","source_tag":"tformat"},"source":"%d fire damage","target":"%d 火焰伤害","source_tag":"tformat","placeholder_order":[1],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/misc/inscriptions.lua"},
    "tome-misc-npcs-flame-bolt-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/misc/npcs.lua","source_tag":"tformat"},"source":"Conjures up a bolt of fire, setting the target ablaze and doing %0.2f fire damage over 3 turns.\n\t\tThe damage will increase with your Spellpower.","target":"召唤一枚火焰箭，点燃目标，并在 3 回合内造成 %0.2f 火焰伤害。\n\t\t伤害受法术强度加成。","source_tag":"tformat","placeholder_order":[1],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/misc/npcs.lua"},
    "tome-psionic-focus-pyrokinesis-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/psionic/focus.lua","source_tag":"tformat"},"source":"Telekinetically energize the matter of all foes within %d squares at the molecular level, setting them ablaze. This does %0.1f fire damage over six turns.","target":"对 %d 范围内的所有敌人，用意念使组成其身体的分子活化并引燃他们，在 6 回合内造成 %0.1f 火焰伤害。","source_tag":"tformat","placeholder_order":[1,2],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/psionic/focus.lua"},
    "tome-psionic-projection-thermal-aura-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/psionic/projection.lua","source_tag":"tformat"},"source":"Fills the air around you with reactive currents of furnace-like heat.\n\t\tIf you have a gem or mindstar in your psionically wielded slot, this will do %0.1f Fire damage to all adjacent enemies, costing %0.1f energy per creature. \n\t\tIf you have a conventional weapon in your psionically wielded slot, this will add %0.1f Fire damage to all your weapon hits, costing %0.1f energy per hit.\n\t\tWhen deactivated, if you have at least %d energy, a massive spike of thermal energy is released as a conical blast (radius %d) of superheated air. Anybody caught in it will suffer up to %d fire damage over several turns.\n\t\t#{bold}#Activating the aura takes no time but de-activating it does.#{normal}#\n\t\tTo turn off an aura without spiking it, deactivate it and target yourself. The damage will improve with your Mindpower.\n\t\tYou can only have two of these auras active at once.","target":"将你周围的空气充满火炉般的热量。\n\t\t如果你的灵能武器槽佩戴的是宝石或灵晶，会对所有接近的目标造成 %0.1f 的火焰伤害，每个生物消耗 %0.1f 能量。\n\t\t如果你的灵能武器槽佩戴的是武器，每次攻击附加 %0.1f 的火焰伤害，每次攻击消耗 %0.1f 能量。\n\t\t当关闭该技能时，如果你拥有最少 %d 点能量，巨大的热能会释放为一个范围为 %d 的锥形冲击。范围内的任意目标在数轮中受到高达 %d 的火焰伤害。\n\t\t#{bold}#激活光环是不消耗时间的，但是关闭它则需要消耗时间。#{normal}#\n\t\t如果要关闭光环且不发射射线，关闭它并选择你自己为目标。伤害随着精神强度而增长。\n\t\t你同时只能激活两种此类光环。","source_tag":"tformat","placeholder_order":[1,2,3,4,5,6,7],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/psionic/projection.lua"},
    "tome-explosives-throw-bomb-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/spells/explosives.lua","source_tag":"tformat"},"source":"Imbue an alchemist gem with an explosive charge of mana and throw it.\n\t\tThe gem will explode for %0.1f %s damage.\n\t\tEach kind of gem will also provide a specific effect.\n\t\tThe damage will improve with better gems and with your Spellpower.","target":"向一块炼金宝石内灌输爆炸能量并扔出它。\n\t\t宝石将会爆炸并造成 %0.1f 的 %s 伤害。\n\t\t每个种类的宝石都会提供一个特殊的效果。\n\t\t伤害受宝石品质和法术强度加成。","source_tag":"tformat","placeholder_order":[1,2],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/spells/explosives.lua"},
    "tome-fire-flame-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/spells/fire.lua","source_tag":"tformat"},"source":"Conjures up a bolt of fire, setting the target ablaze and doing %0.2f fire damage over 3 turns.\n\t\tAt level 5, it will create a beam of flames.\n\t\tThe damage will increase with your Spellpower.","target":"制造一个火球，使目标进入灼烧状态并在 3 回合内造成 %0.2f 火焰伤害。\n\t\t在等级 5 时，火焰会有穿透效果。\n\t\t伤害受法术强度加成。","source_tag":"tformat","placeholder_order":[1],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/spells/fire.lua"},
    "tome-golem-molten-skin-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/spells/golem.lua","source_tag":"tformat"},"source":"Turns the golem's skin into molten rock. The heat generated sets ablaze everything inside a radius of 3, doing %0.2f fire damage in 3 turns for %d turns.\n\t\tBurning is cumulative; the longer they stay within range, they higher the fire damage they take.\n\t\tIn addition the golem gains %d%% fire resistance.\n\t\tMolten Skin damage will not affect friendly creatures.\n\t\tThe damage and resistance will increase with your Spellpower.","target":"使傀儡的皮肤化为熔岩。产生的高温会点燃半径 3 格内的一切，使其在 3 回合内受到 %0.2f 点火焰伤害；炽热皮肤持续 %d 回合。\n\t\t灼烧可以叠加；目标处于范围内越久，受到的火焰伤害越高。\n\t\t此外，傀儡获得 %d%% 火焰抗性。\n\t\t炽热皮肤造成的伤害不会影响友方生物。\n\t\t伤害和抗性随你的法术强度提高。","source_tag":"tformat","placeholder_order":[1,2,3],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/spells/golem.lua"},
    "tome-war-alchemy-heat-info":{"identity":{"component":"tome","section":"mod-tome/data/talents/spells/war-alchemy.lua","source_tag":"tformat"},"source":"Turn part of your target into fire, burning the rest for %0.2f fire damage over 8 turns.\n\t\tThe damage will increase with your Spellpower.","target":"将你的敌人化为火焰，在8回合内造成 %0.2f 火焰伤害。\n\t\t伤害受法术强度加成。","source_tag":"tformat","placeholder_order":[1],"translation_file":"mod-tome.lua","section":"mod-tome/data/talents/spells/war-alchemy.lua"}
  },
