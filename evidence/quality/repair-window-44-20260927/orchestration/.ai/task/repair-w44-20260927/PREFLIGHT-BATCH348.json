391b64ab0efa","component":"orcs","fixed_source_identity":"snapshot:c49975dd444a5402e37267005027ab2c54e23745a37836d31fd27fd808ee7484","logical_entry_identity":"585804bf29fda23246dd0d2a62d9cc18cfcafc34f79c92147f500d459ccb26a1","normalized_path":"tome-orcs.lua","parent_entry_revision_identity":"dc6704a553d52b315ff2c1bb45e16d805e53b68eeba070da404500ae02e44b45","rules_version":"production-review-v2-lite-rules-v2","section":"tome-orcs/data/chats/destructicus.lua","source":"#LIGHT_GREEN#*#{italic}#\"OBTAINING SCRYING LOCK...  OBTAINED.\"#{normal}#\n \nThe beaded panel is suddenly awash with colors, showing the colossal interior of the airship.  Steam Giant families huddle and weep, sorting through the few belongings they could take with them when fleeing; a guard sits on a pile of luggage and storage crates, head in her hands.  The view pans around the cabin, and you see a few crew members hurrying between the captain's quarters and the engine room, pausing to take worried glances out the window - at you.\n \nThis airship appears to be evacuating what's left of the Atmos Tribe.  With the press of a single button, you could eradicate the Steam Giant species forever.\n \nYou press a button labelled #{italic}#\"SELECT NEXT TARGET\"#{normal}#, and the panel shifts to show a very lost and very confused Fire Imp, flying in the air near nothing of importance.  Firing on it would have little effect whatsoever, aside from showing off DESTRUCTICUS's power in the most harmless way possible.*#WHITE#","source_tag":"_t","target_preimage_sha256":"563a7b902db2fe8da8297313bccb198cced0dbc4b327119f71d8d68c25f1a08b","terminology_snapshot_sha256":"d4b72174d314b06054f85291c2c85c383e1124f108b35cf3d0993a6648719f6a"},"rules_version":"production-review-v2-lite-rules-v2","section":"tome-orcs/data/chats/destructicus.lua","source":"#LIGHT_GREEN#*#{italic}#\"OBTAINING SCRYING LOCK...  OBTAINED.\"#{normal}#\n \nThe beaded panel is suddenly awash with colors, showing the colossal interior of the airship.  Steam Giant families huddle and weep, sorting through the few belongings they could take with them when fleeing; a guard sits on a pile of luggage and storage crates, head in her hands.  The view pans around the cabin, and you see a few crew members hurrying between the captain's quarters and the engine room, pausing to take worried glances out the window - at you.\n \nThis airship appears to be evacuating what's left of the Atmos Tribe.  With the press of a single button, you could eradicate the Steam Giant species forever.\n \nYou press a button labelled #{italic}#\"SELECT NEXT TARGET\"#{normal}#, and the panel shifts to show a very lost and very confused Fire Imp, flying in the air near nothing of importance.  Firing on it would have little effect whatsoever, aside from showing off DESTRUCTICUS's power in the most harmless way possible.*#WHITE#","source_tag":"_t","target_preimage":"#LIGHT_GREEN#*#{italic}#\"获取侦测锁定中……已获取。\"#{normal}#\n\n珍珠面板突然充满色彩，显示飞船的巨大内部结构。蒸汽巨人们拥挤而哭泣，整理着逃离时仅能带走的少量财物；一名守卫双手抱头，坐在一堆行李和储物箱上。视角切换到船舱，你看见一些成员匆忙走过船长室和引擎室，偶尔忧虑地瞥向窗外——看向你。\n飞船似乎正在疏散气之部族的残余成员。只要按下一个按钮，你将能永久摧毁蒸汽巨人这个种族。\n\n你按下按钮 #{italic}#\"选择下个目标\"#{normal}#，面板显示出一个迷茫而混乱的火焰小鬼，在空中无害地飞舞。向他开火没什么意义，只是以最无害的方式炫耀毁灭号的力量。*#WHITE#","target_preimage_sha256":"563a7b902db2fe8da8297313bccb198cced0dbc4b327119f71d8d68c25f1a08b","terminology_snapshot_sha256":"d4b72174d314b06054f85291c2c85c383e1124f108b35cf3d0993a6648719f6a","winner_evidence":{"adjudications_path":"evidence/production-review-v2-lite/batches/batch-cb782c29f8583a6e6046/adjudications.jsonl","batch_id":"batch-cb782c29f8583a6e6046","evidence_commit":null,"evidence_path":null,"manifest_path":"evidence/production-review-v2-lite/batches/batch-cb782c29f8583a6e6046/manifest.json","observation_identity":"5d93f08fc8cf3af9e7a0c9753bcbab9ab4b8b97abce1eb91eadb7cc45b956408","publication_commit":"4ebffef5681df76600eb20aaffcdb6129a7fac56","result_sha256":"d7cff7b908c5ce9ca8860060061f20e398035a5a5df2bc4cb33c97516de6fefd","results_path":"evidence/production-review-v2-lite/batches/batch-cb782c29f8583a6e6046/results.jsonl"}},{"call_locator":"f6457046b61a9585dfd3fd03680161f6ee18e93fa77ed707cc19f8968ed2a4a8","component":"orcs","entry_revision_identity":"dcb810596c1a05d42e63d20b2e7e8df554d235f205973bf76df69a530bee6d3a","fixed_source_identity":"snapshot:c49975dd444a5402e37267005027ab2c54e23745a37836d31fd27fd808ee7484","logical_entry_identity":"8d10e739d1518a12abbe7f581e65085fc2a76536cbb7a33bb25587204d82463a","normalized_path":"tome-orcs.lua","proposed_successor_input":{"call_locator":"f6457046b61a9585dfd3fd03680161f6ee18e93fa77ed707cc19f8968ed2a4a8","component":"orcs","fixed_source_identity":"snapshot:c49975dd444a5402e37267005027ab2c54e23745a37836d31fd27fd808ee7484","logical_entry_identity":"8d10e739d1518a12abbe7f581e65085fc2a76536cbb7a33bb25587204d82463a","normalized_path":"tome-orcs.lua","parent_entry_revision_identity":"dcb810596c1a05d42e63d20b2e7e8df554d235f205973bf76df69a530bee6d3a","rules_version":"production-review-v2-lite-rules-v2","section":"tome-orcs/data/lore/palace-fumes.lua","source":"A Reminder to Our Constituents:\n\nAny votes for an individual candidate for office cease to be valid once the primaries are over, and the field has been narrowed down to two (or rarely three, in a close race) candidates.  At this point, you cannot vote for your candidate; instead, a competition will be held, after which its victor will be awarded with the position.  The vote you are submitting now determines how they will be competing.  While we cannot enforce how or why you vote, we request that you respect the spirit of our system, and select a competition which reflects the candidates' capability to handle the responsibilities of the Chief Councilor position.","source_tag":"_t","target_preimage_sha256":"783b18cc34d42fe11739d3cc845bbfb01f7c7fdf3356441ae6edbb48943a7631","terminology_snapshot_sha256":"d4b72174d314b06054f85291c2c85c383e1124f108b35cf3d0993a6648719f6a"},"rules_version":"production-review-v2-lite-rules-v2","section":"tome-orcs/data/lore/palace-fumes.lua","source":"A Reminder to Our Constituents:\n\nAny votes for an individual candidate for office cease to be valid once the primaries are over, and the field has been narrowed down to two (or rarely three, in a close race) candidates.  At this point, you cannot vote for your candidate; instead, a competition will be held, after which its victor will be awarded with the position.  The vote you are submitting now determines how they will be competing.  While we cannot enforce how or why you vote, we request that you respect the spirit of our system, and select a competition which reflects the candidates' capability to handle the responsibilities of the Chief Councilor position.","source_tag":"_t","target_preimage":"敬告广大选民：\n初选结束后，任何向个人的投票将会不再有效，名额会被削减到两名（如果票数接近，有时会是三名）候选人。在那个时候，您将不能为您的候选人投票；相对应的，将会举行一个比赛，胜利者会获得职位。您现在的投票将会决定他们竞争的方式。我们不能强制要求您投票的方式或动机，但我们仍然请求您尊重我们体制的精神，选择一个能够反映出候选人作为议长履行职责的能力的合适的比赛项目。","target_preimage_sha256":"783b18cc34d42fe11739d3cc845bbfb01f7c7fdf3356441ae6edbb48943a7631","terminology_snapshot_sha256":"d4b72174d314b06054f85291c2c85c383e1124f108b35cf3d0993a6648719f6a","winner_evidence":{"adjudications_path":"evidence/production-review-v2-lite/batches/batch-cb782c29f8583a6e6046/adjudications.jsonl","batch_id":"batch-cb782c29f8583a6e6046","evidence_commit":null,"evidence_path":null,"manifest_path":"evidence/production-review-v2-lite/batches/batch-cb782c29f8583a6e6046/manifest.json","observation_identity":"8806bdd38a40bbfb5afc487d471e2d2c415ecb30f70eb7fa439c33193eac1132","publication_commit":"4ebffef5681df76600eb20aaffcdb6129a7fac56","result_sha256":"aeed69b406517baa0b6bde54ead7f65d149f9d68bf7a20998764af427e437665","results_path":"evidence/production-review-v2-lite/batches/batch-cb782c29f8583a6e6046/results.jsonl"}}],"items_sha256":"c47f385aec803dbc9a65348faf105f341bde123384ba850524da29bbffc50893","kind":"production_review_v2_lite_repair_workset_v1","policy_sha256":"99dd4164ae278c74dd670ae726f8fea2f9c8e6ae7e44a9b9d9dd2f0