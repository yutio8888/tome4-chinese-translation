{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prospective-source-context-truth-audit-v1/SURFACE-CANDIDATE-SCHEMA.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "phase", "shard_id", "surface_queue_sha256", "items"],
  "properties": {
    "schema_version": {"const": "prospective-source-context-surface-candidate-v1"},
    "status": {"const": "SURFACE_CANDIDATE_COMPLETE"},
    "phase": {"const": "SURFACE"},
    "shard_id": {"type": "integer", "minimum": 1, "maximum": 3},
    "surface_queue_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["audit_id", "label", "surface_material_defect", "reason"],
        "properties": {
          "audit_id": {"type": "string", "pattern": "^V1-[0-9]{3}$"},
          "label": {"enum": ["SURFACE_VISIBLE_DEFECT", "CLEAN", "UNRESOLVED"]},
          "surface_material_defect": {"type": ["boolean", "null"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
