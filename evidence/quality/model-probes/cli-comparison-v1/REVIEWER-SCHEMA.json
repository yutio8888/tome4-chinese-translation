{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["revisions"],
  "properties": {
    "revisions": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision_id", "observation", "evidence"],
        "properties": {
          "revision_id": {"type": "string"},
          "observation": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
