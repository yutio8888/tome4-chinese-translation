    "max_chars": 8000,
    "head_chars_when_truncated": 5200,
    "tail_chars_when_truncated": 2700,
    "missing_policy": "any missing or non-unique source file or enclosing block is CONTEXT_MISSING and fails preflight before inference; multiple literal occurrences are allowed only when every occurrence resolves to the same block",
    "visible_content": "raw sanitized Lua code only; no paths, symbol labels, expected claims, mutation metadata or human conclusions"
  },
