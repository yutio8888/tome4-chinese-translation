nt":"tome","entry_revision_identity":"66b8d69733a9935bab3992e3ba19e3aa7714c28bd1d3f2d40af6640d7353bb02","logical_entry_identity":"1d785779f987e6ecbb11aba6c89886350422d9370ea6b1f632f4fd602b619fab","normalized_path":"mod-tome.lua","source":"The target is near a protective aura, granting +%d armour and +%d physical save.","source_tag":"tformat","target":"目标靠近防御光环，获得 +%d 点护甲和 +%d 物理豁免。"},{"args_order":null,"call_locator":"c9138f99a754d65f31316339c6feea8e953a968812417d0a73c90ce434a24055","component":"tome","entry_revision_identity":"66ba4f526a33d9f1221bfcf66624cd2859c87aa2e947b28350e85ff25cf106a8","logical_entry_identity":"1d74b664da60b032f122edc1e16f5402eaf0a698eccd995b4f2fc6eec47db40b","normalized_path":"mod-tome.lua","source":"%s is listening attentively, and wants to know what talents to use.\nYou can modify the tactical weights of various talents to increase or decrease their use.  The weights are multiplicative (zero will turn the talent off) and relative (changing everything to a weight of 2 will not alter how talents are used relative to each other).\nWord travels fast in Maj'Eyal, and if %s is a summon all future summons of the same type will remember your preferences.\n","source_tag":"tformat","target":"%s正在仔细地听着你，向你询问该怎么使用它的技能。\n你可以修改他的技能使用策略中每个技能的权重，增加或减少某些技能使用的概率。这些权重是乘法性的（权重为零表示该技能永远不会被使用）和相对性的（把所有技能的权重都调整为 2，并不会改变各技能之间的相对使用）\n在马基·埃亚尔消息传播得很快。如果 %s 是一个召唤生物，所有同类的召唤生物都会记住你的设置。\n"},{"args_order":null,"call_locator":"4c7d41dfea8101a8b2dddbedbab6a935c0731b95c1beb9502dd142218da6b282","component":"tome","entry_revision_identity":"66bb3c5a3a62a3867c5fdc829c38a301896acdffe6653236ecd6176223f86295","logical_entry_identity":"4e272fc754c5332bfc01e9eaf11f5cd1ec709abbbfc409c9354ade0eb152bff8","normalized_path":"mod-tome.lua","source":"Talent category bonus: ","source_tag":"_t","target":"技能树加成："},{"args_order":null,"call_locator":"d8e391b3fab72aeee9327a70bc25a5ae7d16637fa51691d9959662f5fba0ed71","component":"tome","entry_revision_identity":"66c39b3952915b5fab3af56ad842c8909