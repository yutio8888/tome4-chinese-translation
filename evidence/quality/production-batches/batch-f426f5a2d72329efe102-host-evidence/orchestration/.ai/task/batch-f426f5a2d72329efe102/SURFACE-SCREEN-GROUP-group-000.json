708e892deb9639393e0de9e8d809f792a2bc782f24e43a511c6eaf0b4e835","logical_entry_identity":"f557e78436c28b69e67e8e49cec4f129df021eb9929f9e6fe25da5bfbdef1e55","normalized_path":"mod-tome.lua","source":"Fashioned in ancient times by cultists of Harkor'Zun, these heavy granite gauntlets were designed to protect the wearer from the wrath of their dark master.","source_tag":"_t","target":"古时候由哈克祖的狂热崇拜者制作，这副花岗岩臂铠被设计为可以保护穿戴者免于遭受黑暗之主的暴怒。"},{"args_order":null,"call_locator":"c87c576621f4482e49e12bd321d815940eb88d0cbded0e7b69699475cb0f17c8","component":"tome","entry_revision_identity":"df5963fd0d263096db41f2a64b4da59e598a45c1c2c9a48b2a5f49fb31db80d2","logical_entry_identity":"1b31125db125a16ce964c48a2fbe218a8ea09b6725120c7b84ae5203a47556cf","normalized_path":"mod-tome.lua","source":"turn","source_tag":"_t","target":"回合"},{"args_order":null,"call_locator":"73a910257a58fe764785c84d572263433542133b86c043fb768704f7a3b0c4ab","component":"tome","entry_revision_identity":"df5a1df19c10de9b4721d9c864908774fd6fca8c8eae0b077e8461aba8851931","logical_entry_identity":"da854fab3a0be2ccaeac4cb31fc4c35a07a313c7c2035c250904d9fef2534032","normalized_path":"mod-tome.lua","source":"Hi, I am Nicolas (DarkGod), the maker of this game.\nIt is my dearest hope that you find my game enjoyable, and that you will continue to do so for many years to come!\n\nToME is free and open-source and will stay that way, but that does not mean I can live without money, so I have come to disturb you here and now to ask for your kindness.\nIf you feel that the (many) hours you have spent having fun were worth it, please consider making a donation for the future of the game.\n\nDonators are also granted a few special features: %s.","source_tag":"tformat","target":"你好，我是Nicolas (DarkGod)，这个游戏的制作者。\n我最衷心的希望你会觉得我的游戏很有趣，并且在今后的许多年里你还会继续游玩这款游戏！\n\nToME是免费开源的游戏，并且会一直保持这样。但是我仍然需要钱来生活，所以我来这里打扰你，希望得到你的帮助\n如果你觉得在游戏中体验的时间充满了快乐，你可以考虑捐赠一下，让这个游戏的未来变得更好。\n\n捐赠者将会得到一些游戏的附加功能：%s。"},{"args_order":null,"call_locator":"f69c2664bb510736176d3f1d2f1b7f8cecd003e6d5f55eab5461d6b3dba2fb14","component":"tome","entry_revision_identity":"df5be916f3b655c0c5b11ef8ca2f84d6af5a1ee1d44309c70607cef1eaf97a63","logical_entry_identity":"96efd0c1568a0160ca03795e1214cb5b952c8ab1e1d20127c48a901a86694a7b","normalized_path":"mod-tome.lua","source":"Zone-wide effect: +10% critical chance, +20% critical damage, -20% nature and blight resistance.","source_tag":"_t","target":"区域效果：+10% 暴击几率，+20% 暴击伤害，-20% 自然抗性和枯萎抗性。"},{"args_order":null,"call_locator":"14ae9fdfdb519146133c400d5db74314275df3b7ef19fb8acdd8436ddfbc37aa","component":"tome","entry_revision_identity":"df5ce9ea124298808f552a12dde497ba918d6d14bf54ca61cd3f53ae6db12127","logical_entry_identity":"6dca31ea0e2e8ea9864e8b9126c463966d7f1e4be50d81f92719016037a9c90b","normalized_path":"mod-tome.lua","source":"Enable Discord's Rich Presence integration to show your current character on your currently playing profile on Discord (restart the game to apply).\n#ANTIQUE_WHITE#If you do not use Discord this option doesn't do anything in either state.","source_tag":"_t","target":"开启Discord实时状态可以让你的朋友在Discord上看见你正在玩什么角色（重启游戏后生效）。\n#ANTIQUE_WHITE#如果你不使用Discord, 那么这个选项就是无效的。"},{"args_order":null,"call_locator":"127efddfc15227f0d9ec87db1010a358ab877822217df9784615bdf81d12305e","component":"tome","entry_revision_identity":"df5e98d17924ddbf0d8b5af2c427fe9fd5fb3575b5c45ff334870669d049bb42","logical_entry_identity":"79935fccf4114d34c3129dcc78ad5abcd4217253206a6505ecfe58ec8fd98f72","normalized_path":"mod-tome.lua","source":"- poison immunity","source_tag":"_t","target":"- 毒素免疫"},{"args_order":null,"call_locator":"450edddaaec97583562bda37817a511a48972b69945427db6af39ba49f2c3074","component":"tome","entry_revision_identity":"df6167b0e282528579eed3f689f0e2dbe52038980f9a536210663f942adb0554","logical_entry_identity":"766fc46e9c61d8ad52345f5a8c4876a4efb6c23be739d6436926e30019abcf0b","normalized_path":"mod-tome.lua","source":"jagged, segmented, sword","source_tag":"_t","target":"锯齿分节的剑"},{"args_order"