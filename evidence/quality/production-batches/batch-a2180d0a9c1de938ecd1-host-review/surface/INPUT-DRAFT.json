evision_identity":"84bfef65f9a0e7b8dc964dde0f889494cd11ddbf5d26d1237593a3c61b33ce92","logical_entry_identity":"7fa86e278a48189426974dd08f589a2e24b335ff8ebda7f1c94d76b0361b3f60","normalized_path":"mod-tome.lua","source":"When you hit with a melee or arrow attack, there is a %d%% chance that a warden will appear from another timeline to attack a random enemy.\n\t\tThe summoned warden will attempt a melee attack if you made an arrow attack, or an arrow attack if you made a melee attack.\n\t\tThese wardens are out of phase with your reality and deal %d%% less damage, and their arrows will pass through friendly targets.\n\t\tA warden can only be summoned this way once per turn and they return to their own timeline after attacking.","source_tag":"tformat","target":"当你的近战或箭矢攻击命中时，有 %d%% 几率召唤一名来自另一条时间线的守卫，攻击一个随机敌人。\n\t\t若你使用箭矢攻击，守卫会尝试近战攻击；若你使用近战攻击，守卫则会尝试箭矢攻击。\n\t\t这些守卫与当前现实相位错开，造成的伤害降低 %d%%，且其箭矢会穿过友方目标。\n\t\t每回合只能以此方式召唤一次守卫；守卫攻击后便返回自己的时间线。"},{"args_order":null,"call_locator":"14593a07cdcab56dee5c21f202f4e7c13f443ce53d5a31445966f0596a3fba93","component":"tome","entry_revision_identity":"84c25651aa68764f9fe69f9e44d0f34f28718cdf9fe739c3ccb7d1d27c8bff49","logical_entry_identity":"5f0ac8c253f7adb45f5b420c5109bf728f3cf51a3b07d1845b3e858d2a169b3d","normalized_path":"mod-tome.lua","source":"Click to assign stats and talents!","source_tag":"_t","target":"点击分配属性点和技能点！"},{"args_order":null,"call_locator":"2ead5b18e955fa8e9db3b244baa693737906c0d73a1ccb6811419221dca9c970","component":"tome","entry_revision_identity":"84c3f5dd00968f8d438ad77a5ec57095c0d0057d71c67a8a8c3a02fad4e4ba85","logical_entry_identity":"4e32764ebd32d0ccca9c4c9468795ab4f409ead22cad339a20bc68ca0c6ed5e8","normalized_path":"mod-tome.lua","source":"Control the power of tricks and illusions.","source_tag":"_t","target":"制造错觉来混乱敌人的战术。"},{"args_order":null,"call_locator":"25d58916c50ebc83a1588e463c08cf02f102fed64fcd60adc23a5a31bb20a8f6","component":"tome","entry_revision_identity":"84c43fe7aeed5fe2b9d1ec6288a09e418cfc193f78e018f8d2a72953587e72fd","logical_entry_identity":"daee2e2e9a7b289b85cd47ee494e6c620606ce64f77231409754818295a47bf7","normalized_path":"mod-tome.lua","source":"test glyph","source_tag":"tformat","target":"测试圣印"},{"args_order":null,"call_locator":"1e625fe8835133ca2e475dfc72b57b10fcfb38d93844e6e9473db11a5a521cbd","component":"tome","entry_revision_identity":"84c665e28d9cd2219896fb9a570d19c5e876cfabe9b916e7de394d26157d793c","logical_entry_identity":"b4a31e827612d86d6e39cec09c7433aa426ad469ead0bc0cc6e4670e81eac53f","normalized_path":"mod-tome.lua","source":"#LIGHT_GREEN#Welcome to Tales of Maj'Eyal!#LAST#\n\nThis tutorial will present you with a short quest to familiarise yourself with the game.\nYou are a Human adventurer sent into the forest by the local village to dispose of the \"Lone Wolf\".\n\nThis tutorial character is more powerful than a normal starting character and has infinite lives.\nA normal character has limited lives, and once you run out, you stay dead (unless you found or accomplished things that allow you to resurrect).\n\nDuring this tutorial you will be guided by dialog boxes such as this one, explaining how things work.\nDialog boxes can be dismissed by pressing Escape or clicking outside of their zone (or on the title bar).\n\nNow press #LIGHT_BLUE#escape#LAST# or #LIGHT_BLUE#click outside#LAST# this dialog to close it and proceed.\n","source_tag":"_t","target":"#LIGHT_GREEN#欢迎你来到 ToME 4！#LAST#\n\n这个教程会安排给你一个简短的任务以帮助你熟悉这个游戏。\n你是一个人类冒险者，被当地村庄派到森林里去消灭“孤狼”。\n\n这个教程角色比普通开始游戏时的游戏角色要强大的多，而且拥有无限生命。\n普通角色的生命数有限，一旦耗尽便会永久死亡（除非你找到或完成了能让你复活的事物）。\n\n在这个教程游戏过程中，你会碰到很多像这样的弹出对话框，来解释游戏的内容。\n对话框可以通过按 Esc 键或者点击框外其他地方或者单击对话框标题来关闭。\n\n现在按下#LIGHT_BLUE#Esc 键#LAST#或者#LIGHT_BLUE#点击对话框外#LAST#即可关闭此对话框并继续。\n"},{"args_order":null,"call_locator":"01e2ab24a7c9cc2da0afe3a8f5ef21b8547f6572db45b746a2228556f7c7e085","component":"tome","entry_revision_identity":"84ca34e7a7f869722861c3aecab123b27c4042e4d2a45ba2ed10c91064de75e0","logical_entry_identity":"3ce15a783becadc2f6bce60d0bda9f475b025b4c76fdcb3e01def69193066374","normalized_path":"mod-tome.lua","source":"reveal the area around you, dispelling darkness (radius %d, power %d based on Magic), and detect the presence of nearby creatures for 10 turns","source_tag":"tformat","target":"揭示周围区域，驱散黑暗（范围%d，强度%d基于魔法），并在10回合内侦察周围生物"},{"args_order":null,"call_locator":"f859b85bfb50788c481f2f06b9f2c647f86d64867b1fde94f3f0799f32e81b1e","component":"tome","entry_revision_identity":"84ce72d9b0ec10d4aecfe8f790768ff614751fbe9545538f9318077ea1323f29","logical_entry_identity":"6ec15890b5d1164a539eb81ddbd1ac3ba5a52e5ab5ae292c9828d051931ecd4c","normalized_path":"mod-tome.lua","source":"A rough hide made from a massive beast.  Seeing as it's so weathered but still usable, maybe it's a bit special...","source_tag":"_t","target":"一张取自巨型猛兽的粗制兽皮。鉴于它已经被风吹日晒了这么久还能凑合用用，没准会有一点特别的……"},{"args_order":null,"call_locator":"67c66cb48dbc8c83707e4ce8e2bb2f09ac81154942671e3f95fb27f9dec5d7bd","component":"tome","entry_revision_identity":"84ce8ece97e6b8222eebd5c5f2f661540d8a5412f8e17d2d940d92e8647b5ce7","logical_entry_identity":"a1845a5fbb75624176ac6d7e8c2f29fb2da5ffc312638630d8125f8d428fa27f","normalized_path":"mod-tome.lua","source":"Consume Soul","source_tag":"_t","target":"消耗灵魂"},{"args_order":null,"call_locator":"ebfcfae00bf01968f2572422d7063475399c087fd745b924e6401ed404b9badf","component":"tome","entry_revision_identity":"84d3b08436d811b1e3f9ba4144906870274d328d6dc58c88744e44da3546cb73","logical_entry_identity":"640297c91033f6407883cc0564c2f83da353da7efa4fc5f3e5522e0060c98f40","normalized_path":"mod-tome.lua","source":"Warrior","source_tag":"birth descriptor name","target":"战士系"},{"args_order":null,"call_locator":"b700f31a34eeebaa175e3d5aa3c8ac1e12d77ead4662385ee564126accf7099e","component":"tome","entry_revision_identity":"84d7bd23102c4b52429a027ea7ba63a92c2e79382f178378b41b6c1fd8cbc6d9","logical_entry_identity":"9a36207aabf414eb96cfd17681f4ead7d08864df5b54dbd01f2be5eca599e615","normalized_path":"mod-tome.lua","source":"Did the righteous thing in the ring of blood and disposed of the Blood Master.","source_tag":"_t","target":"你在鲜血之环做出了正确的选择，并消灭了血之领主。"},{"args_order":null,"call_locator":"49f623f97c456e6216056b63578928ca040e8c74c1081c0ede5336eecd567892","component":"tome","entry_revision_identity":"84db2918788022fd5fca6a7f4a2aa947e600ab7977cf41aee4813d2d47bfca31","logical_entry_identity":"7710e2c7a235b77cc8583b9efbffbcd5eca186812b31caf13cfc42399502902a","normalized_path":"mod-tome.lua","source":"cryomancer","source_tag":"entity name","target":"冰霜术士"},{"args_order":null,"call_locator":"589d968618887c57b97003cc246e7ec970a709e997e1ccb378c30ed3bde775f0","component":"tome","entry_revision_identity":"84db4a227a229c1919dd1bb50c75d43be12d20648fc62bcf93451bc8d07f958c","logical_entry_identity":"f072a53365a0782f2432f126c745cc158b4655087944cb618fca46a0f06bab2b","normalized_path":"mod-tome.lua","source":"You must have a quiver or pouch equipped.","source_tag":"logPlayer","target":"你必须装备弹药。"},{"args_order":null,"call_locator":"da52492c34359fa0d49a3bafe071129faa961bd29b3f62d8ab23f106f036c196","component":"tome","entry_revision_identity":"84de5a54f88837074ff725c229c1741320e828f726adfc4683368a11f1defc6b","logical_entry_identity":"6fa2f7aa7995752d83f78583ea91927e129fdfe50026ece039aff90744085c6d","normalized_path":"mod-tome.lua","source":"#Target# is no longer infected.","source_tag":"_t","target":"#Target#不再受到感染。"},{"args_order":null,"call_locator":"3f917fa7238c3c01d71c9d275ed2211ef07f5ad4661fa929fd42ef3ef04deebf","component":"tome","entry_revision_identity":"84e0a2758542a62701ec5d9a244ffcb0d2542f2a527063210419843a9b82a295","logical_entry_identity":"1125215ec7258cf67edb318bb6a73bcda28a214f267fe493c0e630b8136e660a","normalized_path":"mod-tome.lua","source":"Try your purse for the 100 gold. As for an Athame and a Resonating Diamond, I assume the orcs have some if they're cooking up portals to use that Orb on. Try the Vor Armory. It so happens that I know a back way in. Never mind why.","source_tag":"_t","target":"100 金币嘛……你摸摸自己的钱袋就有了。至于仪式匕首和共鸣钻石，既然那些兽人正准备配合多元水晶球开启传送门，我猜他们手上就有。去沃尔军械库找找吧。碰巧我知道一条后门，别问为什么。"},{"args_order":null,"call_locator":"632be53cf08482563c83b294a7361dd4a6ded523317775f0e6e5a1faf7da1de6","component":"tome","entry_revision_identity":"84e21eeec0833ac9ee0b601009d6811b015b3427b7cfb138fb6768299cfcb38f","logical_entry_identity":"5bab62d885eb2a9e24f25930d76b878aafc3c568814381f0c0469131f8243398","normalized_path":"mod-tome.lua","source":"human","source_tag":"entity name","target":"人类"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"9c5578a9655e6dd80db73e1cd996c97dce1bee4abd5e219636a19c81f80a7672"}