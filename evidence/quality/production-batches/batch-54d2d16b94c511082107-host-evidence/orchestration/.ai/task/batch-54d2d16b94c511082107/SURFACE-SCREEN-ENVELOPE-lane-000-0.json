04082a","logical_entry_identity":"2b43f586accc2359d78e55ef309b75dea35895cc555bf028043cab89eb6e81b1","normalized_path":"mod-tome.lua","source":"%s#Source# converts some damage to Psi!","source_tag":"tformat","target":"%s#Source#将部分伤害转化为灵能值！"},{"args_order":null,"call_locator":"e464ccefe81a7a97796df283672726faf3932cee785ad9085b8bf5f75bf87019","component":"tome","entry_revision_identity":"fe90619ef2e1e48cab53d9352846971ad10ff1dfb3bbff4bfc27a5f58bea47f6","logical_entry_identity":"77698f2306dbc164611c8501031f1ada83b260b3d1fba613982056221cbcc57b","normalized_path":"mod-tome.lua","source":"Summon a part of the Fearscape to intersect with the current level.\n\t\tYou and your target are taken to the Fearscape, trapped there until you end the spell or until your target dies.\n\t\tWhile inside, a constant aura of flames will burn both of you for %0.2f fire damage (demons are healed instead) each turn.\n\t\tWhen the spell ends, only you and the target (if still alive) plus any loose objects are taken back to your home plane; all summons are left in the Fearscape.\n\t\tThis powerful spell drains 5 vim per turn initially, increasing by +1 for each turn it has been active, and ends when your vim is depleted.\n\t\tIt has no effect if cast from within the Fearscape.\n\t\tThe damage will increase with your Spellpower.","source_tag":"tformat","target":"召唤一部分恶魔空间与现有空间交叉。\n\t\t你的目标和你自己都会被带入恶魔空间，只有当你中断技能或目标死亡时，限制解除。\n\t\t在恶魔空间内，永恒之焰会燃烧你和目标，造成 %0.2f 火焰伤害，对恶魔则会改为进行治疗。\n\t\t当技能中断时，你和目标（如果还活着），以及所有掉落物品会被带回原来空间；所有召唤物都会留在恶魔空间。\n\t\t这个强大的法术最初每回合消耗 5 点活力，活力值消耗每回合增加 1 点，当活力值归零时技能终止。\n\t\t当你已处于恶魔空间时，此技能施放无效果。\n\t\t伤害受法术强度加成。"},{"args_order":null,"call_locator":"1e85f646b1585998e7810ee22f7bd47facf8d949ccc0c49c437814ea09cd8474","component":"tome","entry_revision_identity":"fe91c6a7f9f978f51dc5e8ac5f4bb6307210857a082db9d2488b78d714b09581","logical_entry_identity":"ecd0a04995587ecc29c7044306b3425cd30a70d21b9435fd8ae77ba5dacb23fe","normalized_path":"mod-tome.lua","source":"Activating this item is instant.","source_tag":"_t","target":"使用该物品不需要时间。"},{"args_order":null,"call_locator":"4f5c308a8115273ba254747f0db16b46ffc0ea20edfe093ad9164028de5fce1a","component":"tome","entry_revision_identity":"fe94fa244752c989c012aa598d8f429a840e263c3af2f2611b0815b3570b076b","logical_entry_identity":"d34413010c87c22f0fe9f4dbefd1b66f61431565055ad2b690c229f2aac5f7f0","normalized_path":"mod-tome.lua","source":"#LIGHT_RED#You lost sight of your golem for too long; direct control is broken!","source_tag":"logPlayer","target":"#LIGHT_RED#傀儡离开你的视线时间太长，控制被中断了！"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"66da49fcce23e27b95027c5aa51dc41afc9211cbc227c05fd9cfa8413ec4d2aa"}}