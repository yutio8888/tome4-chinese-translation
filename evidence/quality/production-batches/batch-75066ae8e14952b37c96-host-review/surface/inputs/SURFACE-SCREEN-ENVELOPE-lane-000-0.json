entity":"81e2d09a75ecb50b4c230437b159ac905e860359bb08210f59f6e04f3bc0650f","logical_entry_identity":"d34e171112c47c730147d5d7fc585023e8086548ddf7b0b88fb65a7b422b35fa","normalized_path":"mod-tome.lua","source":"Be at one with nature.","source_tag":"_t","target":"与大自然融为一体。"},{"args_order":null,"call_locator":"ac01ef36a143fc42e7380bdfbde219ba3603e1576c1d95e4822c23f59704c2f5","component":"tome","entry_revision_identity":"81e47fad2a917254f4f5fcfbd26e96f6648f3143db09ba0560ca713577f97382","logical_entry_identity":"6eb3a2bce15123c2bde8e22a0a148dc6d1bb4bcc9bc185ea19c29222fb3aedeb","normalized_path":"mod-tome.lua","source":"When an attack would deal 15%% or more of your effective total health, you forge the Dream Shield to protect yourself, reducing the damage of all attacks of that type by %0.2f for the next %d turn(s).\n\t\tYou may block multiple damage types at one time, but the base damage threshold increases by 15%% per damage type the shield is already blocking.\n\t\tIf you block all of an attack's damage, the attacker will be vulnerable to a deadly counterstrike (a normal melee or ranged attack will instead deal 200%% damage) for one turn.\n\t\tAt talent level 5, the block effect will last two turns.\n\t\tThis damage reduction scales with your Mindpower.","source_tag":"tformat","target":"当一次攻击将造成你有效总生命值 15%% 或更多的伤害时，你会锻造梦境屏障保护自己，使该类型的所有攻击减少 %0.2f 点伤害，持续 %d 回合。\n\t\t你可以同时格挡多种伤害类型，但护盾每多格挡一种伤害类型，基础伤害阈值便提高 15%%。\n\t\t若你完全格挡一次攻击的全部伤害，攻击者会进入持续 1 回合的致命反击状态（对其发起的下一次普通近战或远程攻击将造成 200%% 伤害）。\n\t\t技能等级 5 时，格挡效果将持续 2 回合。\n\t\t伤害减免受精神强度加成。"},{"args_order":null,"call_locator":"5c146c5422d3b4226a55bacca0c2d6a763344221f9e1bec2c37c949ae9f470d3","component":"tome","entry_revision_identity":"81efb1a50991947962566a8412997bacf0eb853feb498b3ab4b15f6b61180a6f","logical_entry_identity":"32cec05930728b0c4fab0e52a006fffd344aea8a614b3452685370088abd139e","normalized_path":"mod-tome.lua","source":"A good Bulwark is able to withstand terrible attacks from all sides, protected by her shield, and when the time comes lash out at her foes with incredible strength.","source_tag":"_t","target":"一个好的盾战士能够使用盾牌承受来自各方的攻击，当时机一到就立即将对手置于死地。"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"9c5578a9655e6dd80db73e1cd996c97dce1bee4abd5e219636a19c81f80a7672"}}