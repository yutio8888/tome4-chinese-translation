{"contract":"translation_surface_screen_v1","entries":[{"args_order":null,"call_locator":"63e02507ab8648318fd27816a2b4608a87d5ebbb4ef07e0de4f3cc58e0182ebb","component":"tome","entry_revision_identity":"6d0fcc5f9af63dc9bf08929e954c1b52fb28e0f6155aadceec8d1f081f1903e4","logical_entry_identity":"42d75286e51f4d7c7a7de52262bd9bc67a6585d7cef15fd65bc17a0aaad24204","normalized_path":"mod-tome.lua","source":"You focus yourself on nature, allowing you to summon natural creatures much faster (%d%% of a normal summon time) and with no chance to fail from high equilibrium for %d turns.\n\t\tWhen activating this power, a random summoning talent will come off cooldown.\n\t\tEach time you summon, the duration of the frantic summoning effect will reduce by 1.","source_tag":"tformat","target":"你专注于自然，使召唤自然生物所需时间缩短至正常召唤时间的 %d%%，且在自然失衡值较高时也不会失败，持续 %d 回合。\n\t\t激活此能力时，一个随机的召唤技能会立即结束冷却。\n\t\t每次召唤都会使疯狂召唤的剩余持续时间减少 1 回合。"},{"args_order":null,"call_locator":"cc420fdcb9d9ea4f69fdc81970f56572a2bc14789f9726176990e2bc8021fb55","component":"tome","entry_revision_identity":"6d0fdc1e138ae2c3138666e7d9ff3226fac79cb577c64c7e225f6ff717b3059c","logical_entry_identity":"6d7864af85e1754aa6298be61cc329c35f81fc3e17dac811ac27be7a0574dc71","normalized_path":"mod-tome.lua","source":"Unflinching Eye","source_tag":"entity name","target":"坚定之眼"},{"args_order":null,"call_locator":"474391a5f65dcf0d64ba1fb162713a95c217d555344a8b0a0662557181e93fbc","component":"tome","entry_revision_identity":"6d1003b21d0b9d8de16b96b214e7bbc85018b145fadbc5291b016078af916c0f","logical_entry_identity":"ccba03666962c7084737a242bb909bb5ba2c1efa131e8db5ec6e824a5c7da70f","normalized_path":"mod-tome.lua","source":"Feathersteel Amulet","source_tag":"entity name","target":"失重项链"},{"args_order":null,"call_locator":"1a30dd8b8419452a9ae522c64d57808975ad2d9e6e63ad38b9a908f6a1a13cdc","component":"tome","entry_revision_identity":"6d1a0316a74da81c55d754753e930a82816198f209ead91fcc33f55ff2611454","logical_entry_identity":"3b08cec662ffca412a934bed4a23