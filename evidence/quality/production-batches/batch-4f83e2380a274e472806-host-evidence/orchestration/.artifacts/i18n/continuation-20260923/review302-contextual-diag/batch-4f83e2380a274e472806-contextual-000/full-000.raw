{"contract":"translation_contextual_v2","candidate_identity":"bf715d3d28ef5f47080e3f16b27e05cb6997a3c523cc9d32cedfeed63fbf991b","verdicts":[{"revision_key":"3081f3206c3067ba1ce6c2e3b29d83fcbe3640f974a60aadf650516f7b0dadbb","verdict":"ISSUE","observation":"遗漏专名：tome-cults/data/lore/fay-willows.lua（来源未固定，冻结快照第363-381行）中食人魔质问“Weren't they the ones behind this, this Spellblaze?”，明确指控永恒精灵（Shaloren）造成了法术大爆炸（Spellblaze）；译文“他们不是这一切的罪魁祸首吗？”删去了 Spellblaze，泛化成“这一切”，丢失了该事件的历史指涉。另有一处误读：“the other ogres faces turned to a look of total dismay”指神情变为沮丧，被译成“脸都转过头来”，变成了实际转头的动作。"},{"revision_key":"6dad9c79f84bedb7fa4ffbc9722d81e4686f43f9e0a33ba8a207a5b4f655a7a1","verdict":"OK"},{"revision_key":"a133e480df406f077db0b2e23c27e90dcffdff253fefec8927c1902b958ab1a0","verdict":"OK"},{"revision_key":"a1820d869fd8c20dca7fb951118c4954c097c538f8dd8bd8f0f8f5846478b778","verdict":"OK"},{"revision_key":"a2afceeb436c47bce75573e82d16d936c2d80ddaddc9e289c40a34f9c9f01dc7","verdict":"OK"},{"revision_key":"a4fcb9367934a0185a20ae90da4b6df1d431dd4fe7cbf3a3598a07b2e691e2f5","verdict":"OK"},{"revision_key":"a79acd2b23757065e0ffc1feafd75c789efdd75db91000ddf22978b5576afc92","verdict":"OK"},{"revision_key":"a94173532c8bcb41953417d4b62dcf68c3f162bcbca0f6fbd7785291a5373007","verdict":"OK"}]}