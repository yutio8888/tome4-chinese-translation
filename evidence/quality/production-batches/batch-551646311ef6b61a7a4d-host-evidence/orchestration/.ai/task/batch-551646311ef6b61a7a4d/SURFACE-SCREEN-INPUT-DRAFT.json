ty":"f695f948f3b573a33e6a23e4753d74407a8b5e29f9e8d6211921cbf3ee5213ac","logical_entry_identity":"75accf7cf0b6837f4e8a03020a0f868bad2ff4dfa843077005258ebb52bc1399","normalized_path":"mod-tome.lua","source":"#LIGHT_GREEN#Thanks to your timely aid, %s is the newest member of the Brotherhood of Alchemists.#WHITE#","source_tag":"tformat","target":"#LIGHT_GREEN#感谢你的及时帮助，%s成为了炼金术士兄弟会的新成员。#WHITE#"},{"args_order":null,"call_locator":"4179f52a3354e7bcda52ff7497c95ea53025cccb117a835a6e55561c7e5461da","component":"tome","entry_revision_identity":"f69b4eac1aed6a1e8d34bb1f1f5c9b3d4e8f85dd6e74b64c1756f5ee8fef8e28","logical_entry_identity":"0e1dcffeca55911e5f16e90e0c1bafeac53d259a7a9c125636d0f6e9984f72a4","normalized_path":"mod-tome.lua","source":"arcane silence","source_tag":"damage type","target":"奥术沉默"},{"args_order":null,"call_locator":"46f5e46a20c13a99277f3aadb0df3f04e3e6eb16e74fd113ad02afd98cd2e1ce","component":"tome","entry_revision_identity":"f6a309e13e02dd8bf1325b8e8b2e0a962a323dff81ba6926aa34c80a77a432d1","logical_entry_identity":"2b5f136e178c7f8d971e9596110ba5ad99d2b49d0c6ab72ac24a8630f5efa6bb","normalized_path":"mod-tome.lua","source":"Rapid Shot","source_tag":"talent name","target":"速射姿态"},{"args_order":null,"call_locator":"ab852bdfe65d01ae23b6c9028fac7e9b8afc73f730463023128ea0167f636fb8","component":"tome","entry_revision_identity":"f6a545d079ceafc869ce383b0a85a769f06125cc6ee7d85e92bda7016ad346aa","logical_entry_identity":"59e8be87ea3664072c96d0a9f18e19372aba17d3f40dc61e593dcaafb8758013","normalized_path":"mod-tome.lua","source":"Sun Flare","source_tag":"talent name","target":"日珥闪耀"},{"args_order":null,"call_locator":"6ffac316224e9643bbe3648e8aef9b0e8501e925128b8612ad9f08fa28a2680f","component":"tome","entry_revision_identity":"f6af37b31936e16a74de1ff90d5c852437d5f0e8ae15a0c3fd7217ae4eac345e","logical_entry_identity":"43cd5631d782ec0b3b923df6f698fd36c7d8bcfb9ea1d0529ecc551b7c36e8bb","normalized_path":"mod-tome.lua","source":"#{italic}#\"Giant\"#{normal}# is a catch-all term for humanoids which are typically over eight feet in height.  Their origins, cultures, and relationships to other races differ wildly, but they tend to live as refugees and outcasts, shunned by smaller sentient races who usually see them as a threat.","source_tag":"_t","target":"#{italic}#\"巨人\"#{normal}# 是对那些身高超过八英尺的人型生物的统称。他们的起源、文化和关系与其他种族迥异。他们被其他矮小的种族视为威胁而躲避，作为避难的流浪者而生存。"},{"args_order":null,"call_locator":"5a1d498d3b4360ad01b120ff57b149fdf26a201dab97ecc541665c07c5901aef","component":"tome","entry_revision_identity":"f6b48b343981b8c7e9c8144599907c35343c48497c1060a2167244c81c51b383","logical_entry_identity":"d791f06d98feae01ce595226c985ad6c86e682d884f4cf14bfa07141880c7be3","normalized_path":"mod-tome.lua","source":"reckless","source_tag":"entity keyword","target":"鲁莽"},{"args_order":null,"call_locator":"43c2a3cd78d4270f9645eecd56213ba49e19ef3676c02a51deeb2c0b91ea2af6","component":"tome","entry_revision_identity":"f6b4d6406ff0d5550d2df951fd007895782cc08cfc76a7fe2100a3e34e93e48f","logical_entry_identity":"da9826315514bc3fe3431e56c54f19f3854026b40a44da886898543e6b1a69be","normalized_path":"mod-tome.lua","source":"When you kill a creature, the remainder of the damage done will not be lost. Instead, %d%% of it will splash in a radius 2 as blight damage.\n\t\tThe splash damage will increase with your Spellpower.","source_tag":"tformat","target":"当你杀死一个敌人后，多余的伤害不会消失。\n\t\t反之 %d%% 的伤害会溅落在 2 码范围内，造成枯萎伤害。\n\t\t伤害受法术强度加成。"},{"args_order":null,"call_locator":"f15eca4ac8b8c8f90a00ac2757845ae41c99f92da549f7641de01722e07cae70","component":"tome","entry_revision_identity":"f6b792a858093fe3ec6d170cf96650e2453a065beb76f84cb0fb22b2d881f498","logical_entry_identity":"3f08b50c69a908fddb7a98c2d4a13badabc3e4f57f1418e7f845848e7012b18c","normalized_path":"mod-tome.lua","source":"Inspect Creature","source_tag":"_t","target":"查看生物"},{"args_order":null,"call_locator":"5d108d56b5b3b22a9f67148a1aef1cd6cbf0b6eb5d042021f3b7ae4e79d7ece0","component":"tome","entry_revision_identity":"f6bb27e311fb5bc56465df36f2a6f61a9071548d5d9a3b47af99d4dc7c7b5700","logical_entry_identity":"bb85532a2e882fa4cfe792b7079f05e8638fba0d92a31e21396f8b2b11c4cca0","normalized_path":"mod-tome.lua","source":"A paper scrap, left by Ukruk.","source_tag":"_t","target":"乌克鲁克留下的纸片。"},{"args_order":null,"call_locator":"0f9956c9c5c5cbc63b570c442b763638fd1b4f4d91ee8fd89478f995af1f9764","component":"tome","entry_revision_identity":"f6bdec8b49f1d4a973c58c3bf2fd03d0dc2d8315c2a2bc7d5eabf659922f1ef9","logical_entry_identity":"5c84d00ee69c05677283d3ef13cc51de8b1eb5b675fed78fc1c8952a6fce44b2","normalized_path":"mod-tome.lua","source":"glyph of moonlight","source_tag":"_t","target":"月光圣印"},{"args_order":null,"call_locator":"e8d97211e0096fa8c5e5500c5746406e9176816d453383fef7c01061cb256c76","component":"tome","entry_revision_identity":"f6bec9ce4924ff6c631ba49ee72185b0ca685137d201c913550b90452576e440","logical_entry_identity":"17e3ab0e86c86eb086426763a39ab5c1433e0b7d595f06d2f8a43ce5768d1d51","normalized_path":"mod-tome.lua","source":"Mirror Match","source_tag":"_t","target":"镜像战斗"},{"args_order":null,"call_locator":"64eeffa59136ea186762541e1985bac4fe2d299634288e5e182d331d0cccd1d7","component":"tome","entry_revision_identity":"f6c02b61e194b233f66a00dfe33a2f7cc7fcc552c0b013a3afe021ce5ada2ef4","logical_entry_identity":"3e0fddda153e139ba8e6b7bd6b6cbc552ea20b61e58348c02cacfd5467fa505b","normalized_path":"mod-tome.lua","source":"Fills the air around you with reactive currents of furnace-like heat.\n\t\tIf you have a gem or mindstar in your psionically wielded slot, this will do %0.1f Fire damage to all adjacent enemies, costing %0.1f energy per creature. \n\t\tIf you have a conventional weapon in your psionically wielded slot, this will add %0.1f Fire damage to all your weapon hits, costing %0.1f energy per hit.\n\t\tWhen deactivated, if you have at least %d energy, a massive spike of thermal energy is released as a conical blast (radius %d) of superheated air. Anybody caught in it will suffer up to %d fire damage over several turns.\n\t\t#{bold}#Activating the aura takes no time but de-activating it does.#{normal}#\n\t\tTo turn off an aura without spiking it, deactivate it and target yourself. The damage will improve with your Mindpower.\n\t\tYou can only have two of these auras active at once.","source_tag":"tformat","target":"将你周围的空气充满火炉般的热量。\n\t\t如果你的灵能武器槽佩戴的是宝石或灵晶，会对所有相邻的敌人造成 %0.1f 的火焰伤害，每个生物消耗 %0.1f 能量。\n\t\t如果你的灵能武器槽佩戴的是武器，每次武器命中时附加 %0.1f 的火焰伤害，每次命中消耗 %0.1f 能量。\n\t\t当关闭该技能时，如果你拥有最少 %d 点能量，巨大的热能会释放为一个半径为 %d 的锥形冲击。范围内的任意目标在数轮中受到高达 %d 的火焰伤害。\n\t\t#{bold}#激活光环是不消耗时间的，但是关闭它则需要消耗时间。#{normal}#\n\t\t若要关闭光环而不释放热能冲击，请在关闭时以自己为目标。伤害随着精神强度而增长。\n\t\t你同时只能激活两种此类光环。"},{"args_order":null,"call_locator":"6aa0862855fa43f31322aff38bc91750c0773fbb1644f290971b8880ecf77689","component":"tome","entry_revision_identity":"f6c20950251ef7c3e04729c3c3296e9da897e5bdb416a4fca755e8c11ee9a6a2","logical_entry_identity":"3d26f04327e83abbdbeafad392258bbd749d7c3d40edfde83648aac9a8acbdb5","normalized_path":"mod-tome.lua","source":"infusion store","source_tag":"entity name","target":"纹身店"},{"args_order":null,"call_locator":"116f455d2bc39968288d1431f3da63fab7d3ced9211bc2eec786d8776d9c04ae","component":"tome","entry_revision_identity":"f6c86d4f03d70369ad0b39525f022455434b1fd3da1d779e0702f560c196addd","logical_entry_identity":"45417c890f1db486936caf576c41446421b1d1e2201ba51e69abe40344c6df86","normalized_path":"mod-tome.lua","source":"Increases attack speed by %d%%.","source_tag":"tformat","target":"攻击速度增加 %d%%。"},{"args_order":null,"call_locator":"d8612049280bb997554f350665571e524d4633b23ea027dde96516e391ca9708","component":"tome","entry_revision_identity":"f6cc31f278f852ce562184f9b8411d668cbda4d65ae2c3c4059abaa243f5d29f","logical_entry_identity":"49027cec87e1422f0bbb09fc4d804cfb86b9dd7de7e9af7c1d18fd816618dc74","normalized_path":"mod-tome.lua","source":"debilitated by noxious blight before falling","source_tag":"_t","target":"死前吸入过多剧毒瘴气"},{"args_order":null,"call_locator":"420c3acfcbe2c781c5a48b56