削减效果可叠加。\n\t\t若目标处于思维封锁状态，则会产生双倍的伤害和豁免削减。\n\t\t受精神强度影响，伤害和豁免削减按比例加成。"},{"args_order":null,"call_locator":"092f5f96fdfd9a7102024952abb0a4fb349f32a1e0fb1099a1707d87476c3ea8","component":"tome","entry_revision_identity":"5ea086b3c52e449260c5be0deae4e960249c975bf84eac34ec7c3e509beaf635","logical_entry_identity":"3ac500b60d2a4ce9d63f1b117543a43023dcd9cb2d8a0284ace25a0fd1af3ef6","normalized_path":"mod-tome.lua","source":"icy","source_tag":"entity keyword","target":"冰冷"},{"args_order":null,"call_locator":"09649b4a598f4cfd644db585d4c3d82a05e5002b22f4e7c6d23241c3c1bcac43","component":"tome","entry_revision_identity":"5ea80b62908c5cd5347bb3e3922188aacb23f5701c2354456f43646208abb80c","logical_entry_identity":"1c1ac9ce26ae9862be6ab672858bf0f886df20da6a41f4e2824222a4cf532af5","normalized_path":"mod-tome.lua","source":"+Juggernaut","source_tag":"_t","target":"+战场主宰"},{"args_order":null,"call_locator":"402fd4875cf1ce15b3d8708c838be174c45bebfba160c5307fbab9173f4bf250","component":"tome","entry_revision_identity":"5eb5b709d9e13e88b25b1dbec959b0b1287eaa5c4fc0de4f17b591d1a3417428","logical_entry_identity":"9b9cb7948347d069b16d0b6173b8999715c5cece39ffa3417e40f801f7789d63","normalized_path":"mod-tome.lua","source":"Swordbreaker","source_tag":"entity name","target":"破剑匕"},{"args_order":null,"call_locator":"cd247cea5f54579b76846c8643d18b657dd203973c70d041a91104bd33f47b91","component":"tome","entry_revision_identity":"5eba511f3c99d42e895f6e3c86180ef7e569e840d1a0acf7045fac70809f560d","logical_entry_identity":"00033bf36652881e5df5ddcfd9aea8401ce339b1ce79f00949317424812fe5a8","normalized_path":"mod-tome.lua","source":"Blighted Soil","source_tag":"floorEffect desc","target":"荒芜之地"},{"args_order":null,"call_locator":"7f3fc4b4e182c396797b5aa16bfd5780e584d3f0300a42b0a9440200b8a4fb67","component":"tome","entry_revision_identity":"5ec09442e5b91d3f28428b7bd09a45c97f7385acb8272c55aa55715abc17dfc4","logical_entry_identity":"a5558fa69441de3b1223a9efbb6f8ee56ae79753738f866397672dfb26578c41","normalized_