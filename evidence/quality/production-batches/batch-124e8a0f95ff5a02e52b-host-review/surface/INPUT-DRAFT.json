call_locator":"dbfce9725979aa4446cc58b30abf56fd794e770f2c0ac51d22f443cce485476e","component":"tome","entry_revision_identity":"5eeecf4022f434bc13858016e2acf98b314cb7ad05d49c4e50adeef5b3e80961","logical_entry_identity":"b895d12df92bd7c5efaebd932f8dd00d3ddd281f5728f7f1d01443756f45d287","normalized_path":"mod-tome.lua","source":"-Shell Shield","source_tag":"_t","target":"-甲壳护盾"},{"args_order":null,"call_locator":"05f828df142e29ef9867c072bc9c8b77c8775cd508208a4c89b7e5c74d3d2e5f","component":"tome","entry_revision_identity":"5ef1549e2242ceaf1778e3ccf2ebac6e52eb483920d94ed4272979f8fe5c0983","logical_entry_identity":"c947b074bab0b6c85c407c3c13897b4d219eff61983554c36c6f7c24b9e1e35e","normalized_path":"mod-tome.lua","source":"stave resists pen fire","source_tag":"entity name","target":"法杖 增加火焰抗性穿透"},{"args_order":null,"call_locator":"3c65fe2a9de998e10cbb5bdc8de079a45461eb428a91497c547925e2181406f5","component":"tome","entry_revision_identity":"5ef6f8c52050cfe1f37bfbee46caef8682ea50d792b9e7d419be307051b1f8fe","logical_entry_identity":"60caab367f7d266e00cbb5717fba36376588f027e9b6c310e9f719f3afee8455","normalized_path":"mod-tome.lua","source":"spellcrit","source_tag":"entity name","target":"法术暴击"},{"args_order":null,"call_locator":"1ec6a600920bb65fea7c3639057d18fd5e2fe916530d1b90327a65f6930d7d97","component":"tome","entry_revision_identity":"5ef710b850374f67de3419be18972806c3e0b5531f6d0e28205d2d736adfddf6","logical_entry_identity":"b55f1132dd78e9d5a8127f274c7572a932b2a01eced208c1a20c4c0a45c27722","normalized_path":"mod-tome.lua","source":"For %d turns your pyrokinesis transcends your normal limits, increasing your Fire and Cold damage by %d%% and your Fire and Cold resistance penetration by %d%%.\n\t\tIn addition:\n\t\tThe cooldowns of Thermal Shield, Thermal Leech, Thermal Aura, Thermal Strike and Pyrokinesis are reset.\n\t\tThermal Aura effects will have their radius increased by 1.\n\t\tYour Thermal Shield will have 100%% absorption efficiency and will absorb twice the normal amount of damage.\n\t\tPyrokinesis will inflict Flameshock.\n\t\tThermal Leech will reduce enemy damage by %d%%.\n\t\tThermal Strike will have its secondary cold/freeze explode in radius 1.\n\t\tThe damage bonus and resistance penetration scale with your Mindpower.\n\t\tOnly one Transcendent talent may be in effect at a time.","source_tag":"tformat","target":"在 %d 回合内，你的意念燃烧突破常规极限，使火焰与寒冷伤害提高 %d%%，火焰与寒冷抗性穿透提高 %d%%。\n\t\t此外：\n\t\t重置热能护盾、热能吸取、热能光环、热能打击和意念燃烧的冷却时间。\n\t\t热能光环的效果半径增加 1 格。\n\t\t热能护盾的吸收效率提高至 100%%，并可吸收通常两倍的伤害。\n\t\t意念燃烧会施加火焰冲击。\n\t\t热能吸取会使敌人造成的伤害降低 %d%%。\n\t\t热能打击的次要寒冷/冻结效果会产生半径 1 格的爆炸。\n\t\t伤害加成与抗性穿透受精神强度加成。\n\t\t同一时间只能有一个卓越技能生效。"},{"args_order":null,"call_locator":"05825a04e66d66489572b83041e1fbdcf8ed5937149ba3ab0ba7661814000610","component":"tome","entry_revision_identity":"5efde6132f11ce8a9747b3eec84e479b011b8d54124a3695a9bbb91e20f25a35","logical_entry_identity":"cc56d47b733b61bda3cb4d053422402cf04e16248d1148629f67b3c11dcad916","normalized_path":"mod-tome.lua","source":"Lord of Skulls (warrior)","source_tag":"_t","target":"骷髅王（战士）"},{"args_order":null,"call_locator":"ae9cb80655b398d6f80bb9f7f3089f28b59459d32c79924bfd590a6ff6b5adc4","component":"tome","entry_revision_identity":"5efffba099788ce2d7f4101db310261a5d9b5519c87fded2fc5cb9b5504e866d","logical_entry_identity":"6ff6ea24b96a21c842f1fbd1771c8c77971532a72cc29ce03d70f4ca04a175da","normalized_path":"mod-tome.lua","source":"This target has retreated to a safe place.","source_tag":"tformat","target":"目标被传送至安全位置。"},{"args_order":null,"call_locator":"6f50905382e773f9963612a1d3f8acdefd893c9a27c8c2370c10c99efd9d3382","component":"tome","entry_revision_identity":"5f028af0b49a46ee8fabd696cac5726c12f48e21ee653c7ae788365905c1f552","logical_entry_identity":"1c3867aefd2fd1ad106e9ca6eae771c8854fee6d82df43ddaeaac5b15f22e06e","normalized_path":"mod-tome.lua","source":"flame covered greatsword","source_tag":"_t","target":"附着火焰的大剑"},{"args_order":null,"call_locator":"df324c8b1d3851ed1ea9692bca13a1d23b9362480c6ec7ffa6c