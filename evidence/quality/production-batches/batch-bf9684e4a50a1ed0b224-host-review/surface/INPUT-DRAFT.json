ome","entry_revision_identity":"7859e3f094ccf4120f114289ac4e2ea0a9fd3be9632fedfe4cdafca4ae397e1f","logical_entry_identity":"b5e9bdb87392ddd66bc8d3be40c0b56040f231354326c14df894bfe4b04e42dc","normalized_path":"mod-tome.lua","source":"Enter a calm, focused stance, increasing physical power and accuracy by %d, projectile speed by %d%% and the chance to mark targets by an additional %d%%.\nThis makes your shots more effective at range, increasing all damage dealt by %0.1f%% per tile travelled beyond 3, to a maximum of %0.1f%% damage at range 8.\nThe physical power and accuracy increase with your Dexterity. This requires a bow to use.","source_tag":"tformat","target":"进入一个平静，专注的姿态，增加 %d 物理强度和命中，抛射物速度增加 %d%% 并且标记目标的几率增加 %d%%。\n这让你在射程内射击更有效：对三格外目标的距离每增加一格，伤害增加 %0.1f%% , 8 格距离时达到最大值（%0.1f%%）。\n物理强度和命中受敏捷值加成。该技能需要弓来使用。"},{"args_order":null,"call_locator":"8291220ba1adfe0793c7e7fc0635f7513d191f261f46cf4276e1522e35f3faff","component":"tome","entry_revision_identity":"785cfc6b366accd1c2e8eead3a58b129d44c47656928d4b90baed3f7c8b5f71e","logical_entry_identity":"28bd8887265384f1a60b5781b50dee5d5084d9db21089e8c8f4ae6f60ebf1a62","normalized_path":"mod-tome.lua","source":"#Target# is freed from a bear trap.","source_tag":"_t","target":"#Target#从捕熊陷阱中解脱。"},{"args_order":null,"call_locator":"545b91c68c088304b6ca85617abfca7ecd7d5e3dad47a167c252db06fbd0661f","component":"tome","entry_revision_identity":"785f3d0560058b6606f0ffd7997e4c77492f059530d48740225e8da8dd9425fb","logical_entry_identity":"8b6ce69987ada6eb8e75296dd73dbd65b21193a724e1eac705cd20f43bf955d0","normalized_path":"mod-tome.lua","source":"#VIOLET#You have found the entrance to a vault!","source_tag":"logPlayer","target":"#VIOLET#你找到了通往一处宝库的入口！"},{"args_order":null,"call_locator":"9d96c8e595ea40e4c3afabacb74c77a0c53a2a918307340ed70d5bb0460a9194","component":"tome","entry_revision_identity":"78640b54d5cb59e38bdafda8016842695a36966f6d1eb019dd348eefd289bd80","logical_entry_identity":"38728428f61b1e2a0c778c37b42955a31deac1c452350c6