ity":"60e598664ba86c18a9c646d4965a9b1fcfb6b8316d80dc353af7ecedc334c1a9","normalized_path":"mod-tome.lua","source":"and folded out of existence","source_tag":"_t","target":"并将其从时空中抹杀"},{"args_order":null,"call_locator":"bc8d76e3d4eaa823c0478820d2b2d9ee3baac6faef2c6aab07974e7a919f8db6","component":"tome","entry_revision_identity":"c983263ebe77185ebb30dd04685a513988b1b8d6a3e3d75cbe146300fa46760d","logical_entry_identity":"dc7684235c869ce9d01d5be395cbc6cbc29946ce64b5bde103f2678f0543dd93","normalized_path":"mod-tome.lua","source":"and offered to his dark Master","source_tag":"_t","target":"并将其献祭给他的黑暗领主"},{"args_order":null,"call_locator":"2e5bafcfcc0bad27740403433dd334f43392d341571b777d2a6138dbf37c7ebb","component":"tome","entry_revision_identity":"ca2bcc977ed2ac14ca845b3750c21cc8d1146e256a9d28cdbf58da8c1eec536b","logical_entry_identity":"d3029c01d9deaed23c653886a6fe504ba7c7a199c31d2af8cbe00a1810005288","normalized_path":"mod-tome.lua","source":"and swallowed whole","source_tag":"_t","target":"并将其整个吞下"},{"args_order":null,"call_locator":"3bc077c2895091a620ebfaf40d8b58e71e3b8a3cef287c1e77fc66c6252f0c5a","component":"tome","entry_revision_identity":"ca4e6a2443a9bfa89411c37e8d584519d216809ba94b64b394f6335af15e9786","logical_entry_identity":"89cebcaae4af8058cac28e1d8ab4d54edfcb7a48870d3d7b2797743484c54483","normalized_path":"mod-tome.lua","source":"and flushed out to sea","source_tag":"_t","target":"并将其冲进了大海"},{"args_order":null,"call_locator":"8cafdb55acef5030ca9a8db599b95f1a69f03c380a4c0a458a44e76d402cfe2e","component":"tome","entry_revision_identity":"ccd2720029c32de258b347d58d0dc1b1f6c8ed95d6df8f3d598fdfa969f3b9b9","logical_entry_identity":"5d198235e51314a6647586b49e9a611183e8b665e4179c5f8852f60196531259","normalized_path":"mod-tome.lua","source":"and bloodily smeared across the granite walls","source_tag":"_t","target":"并将其血淋淋地涂抹在花岗岩墙壁上"},{"args_order":null,"call_locator":"6761cd9fabc0b9055f0f940f894008cbd6c7d56c72647670a6be7154d2382a59","component":"tome","entry_revision_identity":"cdcfa5b2af975190c8b1768c1f911621680a6b0645aa0d4fee050370653719c4","logical_entry_identity":"ad563e41bd3148e3c760f01746235fbdb5023c339fa5c042c979ba9425763a7b","normalized_path":"mod-tome.lua","source":"Heighten the fears of those near to you. Any foe you attempt to inflict a fear upon and who remains in a radius of %d and in sight of you for %d (non-consecutive) turns, will take %0.2f mind and %0.2f darkness damage and gain a new fear that lasts for %d turns.\n\t\t\tThis effect completely ignores fear resistance, but can be saved against.","source_tag":"tformat","target":"加深你周围敌人的恐惧。所有你试图施加恐惧的目标若停留在你视野内，并且和你距离不超过 %d， 这样累计达到 %d 回合时，受到 %0.2f 精神和 %0.2f 暗影伤害，并获得一个新的持续 %d 回合的恐惧效果。\n\t\t\t这一效果无视恐惧抗性，但可以被豁免。"},{"args_order":null,"call_locator":"1be58e76151ce2c40e067cd460bbefb23816fb070401c5cfcd9be3f0258eaa8d","component":"tome","entry_revision_identity":"d01ea3df0ab4253ff2a5987b8fac9af6cdf7787c93eb724df09b678c74220f2f","logical_entry_identity":"89a0d013e11ea1fc7114a918ce825db8e0b7880b7da7199bc3a0d32f26dfcd1a","normalized_path":"mod-tome.lua","source":"and used as a new host","source_tag":"_t","target":"并将其作为新的宿主"},{"args_order":null,"call_locator":"01db61ebb01cfca5f0ba2b1a3e999864cae740e0865f3b7f6a9784cf5e056099","component":"tome","entry_revision_identity":"d64ab38dc4a97f058480efad1cb5088bce41613a888700481ef1b6b21178be31","logical_entry_identity":"90d978d262792aea78f02bb197a06835754fb61f3b4ab18c12c615b70e6b8223","normalized_path":"mod-tome.lua","source":"and quickly burned in a pyre","source_tag":"_t","target":"并迅速将其放在火葬柴堆上烧掉"},{"args_order":null,"call_locator":"280094e7c884fdbf12ebc1d4d7d53f342b63598b2813e7f9f0e13275c08dcf13","component":"tome","entry_revision_identity":"e11ec6fe9fe2ed9f98cfda31bb37a2918372b89cd9a10043f8a33cba798da67b","logical_entry_identity":"f11b7b59cc3dcee511f4e5f841c8d6bcb76f631700fcfe5a4d8b6f67fa08fa7e","normalized_path":"mod-tome.lua","source":"and used as target practice for initiate mages","source_tag":"_t","target":"并将其当作新兵法师的人肉靶子"},{"args_order":null,"call_locator":"fd0ccde21e0fe384069090e91d43a97b71831f5526917eee33f8c63fa45e27e0","component":"tome","entry_revision_identity":"e45d0a0256558b110ca0a55575b407603018ad625fc1e1bb8e943f40321cf370","logical_entry_identity":"0cf7fbd23e3d7828c521efa2e360e5f63c2f398e3a99d0c34eaa6bc13a83c1dd","normalized_path":"mod-tome.lua","source":"While this ability is active, you will continually call up to %d level %d shadows to aid you in battle. Shadows are weak combatants that can: Use Arcane Reconstruction to heal themselves (level %d), Blindside their opponents (level %d), and Phase Door from place to place.\n\t\tShadows ignore %d%% of the damage dealt to them by their master.","source_tag":"tformat","target":"维持此技能时，你会不断召唤最多 %d 个等级为 %d 的阴影协助战斗。阴影是脆弱的战士，可以使用奥术重组治疗自己（等级 %d）、 使用闪电突袭攻击敌人（等级 %d）， 以及使用相位之门移动。\n\t\t主人对阴影造成的伤害降低 %d%%。"},{"args_order":null,"call_locator":"a6b1227d0e0de3d03b03e7a6759d8ce6648f0d0c79aa827acdb19c33e970e6d0","component":"tome","entry_revision_identity":"e7dd62b62e3e4b8f0f1c213752a31d8e5688a40d6833495757682e47e8a8b040","logical_entry_identity":"58d09da14410e6fe930b333a6a6203bb18a282e853d3f51fc6702e52bf5b2fb0","normalized_path":"mod-tome.lua","source":"and brought back to Vargh for experimentation","source_tag":"_t","target":"并将其带回瓦尔弗做实验"},{"args_order":null,"call_locator":"cbdbcf2666a66aaa7b053ac0ff5d990a85cd5d7bdc0501058118829f7bc5758f","component":"tome","entry_revision_identity":"e9a6d61d6adf70872ee14f4a896e2db687af2aa17ebb40aeab548e4f45fc0a69","logical_entry_identity":"6d5db4601896f7525710c1c6b927d5e12e817552314452e7d25a187db56f0072","normalized_path":"mod-tome.lua","source":"and revived as a mindless horror","source_tag":"_t","target":"并将其复活为一只无心智的恐魔"},{"args_order":[1,2,3,4,8,9,5,6,7],"call_locator":"341682da6d1acc998bbc9840f3d72c7e01041c3e87397d4f9cf24b72bb5d1d25","component":"tome","entry_revision_identity":"eb743697bd270763c55d50c58375b0c5a32ad23438c2c00dfde37c4cb87e2736","logical_entry_identity":"6ebe9bb7a351b5260348cbe1b93ecfb6b