n inscription slot every 2 raw talent levels (%d).","source_tag":"tformat","target":"你和蠕虫合体建立强大的精神链接。\n\t\t只要你和它的距离不超过 3 格，你们均获得持续 5 回合的 %d%% 全体抗性。\n\t\t该技能每增加两级原始等级，你的蠕虫合体永久获得一个刻印位（当前： %d）。"},{"args_order":null,"call_locator":"32652a88f356b11c789ee9ec72919925010af4a3366e80b446fead867425bb69","component":"cults","entry_revision_identity":"355752d82bf6517354c65683ed9666212092f8640de40de5af8ec73cf1d2995a","logical_entry_identity":"083cc4e83c5723b5b16f87b6ee32f67fc0ee5c1345bb2b4b3a60f1926c87eee9","normalized_path":"tome-cults.lua","source":"and absorbed into the foul thing","source_tag":"_t","target":"并将其吸进了自己那肮脏的躯体"},{"args_order":null,"call_locator":"c1a60ebab83f47b05c2186ca0e23e0507256503e0211104961a32ed9c124a287","component":"cults","entry_revision_identity":"4d0181069b08a55050addcd8beaf93a4763aac9a213376186fe43a36b4f35a3f","logical_entry_identity":"8c4846162099f51d091e602611b2e25dd81a299c3f0ba9c0e3e72d468e9f73fc","normalized_path":"tome-cults.lua","source":"and written off the story","source_tag":"_t","target":"并将其从故事里抹去"},{"args_order":null,"call_locator":"ce73143ed1171423bc51e4a2691fed225a426533230da81b0402c1543c2f73fe","component":"cults","entry_revision_identity":"516e0314c8021e19164bdff912808a519a94003287600a42fe1d9d3f15563249","logical_entry_identity":"df2a131c4b2532e3914d18ea69a86ba5ae9bcaf8c78a11040affddcd325f1d84","normalized_path":"tome-cults.lua","source":"and written off the story","source_tag":"_t","target":"并将其从故事里抹去"},{"args_order":null,"call_locator":"7f74b1841e6398bac689e9467afb08fb874b947834c1f1bbf21d0d4af80b8958","component":"cults","entry_revision_identity":"79fc26f1ad285f65c3a60587f5a1001b0d348c1742356eebba8cec1d2b488d96","logical_entry_identity":"76bcce062134265b5aa132a0c43cdfefd2e9586418f6aa7329e99fdcc21dd87e","normalized_path":"tome-cults.lua","source":"and fed to the corrupt writhing tentacles","source_tag":"_t","target":"并将其喂给了腐化的扭动触手"}],"fixed_source_identity":"snapshot:ed0b1126c2636738204f2cafa3259812092fe47f5393ba3b81d696fb56865747","r