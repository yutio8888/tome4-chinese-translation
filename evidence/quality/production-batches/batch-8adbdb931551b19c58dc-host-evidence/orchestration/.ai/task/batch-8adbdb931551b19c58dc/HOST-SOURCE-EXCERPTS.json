  {
    "entry_revision_identity": "1e5c0b5645954ca46960fa97bd717f3ebb1d78f8277756f165dd347e2f453a2c",
    "public_source_path": "tome-cults/data/lore/misc.lua",
    "lines": [
      {
        "line": 49,
        "text": "\tid = \"cults-cultist-unlock-lesson-1\","
      },
      {
        "line": 50,
        "text": "\tcategory = \"Forbidden Cults\", always_pop = true,"
      },
      {
        "line": 51,
        "text": "\tname = _t\"Lessons of Inevitability - Entropic Backlash and Healing\","
      },
      {
        "line": 52,
        "text": "\tlore = _t[[My first lesson to you, my students, is to understand what it means to wield entropy. When using its power, it's impossible to escape its withering touch. Your bodies will suffer from the backlash of your spells and carry a residue of those energies at all times. As such, your ability to recover from wounds and injury will be significantly impaired. However, you can learn to resist this backlash and even manipulate the threads of fate to pass it on to your enemies."
      },
      {
        "line": 53,
        "text": ""
      }
    ]
  },
  {
    "entry_revision_identity": "31f9809953d3e51b258010bdb00b833b1db9f6aa20ba43fb5b6eb31d696f127d",
    "public_source_path": "tome-cults/data/talents/demented/path-of-horror.lua",
    "lines": [
      {
        "line": 146,
        "text": ""
      },
      {
        "line": 147,
        "text": "newTalent{"
      },
      {
        "line": 148,
        "text": "\tname = \"Writhing One\","
      },
      {
        "line": 149,
        "text": "\ttype = {\"demented/path-of-horror\", 4},"
      },
      {
        "line": 150,
        "text": "\trequire = dementedreq4,"
      }
    ]
  },
  {
    "entry_revision_identity": "464da39b60d1a76a382fb2948387ef6df5fca457c51202087ec0c091b33d3ea0",
    "public_source_path": "tome-cults/data/general/objects/world-artifacts.lua",
    "lines": [
      {
        "line": 364,
        "text": "\tname = 'Forbidden Tome: \"The Day It Came\"', unique=true,"
      },
      {
        "line": 365,
        "text": "\timage = \"object/artifact/forbidden_tome_cultist.png\","
      },
      {
        "line": 366,
        "text": "\tdesc = _t[[The cover of this tome is old and withered. As you hold it, you get the impression of many things. Despair, misery, desperation and hopelessness all assail you at once. Something about the book also promises great power, but at what cost?]],"
      },
      {
        "line": 367,
        "text": "\tlevel_range = {22, 50},"
      },
      {
        "line": 368,
        "text": "\trarity = 220,"
      }
    ]
  },
  {
    "entry_revision_identity": "883d967c0e1d52b9c86d9adfb807a377249dfd4abcb17597b6ba30552dfb010e",
    "public_source_path": "tome-cults/data/general/objects/world-artifacts.lua",
    "lines": [
      {
        "line": 1013,
        "text": "\t},"
      },
      {
        "line": 1014,
        "text": "\tuse_power = {"
      },
      {
        "line": 1015,
        "text": "\t\tname = function(self, who) return (\"temporarily causes the target to receive entropic backlash from any healing they receive for %d turns up to %d%% of the healing done. This effect scales with your Magic stat.\"):"
      },
      {
        "line": 1016,
        "text": "\t\t\ttformat(self.use_power.duration, self.use_power.getpower(self, who))"
      },
      {
        "line": 1017,
        "text": "\t\tend,"
      }
    ]
  },
  {
    "entry_revision_identity": "d075ec8a54c2632c01a25ed5e3cde309309fdf525764581d12ae198544b3c86b",
    "public_source_path": "tome-cults/data/general/objects/world-artifacts.lua",
    "lines": [
      {
        "line": 370,
        "text": ""
      },
      {
        "line": 371,
        "text": "\tchange_zone = \"cults+ft-cultist\","
      },
      {
        "line": 372,
        "text": "\tbook_text = _t[[In the Age of Pyre, it seemed that the world was ending to many of Eyal's inhabitants. The destruction caused by the Spellblaze left the land withered and scorched. Food was scarce, paranoia was rampant and everyone was desperate. For a select few, their salvation came from an unlikely visitor. An entity they simply came to knew as The Teacher visited Eyal from somewhere beyond the stars, emerging from an ancient Sher'tul farportal. It discovered a group of survivors in the depths of Eyal which begged it for knowledge, anything they could use as a weapon against the horrors ravaging their world.]],"
      },
      {
        "line": 373,
        "text": "\tbook_font_size = 16,"
      },
      {
        "line": 374,
        "text": "\tbook_texture = \"book-texture-impossible\","
      }
    ]
  },
