        "line": 35,
        "text": "\t\tif profile.mod.allow_build.yeek then races[#races+1] = \"yeek\" end"
      },
      {
        "line": 36,
        "text": ""
      },
      {
        "line": 37,
        "text": "\t\tself:simpleLongPopup(_t\"Welcome to #CRIMSON#Forbidden Cults\", (_t[[Thank you for purchasing #CRIMSON#Forbidden Cults#WHITE#, the third expansion pack of Tales of Maj'Eyal."
      },
      {
        "line": 38,
        "text": ""
      },
      {
        "line": 39,
        "text": "To begin your adventures as a half horror simply create a character with the class #LIGHT_GREEN#Writhing One#WHITE# (in the Demented category)."
      },
      {
        "line": 40,
        "text": ""
      },
      {
        "line": 41,
        "text": "Have fun lashing your tentacle at your foes!"
      },
      {
        "line": 42,
        "text": "]]):format(table.concatNice(table.ts(races), ', ', _t' or ')), 500)"
      },
      {
        "line": 43,
        "text": "\tend) end"
      },
      {
        "line": 44,
        "text": "end"
      }
    ]
