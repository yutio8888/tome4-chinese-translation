        "line": 26,
        "text": "\tname = \"Walrog\", color=colors.DARK_SEA_GREEN, unique=true,"
      },
      {
        "line": 27,
        "text": "\ttype = \"demon\", subtype = \"major\","
      },
      {
        "line": 28,
        "text": "\tdesc = _t\"Walrog, the lord of Water, is #AQUAMARINE#fearsome#LAST# to behold. The water boils and writhes around him as if trying to escape, frothing steam making his form indistinct.  He does not seem surprised to see you.\","
      },
      {
        "line": 29,
        "text": "\tresolvers.nice_tile{image=\"invis.png\", add_mos = {{image=\"npc/aquatic_demon_walrog.png\", display_h=2, display_y=-1}}},"
      },
      {
        "line": 30,
        "text": "\tlevel_range = {20, nil}, exp_worth = 1,"
      }
