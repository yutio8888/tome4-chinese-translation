[
  {
    "entry_revision_identity": "20fa052d6c3f569c56a139a845e16a768b7b1562be6c5e92e0deed27395f1d63",
    "public_source_path": "game/modules/tome/data/achievements/quests.lua",
    "lines": [
      {
        "line": 130,
        "text": "\tname = \"They Came Back For Eyal\", id = \"AOADS_SHERTUL\","
      },
      {
        "line": 131,
        "text": "\tshow = \"name\", huge=true,"
      },
      {
        "line": 132,
        "text": "\tdesc = _t[[Won ToME thanks to a Sher'tul stopping you at the last moment from opening a portal to your mad patron sun.]],"
      },
      {
        "line": 133,
        "text": "}"
      },
      {
        "line": 134,
        "text": "newAchievement{"
      }
    ]
  },
  {
    "entry_revision_identity": "c33a9574ec22a8b5b4bf77073cd84f06ed71cd952a319eb7a76c02c78f62814d",
    "public_source_path": "game/modules/tome/data/general/npcs/aquatic_demon.lua",
    "lines": [
      {
        "line": 61,
        "text": "newEntity{ base = \"BASE_NPC_AQUATIC_DEMON\","
      },
      {
        "line": 62,
        "text": "\tname = \"Walrog\", color=colors.DARK_SEA_GREEN, unique=true,"
      },
      {
        "line": 63,
        "text": "\tdesc = _t\"Walrog, the lord of Water, is fearsome to behold. The water writhes around him as if trying to escape, making his form indistinct. He does not seem surprised to see you.\","
      },
      {
        "line": 64,
        "text": "\tresolvers.nice_tile{image=\"invis.png\", add_mos = {{image=\"npc/aquatic_demon_walrog.png\", display_h=2, display_y=-1}}},"
      },
      {
        "line": 65,
        "text": "\tlevel_range = {20, 30}, exp_worth = 1,"
      }
    ]
  },
  {
    "entry_revision_identity": "cd5ee35662166e609e8b0d2c9213482dd1bc8078f5b0d1046d4e081281e66f83",
    "public_source_path": "game/modules/tome/data/quests/high-peak.lua",
    "lines": [
      {
        "line": 194,
        "text": "\telseif who:isQuestStatus(\"high-peak\", engine.Quest.COMPLETED, \"distant-sun-shertul\") then"
      },
      {
        "line": 195,
        "text": "\t\tdesc[#desc+1] = _t\"In the aftermath of the battle the Distant Sun tried to force you to open the portal to bring it forth onto Eyal.\""
      },
      {
        "line": 196,
        "text": "\t\tdesc[#desc+1] = _t\"Through an incredible display of willpower you resisted for a few decisive seconds. During this time a Sher'tul appeared, took the Staff and killed you.\""
      },
      {
        "line": 197,
        "text": "\t\tdesc[#desc+1] = _t\"Though you succumbed to the fight, your mind was already gone, burnt to ashes by your mad patron sun. But the world was saved.\""
      },
      {
        "line": 198,
        "text": "\t\treturn 0, desc"
      }
    ]
  },
  {
    "entry_revision_identity": "ca330222d1895218a6cfc1ad7d7b237995da67ebd9efc8e30c1f21d9030e7389",
    "public_source_path": "tome-ashes-urhrok/data/general/npcs/aquatic-demon.lua",
    "lines": [
