":"tome","entry_revision_identity":"e117b57fcb4f38689076b018cd90fd088a997468e8e454ae83c5484e594db1c9","logical_entry_identity":"d3e4942fd5cdeba1a973ec21fda2f11514d4f283cf9ad1a0d3250ae0b44a3615","normalized_path":"mod-tome.lua","source":"generic phys crit","source_tag":"entity name","target":"通用 物理暴击"},{"args_order":null,"call_locator":"047e496c4ffad5169fc121bbfb275e7722e7afad524c77e5725bdf2b9f43f370","component":"tome","entry_revision_identity":"e122dd9c588110e524f88fff62fa5c22a25ecd479f49ee7c2fe5fdf14a7ea7d1","logical_entry_identity":"22d480681856d9f834264ac8301e01097a004954842f12ad9c9e3a88658f9756","normalized_path":"mod-tome.lua","source":"The Doomed strike from behind a veil of darkness or a host of shadows.","source_tag":"_t","target":"末日使者操纵阴影，从黑暗中发动攻击。"},{"args_order":null,"call_locator":"337baecca1f925724575c7447ca28b328c1f971bc03aa31caad581b3e3109bcc","component":"tome","entry_revision_identity":"e128c83148dea5452e6b6b00ae7f012edd33d7b5df2e8a7be284e4930a7f56b2","logical_entry_identity":"86aee639985081ee81f5b5d79b3e91a67e61fa9cb22e6b0b9f8bd8b0277591dd","normalized_path":"mod-tome.lua","source":"Your fungus reaches into the primordial ages of the world, granting you ancient instincts.\n\t\tEach time you receive non-regeneration healing you gain %0.1f%% of a turn per 100 life healed.  This effect can't add energy past 2 stored turns and overhealing is not counted.\n\t\tAlso, regeneration effects on you will decrease your equilibrium by %0.1f each turn.\n\t\tThe turn gain increases with your Mindpower.","source_tag":"tformat","target":"你的孢子可以追溯到创世纪元，你可以传承来自远古的天赋。\n\t\t每当你获得一个非回复的治疗效果，每治疗 100 点生命值，你获得 %0.1f%% 个回合。\n\t\t这一效果最多获得 2 个回合。\n\t\t同时，每当你受到回复作用时，每回合你的失衡值将会减少 %0.1f。\n\t\t增益回合受精神强度加成。"},{"args_order":null,"call_locator":"b403b011adf57ab824216a0f24acb76ced3438e204bea108c7c368f25a5c4cbe","component":"tome","entry_revision_identity":"e129d9c90be56a1bf2671a5e3eb71ed0dabd1fb51a1622a692c0cfb1707d6eb2","logical_entry_identity":"aa250ae8f503a307e04334ea434c18667f5