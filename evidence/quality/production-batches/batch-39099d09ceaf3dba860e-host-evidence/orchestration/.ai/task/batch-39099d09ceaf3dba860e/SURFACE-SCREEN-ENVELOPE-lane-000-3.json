f105ed7c3a1c499f062356a","logical_entry_identity":"63bc4ca9bfc60c4a6c8eaf28c856997a0585c06666a2b854d267594a1523eb5e","normalized_path":"tome-orcs.lua","source":"#PURPLE#Automated Reflex System activated!","source_tag":"saySimple","target":"#PURPLE#自动化反射系统启动！"},{"args_order":null,"call_locator":"0ddc24d0378227a858021280ebe25ca85512dff2e1e22911bca66e9c6f31fcc5","component":"orcs","entry_revision_identity":"5bb911ddb970b1fd6a67a82a2cf176b3569816d5e219e231b18b5541d5a81411","logical_entry_identity":"d543c8fc0b058b446353fac6453f13023f67d91143471a96b5bfbc22f8429be5","normalized_path":"tome-orcs.lua","source":"You build %d micro spiderbot(s) from the earthly elements around you. Spiderbots are powered by an arcane cryogenic power unit directly linked to your own power.\n\t\tSpiderbots will deal %0.2f terrene damage (physical and cold) each turn to their targets. The deep cold of the attack has 25%% chance to freeze the feet of the target, pinning it to the ground for 5 turns.\n\t\tIf a target dies, the spiderbot will jump onto a new target in range %d around you.\n\t\tIf there are multiple spiderbots on a single target and more free targets are in range they will dispatch on as many as possible.\n\t\tIf there are multiple spiderbots on a single target they attack as one, stacking their damage (with disminishing returns) and trying to freeze once.\n\t\tYou can maintain up to %d spiderbots at once and each can last up to %d turns, but spiderbots need to be in sight to be able to act.\n\t\tThe cooldown of this spell is affected by Body of Stone.\n\t\tThe damage will increase with your Spellpower.\n\n\t\tYou have currently %d spiderbot(s) up.","source_tag":"tformat","target":"你使用周围的土元素制造 %d 个迷你蜘蛛机器人。蜘蛛机器人是由和你的力量相连的奥术致冷单元驱动的。\n\t\t蜘蛛机器人每个回合会对它们的目标造成 %0.2f 寒岩（物理和寒冷）伤害。极寒的攻击有 25%% 的几率冻结目标的双脚，将他们定身 5 回合。\n\t\t如果目标被击杀了，蜘蛛机器人将会跳跃到你半径 %d 码范围内的另一个敌人身上。如果这个目标上有多个机器人，并且在范围内有足够多的可选目标，他们会尽可能分散地跳到每个敌人身上。\n\t\t如果一个目标的身上附身了多个蜘蛛机器人，他们会一起攻击，伤害会叠加（但收益递减），并且会一起试图冻结目标。\n\t\t你可以维持最多 %d 个蜘蛛机器人，他们最多存活 %d 回合。但是，只有在你视野范围内的蜘蛛机器人才会行动。\n\t\t这一技能的冷却时间受岩石身躯的影响。\n\t\t技能伤害受法术强度加成。\n\n\t\t你现在有 %d 个蜘蛛机器人。"},{"args_order":null,"call_locator":"15fa62a1f3099e088f0ab7c7bc3d0f01caafd628bdb30f0b39a1e01fa86e3a1a","component":"orcs","entry_revision_identity":"5bc1afc745976a8be2a8f0735a126c0672b4ed048eed30b56a85782e37c860fc","logical_entry_identity":"a702c5f2783bc981d973aaee32507d8c0f74a247db9136dc42b1494c529d3611","normalized_path":"tome-orcs.lua","source":"call a trained yeti for help","source_tag":"_t","target":"召唤受训练的雪人来帮助你"},{"args_order":null,"call_locator":"c5efa4d80248329d926cf66edca78b91289c2d967b928171dd14946c9481b7bf","component":"orcs","entry_revision_identity":"5bf7662170b1271653e3f1388f7c9d9263d6efc3cb3785f8a763bb3f631a16dc","logical_entry_identity":"a7fd5dfe4c74cb7edd24d44b6761d05ffa5d3484810172d3b9aa604e069122f4","normalized_path":"tome-orcs.lua","source":"Dominion Port: Tower","source_tag":"_t","target":"巨魔帝国港口：塔楼"},{"args_order":null,"call_locator":"1781cfcf45a27bb973880e022547a1dc96820f3543cb789eea56c54eddcf5229","component":"orcs","entry_revision_identity":"5bfa76cbadf4b6b4f3704fa0ff8fe979997b4d1006b4ef8a01e5b0054742f376","logical_entry_identity":"47180b5d7315c315c7f351609a1ada1ededc4b6b5211a40e903f49f7b681c1d2","normalized_path":"tome-orcs.lua","source":"caustic steam","source_tag":"damage type","target":"腐蚀蒸汽"},{"args_order":null,"call_locator":"cf99a11efc65379fd12d135ee1bee62ebacea7ff0a286cebb611346cba52f78c","component":"orcs","entry_revision_identity":"5c19dacca837ec7f026db8cb7f0eb199b3490978147f2bd2dc68928a8a08c19f","logical_entry_identity":"5046e7ed41dd81ec2594094c35f2700eb84303daaec4f5e597686e9dbaeb517c","normalized_path":"tome-orcs.lua","source":"#Target# is not affected anymore by the salve.","source_tag":"_t","target":"#Target# 不再受药剂影响。"},{"args_order":null,"call_locator":"1de700b174ed4a8c12432d7f4b8d0009253eee3479224cadec2fed8136b5e50d","component":"orcs","entry_revision_identity":"5c1ca67950d210644b377c5cbeb168bdf65c90755971cd3e0078d56f186cfdd9","l