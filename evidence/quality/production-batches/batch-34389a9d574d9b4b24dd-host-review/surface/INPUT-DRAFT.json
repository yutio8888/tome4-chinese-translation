l,"call_locator":"eeed2bf4564c89a591f92b430fa478abcb05d0d08ba09aea66b21707f28752be","component":"tome","entry_revision_identity":"632fd26cdbae947c52b2beaf012bece5e3658ac8e93c94160100e778cc83ed24","logical_entry_identity":"17421568cc88e8a32804918ffb9868c04b84a17ec11c350362be0e9a13fd5183","normalized_path":"mod-tome.lua","source":"Claws and teeth. Ice and death. Dragons are not all extinct it seems...","source_tag":"_t","target":"尖牙利齿，冰冷致命。似乎龙族并没有完全灭绝……"},{"args_order":null,"call_locator":"ce22320413b3d7afe836d6e892474a2e30231ddebd78fc19dfa1ef2eefcee08b","component":"tome","entry_revision_identity":"6330e1f87f71b12f907d801a1bd7edcef49f5139f74e62faf11e46ce5ee108d5","logical_entry_identity":"85fb150c76647d00af145cc90196bc249e4185371fa3d1a463e60a8f4ca454a7","normalized_path":"mod-tome.lua","source":"Stealth","source_tag":"talent name","target":"潜行"},{"args_order":null,"call_locator":"433985235cd25fdc1caf0bf526c747801e498faddbfa9dc3fd67521cb722c857","component":"tome","entry_revision_identity":"6331e3bb4f4099d73043744fac95cb98256c8dfb191747c880fe2a357181cbd8","logical_entry_identity":"090b9e3be7147b31adebd5168362eaf4a51b56eb900d48f25bb5d257e33584eb","normalized_path":"mod-tome.lua","source":"%s(%d flat reduction)#LAST#","source_tag":"tformat","target":"%s(%d 固定减伤)#LAST#"},{"args_order":null,"call_locator":"7200f36748f14865736dec0679a7d3dbfba24d1432ab070f19c5dcbfe6319ab1","component":"tome","entry_revision_identity":"633785fc261a963b27eac7fd9c68be7e16c00acc754a467e5e5796e4e0272e99","logical_entry_identity":"9c569a187663ab35788ef18804c62e3f0e9e6e43963aa619a08393c1f76af3b1","normalized_path":"mod-tome.lua","source":"Death mocks my experiments. I can preserve the flesh of my servants, tightly wrapped and salted, treated with the correct chemicals. I can animate them, make them shuffle about the empty halls of my mausoleum. But they are but empty shells, devoid of any soul. Is this how my majesty is to end? I demand a greater fate...\n\nMy days are numbered. Each night that passes saps strength from me. I must find the way to preserve my soul within my flesh. My greatness cannot be allowed to fade.","source_tag":"_t","target":"死亡嘲弄着我的实验。我可以保存侍从们的血肉，将他们用盐防腐后紧紧的包裹起来，就像是对待真正的实验品一样。我可以复活他们，使他们在我阴森森的坟墓里晃悠。但他们不过是没有任何灵魂的容器。这意味着我的霸业要结束了？我需要更好的机遇……\n\n我的日子屈指可数。我的力量随着每个夜晚逐渐流逝。我必须找到将灵魂保存在肉体里的方法。我的伟大不容亵渎。"},{"args_order":null,"call_locator":"50c2f1d636a6ce8ed7bdea04425a8305465d774036a7c997c7eb6ac0eacedf7f","component":"tome","entry_revision_identity":"633b7c713cb4bc859a56d090824a4da2b33db65a7c7ff84250c9f73c94bd2c06","logical_entry_identity":"8b5f6f2a5c87f87f59b710b1d93cfca46f324c70c8e258789b8e971de697094e","normalized_path":"mod-tome.lua","source":"+Free Action","source_tag":"_t","target":"+自由行动"},{"args_order":null,"call_locator":"41a6de9aa1fcf1cb9771e7d53bbd70cb5824bb00031c86718ae9f9b98a9893cc","component":"tome","entry_revision_identity":"633fff4fc236cacb15d9ec16b4a074be1187af4f40c284f9b0c59c438e9e81a8","logical_entry_identity":"89d5f3b12feae0f235bef961e588baf6ed0d5ce586efb287b6cebee2b1ed969a","normalized_path":"mod-tome.lua","source":"Fumble","source_tag":"_t","target":"笨拙"},{"args_order":null,"call_locator":"e6932479c83a514b53037837640a95909e957d28f2e9329ba2111d5e0f6dea71","component":"tome","entry_revision_identity":"6345b7d95e28960bbe39dc9a5b298b90e573858b9ab0607790468646a097c05c","logical_entry_identity":"de1756cae17a28abee52ece07b5e888249d8fa171f6e36ac1dbbe56fa3847d23","normalized_path":"mod-tome.lua","source":"You have become wary of danger in your journeys. You have a %d%% chance of not triggering traps.","source_tag":"tformat","target":"你的行动变得更加谨慎，有 %d%% 几率不会触发陷阱。"},{"args_order":null,"call_locator":"efb3232a6d141e69cc886e20095bd16cb1a09c8fdd6ad31a325c654baa465202","component":"tome","entry_revision_identity":"634c8d76df937433f0e2d75e5e9dea4623c06e1936d9e9454a396dbccde19dce","logical_entry_identity":"f708ec60b6b3ab6a675efe4a82b4e2b99c8fb271c42da7ba4eccdc5911986e0e","normalized_path":"mod-tome.lua","source":"fire alchemy","source_tag":"ta