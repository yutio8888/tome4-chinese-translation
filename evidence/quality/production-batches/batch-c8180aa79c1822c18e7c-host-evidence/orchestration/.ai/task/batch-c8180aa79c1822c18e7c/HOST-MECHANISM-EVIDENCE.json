      {
        "line": 1266,
        "text": "\tlocal mult = 1"
      },
      {
        "line": 1267,
        "text": "\tif light_armor then"
      },
      {
        "line": 1268,
        "text": "\t\tif self:knowTalent(self.T_MOBILE_DEFENCE) then"
      },
      {
        "line": 1269,
        "text": "\t\t\tmult = mult + self:callTalent(self.T_MOBILE_DEFENCE,\"getDef\")"
      },
      {
        "line": 1270,
        "text": "\t\tend"
      },
      {
        "line": 1271,
        "text": "\tend"
      },
      {
        "line": 1272,
        "text": ""
      },
      {
        "line": 1273,
        "text": "\treturn math.max(0, d * mult + add) -- Add bonuses last to avoid compounding defense multipliers from talents"
      },
      {
        "line": 1274,
        "text": "end"
      },
      {
        "line": 1275,
        "text": ""
      },
      {
        "line": 1276,
        "text": "--- Gets the defense ranged"
      },
      {
        "line": 1277,
        "text": "function _M:combatDefense(fake, add)"
      },
      {
        "line": 1278,
        "text": "\tif self.combat_precomputed_defense then return self.combat_precomputed_defense end"
      },
      {
        "line": 1279,
        "text": "\tlocal base_defense = self:combatDefenseBase(true)"
      },
      {
        "line": 1280,
        "text": "\tif not fake then base_defense = self:combatDefenseBase() end"
      },
      {
        "line": 1281,
        "text": "\tlocal d = math.max(0, base_defense + (add or 0))"
      },
      {
        "line": 1282,
        "text": "\tif self:attr(\"dazed\") then d = d / 2 end"
      },
      {
        "line": 1283,
        "text": "\treturn self:rescaleCombatStats(d)"
      },
      {
        "line": 1284,
        "text": "end"
      },
      {
        "line": 1285,
        "text": ""
      },
      {
        "line": 1286,
        "text": "--- Gets the defense ranged"
      },
      {
        "line": 1287,
        "text": "function _M:combatDefenseRanged(fake, add)"
      },
      {
        "line": 1288,
        "text": "\tif self.combat_precomputed_defense then return self.combat_precomputed_defense end"
      },
      {
        "line": 1289,
        "text": "\tlocal base_defense = self:combatDefenseBase(true)"
      },
      {
        "line": 1290,
        "text": "\tif not fake then base_defense = self:combatDefenseBase() end"
      },
      {
        "line": 1291,
        "text": "\tlocal d = math.max(0, base_defense + (self.combat_def_ranged or 0) + (add or 0))"
      },
      {
        "line": 1292,
        "text": "\tif self:attr(\"dazed\") then d = d / 2 end"
      },
      {
        "line": 1293,
        "text": "\treturn self:rescaleCombatStats(d)"
      },
      {
        "line": 1294,
        "text": "end"
      },
      {
        "line": 1295,
        "text": ""
      }
    ]
  },
