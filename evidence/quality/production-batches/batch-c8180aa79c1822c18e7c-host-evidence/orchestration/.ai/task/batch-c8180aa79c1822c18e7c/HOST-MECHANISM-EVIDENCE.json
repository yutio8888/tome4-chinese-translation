[
  {
    "fixed_source_commit": "624a67329fe2ad440c5b344785a9c73fcf22ae63",
    "public_source_path": "game/modules/tome/data/talents/misc/races.lua",
    "sha256": "958b207fd24723fa3b1613c62048b19012df2e24e9b82152eb1ef2485a88aed1",
    "lines": [
      {
        "line": 743,
        "text": "\tname = \"Hold the Ground\","
      },
      {
        "line": 744,
        "text": "\ttype = {\"race/orc\", 2},"
      },
      {
        "line": 745,
        "text": "\trequire = racial_req2,"
      },
      {
        "line": 746,
        "text": "\tpoints = 5,"
      },
      {
        "line": 747,
        "text": "\tcooldown = function(self, t) return 12 end,"
      },
      {
        "line": 748,
        "text": "\tmode = \"passive\","
      },
      {
        "line": 749,
        "text": "\tgetSaves = function(self, t) return self:combatTalentScale(t, 4, 16, 0.75) end,"
      },
      {
        "line": 750,
        "text": "\tgetDebuff = function(self, t) return math.ceil(self:combatTalentStatDamage(t, \"wil\", 1, 5)) end,"
      },
      {
        "line": 751,
        "text": "\tpassives = function(self, t, p)"
      },
      {
        "line": 752,
        "text": "\t\tself:talentTemporaryValue(p, \"combat_physresist\", t.getSaves(self, t))"
      },
      {
        "line": 753,
        "text": "\tend,"
      },
      {
        "line": 754,
        "text": "\tcallbackOnTakeDamage = function(self, t, src, x, y, type, dam, state)"
      },
      {
        "line": 755,
        "text": "\t\tif self:isTalentCoolingDown(t) then return end"
      },
      {
        "line": 756,
        "text": "\t\tif not ( (self.life - dam) < (self.max_life * 0.5) ) then return end"
      },
      {
        "line": 757,
        "text": "\t\t"
      },
      {
        "line": 758,
        "text": "\t\tlocal nb = self:removeEffectsFilter(self, {status = \"detrimental\", type = \"mental\"}, t.getDebuff(self, t))"
      },
      {
        "line": 759,
        "text": "\t\tif nb > 0 then"
      },
      {
        "line": 760,
        "text": "\t\t\tgame.logSeen(self, \"#CRIMSON#%s roars with rage shaking off %d mental debuffs!\", self:getName():capitalize(), nb)"
      },
      {
        "line": 761,
        "text": "\t\t\tself:startTalentCooldown(t)"
      },
      {
        "line": 762,
        "text": "\t\tend"
      },
      {
        "line": 763,
        "text": "\tend,"
      },
      {
        "line": 764,
        "text": "\tinfo = function(self, t)"
      },
      {
        "line": 765,
        "text": "\t\treturn ([[Orcs have been the prey of the other races for thousands of years, with or without justification. They have learnt to withstand things that would break weaker races."
      },
      {
        "line": 766,
        "text": "\t\tWhen your life goes below 50%% your sheer determination cleanses you of %d mental debuff(s) based on talent level and Willpower.  This can only happen once every %d turns."
      },
      {
        "line": 767,
        "text": "\t\tAlso increases physical save by %d.]]):"
      },
      {
        "line": 768,
        "text": "\t\ttformat(t.getDebuff(self, t), self:getTalentCooldown(t), t.getSaves(self, t))"
      }
    ]
  },
