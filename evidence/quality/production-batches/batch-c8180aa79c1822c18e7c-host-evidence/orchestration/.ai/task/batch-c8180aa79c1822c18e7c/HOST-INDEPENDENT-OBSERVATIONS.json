      {
        "line": 2060,
        "text": "--- Computes mind crit for a damage"
      },
      {
        "line": 2061,
        "text": "function _M:mindCrit(dam, add_chance, crit_power_add)"
      },
      {
        "line": 2062,
        "text": "\tself.turn_procs.is_crit = nil"
      },
      {
        "line": 2063,
        "text": ""
      },
      {
        "line": 2064,
        "text": "\tcrit_power_add = crit_power_add or 0"
      },
      {
        "line": 2065,
        "text": "\tlocal chance = self:combatMindCrit() + (add_chance or 0)"
      },
      {
        "line": 2066,
        "text": "\tlocal crit = false"
      },
      {
        "line": 2067,
        "text": ""
      },
      {
        "line": 2068,
        "text": "\tif self:attr(\"stealth\") and self:knowTalent(self.T_SHADOWSTRIKE) then"
      },
      {
        "line": 2069,
        "text": "\t\tchance = 100"
      },
      {
        "line": 2070,
        "text": "\tend"
      },
      {
        "line": 2071,
        "text": ""
      },
      {
        "line": 2072,
        "text": "\tprint(\"[MIND CRIT %]\", self.turn_procs.auto_mind_crit and 100 or chance)"
      },
      {
        "line": 2073,
        "text": "\tif self.turn_procs.auto_mind_crit or rng.percent(chance) then"
      },
      {
        "line": 2074,
        "text": "\t\tself.turn_procs.is_crit = \"mind\""
      },
      {
        "line": 2075,
        "text": "\t\tself.turn_procs.crit_power = (1.5 + crit_power_add + (self.combat_critical_power or 0) / 100)"
      },
      {
        "line": 2076,
        "text": "\t\tdam = dam * (1.5 + crit_power_add + (self.combat_critical_power or 0) / 100)"
      },
      {
        "line": 2077,
        "text": "\t\tcrit = true"
      },
      {
        "line": 2078,
        "text": "\t\tgame.logSeen(self, \"#{bold}#%s's mind surges with critical power!#{normal}#\", self:getName():capitalize())"
      },
      {
        "line": 2079,
        "text": ""
      },
      {
        "line": 2080,
        "text": "\t\tif self:attr(\"hate_on_crit\") then self:incHate(self:attr(\"hate_on_crit\")) end"
      },
      {
        "line": 2081,
        "text": "\t\tif self:attr(\"psi_on_crit\") then self:incPsi(self:attr(\"psi_on_crit\")) end"
      },
      {
        "line": 2082,
        "text": "\t\tif self:attr(\"equilibrium_on_crit\") then self:incEquilibrium(self:attr(\"equilibrium_on_crit\")) end"
      },
      {
        "line": 2083,
        "text": ""
      },
      {
        "line": 2084,
        "text": "\t\tif self:knowTalent(self.T_EYE_OF_THE_TIGER) then self:triggerTalent(self.T_EYE_OF_THE_TIGER, nil, \"mind\") end"
      },
      {
        "line": 2085,
        "text": "\t\tif self:knowTalent(self.T_LIVING_MUCUS) then self:callTalent(self.T_LIVING_MUCUS, \"on_crit\") end"
      }
    ],
