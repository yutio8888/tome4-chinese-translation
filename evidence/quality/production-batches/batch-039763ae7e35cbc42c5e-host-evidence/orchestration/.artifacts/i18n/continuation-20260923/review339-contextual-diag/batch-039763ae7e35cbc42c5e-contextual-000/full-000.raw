{"contract":"translation_contextual_v2","candidate_identity":"dcb3e95d3d6b2e0d0228143a7847819e6f57c88d1b97c88d647cc374e97ddaae","verdicts":[{"revision_key":"a21112e52912b3c4941bf8db078b9f7f39bc3c006a4c938dabe7162f94fcb4c0","verdict":"OK"},{"revision_key":"a27688ff3f72672447396d04b85c27f968d541c301d2e69b937b0a814d74c6e8","verdict":"OK"},{"revision_key":"a2aa6c921a9d503e70300e1386e304eb8090b27e85babf7ef11d9493b71c67c4","verdict":"OK"},{"revision_key":"a2d8aa0cb9ed8d6b879c95fffb43c4a4a159fee0be1331bb48f9b5eeb15a562f","verdict":"OK"},{"revision_key":"a2e0e9841a0fe637d6defd5fbc1f6d104c7917c5245b3efeddca5c92a80d01bd","verdict":"OK"},{"revision_key":"a3a35758bd4127b678ed0e34dd7ff8003a0571c8b4753ee5a84a5400764b84ca","verdict":"OK"},{"revision_key":"a3cecc7f1f6f555ecfa59f86e08ca69ad7acd00bb70c44e91dfaa759469af241","verdict":"OK"},{"revision_key":"a49b334d447d3a4920b3b71565c9b5b7152fc4ea83ad74c2a945a9825c947f85","verdict":"OK"},{"revision_key":"a4b6ae91d9bb42534ea7ffdedce059ecad06800b9556f0928a9970bbc9821be7","verdict":"OK"},{"revision_key":"a534d81fa41830dd7075167b76e460cf125421528a6a1044f708fff838ed05bb","verdict":"OK"},{"revision_key":"a668705856cd7297fb89aed03e5d5d647948c81d2efba4a280d9663d3ef6d0a6","verdict":"ISSUE","observation":"tome-orcs/data/lore/gem.lua:39-55（来源未固定）有多处误译：开头的“for posterity!”意为“为了后世／留给后人”，译成了“为了繁荣！”（把 posterity 当成了 prosperity）；“Er... splendid, I assume!”是“我想是很好吧”的推测语气，译成了“太棒了，我保证！”，意思变成了承诺；“GO FORTH, MY HERALD. TELL THEM ALL ARE WELCOME.”中的“告诉他们，我十分欢迎你们”，人称从“他们”错成了“你们”，应译为“告诉他们，所有人都受欢迎”。"},{"revision_key":"a79480d625d3593293180ae270d12e20e6ccd11ce1e4b1573b3b9ce5081882b8","verdict":"ISSUE","observation":"tome-orcs/data/talents/psionic/action-at-a-distance.lua:210-211（来源未固定）原文写的是“propagates to all foes in radius %d”和“All affected foes”，只指敌人，译文却写成“半径内的所有单位”“所有被劈中的单位”，范围扩大到可能包含友方，与原文不符，应译为“敌人”。envelope 只提供了 info 片段，action 的实际目标筛选无法核验。"}]}