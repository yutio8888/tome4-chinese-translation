03d378e249b7b","component":"ashes-urhrok","entry_revision_identity":"295b84f066bb5e2610c84354d9f94de40a32ef9ded864d97373d29cbf3df47c5","logical_entry_identity":"c9e454780ea3519f0ac896add9aab679b9350256b341d576d1b38a66951483d5","normalized_path":"tome-ashes-urhrok.lua","source":"Your body overflows with the power of the Fearscape, turning you into a powerful demon for %d turns. This increases your stamina regen and physical power by %d, and your disarm and stun immunity by %d%%.\n\t\tThe physical power, stamina regen, and status resistances increase with your spellpower.\n\t\tYour other talents also gain a variety of bonuses:\n\t\t-Draining Assault: Reduces cooldown by %d.\n\t\t-Reckless Strike: Gain %d%% resistance penetration for all elements for %d turns.\n\t\t-Obliterating Smash: Increases range by %d.\n\t\t-Abduction: If it hits, get an additional %d attacks at 35%% weapon damage.\n\t\t-Incinerating Blows: Increases chance of bonus damage to %d%%.\n\t\t-Fearfeast: Gain %0.1f vim per stack.\n\t\t-Maw of Urh'rok: Increases cone width by %d degrees.","source_tag":"tformat","target":"恶魔空间的力量充溢了你的身体，将你转换成一个强大的恶魔，持续 %d 回合。\n\t变身期间，体力恢复和物理强度增加 %d，缴械和震慑抗性增加 %d%%。\n\t物理强度、体力恢复和状态抗性加值受法术强度加成。\n\t变身期间，其他技能也受到强化：\n\t汲魂痛击：冷却时间减少 %d。\n\t舍身一击：增加 %d%% 全体抗性穿透，持续 %d 回合。\n\t歼灭挥斩：增加半径 %d。\n\t锁魂之链：如果命中，额外附加 %d 次 35%% 武器伤害的攻击。\n\t焚尽强击：增加额外伤害几率至 %d%%。\n\t恐惧盛宴：每汲取一层叠加的恐惧，获得 %0.1f 点活力。\n\t乌鲁洛克之口：角度增加 %d。"},{"args_order":null,"call_locator":"5510aedfdb4f01f1361cbdc594f622263e735ec6ac5fb9e010a5f2f24b034a89","component":"ashes-urhrok","entry_revision_identity":"296765c04dd18b827507eb5e75e9d99280a590ea2208e9c1ada218a001d627f0","logical_entry_identity":"349f3afba86529db121ae0f890968041b841249fe80a090b9f1bca097bf37c3f","normalized_path":"tome-ashes-urhrok.lua","source":"The target is surrounded by a magical shield, absorbing %d/%d damage before it crumbles and dealing %d damage in a radius of %d when it does.","source_tag":"tformat","target":"目标被一层魔法护盾包围，吸收 %d/%d 伤害，护盾结束时（无论吸收耗尽还是自然到期），对周围敌方生物施加持续 3 回合的灼烧，总计造成 %d 伤害，作用半径为 %d。"},{"args_order":null,"call_locator":"b7f0ec2f93e15ef174769a222a0cc1444323ba4b7cbff69dfe3f663836e81410","component":"ashes-urhrok","entry_revision_identity":"2972a5fbbdab234502c9dd44592779736078e7c52ddb7c012094b00e9eb6a7d1","logical_entry_identity":"f285898646434c9ce0e87bdea21d760785c4ac593c01b454d76571730d3e7d49","normalized_path":"tome-ashes-urhrok.lua","source":"#GOLD#Life per level:#LIGHT_BLUE# +3","source_tag":"_t","target":"#GOLD#每等级生命加值：#LIGHT_BLUE# +3"},{"args_order":null,"call_locator":"ad66b790b17c113d194b26fea84e180e542c8d5209f1df501adc91cf764554f7","component":"ashes-urhrok","entry_revision_identity":"299c0276d3c3d2d4e7bbe32ff23ce6a7c3f547c349d4479f80fdaaaee13ed0ec","logical_entry_identity":"09a97248c99e142465b24aff792de7de544369b29fe7a69c7570f870ce450050","normalized_path":"tome-ashes-urhrok.lua","source":"race","source_tag":"talent category","target":"种族技能"},{"args_order":null,"call_locator":"41ee57e855db907ec2d16c137c0ef7f05fa0bc841535983123c371b92acb10ed","component":"ashes-urhrok","entry_revision_identity":"2a7624de0cd07c23dde4e0ac3240c4ddc0cfafb78db0f05558f7073f4748c9ae","logical_entry_identity":"c12aae1c7b6cc369f7ae457d0c72ae394c2cbca4672b6d97c6282b34edfe9cb5","normalized_path":"tome-ashes-urhrok.lua","source":"#Target# is infected by a demon seed!","source_tag":"_t","target":"#Target#被恶魔种子感染！"},{"args_order":null,"call_locator":"d4a2869c1550099a7ab1ef101b5042a9b701aadd8d47a1186ff0c8d7d954df2d","component":"ashes-urhrok","entry_revision_identity":"2ad8b0465c184d212dd42cd12e3948ba00844c647ff12df5fb49b41152bedab9","logical_entry_identity":"592d9686657f10738117d0f20c6f280ad0b725e746497cdb019520f2b11da0a2","normalized_path":"tome-ashes-urhrok.lua","source":"The Black Spike","source_tag":"entity name","target":"黑之钉"}],"fixed_source_identity":"snapshot:104ad8232778010e72f736559c726ea6ba8291265c28de2ecdf2275ec76dc2f2","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-ru