    "lines": [
      {
        "line": 37,
        "text": "newTalent{"
      },
      {
        "line": 38,
        "text": "\tname = \"Shadows Empathy\", image = \"talents/shadow_empathy.png\","
      },
      {
        "line": 39,
        "text": "\ttype = {\"cursed/one-with-shadows\", 2},"
      },
      {
        "line": 40,
        "text": "\trequire = cursed_cun_req_high2,"
      },
      {
        "line": 41,
        "text": "\tpoints = 5,"
      },
      {
        "line": 42,
        "text": "\tcooldown = 10,"
      },
      {
        "line": 43,
        "text": "\tmode = 'sustained',"
      },
      {
        "line": 44,
        "text": "\tno_npc_use = true,"
      },
      {
        "line": 45,
        "text": "\t--count shadows in party"
      },
      {
        "line": 46,
        "text": "\tgetShadows = function(self, t)"
      },
      {
        "line": 47,
        "text": "\t\tlocal shadowsCount = 0"
      },
      {
        "line": 48,
        "text": "\t\tfor _, actor in pairs(game.level.entities) do"
      },
      {
        "line": 49,
        "text": "\t\t\tif actor.summoner and actor.summoner == self and actor.subtype == \"shadow\" then shadowsCount = shadowsCount + 1 end"
      },
      {
        "line": 50,
        "text": "\t\tend"
      },
      {
        "line": 51,
        "text": "\t\treturn shadowsCount"
      },
      {
        "line": 52,
        "text": "\tend,"
      },
      {
        "line": 53,
        "text": "\t--values for resists and affinity"
      },
      {
        "line": 54,
        "text": "\tgetLightResist = function(self, t) return -15 end,"
      },
      {
        "line": 55,
        "text": "\tgetDarkResist = function(self, t) return self:combatTalentScale(t, 10, 25) end,"
      },
      {
        "line": 56,
        "text": "\tgetAffinity = function(self, t) return self:combatTalentScale(t, 10, 25) end,"
      },
      {
        "line": 57,
        "text": "\tgetAllResScale = function(self, t) return self:combatTalentScale(t, 2, 4) end,"
      },
      {
        "line": 58,
        "text": "\tgetAllResist = function(self, t) return t.getAllResScale(self, t) * t.getShadows(self, t) end, "
      },
      {
        "line": 59,
        "text": "\t--activate effects"
      },
      {
        "line": 60,
        "text": "\tactivate = function(self, t)"
      },
      {
        "line": 61,
        "text": "\t\tlocal ret = {"
      },
      {
        "line": 62,
        "text": "\t\t\tshadowres = self:addTemporaryValue(\"resists\", {all=t.getAllResist(self, t)}),"
      },
      {
        "line": 63,
        "text": "\t\t\tres = self:addTemporaryValue(\"resists\", {[DamageType.LIGHT]=t.getLightResist(self, t), [DamageType.DARKNESS]=t.getDarkResist(self, t)}),"
      },
      {
        "line": 64,
        "text": "\t\t\taff = self:addTemporaryValue(\"damage_affinity\", {[DamageType.DARKNESS]=t.getAffinity(self, t)}),"
      },
      {
        "line": 65,
        "text": "\t\t}"
      },
      {
        "line": 66,
        "text": "\t\treturn ret"
      },
      {
        "line": 67,
        "text": "\tend,"
      },
      {
        "line": 68,
        "text": "\t--callbacks"
      },
      {
        "line": 69,
        "text": "\tcallbackOnPartyAdd = function(self, t)"
      },
      {
        "line": 70,
        "text": "\t\tlocal p = self:isTalentActive(t.id)"
      },
      {
        "line": 71,
        "text": "\t\tif p.shadowres then self:removeTemporaryValue(\"resists\", p.shadowres) end"
      },
      {
        "line": 72,
        "text": "\t\tp.shadowres = self:addTemporaryValue(\"resists\", {all=t.getAllResist(self, t)})"
      },
      {
        "line": 73,
        "text": "\tend,"
      },
      {
        "line": 74,
        "text": "\tcallbackOnPartyRemove = function(self, t)"
      },
      {
        "line": 75,
        "text": "\t\tlocal p = self:isTalentActive(t.id)"
      },
      {
        "line": 76,
        "text": "\t\tgame:onTickEnd(function()"
      },
      {
        "line": 77,
        "text": "\t\tif p.shadowres then self:removeTemporaryValue(\"resists\", p.shadowres) end"
      },
      {
        "line": 78,
        "text": "\t\tp.shadowres = self:addTemporaryValue(\"resists\", {all=t.getAllResist(self, t)})"
      },
      {
        "line": 79,
        "text": "\t\tend)"
      },
      {
        "line": 80,
        "text": "\tend,"
      },
      {
        "line": 81,
        "text": "\t--daectivate effects"
      },
      {
        "line": 82,
        "text": "\tdeactivate = function(self, t, p)"
      },
      {
        "line": 83,
        "text": "\t\tself:removeTemporaryValue(\"resists\", p.shadowres)"
      },
      {
        "line": 84,
        "text": "\t\tself:removeTemporaryValue(\"resists\", p.res)"
      },
      {
        "line": 85,
        "text": "\t\tself:removeTemporaryValue(\"damage_affinity\", p.aff)"
      },
      {
        "line": 86,
        "text": "\t\treturn true"
      },
      {
        "line": 87,
        "text": "\tend,"
      },
      {
        "line": 88,
        "text": "\tinfo = function(self, t)"
      },
      {
        "line": 89,
        "text": "\t\treturn ([[You empathy with your shadows causes the line between you and your shadows to blur."
      },
      {
        "line": 90,
        "text": "\t\tYou lose %d%% light resistance, but gain %d%% darkness resistance and affinity. You also gain %0.2f%% all resistance for each shadow in your party.]]):"
      },
      {
        "line": 91,
        "text": "\t\ttformat(t.getLightResist(self, t), t.getDarkResist(self, t), t.getAllResScale(self, t))"
      },
      {
        "line": 92,
        "text": "\tend,"
      }
    ],
    "status": "context_verified_no_final_adjudication"
  },
