,"normalized_path":"mod-tome.lua","source":"temporal slow","source_tag":"damage type","target":"时空减速"},{"args_order":null,"call_locator":"988ab4c75b73f456fe0e3ab19ad014ca874b56afff5d711909a5790b612fd321","component":"tome","entry_revision_identity":"ef34a097305919ae26461e250c2203fa1fab181e7507b05a033bfc1b77161f57","logical_entry_identity":"bf588fa8984f84333ca07ff7678382a4e289083a9b2b81896985d1be9da718b5","normalized_path":"mod-tome.lua","source":"Thank you. I will rest for a while.","source_tag":"_t","target":"谢谢你。我在此休息片刻。"},{"args_order":null,"call_locator":"fc1b028a3a8fff4e481543beef85f9a3ee9e92d5a928e627ca90cdc49e18f22a","component":"tome","entry_revision_identity":"ef35dc1331ae8103b28c317807fd898c925edaa0c644cfd66fc71dd2099d64ca","logical_entry_identity":"eaac727be52840ff9866c1a7350cf9bd439f28493e628dd087364a6ae25753a3","normalized_path":"mod-tome.lua","source":"Running man","source_tag":"_t","target":"逃跑者"},{"args_order":null,"call_locator":"a662a880fa6d3bef0e101316b18c1a629768e90b74d7441d5ebbfa9ae4aea78e","component":"tome","entry_revision_identity":"ef3620b84230d36d9b622561c9ec84e3d0fd6767235f026fade0d55dc65bec6c","logical_entry_identity":"c199c29bd46d48091dabeb94d6a103ce7efea6a1ad1f8e8a3b325e97b240526d","normalized_path":"mod-tome.lua","source":"@playername@, this message is of utmost importance.\n\nThe staff you left at Last Hope is gone. A raid of orcs ambushed the guards that were transporting it to a secret vault.\nOur troops managed to capture one of the orcs and made him talk.\nHe did not know much, but he did speak about \"masters\" in the Far East.\nHe spoke about Golbug -- this seems to be a warmaster in Reknor -- leading a raid to send a \"package\" through a portal.\n\nThis calls for urgency; should you find this Golbug or the portal, please investigate.\n\n               #GOLD#-- Tolak, King of the Allied Kingdoms","source_tag":"_t","target":"@playername@，这份报告极其重要。\n\n你留在最后的希望的法杖不见了。一群兽人伏击了正将它押送往秘密金库的守卫。\n我们的部队设法俘虏了其中一个兽人，并让他开了口。\n他知道的不多，但他提到了远东大陆的“主人”。\n他提到了高尔布格，貌似是瑞库纳的一位战争领主，带领一场袭击，以便将一个“包裹”送过传送门。\n\n事情非常紧急；如果你找到这个高尔布格或那个传送门，请务必调查。\n\n\t\t\t   #GOLD#-- 托拉克，联合王国国王。"},{"args_order":null,"call_locator":"ba3ec31879c8f84692f2bd88300b6e308ba4956f2b38265a4af26975dc58902f","component":"tome","entry_revision_identity":"ef3670bfb5321159671d10621c3dade24cc02741d97ba7e7b7da3e36ba38bb9d","logical_entry_identity":"19182119c3ebf3a9896765492bbbedea26b39ea1beb19a6d980d2b0158bf6e69","normalized_path":"mod-tome.lua","source":"Elemental Orb (Orb of Command)","source_tag":"entity name","target":"指令水晶球（元素）"},{"args_order":null,"call_locator":"4948dc5382dcf90ab0f5fe145f310193e0ebdabb2c93b08d4addc83a35e3e8f5","component":"tome","entry_revision_identity":"ef3874ceff8dd8ac20e34e8c21f35772ab4ce6065bb63f6bc96319970c3f4a58","logical_entry_identity":"0cc0d7efb2d2d955f2b52c642e55c7a3ca586bfa03241f149b2df71bb8f0ab0b","normalized_path":"mod-tome.lua","source":"#F53CBE#You panic and flee from %s.","source_tag":"logPlayer","target":"#F53CBE#你因为恐惧而逃离%s。"},{"args_order":null,"call_locator":"ba7c0611eab04fdbd2c028229a1b742c5b304ff280107a8e4aa62fe83c9aa976","component":"tome","entry_revision_identity":"ef3c591366f6268faf4b8127683b1adb2b5300d7974380ab596e387fe892ec9e","logical_entry_identity":"553de8644e452b6712d6e5522e95d3d2822e24a5108eb938dc28788569bc0cf9","normalized_path":"mod-tome.lua","source":"stave inc damage lightning","source_tag":"entity name","target":"法杖 增加闪电伤害"},{"args_order":null,"call_locator":"b870d0efe2707add4deb30d1c7250070099269c75b3b5427d3b6aee6c6d5698e","component":"tome","entry_revision_identity":"ef3ca50787a59d01bd8385545610cabbc5a802d43a4cfcd7dbbbf7a17a7403cc","logical_entry_identity":"2d513cd0d0d97819858ac4f75e83923867a9cd851ad745bacd63c0ab39909238","normalized_path":"mod-tome.lua","source":"Left mouse to show known talents","source_tag":"_t","target":"左键点击显示已掌握的技能"},{"args_order":null,"call_locator":"f4dc81f7a07418c44c1c5b1e4a9d0b90a5a6470be6397a17317b5cb2cc0a56d3","component":"tome","entry_revision_identity":"ef3cbb0