{"candidate_identity":"b061cb23ffe43ec784c0447b28ee4195972471570dcc14a554f2853e54268acc","contract":"translation_surface_screen_v1","results":[{"entry_revision_identity":"a5a0cf47b6802dddeef6637f7b9bfca405c92645e7cead583d51aee33a0b37c9","observation":"原文“sets its duration to %d”表示将持续时间设为指定值，译文“持续时间增大到 %d 回合”额外断言持续时间增加；冻结输入没有支持必然增加的证据。","verdict":"ISSUE"},{"entry_revision_identity":"ab69970be2c6d5189d36b6e032e641a6fa6a87827a28165d7c70f904e3d6e5c8","verdict":"OK"},{"entry_revision_identity":"b028c0ed3b26eee3628f7131c99b0d4d08cd93d129474cc66fd05f1f52bde874","observation":"原文“teleporting you to a specific location up to %d spaces away”明确传送至范围内的指定位置，译文仅写“传送半径 %d”，遗漏指定目的地的信息。","verdict":"ISSUE"}]}