半径为 2 的奥术爆炸。"},{"args_order":null,"call_locator":"fb65a6bc2a831d5473acef5a9e477c760ea02d4bd85622d9c8d40c6c0d8119b5","component":"tome","entry_revision_identity":"f8f9b54caee4d5eb90297b6ec0eceb37ab10f49ae975ed3441e80eb42a20e918","logical_entry_identity":"b9f9d217e31724d92e76c54e64c44383b4193f8d61c35baf5a02c92e73e3d977","normalized_path":"mod-tome.lua","source":"#YELLOW#Items lying around will disappear in #WHITE#%d#YELLOW# turns!#LAST#","source_tag":"log","target":"#YELLOW#地上的物品将会在#WHITE#%d#YELLOW#回合内消失！#LAST#"},{"args_order":null,"call_locator":"f2f7fea208fc762a488c04210b6c133ff22fe1d648c75b4477ad5d781b938134","component":"tome","entry_revision_identity":"f8ff1c5d3a879ee9f22d7fb8e27b7b02f169507932a488278a68e34b453430ca","logical_entry_identity":"2255c6cdbf77577b7b247abb3a4895d9398f3891c629bd89b78b91460d0d70d8","normalized_path":"mod-tome.lua","source":"#Target# focuses on #Source#.","source_tag":"logCombat","target":"#Target# 将注意力集中到 #Source#。"},{"args_order":null,"call_locator":"dd1af17ff13afa75f093cf5405572ca962f700ce24a01e865bf52154522b2392","component":"tome","entry_revision_identity":"f901c07dd512d84f92d5754de1e9cd4449976d88224245bd7ab6767eaa355fba","logical_entry_identity":"2d7d502d3452aaa1d377207972855a7cdd7abaa0d325b4b0159fbe6e1da9fddc","normalized_path":"mod-tome.lua","source":"Taking on a spectral form, allowing teleportation back to their original tile.","source_tag":"tformat","target":"进入游魂形态，可以传送回原来的位置。"},{"args_order":null,"call_locator":"41bf5e2636137f508cf14dc408c351ca39719baf51cd17eb38f5c458f4903fdb","component":"tome","entry_revision_identity":"f908f88af93bf8cceb181fd48d2d56abb074862ab7fde9e748a2ee8b53e1e7d5","logical_entry_identity":"7f19280f4fc8e6f908183219d2cfa588078b10bda2486d034aa0668fd6f799e7","normalized_path":"mod-tome.lua","source":"Reduces global action speed by %d%%.","source_tag":"tformat","target":"全局速度下降 %d%%。"},{"args_order":null,"call_locator":"d7aff75a71a7610c55122d6e5a45a4ac364cb99c743d1cea34b53c42905916e2","component":"tome","ent