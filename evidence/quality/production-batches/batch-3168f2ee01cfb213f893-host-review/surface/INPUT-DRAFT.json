within %d tiles of it.","source_tag":"tformat","target":"在你当前位置创造第 2 个跃迁之门，你可以使用跃迁之门：传送技能将你传送至这个位置，距离不超过 %d 码。"},{"args_order":null,"call_locator":"d54df5bc36b62f69907aa1282dbb6bc26512300ad3fb55bce798d625b1efbdda","component":"tome","entry_revision_identity":"67370399ae77db22ccb661e2b85134280717268d3d91e2615f5a37afbfa85bff","logical_entry_identity":"b95b9563f0e2123edff2932659945bbfcd8beecd382dcf6523583731aa0d0756","normalized_path":"mod-tome.lua","source":"#F53CBE##Target# has been maligned!","source_tag":"_t","target":"#F53CBE##Target#受到恶意影响！"},{"args_order":null,"call_locator":"54d798e082f79caff91a66545a7b8419487e34f44d56dc8e185a02586e28d317","component":"tome","entry_revision_identity":"67398166fb2dabd2a22a2dad851d879f071f2461ad42dd497a56c0a6752d0d04","logical_entry_identity":"8d38af9fcf0148e87270a5f21136b26fcf9a66cf22abcab4f8d5f44f681f4443","normalized_path":"mod-tome.lua","source":"Range: %d\nNet Damage: %d - %d\nAccuracy: %d (%s)\nAPR: %d\nCrit Chance: %+d%%\nCrit mult: %d%%\nUses Stats: %s\n","source_tag":"tformat","target":"射程：%d\n基础伤害：%d - %d\n命中：%d (%s)\n护甲穿透：%d\n暴击几率：%+d%%\n暴击伤害：%d%%\n使用属性：%s\n"},{"args_order":null,"call_locator":"6931f343d5cd3d0fe9e15adcfc197456f553a8bbff4ba186588b8fb3007cd343","component":"tome","entry_revision_identity":"673cd0d48696f08b530f64c73b232ad769e8552744a2c3274ef0c01d649cdd4a","logical_entry_identity":"c1e21a09cab10cb767d577a27e25223e4fac8eea1e5c19958dd2943b7ef49fdd","normalized_path":"mod-tome.lua","source":"-Sleep","source_tag":"_t","target":"-睡眠"},{"args_order":null,"call_locator":"f0601d9f5ddbad695b83cdfd5317bf61c1eaa1b6d0e29dec1b779129213283b6","component":"tome","entry_revision_identity":"67400978701a032b16676ca010011ab5f1035290402de5bb6eb4927523be6959","logical_entry_identity":"c5aa46bfc71a1792c7d25193905caf6c208b135c306d982450ed065fa8a5f1a1","normalized_path":"mod-tome.lua","source":"Damp Cave","source_tag":"_t","target":"潮湿洞穴"},{"args_order":null,"call_locator":"af46757dd6fe6dd6c2a50bd53c7767145df95e2ded77abce363f19c9