locator":"71e2a53397ba51b471e848e43534391e1521d414e46fce146a6f52d4d0301206","component":"tome","entry_revision_identity":"88a79f2617ed89f772c7e3cb5235df5fd8588d28dd61a94148c1c3c360094846","logical_entry_identity":"7c4550df0d91a47fbe09c166b532ae130f9e9a61956b2b81994b8ace54a79b9c","normalized_path":"mod-tome.lua","source":"ringing amulet","source_tag":"_t","target":"吵闹的护身符"},{"args_order":null,"call_locator":"aadf75d6b6a5103d984a15b1c18643927426d0bc429f56ec0d09ff3069214d43","component":"tome","entry_revision_identity":"88a7b0b33410d82438a654a4af758c374547d3cb56c04938e9b9b59e5327c64e","logical_entry_identity":"24f22d89be037dffdda116850ddb229ffbc21c08ec9e77901be9d55ce98b1920","normalized_path":"mod-tome.lua","source":"faint distortion","source_tag":"_t","target":"微弱的扭曲"},{"args_order":null,"call_locator":"013c78c9db1438428648bed0978acf82dfc733f41b57159b183fdf4699d1c461","component":"tome","entry_revision_identity":"88a9b04876aa4e4ba836b9e5af8c886bf3f9ffbbb603a67393565f25ea4e582e","logical_entry_identity":"d7ec91affd0e676a748c05e38a00106c395d2c24f85133a580ab0c00148bfb28","normalized_path":"mod-tome.lua","source":"#LIGHT_RED#%s briefly catches sight of you!","source_tag":"logPlayer","target":"#LIGHT_RED#%s 发现了你的踪迹！"},{"args_order":null,"call_locator":"33f38265cf5d5504420f875824823e3102d07c815e7c84007b8d6d9b8e1951d9","component":"tome","entry_revision_identity":"88af2fb84e09d6d1d46cb407de8db8acc627920ea8f1dadc43bb65c7ecc120b3","logical_entry_identity":"4bd4091fbb4e37d886f08452d593d9171c3330a8aed69c8ac4ed308253b554a0","normalized_path":"mod-tome.lua","source":"#GOLD#Spellpower#LAST#\nYour spellpower represents how powerful your magical spells are.  It is opposed by your opponent's spell save.\nIn addition, when your spells inflict temporary detrimental effects, every point your opponent's save exceeds your spellpower will reduce the duration of the effect by 5%.\n","source_tag":"_t","target":"#GOLD#法术强度#LAST#\n你的法术强度决定了你施放法术技能的威力。敌人用法术豁免对抗你的法术强度。\n另外当造成基于法术强度的负面效果时，敌人的相应豁免每超过法术强度一点将减少5%持续时间。\n"},{"args_order":null,"call_locator":"0bf03e9a6fe77577ddc1510d3c3f5d4e097509f5213908db26f1d9865cf21ebf","component":"tome","entry_revision_identity":"88af4cd4af15bb6cbfedb0585d1fd695edb490bca821dce96ad3a0b22b42afab","logical_entry_identity":"e30eed04b060911843fe23a4aa606d14529ce816e56b4deb487b7cb6ea45c03e","normalized_path":"mod-tome.lua","source":"I would still rather kill you and take your treasure!","source_tag":"_t","target":"我还是要杀了你，夺取你的财宝！"},{"args_order":null,"call_locator":"f2885d73a06b6f67a7660ffa5e01a3287d523af9c09050c0486517c40aac264c","component":"tome","entry_revision_identity":"88af87d16477d75bdf30e3eb10c82b1c402824529911b52d829d8e9cb44500ea","logical_entry_identity":"4eaa37b9ebc279c3891b3e00a0571254cb85d9976f65460753c0d58212540757","normalized_path":"mod-tome.lua","source":"Chant Adept","source_tag":"talent name","target":"赞歌专家"},{"args_order":null,"call_locator":"f42e134fb497e5c2772bc9b02fd8eada63cbcde8210762a2a305712db94baa0c","component":"tome","entry_revision_identity":"88b14a8249b119e2adcd1027ff79b98a2ac31f12e74c7531afc7807c43ed1a85","logical_entry_identity":"60682e63f4c51f63ec9a8ea63489b8e6a40855900d30c499b11327ed1a0c2ca8","normalized_path":"mod-tome.lua","source":"Concentrate on the corruption you bring, enhancing each of your melee strikes with %0.2f blight damage (which also heals you for %0.2f each hit).\n\t\tThe damage will increase with your Spellpower.","source_tag":"tformat","target":"专注于你带来的瘟疫，每次近战攻击会造成 %0.2f 枯萎伤害（同时每击恢复你 %0.2f 生命值）。\n\t\t伤害受法术强度加成。"},{"args_order":null,"call_locator":"615660ca1c823d864ef4649885ed660f41aabdfa9d48b10560dae143416fd121","component":"tome","entry_revision_identity":"88b1c79cd331ba1bbd1c5059631a0a30da402172a79e339932c63ce51760e03a","logical_entry_identity":"4b65e3e32ece2d13711819dc1992473f34843f630c4248a3959cb4a1ea20c7c3","normalized_path":"mod-tome.lua","source":"Yes, we have sensed the blight of the eldritch forces there. I have people working to dispel the cloud, but the real threat is not there.\nWe know that a Tempest, a powerful Archmage who can control the storms, is responsible for the damage. Those wretched fools from Angolwen will not act. All corrupted!\nSo you must act, @playername@. I will show you the location of this mage - high in the Daikara mountains.\nErase him.","source_tag":"_t","target":"是的，我们已经感受到那里奥术力量带来的腐化。我已经派人去驱散乌云，但真正的威胁并不在那里。\n我们知道，造成这场灾难的是一名风暴术士，一个能操纵风暴的强大元素法师。安格利文那些可悲的蠢货不肯行动。他们全都腐化了！\n所以你必须采取行动，@playername@。我会告诉你这名法师的所在——岱卡拉山脉高处。\n除掉他。"},{"args_order":null,"call_locator":"120d9ec59b03e1aa8d630461a025c39fc94a130f2ed164ca1ed8191e4840ccbc","component":"tome","entry_revision_identity":"88bb4cc0832070a86b496e8beb92990689f0bb6bd1a6285311b7ddf68dcbb0de","logical_entry_identity":"a152452f1147c43c41d3b0bf26d54db215a017a164662a44a679761c94b21713","normalized_path":"mod-tome.lua","source":"[As you begin to leave, Protector Myssil stops you.]\n\nActually...  You fight in a more subtle way than most, do you not?  It is a point of pride for many of us that we stand tall in the face of arcane aggression and give warlocks one chance to repent before purging them, and much of our training reflects that, but I won't deny that less...  #{italic}#traditionally glorious#{normal}# methods can be extremely effective.  Decorum's no reason to let a necromancer get away alive when you could've planted a trap in their escape route.\n\n(She hands you a scroll.) Here - some of us have come up with a pre-prepared device which will sap magic from whoever or whatever sets it off.  All we ask is that you use discretion with these devices; no matter what our #{italic}#last#{normal}# assassin thought, planting them in some lesser rune-scribe's shop would be more likely to do us harm than good in the long run.","source_tag":"_t","target":"[当你正要离开时，守护者米歇尔叫住了你。]\n\n其实……你的战斗方式比大多数人都更为精妙隐蔽，不是吗？我们许多人都以正面迎击奥术侵袭、先给术士一次悔悟机会再将其净化为荣。我们的许多训练也体现了这一点。不过我不否认，不那么……#{italic}#符合传统英雄作风#{normal}#的方法也可能极其有效。若能预先在逃跑路线上布下陷阱，礼法可不是放任死灵法师活着逃走的理由。\n\n（她递给你一张卷轴。）拿着——我们有些成员制成了一种预先备好的装置，无论何人或何物触发它，装置都会抽走魔力。我们只希望你审慎使用这些装置；无论我们#{italic}#上一位#{normal}#刺客怎么想，把它们布置在某个低阶符文刻印师的店里，长远看来更可能损害我们的事业，而非带来益处。"},{"args_order":null,"call_locator":"9a3ea89f24856f1aa4beeda4fea9f70430e4d5ad649248f921eef28f33694d99","component":"tome","entry_revision_identity":"88bc0bbf73d0636f183d19786e5821b5b507625706b3c8f442604c255f23abfc","logical_entry_identity":"d82544e74e9807fc38e0c0fbd79939ef29973136a7912c6a113689d9884459b2","normalized_path":"mod-tome.lua","source":"daelach","source_tag":"entity name","target":"达莱奇"},{"args_order":null,"call_locator":"905c3348b3ba40c098000d70107d8f8c1df6c2196b5cb07843d85a753be93091","component":"tome","entry_revision_identity":"88bd47f584c51e1cc18981d62f40d5c0b32eef768c68d11532a191be2d10777e","logical_entry_identity":"93b000bf3fb3691da66e39b19f0ee495a64a91e8a5c31e87074644c6cdd39fcc","normalized_path":"mod-tome.lua","source":"Singularity Arrow","source_tag":"talent name","target":"奇点之矢"},{"args_order":null,"call_locator":"2954b1729d3793783d554544891087d66d5b6f6c4f49cee960ba860fece572de","component":"tome","entry_revision_identity":"88bdfa031fa50f5aef7753fbdfafa22e9ef9aff053458ada72e4ed1b0180a4f9","logical_entry_identity":"d8b3bd35d84413e54a027634d41a9e7d5a39dc5ac2de3a4a876abf5241fa893d","normalized_path":"mod-tome.lua","source":"Curse of Hate","source_tag":"_t","target":"仇恨诅咒"},{"args_order":null,"call_locator":"7fae375113de7558fb106e73486f02a378ebfa199937924081b3d19a6b833503","component":"tome","entry_revision_identity":"88c171e9c558f75dc205d9db3a570532a648654dcc590a1de436bf22e76bf8c6","logical_entry_identity":"486a5799d22579bb9c0da9d752cf602da9d37446ea36b8857f96c9222115879e","normalized_path":"mod-tome.lua","source":"A malevolent aura begins to form around you. Choose your curse:","source_tag":"_t","target":"你的身边形成了一个恶意的光环。请选择你的诅咒："},{"args_order":null,"call_locator":"e91368bfb3aff2117aa292f4d1e06cd1c6c3e3665ebd43f9a09851c3a39bbcb7","component":"tome","entry_revision_identity":"88c54dca2bd816b4ec7e3e7fe741e3f8accdb28159d3fc5f18c2fe790dca