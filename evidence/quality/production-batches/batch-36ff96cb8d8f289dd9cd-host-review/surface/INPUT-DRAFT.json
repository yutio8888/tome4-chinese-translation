551e4442a5ba679579da72fd3c13dca3b58866dc57f56f47002f5de72b9693b","component":"tome","entry_revision_identity":"88eb532c4f2e7a7bbe52d956ea33c93a54245dce5c9cd810ccd3823955dd5fb7","logical_entry_identity":"1e9b8c3bb10f906ca7eb78288e0fdf4162d116829f408bc49ce33487bb0ad4a2","normalized_path":"mod-tome.lua","source":"Infinite Dungeon Challenge (Level %s): %s","source_tag":"tformat","target":"无尽地下城挑战 (楼层 %s): %s"},{"args_order":null,"call_locator":"f78d1a26e20a8fd4042b2a575d76d19d29db461c15c3a403ebd2a48a6bf413f8","component":"tome","entry_revision_identity":"88ee6ef967a6517a6d236d683bb50d8b70029b2db8b909218df51f83d882c9bd","logical_entry_identity":"775cddfd787225dccf5032669ccdab5e06c92ecd4cee209a11b8655e45e08b54","normalized_path":"mod-tome.lua","source":" appear!!","source_tag":"_t","target":" 出现了！！"},{"args_order":null,"call_locator":"1cf5349d29661f65cea95523d6f78e3d130b579f9fa77b90243205f58974dd27","component":"tome","entry_revision_identity":"88f0276905039c9eda5726b8f3573ae9b4c436e6a6a71656fbc05b3bf1e32273","logical_entry_identity":"08f1c7f67a597d9ff9d8538b270524c08f34be95a478d19d21336519da771d25","normalized_path":"mod-tome.lua","source":"#RED#You aided various denizens of Maj'Eyal in their attempts to join the Brotherhood of Alchemists, though you did not prove the deciding factor for any. This year's new member is %s.#WHITE#","source_tag":"tformat","target":"#RED#你帮助了马基·埃亚尔的许多人加入炼金术士兄弟会，但是你没有成为任何一个决定性因素。今年的新成员是%s。#WHITE#"},{"args_order":null,"call_locator":"971cee1794a1efa7cc92e1ce6dd2cc0065ac239866b61ed466aea037e02eb0e5","component":"tome","entry_revision_identity":"88f4908caae4905f58e54cf985bdaabd5b5d4cd85a608006eb73618fc3ab2467","logical_entry_identity":"d04cce2df92ffd5f5e0736e750c64ae630bccfcc88e2d1d263d429e1439e1fa6","normalized_path":"mod-tome.lua","source":"The target is infected by a disease, reducing its dexterity, strength, and constitution by %d.","source_tag":"tformat","target":"目标被疾病感染，敏捷、力量和体质各减少 %d 点。"},{"args_order":null,"call_locator":"493df6fbc354ba35a2b1709d11daf53eea026a4d0fe39d8806e15f5be742c7d1","component":"tome","entry_revision_identity":"88f52f22bbc8ee6c4750709e7a815f940e875d286c13519a22ad7e236fb40814","logical_entry_identity":"c063571c47a9bc102ff39b31c92bf0cd6982bf7fcb53f0740daacbd7e233e552","normalized_path":"mod-tome.lua","source":"Current Boss Actor: %s","source_tag":"tformat","target":"目前Boss角色：%s"},{"args_order":null,"call_locator":"4838269f63b079b621c854acfd830fbcbc94c71243868ccb6474489ae16bf305","component":"tome","entry_revision_identity":"88fa97aa600bacbd0b28ec78729f14fb9b749bf7b2a2e258aed9e31c70dfe436","logical_entry_identity":"136ad7e02414f89b27c3e1d6bfb8941128f3fffde0f236bcceff7dc359ebce3c","normalized_path":"mod-tome.lua","source":"Inner Demons","source_tag":"_t","target":"心魔"},{"args_order":null,"call_locator":"d9c456ec5cc61bdbf376e8d98b80973158b3c1683555c74bde18d2fb2c8420d6","component":"tome","entry_revision_identity":"8902557c4cf19c0612a2d98e6e9346196e158ed414fda5c70cb0d5da71f08c8e","logical_entry_identity":"14d93891734918b8e2e0f74aa47d5d84797493e83104407a053d079d768ebad7","normalized_path":"mod-tome.lua","source":"Creates a circle of radius %d at your feet; the circle slows incoming projectiles by %d%% and attempts to push all creatures other than yourself out of its radius, inflicting %0.2f light damage and %0.2f darkness damage per turn as it does so.  The circle lasts %d turns.\n\t\tThe effects will increase with your Spellpower.","source_tag":"tformat","target":"在你的脚下制造一个 %d 码半径范围的法阵，它会减慢 %d%% 抛射物速度并将除你外的其他生物推出去。\n\t\t同时，每回合对目标造成 %0.2f 光系伤害和 %0.2f 暗影伤害。\n\t\t法阵持续 %d 回合。\n\t\t效果受法术强度加成。"},{"args_order":null,"call_locator":"27a5c6ed6fca2266b3820c4470dce8f32653bab82d0f7b1c8decd846cf7a4b84","component":"tome","entry_revision_identity":"8902887ba3dd9d96339926d39f2709da361aa1716db72c97c8f3381601165354","logical_entry_identity":"41309b5897b8dc514ae5d22b31a50ee3a3bed843a93e6202a2b3b8c6dddc1a2a","normalized_path":"mod-tome.lua","source":"#VIOLET#Images of yourself beating people with a stick spring into your mind. (Staff Combat category can be bought)","source_tag":"logPlayer","target":"#VIOLET#你用木棒击打敌人的镜像进入了你的大脑。（能购买法杖格斗系）"},{"args_order":null,"call_locator":"b91ec06fecee5dd16d686bee5df3e930f280fcd43ee7029be1b885f350d5fd2a","component":"tome","entry_revision_identity":"8904128732b26f87249297e3a1fe1205f02db57abe629969e7cddcbae1bcbccc","logical_entry_identity":"913e29cdb7ad499c47bb6d38ab657f1c6d4f36669ab38ad8b7bb8b21d748b51c","normalized_path":"mod-tome.lua","source":"#{bold}#Relle, Cornac Fighter & Expedition Captain#{normal}#\nNothing but hatchlings so far. Honestly, if this keeps up we won't have enough dragonhide to cover a dragon, let alone cover our losses. I've really spared no expense this time as well: Gorran is one of the finest rangers I know, and Sodelost... his prices are exorbitant, but then what else would you expect from those money-grubbing dwarven Thronesmen? I must admit I don't know much about Xann. The locals say there's no finer wyrmic in the area, and I admit she is something special in combat. Now, if only she could turn her draconic talents to FINDING some dragons!","source_tag":"_t","target":"#{bold}#探险队队长，科纳克人战士瑞丽#{normal}#\n到目前为止只遇上了幼龙。老实说，照这样下去，我们得到的龙皮连一条龙都盖不住，更别说弥补损失了。这次我也确实不惜血本：高岚是我认识的最优秀的巡林客之一；至于苏达罗斯特……他的要价高得离谱，不过钢铁王座那群贪财的矮人还能是什么样？我得承认，自己并不了解希安。当地人说这一带没有比她更出色的龙战士，而她在战斗中确实不同凡响。现在只盼她能把操控龙族力量的本事用来找出几条龙！"},{"args_order":null,"call_locator":"3f0b1867428a5ccdbe6a84c07e0709308290bbad39379c3f92371ed9bb7fa65e","component":"tome","entry_revision_identity":"890a5abc799b2442d49ff8b68830dfa4e2205d4e45ce7eba7e0bff0eb7971fa9","logical_entry_identity":"c0aa98fe9c8a038b4e3a0f281c0e8a2eeebc7221a20c7bde5c0c2e544e99839f","normalized_path":"mod-tome.lua","source":"ethereal boots","source_tag":"_t","target":"飘渺的靴子"},{"args_order":null,"call_locator":"a89ec09a8dc4ddab29b6c9df2f146314539b0830c720a4c20734059b7cd2a0ca","component":"tome","entry_revision_identity":"890ee1f06024644ac761bfe91356a8cae3b70a98c4fd3a17451e84f4b4ce27d0","logical_entry_identity":"b4d439aa4582f8e60cea85c5ca707bdac3df5fcc49d5d26f07022f0cdcafb2a6","normalized_path":"mod-tome.lua","source":"#GREY#%s has fed on enough minions and starts to randomly hex foes!","source_tag":"logSeen","target":"#GREY#%s吸取了足够多的随从，开始随机对敌人释放邪术！"},{"args_order":null,"call_locator":"aa785f5a6e9655463519f9ca824e6a0f8750097a6c978306a20aa38ad9a73b53","component":"tome","entry_revision_identity":"890eec11497dc6c7e004e633981bbd8a11534f6ba97aa9b522ad8cf8f51c1daf","logical_entry_identity":"1cb54b3041d1fe01c1b3fe01685678a0b7bf33c986044bb34f7e373b6311b337","normalized_path":"mod-tome.lua","source":"Gnaw your target for %d%% damage.  If your attack hits, the target may be infected with Ghoul Rot for %d turns.\n\t\tEach turn, Ghoul Rot inflicts %0.2f blight damage.\n\t\tTargets suffering from Ghoul Rot rise as friendly ghouls when slain.\n\t\tGhouls last for %d turns and can use Gnaw, Ghoulish Leap, Stun, and Rotting Disease.\n\t\tThe blight damage scales with your Constitution.","source_tag":"tformat","target":"啃噬目标，造成 %d%% 伤害。\n\t\t如果你的攻击命中，目标会感染食尸鬼腐烂疫病持续 %d 回合。\n\t\t食尸鬼腐烂疫病每回合造成 %0.2f 枯萎伤害。\n\t\t目标被杀死时会变成你的可以完全控制的食尸鬼傀儡。\n\t\t食尸鬼傀儡持续 %d 回合，可以使用啃噬、食尸鬼跳跃、震慑和腐烂疫病。\n\t\t受体质影响，枯萎伤害按比例加成。"},{"args_order":null,"call_locator":"1b61b8c133d605379e7ce1dd6b0e0f7b10de4b15fb0e5bd0e65b50701077ad6c","component":"tome","entry_revision_identity":"891922dc23a16c9f769816aefb41e6c3f7131a35fc791a6b7a5b6e1f7648978e","logical_entry_identity":"7df42216cb961a8674165493b81108822c28559842b8182aa77cc91b4ba9d5e8","normalized_path":"mod-tome.lua","source":"#YELLOW_GREEN##Source#'s healing is amplified!","source_tag":"delayedLogMessage","target":"#YELLOW_GREEN##Source#的治疗被增幅了！"},{"args_order":null,"call_locator":"b0feae6abfc9a43388cc10a6f2f47838ea2501ad2d277fc17ac1a53049fd30fe","component":"tome","entry_revision_identity":"891de410a8473f6e7169b67c4856337e1f616dde50f746cb4545a0638085bf9d","logical_entry_identity":"749a7e1863a96028900b3699f218efce3063696f6d7aef79b92132f3d1a2688f","normalized_path":"mod-tome.lua","source":"#LIGHT_GREEN#*A human robed in immaculate white satin opens the door and eyes you appraisingly.*#WHITE#\nAh, an adventurer. I was just thinking that I needed a new one.","source_tag":"_t","target":"#LIGHT_GREEN#*一名身着一尘不染白缎长袍的人类打开了门，审视地打量着你。*#WHITE#\n啊，一位冒险者。我正想着我需要个新的帮手呢。"},{"args_order":null,"call_locator":"ecee3852d70b491399288e2d2e860db70da9242215a1ef94a5bb9f670bb7edd5","component":"tome","entry_revision_identity":"891f93531abe26375ac4d005865ae91f7857adfbb07d1da96649c2bfe76600f5","logical_entry_identity":"335ee3492f4fdc7410d5ffdc596561edea10c019d0907cb3c6d2e30ebdb2a9bc","normalized_path":"mod-tome.lua","source":"It looks awake, beware!","source_tag":"_t","target":"它醒来了，小心！"},{"args_order":null,"call_locator":"6ec9d79a9b9e7146ecd1bfe18b6733059a3a7341195425a446cb8e598b1a2bd5","component":"tome","entry_revision_identity":"8924b56606c61caebd3af746adc6f71b735e6b556614626156164a5fe2f65988","logical_entry_identity":"32a569912bbd7196343d18eee8d3589d7b7e9ad076e4f1b730fee5894d38c479","normalized_path":"mod-tome.lua","source":"The smith spends some time with you, teaching you the basics of armour and weapon usage.","source_tag":"logPlayer","target":"铁匠花了一些时间，教你武器和护甲的基础使用方法。"},{"args_order":null,"call_locator":"dfc88fbc621e5c0e373216b015fcc86b9426b3925a82dbf60d276f0f22e54347","component":"tome","entry_revision_identity":"8924eb8a7a551c456db063bc3ecf6cd06d009f03c84b929090fdfe294e8685e2","logical_entry_identity":"266454189e295ef0f765da9f268e0e221f49f3064312ce88111e51e8235af212","normalized_path":"mod-tome.lua","source":"Use moddable tiles (equipment showing on player)","source_tag":"_t","target":"使用纸娃娃（在玩家身上显示装备）"},{"args_order":null,"call_locator":"2fb61063a8543d6ffe1ef4f5b7aca92188d642025c8f58197bc53df9c47c86b6","component":"tome","entry_revision_identity":"89284f68ed28a7d6d7c8032b25d2323861361587301049cb125f5301b870376b","logical_entry_identity":"2d22d70257fec3400255fa87b32dd344dbfbe745ea29eba3e8816ee7f3c4e836","normalized_path":"mod-tome.lua","source":"#{bold}#How to Summon a Phoenix#{normal}#\n\t  10 pouches faeros ash\n\t  5 vials fire wyrm saliva\n\t  3 red crystal shards\n\t  3 pouches bone giant dust\n\t  1 vial greater demon bile\n\t  1 skeleton mage skull\n\t  pinch of luminous horror dust\n\nThis is a long and complex ceremony, and all steps must be followed precisely if you wish to succeed. Heed well that for the errant fool who takes on what they cannot finish, there will be consequences. To play with fire and assert your dominance over the flames comes with risks if you overestimate your power. \n\t\nThe ritual begins with a vessel; any man will do. Bind them in place with flame secure bindings, and give a sound gag. The gag isn't strictly necessary, but the screams of agony tend to be quite distracting and inspirit mistakes after a few days.\n\nTake 2 vials fire wyrm saliva and dissolve 2 pouches faeros ash in each. Be sure to dissolve completely. A few fireballs at the vial can do the trick if they're stubborn. Using one of the prepared vials, begin to etch the saliva in the skin of the vessel, heating it so that it brands the shape of --- \n\n#{italic}#The remainder of the scroll has been singed into a pile of char, illegible and scattering into a cloud of ash as you grasp it#{normal}#\n\t","source_tag":"_t","target":"#{bold}#如何召唤凤凰#{normal}#\n\t  10袋法罗的灰烬\n\t  5瓶火龙涎\n\t  3块红色水晶碎片\n\t  3袋骨巨人粉尘\n\t  1瓶大恶魔胆汁\n\t  1个骷髅法师头骨\n\t  一小撮金色恐魔的粉尘\n\n这是一个漫长而复杂的仪式，如果你想要成功的话，就必须严格遵循所有的步骤。要知道，自视过高的蠢材如果冒险进行自己没有能力掌控的仪式，一定会迎来自己应得的下场。如果你高估了自己掌控火焰的力量，那么等待你的只有玩火自焚的结局。\n\n仪式需要一份祭品，随便哪个人都可以。用防火胶布把他绑住，塞住他的嘴巴。虽然塞住嘴巴这一步不是必须的，但是那个人痛苦的惨叫可能会让人分心，可能会让你在之后的仪式中犯错。\n\n取2瓶火龙涎，溶解2袋法罗的灰烬。一定要充分溶解。如果还有没有完全溶解的部分，就往瓶子里放几个小火球。使用一瓶准备好的溶液，用火龙涎在祭品的皮肤上蚀刻，加热，构成类似于—\n\n#{italic}#卷轴的剩余部分已经被烧焦了，无法辨认。当你抓到这份卷轴的时候，那些残存的纸页就化为了灰烬#{normal}#\n\t"},{"args_order":null,"call_locator":"461a6eeafac20db74f9d485aa254b630b2acea6534d048ddfa70cce408b5e035","component":"tome","entry_revision_identity":"892dd6fd45256a0239f03d0af04a198ece55ed27520d403dc4e06f6bb71f0db0","logical_entry_identity":"9f0d9d616fa7c9037246e8d08407412bc12d9bc44ed4f672e5c99c480d911e77","normalized_path":"mod-tome.lua","source":"Reduces global action speed by %d%% and all outgoing projectiles speed by %d%%.","source_tag":"tformat","target":"减少 %d%% 全局速度和 %d%% 自身发射的所有抛射物速度。"},{"args_order":null,"call_locator":"e64643bf8a33b080596207f553f8bbfad4d35db99e540c863a4d1dc23b7c168f","component":"tome","entry_revision_identity":"893466d871ba56e24e665df3705035cc0bcc70e67219acabab20e5acaea93a74","logical_entry_identity":"545a2b4ffea53ab81b7ef7acd2d2511e6bc673e86fa2004bbfc376acfbda8fe5","normalized_path":"mod-tome.lua","source":"It's a large black ant.  Its porous skin oozes acid.","source_tag":"_t","target":"一只巨大的黑色蚂蚁，皮肤渗透出酸液。"},{"args_order":null,"call_locator":"91829a7af735a2620daa5988c7f6c90c7497893ade22651e3c53579c2b255b98","component":"tome","entry_revision_identity":"89376469f1a2d555702e46613fe6360dc150fe713efec3b5c3917e553ada5d91","logical_entry_identity":"3fe0b2a3d3d964f1537d3c21615871f9e34b13ff5f213b80e61dc7c9941d4b6e","normalized_path":"mod-tome.lua","source":"You do not have enough feedback to use %s.","source_tag":"logPlayer","target":"你的反馈值不足，无法使用%s。"},{"args_order":null,"call_locator":"8e1f76621f5899d7880048f7a0bf7a569d60ce089b372e793338f5215093406e","component":"tome","entry_revision_identity":"89376d7a321aca9c85fd54c16ea06022363defb12a0b0f8e91eb3b18f1690b58","logical_entry_identity":"cb9d8bf0cc90aec9cacbbb7c794f24bd4e4f31fe945d2d5417613ae707b7e348","normalized_path":"mod-tome.lua","source":"You find an entrance to an old crypt. An aura of terrible evil emanates from this place. You feel threatened just standing there.\nYou hear the muffled cries of a woman coming from inside.","source_tag":"_t","target":"你发现了一个古老地宫的入口，里面笼罩着恐怖的邪恶气息，仅仅站在门口你就已经感受到了它的威胁。\n你听到了里面传来了陌生女人的哭声。"},{"args_order":null,"call_locator":"adf8a590f8634080307a2f1ef669ce4957390e2067ae8eb910beb2f379db6d7f","component":"tome","entry_revision_identity":"89404556c30a1fac68a848ddd8faf471abf8f