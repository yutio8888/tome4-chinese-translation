006aa93b4a9a6e3edb0a24521316f79ebc62f00fdf9a2d","normalized_path":"mod-tome.lua","source":"@Source@ creates a bubble of fast time.","source_tag":"_t","target":"@Source@制造出加速时间气泡。"},{"args_order":null,"call_locator":"37667c4abc0ad86104867a31093a994bdd3ca394ccce6938cff2a8d7638b588d","component":"tome","entry_revision_identity":"947ec09b20c6a0e76c733660ee1ed1be42a6f17bdd218b5f3ac0b8cb66adbafb","logical_entry_identity":"56db6e3c89f58e6ccef8f1005d5aed61ff4bcb2af458caa781fd62bee4b2e969","normalized_path":"mod-tome.lua","source":"Oozemancers separate themselves from normal civilisation so that they be more in harmony with Nature. Arcane force are reviled by them, and their natural attunement to the wilds lets them do battle with abusive magic-users on an equal footing.","source_tag":"_t","target":"软泥使将自己和正常文明割裂，让自己与自然更加和谐。他们拒绝奥术能量，同时，与生俱来的自然和野性力量让他们成为了对抗魔法使用者的中坚力量。"},{"args_order":null,"call_locator":"0a2485058030e2c846e41234cbae21dd4157ea670abc155b84d9d7e5ec3d47c6","component":"tome","entry_revision_identity":"9482bcb696fa93e90a35c4f989e970383f6c2ef96cfe9c3fbb3550708c17349a","logical_entry_identity":"831c3e1b43cf3df3cb05547c6cbfa9b69fcd018ec930f0867916ce85d11839df","normalized_path":"mod-tome.lua","source":"%s: Reducing duration of %s, using %s, by %d","source_tag":"tformat","target":"%s: 减少%s持续时间，依据%s减少%d回合"},{"args_order":null,"call_locator":"ee35f13d3fe57c88a8c43f4130f85911fa9887536ae76a0c0ad20095665780ef","component":"tome","entry_revision_identity":"9484311cd1688cc3d47af6647407dcef6af18c56e0a7452beb2a5eb2ee1b7a04","logical_entry_identity":"878737ae8b047c3164aa47ebb2c8f3827dec23ccb535fe4eb0632d538ec3793e","normalized_path":"mod-tome.lua","source":"absorb and reflect %d; dur %d; cd %d","source_tag":"tformat","target":"吸收并反弹 %d 持续 %d ; 冷却 %d"},{"args_order":null,"call_locator":"da37477dfe2b61d8d47242d5892844c5db7f351499e3ec1eabd96a7435d1034d","component":"tome","entry_revision_identity":"9499813c40d5e0d30897fe7e63ab9cfbd63c906d23fa6644e507801385229c98","logical_entry_id