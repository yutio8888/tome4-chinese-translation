9f33cd67d3ef3cb62cb4a50190089da","component":"tome","entry_revision_identity":"941801a281e83a46c90ab3c73125e977bc9a74de13075c7c9873f43a78321485","logical_entry_identity":"6b698a423c29d94fab8a848d50b6b274e9d4de93f413113ce8ae0c0559e9ff99","normalized_path":"mod-tome.lua","source":"#FFD700#Accuracy#FFFFFF#: ","source_tag":"_t","target":"#FFD700#命中值　#FFFFFF#："},{"args_order":null,"call_locator":"6f23f7fb76583892124055738ab41ac7888096f7685b5b15d06372af4036e67d","component":"tome","entry_revision_identity":"9425827e201d4bf78e4e1aadd7c737a6190bf46da51cc217f12f6282ae3f44d5","logical_entry_identity":"d09b52c8b1e88626706ad6cc8557c7212497c82ac8524205ff3c9608a5314e73","normalized_path":"mod-tome.lua","source":"The arena, a way of violent entertainment. \nA delight for the audience, a source of wealth and glory. A place where aspiring fighters, former adventurers and those cursed to fight\neternally gather to hack away at each other.\n\nYou have unlocked the Arena and can now create new characters in a new campaign: #LIGHT_GREEN#The Arena#WHITE#.\n\nThe arena pits you against multiple enemies in an open field, making your battle tactics important for survival.\nCampaign features:#YELLOW#\n- No quests, plots, friendly creatures or ways out: only you against all odds.\n- Exclusive scoring system where the faster you kill, the more you earn. Scores are kept for bragging rights!\n- Pure hack and slash MAYHEM!\n- Your champion becomes the new master of the arena, allowing you to challenge your own champions!\n","source_tag":"_t","target":"竞技场是一种暴力娱乐方式。\n为了取悦观众，获得财富和荣耀的地方。在那里，有志之士、以前的冒险家和那些受永远战斗之诅咒的人互相厮杀。\n\n你解锁了竞技场，现在你可以创建一个新人物进行新的战役模式：#LIGHT_GREEN#竞技场#WHITE#。\n\n竞技场模式中你将在开阔场地上与多个敌人战斗，为了存活下来，战斗策略至关重要。\n战役特点：#YELLOW#\n- 没有任务、剧情、友善生物或逃生途径：只有你独自面对一切逆境。\n- 这里有一个积分系统，你越快杀死你的对手得分越高，分数可是你向别人夸耀的资本哦！\n- 尽情砍杀吧！\n- 你的冠军将成为竞技场的新主宰，让你可以挑战自己的冠军们！\n"},{"args_order":null,"call_locator":"50ecf32e70e5ea7ed555a4aa1a30e95c152c1c7bdbc194aebe19863b9c607b96","component":"tome","entry_revision_identity":"9428209af05a476e064eaf9fa292f03992450240af09e3c24675061706110c8a","logical_entry_identity":"d126921d4a9de80ba3c3a5b9b609dad7d596d04b68f317870041412fa175005d","normalized_path":"mod-tome.lua","source":"Jumpgate","source_tag":"talent name","target":"跃迁之门"},{"args_order":null,"call_locator":"8e202655e491425699eb977104d39711de05f3af6075e86a05fa91c7d081dac6","component":"tome","entry_revision_identity":"942bf1e4689a8cdf2a16a5db1a35eaf25d7aae218059376ecbfbb6a69d6a2e20","logical_entry_identity":"8cf370bfd0134347bb6ceb71235bfae8f8066666f92ce54486f0d502db24aee0","normalized_path":"mod-tome.lua","source":"Generic combat oriented techniques.","source_tag":"_t","target":"通用格斗技巧。"},{"args_order":null,"call_locator":"5c268aa271838b650c9851166b316524b15cfd3126b1a3e1e2d44ed1e959aa05","component":"tome","entry_revision_identity":"942d0dd6bc974f411ae72d744cdb6783ecb5b26b39d244c8cd0e4ff1026c87d1","logical_entry_identity":"bcc36777d9f4babb21eb7584b39f9502db09dc1b0e61b51ec81ed302ab14ddc1","normalized_path":"mod-tome.lua","source":"and burned on a pyre","source_tag":"_t","target":"并被绑在火刑柱上烧死"},{"args_order":null,"call_locator":"4ae01aecb5961230eb1ded89d8a9ed64f1bb88cf8a39b5cbc661f908bce102f6","component":"tome","entry_revision_identity":"942d2cc5702a05748b19d6c4b61142677f4e95d11c3d81f4dabd2fbfc9b65e1c","logical_entry_identity":"0bf5cb8544b740d9113fe5e96e4d05799a404e5fa6ded6f962ebe5b7de2ff845","normalized_path":"mod-tome.lua","source":"Dull-eyed orc","source_tag":"entity name","target":"眼神呆滞的兽人"},{"args_order":null,"call_locator":"56faebcb0f4e5113f10ba3bd20379cd7e035d1468077699a1b4d2361f91930f8","component":"tome","entry_revision_identity":"942de61f3d1aa63fd92abb8d2e6ae666e2aa05e1c3dbcfde30a5a13d576cee8b","logical_entry_identity":"4862c5bc3891f3184720fb296a25cf5deb54e48fc46e0200858e3dde40e52660","normalized_path":"mod-tome.lua","source":"#Source#'s rage awakens!","source_tag":"logCombat","target":"#Source#的愤怒被激发！"},{"args_order":null,"call_locator":"31e6011145ae2d26e00de77300e9b75d596fd3a4cda6caf35184aefe3e335d87","component":"tome","entry_revision_identity":"942e17514ea43d44b1f9288487fb3601d3bc22365bba75c4f7a23856e3fbfb14","logical_entry_identity":"c68e9d2dd01e60ea3b64aa3e3cad149859805d31b8f5db84d1fb3e197ef88411","normalized_path":"mod-tome.lua","source":"What brings an apprentice mage out into the wilds?","source_tag":"_t","target":"你一个法师学徒，怎么会跑到荒野里来？"},{"args_order":null,"call_locator":"8d55bc256ad29d8984deb3fe629612f7c52aab5b42b631c92ce082020790cfab","component":"tome","entry_revision_identity":"942e960a84085f3d2fe74e1bdb5288671617ddb3d412444949511793d273b18f","logical_entry_identity":"1c2750ab8797f06f44ebf39db144d880037cbe25df5b895c6534ff54c1a528eb","normalized_path":"mod-tome.lua","source":"The Creator. The God who made this world, He who watched silently as the races fought and burnt the land.\nHe who felt great sorrow for this world. He who shall now shatter the barriers of this world to remake it, only better!\nThe staff has allowed us to drain enough energy from this world to open the portal to the Void and summon Him through!\nIt is already too late. He is coming through as we speak -- it is only a matter of hours!","source_tag":"_t","target":"造物主，创造这个世界的神。他默默注视着各个种族争战不休，将大地付之一炬。\n他为这个世界深感悲痛。如今他将击碎这个世界的屏障，将它重塑得更加美好！\n这根法杖让我们得以从这个世界抽取足够的能量，打开通往虚空的传送门并召唤他降临！\n已经太迟了。就在我们说话的此刻，他正在穿过传送门——只需几个小时！"},{"args_order":null,"call_locator":"f8a8be2b77fc63d4fe8ac17f8767ca37af34ed0f81c223d918fb07a7822b523b","component":"tome","entry_revision_identity":"94340c3640ed23a549ee94a8a4741adf2e37be156df64ab60f7d4663e32aa9d0","logical_entry_identity":"a8c58d773fafadf9a694dacac4beda5236d4ae1aea12e00d5866b0e80898aac1","normalized_path":"mod-tome.lua","source":"dwarven-steel greatmaul","source_tag":"entity name","target":"矮人钢巨锤"},{"args_order":null,"call_locator":"4db634a7bae9862d431528d8eda6859765d7c0ba27f5dd3437d2462fcab1779d","component":"tome","entry_revision_identity":"9435815ebb3ae4d2018da71cc9a7a42bc800ff81c0d8b7a902f3ae1443dc3909","logical_entry_identity":"9304e074999362261670020a97ceed413288b120592194bbd0752a0eb36afe55","normalized_path":"mod-tome.lua","source":"Human","source_tag":"birth descriptor name","target":"人类"},{"args_order":null,"call_locator":"62b212df63b8e8af02e6fd612de4728fc7e51a40de5657cf371fca249da57891","component":"tome","entry_revision_identity":"94362f63a7dc96b93682a3b94ad1a7005934ec946e80f7897b3da9bb4fadf74f","logical_entry_identity":"582766c5ad4a50fbfdfedb93d384e4ba2f0e0ec960541732a94a71973eebfcc7","normalized_path":"mod-tome.lua","source":"The chronomancer known as Solith was renowned across all of Eyal. He always seemed to catch his enemies alone.\nIn the case of opponents who weren't alone, he had to improvise.","source_tag":"_t","target":"时空法师索利斯在马基·埃亚尔的世界中十分有名。他总是抓住了他的敌人落单之时。即使对手不是独自一人，他也能临场发挥。"},{"args_order":null,"call_locator":"0660d2efce1b3930fb3309b628acdd5a2920ee693ac8e5275bceb26dad17fb72","component":"tome","entry_revision_identity":"9437028f4ccaa3f85e8dfde8a042f31450bf13c7bdcb799f895c7fe9ee7bf80d","logical_entry_identity":"f23feb1ece1a0f2f47d461e01364fe400c795dd3d0afad2b7a4897321d5f1713","normalized_path":"mod-tome.lua","source":"<<<The precious seconds fly by, but as you feel your mind breaking and burning you see a strange figure appearing in front of you, it radiates of immense power.>>>\n<<<The strange, amorphous figure in front of you remains completely silent. With a gesture of one of its tendrils, the staff is ripped from your hands. A surge of energy goes through the room as it grips the staff. Then you remember the old myth of the Godslayers. This is none other than a ***Sher'Tul***#{italic}#, and it knows you have been colluding with a god. That alone tells you everything you need to know.>>>\n","source_tag":"_t","target":"<<<宝贵的几秒飞逝而过。就在你感觉心智即将崩溃、燃烧之际，一个散发着无穷威能的奇异身影出现在你面前。>>>\n<<<面前这个奇异而无定形的身影始终一言不发。它挥动一根触须，法杖便从你手中被夺走；当它握住法杖时，一股能量席卷了整个房间。你忽然想起关于弑神者的古老传说：这正是一位 ***夏·图尔***#{italic}#，而它知道你一直在与神明勾结。仅此一点，就足以说明一切。>>>\n"},{"args_order":null,"call_locator":"b8fcaaef46958aa1c7e4bc66cbd6fba8e7b8685e435c41323992f60abea9684e","component":"tome","entry_revision_identity":"943b37ba33b9d9eca930d3be685c8bc5f31188986be0315d8dc9e9ffe8a026ad","logical_entry_identity":"90b9506a373aa5c78e9c62fe6d729f3f91c02b0db7a9fe3e09da5bb2099663a7","normalized_path":"mod-tome.lua","source":"Hymn of Detection","source_tag":"talent name","target":"侦测圣诗"},{"args_order":null,"call_locator":"03ea2ff662baa28533d0e50fc26a4ef33a5f8120911935894bfbe5c81a43c9da","component":"tome","entry_revision_identity":"943c67d89eb21ed114857f99d5723d8bc77f42150e617035e32c495b98113d82","logical_entry_identity":"f7316c55b816e58fa63503b05c9b5c8c444ae3bf525dbaf71732a0a94cfdf70e","normalized_path":"mod-tome.lua","source":"cute little bunny","source_tag":"entity name","target":"可爱的小白兔"},{"args_order":null,"call_locator":"fe5747c904220ec5c5abea6e24d56c38b84596321b7f1bc3453394bf2fd30206","component":"tome","entry_revision_identity":"944041d2dd7f37eab28a39eb1085d8aa6c4069b640e46b7ec3f6c8b9f0be2ff7","logical_entry_identity":"e8898f1af5fb39119ba578f1ffd7487cecf643ca9ba24b3d5253aece331a696f","normalized_path":"mod-tome.lua","source":"#ORANGE#%s shrugs off %s '%s'!","source_tag":"logCombat","target":"#ORANGE#%s豁免了%s“%s”！"},{"args_order":null,"call_locator":"a7f77a62f2d08096163608325bf53537425464e6760558bead3ceb27560b00b8","component":"tome","entry_revision_identity":"94475aac60634c662b67ee7ceb3992497da66466f615e89bd964f4c2d0f9c062","logical_entry_identity":"1f244fc90d9b35fe152e9e58a990ec177e7d6e503017dc9546ad2d2b9613491d","normalized_path":"mod-tome.lua","source":"elm longbow of piercing arrows","source_tag":"entity name","target":"穿透的榆木长弓"},{"args_order":null,"call_locator":"aa1660aecd952a86406b441fe71e00ec2b0e5af603463bc3cc13d594f59a03c8","component":"tome","entry_revision_identity":"944eb5440fc61798adca4f05f22da3e5e049a3f1bea21f05093292151684fc96","logical_entry_identity":"1bc3278d34e98e24e80da22dc9739c4be4a944170573121bbf0657d4ff703527","normalized_path":"mod-tome.lua","source":"how to be a necromancer, part 4","source_tag":"_t","target":"怎样成为死灵法师　第四章"},{"args_order":null,"call_locator":"31026847ea8a951b33813006f8f7eab475f04c9c48dd9cd1f491dc3db0e29515","component":"tome","entry_revision_identity":"945432757facf0886599c339e91e599a5c486b27f107ac0a7ebf5adb7174d57a","logical_entry_identity":"9f1ce462a604b9c33af9cc9217e8501a86cfc0a4ecf477d9530f1a191f5395fc","normalized_path":"mod-tome.lua","source":"I have come to see the moonstone again. My younger brother Limmir understands a little of my obsession with it, yet the others do not care. I have tried to explain how it is of importance to Aeryn, but she simply asked if she could make a sword from it. Bah! Such stupidity from that grunt fighter.\n\nOur ancestors found their powers from the intense study of the stars, yet the people these days seem only to care about their applications in battle. I know our position with the orcs is grim, but we must not forget our roots in the celestial sphere! Only by sun, moons and stars do we find knowledge and power in life.\n\nAh well, I shall at least be able to study here in peace. The ring of invisibility I have crafted affords me cover from any orc patrols, and the caves around the moonstone are quiet enough. I have set up my telescope in the open air of the Valley of the Moon itself.\n\nLast night I spotted a red star in the early dawn. How very peculiar... Could this be a new celestial body to study?","source_tag":"_t","target":"我又一次来到这里来观赏那些美丽的月亮石。只有我的弟弟利米尔知道我对它们有多么痴迷，而其他人根本无法理解这样美好的事物。我曾经试着向艾琳女士介绍这些东西有多么重要，她那家伙居然跟我说“难道我能用它做一把剑吗？”呸！这个武夫真是四肢发达、头脑简单！\n\n我们的先祖潜心研究群星的力量才创造出了属于它们的魔法，然而现在的年轻人只知道整天研究它们怎么在战斗中使用，对真正纯粹的魔法研究毫无兴趣。我知道我们现在和兽人交战的局势十分紧张，但是可别忘了，我们一切能量的根基都来自苍穹无限的智慧！我们只有从太阳、月亮和群星中才能获得真正的智慧与力量。\n\n唉，总之，现在我至少可以在这里潜心研究魔法了。我最近研发的隐形戒指让我可以轻松绕过那些兽人巡逻队，而在月亮石一旁的山洞十分寂静宜人，非常适合我的研究活动。我已经在月亮山谷里找了一个好地方架起了我的望远镜，是时候享受美丽的夜空了。\n\n顺带一提，就在昨晚黎明尚未到来之时，我在夜空中发现了一颗闪耀着红光的星星。真奇怪……或许这颗新的天体很值得作为我下一步的研究对象？"},{"args_order":null,"call_locator":"f45ae378e8a5d3a229d8fd685c58b0e3e8511add1a537de1fdfb3b268e1451c3","component":"tome","entry_revision_identity":"945607f0967265dedb50f937fbee72cca221190ed756e71ed31862ff72ed6533","logical_entry_identity":"4492bc76dac50bea503ea953d095fb6c05f57e0436024f7878a1d5c3c3af7743","normalized_path":"mod-tome.lua","source":"huge granite battleaxe","source_tag":"_t","target":"巨大的花岗岩双手斧"},{"args_order":null,"call_locator":"35799802b186f4f06e82b6a2c5e04905737aae948cd26e5a40eff897613a8b83","component":"tome","entry_revision_identity":"94605b7cbfba5aee1160b2b1e52d37298ee7720a79726175e9769e1eda89ef14","logical_entry_identity":"e0a8326a5b3b8466ecf2817aadb1058dba50ce903546d58c5b06e94e8d455c7e","normalized_path":"mod-tome.lua","source":"@Source@ shoots!","source_tag":"_t","target":"@Source@射击！"},{"args_order":null,"call_locator":"ff1a8b64c52c3a19802e6860bc3b2a8be3f37425f495b981368e9af02b5fc6ff","component":"tome","entry_revision_identity":"9461a87563df40010a55b162577d476ded6bdb53461519913727a9f335ca7d7d","logical_entry_identity":"7a01049252603f750c2fa41c87d04ae205c2e1c78137ad583cfca0a2d5827b86","normalized_path":"mod-tome.lua","source":"survival","source_tag":"talent type","target":"生存"},{"args_order":null,"call_locator":"a6c84ab2553a37c1c9af20f249c55639abb9efb68c51e4db7ba340a57fa4791b","component":"tome","entry_revision_identity":"9463f6a92a9df9ec0bc17aa51c38e4d11428a9830caab0aa197610639db5fe13","logical_entry_identity":"d40603caf32f0703e4e62c5839a1398085c92a9f27318134399f1c1042be919d","normalized_path":"mod-tome.lua","source":"rocky mountain","source_tag":"entity name","target":"石山"},{"args_order":null,"call_locator":"801cde842ec001c6db691e4377346d4f30fc63b7a848513c74ae7fca905e0413","component":"tome","entry_revision_identity":"9466b9b447a42d2df2f9611d61ab2e3072661cc8bb947275db4e1e14255e2f2d","logical_entry_identity":"494203cf8ddd7ac7bdcbea6cd2d78f930df3cbdc6bb119b84cf858dca79983aa","normalized_path":"mod-tome.lua","source":"Master Summoner","source_tag":"talent name","target":"召唤精通"},{"args_order":null,"call_locator":"ee9207e2740c53ed7530de6f854b0664