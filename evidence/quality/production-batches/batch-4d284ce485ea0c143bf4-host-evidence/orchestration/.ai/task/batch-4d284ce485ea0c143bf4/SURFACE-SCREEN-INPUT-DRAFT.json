196a370592a09f6274e73ebff4d402639bc8237c013e3813c4847961a7b","normalized_path":"tome-orcs.lua","source":"You focus on managing your steamgun ammo for %d turns.\n\t\tWhile the effect lasts your attacks do not consume shots.","source_tag":"tformat","target":"你集中精力于蒸汽枪弹药 %d 回合。\n\t\t效果持续期间不消耗弹药。"},{"args_order":null,"call_locator":"3e78e55f3edbee07a0c648ad40e9d4d8b2a901cdb92eb1ad69ef10cc62875fea","component":"orcs","entry_revision_identity":"8073bbb08ff3c78dc7a89eaad4bbff219960f269803bf7a118b71d9b9d527c98","logical_entry_identity":"0686fe72ab8ec2eb999f45b05a8b487eb13b7a636e3f6092f1c7dee106ff00ee","normalized_path":"tome-orcs.lua","source":"Sun Paladins patrol","source_tag":"entity name","target":"太阳骑士巡逻队"},{"args_order":null,"call_locator":"f384e2a58b49b3db5c1ba055bc3b65ef35d874bfc10a8c13a6de2566db4deb61","component":"orcs","entry_revision_identity":"807d62704ef39829e0b3c28e74e643353932fe62526656ea7d4021bd42ad505a","logical_entry_identity":"a05ceb7b36de9a0e8dd73c89c8c907ff267cdf3fd74270655f3364984c1dddf9","normalized_path":"tome-orcs.lua","source":"Armament","source_tag":"_t","target":"武装"},{"args_order":null,"call_locator":"277580ca7a422787a1ee945e03a2120bafb7dde545d260a3ab0ce971e8c055a1","component":"orcs","entry_revision_identity":"8081ac630ca73a0da9422cef954cb6ae4b5063d9d625f77caa524069c1076aa3","logical_entry_identity":"b206ef5030746dfa87fba0bdf00d80b798a82bdb07d8835d71ad55df9bdf2c24","normalized_path":"tome-orcs.lua","source":"The static shield around #target# crumbles.","source_tag":"_t","target":"#target#周围的静电力场破碎了。"},{"args_order":null,"call_locator":"9347c86608bd8ca4632c68f0e492a4542f4fe27f73ae67ba7c3e508be7801c89","component":"orcs","entry_revision_identity":"8081fe5f4f0b5d6e1bc385b8b9e3ac54a386aa079e7df00046adddffaadc7fe3","logical_entry_identity":"74e77ba22bc39eaf73d02d79578efada6e9b13654081f76831d6a90d33b96935","normalized_path":"tome-orcs.lua","source":"You send a small steam-powered flying grapple to a target. The drone is homing so if the target moves it will follow.\n\t\tWhen it reaches its target it deploys grapples in all directions around it in radius 4.\n\t\tThe grapples latch onto any foes and pull them toward the target. If they are stopped by a creature (or the target) both them and the creature take %0.2f physical damage.\n\t\t","source_tag":"tformat","target":"向目标发射一枚小型蒸汽动力飞爪无人机。无人机会自动追踪，目标移动时会跟随。\n\t\t命中目标后，无人机向 4 码内的所有方向发射金属飞爪。\n\t\t飞爪会抓住范围内任何敌人，并将它们向目标拉扯。如果被其他生物（或目标本身）阻挡，两者均受到 %0.2f 物理伤害。\n\t\t"},{"args_order":null,"call_locator":"5772ab9eed2f315543a753502ac386ba06555ba7683369b29378a3ab395fee1f","component":"orcs","entry_revision_identity":"80844013d591c71fb6866550faa73a57d7c0f723b07f51ad669417a7bf018511","logical_entry_identity":"593ea74902c458b52ecb5baad2c594a60e77b3cffc652223a692f8b1ddb67e16","normalized_path":"tome-orcs.lua","source":"Crystallized Primal Root","source_tag":"entity name","target":"晶化原始之根"},{"args_order":null,"call_locator":"30673e98bf048d9dfd3831dfeca39a4a314cef983b9a2f8db30896bc66fd799c","component":"orcs","entry_revision_identity":"80924ded21cecec6c4f6a0fdd1f69d518a2ac96278940075b5ab75f6fb0d1208","logical_entry_identity":"1018435fd81b58667d1aa4558fb3f6658798665578ac488988b5bdca9be3a8b1","normalized_path":"tome-orcs.lua","source":"Nothing will ever reach you again.","source_tag":"_t","target":"任何事物都无法再碰触你。"},{"args_order":null,"call_locator":"793287b1c036e84af19119b099a303cc9be815c75378d8cf6e753ed3a0bc19e0","component":"orcs","entry_revision_identity":"809669f47871a187b4c0104514b03bd7db46a99aeed12a42d56d174b748e77c3","logical_entry_identity":"768c2385417a0634732411f5eef2ed7a412e311270ee7b086dedeb21066f036f","normalized_path":"tome-orcs.lua","source":"water","source_tag":"effect subtype","target":"水"},{"args_order":null,"call_locator":"21b6ad49b0833adabad1df8b6e8b7e4b3b8b6345275db2d49e77e32da8e64133","component":"orcs","entry_revision_identity":"809a38a211b34504cfa87c2be1243d759d88d0da7b88ec3a65fc343d6e3517f5","logical_entry_identity":"4b33aeda47e9f9b8e99aa2a9c4c93c71de458f350a242