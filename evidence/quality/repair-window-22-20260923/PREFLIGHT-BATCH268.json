y":"22fe15a9914858c50f4637046644cb117ab706f7c79382d8ea6affa3baf46eda","publication_commit":"d6bed73863e1ad5b82093549bb591e45eaf56a70","result_sha256":"4667907d41fb3dcca5f950486526a96bb8ddc63281f79324be6888665ce6a9fa","results_path":"evidence/production-review-v2-lite/batches/batch-35fcb3df1560de7c5b2d/results.jsonl"}},{"call_locator":"5e8fdfa9d4a246a90016576e4dc324e1ae8e583bb3e460e648ac3860d8889b0e","component":"tome","entry_revision_identity":"f894de79df6d2ecec361043978ae052e31f288ef0034c595ee979ae68db2af8d","fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","logical_entry_identity":"4b7844d14e1b427d5ea067359da20014c13af9f11fda630a94f03e1eae2b9054","normalized_path":"mod-tome.lua","proposed_successor_input":{"call_locator":"5e8fdfa9d4a246a90016576e4dc324e1ae8e583bb3e460e648ac3860d8889b0e","component":"tome","fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","logical_entry_identity":"4b7844d14e1b427d5ea067359da20014c13af9f11fda630a94f03e1eae2b9054","normalized_path":"mod-tome.lua","parent_entry_revision_identity":"f894de79df6d2ecec361043978ae052e31f288ef0034c595ee979ae68db2af8d","rules_version":"production-review-v2-lite-rules-v2","section":"mod-tome/data/talents/gifts/ooze.lua","source":"Your body is more like that of an ooze.\n\t\tWhen you take damage, you may split and create a Bloated Ooze nearby within your line of sight.\n\t\tThis ooze has as much health as twice the damage you took (up to a maximum of %d, based on your Mindpower and maximum life).\n\t\tThe chance to split equals the percent of your health lost times %0.2f.\n\t\tYou may have up to %d Bloated Oozes active at any time (limited by talent level and the summoning limit), and all damage you take will be split equally between you and them so long as this talent is active.\n\t\tBloated Oozes last for %d turns, are very resilient (%d%% all damage resistance to damage not coming through your shared link), and regenerate life quickly.\n\t\t%sThe chance to split increases with your Cunning.","source_tag":"tformat","target_preimage_sha256":"a9759fab11a68c059a6f41b4c6cf9e1824830c9e38d85e16a40f24b20e40f914","terminology_snapshot_sha256":"66da49fcce23e27b95027c5aa51dc41afc9211cbc227c05fd9cfa8413ec4d2aa"},"rules_version":"production-review-v2-lite-rules-v2","section":"mod-tome/data/talents/gifts/ooze.lua","source":"Your body is more like that of an ooze.\n\t\tWhen you take damage, you may split and create a Bloated Ooze nearby within your line of sight.\n\t\tThis ooze has as much health as twice the damage you took (up to a maximum of %d, based on your Mindpower and maximum life).\n\t\tThe chance to split equals the percent of your health lost times %0.2f.\n\t\tYou may have up to %d Bloated Oozes active at any time (limited by talent level and the summoning limit), and all damage you take will be split equally between you and them so long as this talent is active.\n\t\tBloated Oozes last for %d turns, are very resilient (%d%% all damage resistance to damage not coming through your shared link), and regenerate life quickly.\n\t\t%sThe chance to split increases with your Cunning.","source_tag":"tformat","target_preimage":"你的身体构造变的像软泥怪一样。\n\t\t当你受到攻击时，你有几率分裂出一个浮肿软泥怪，其生命值为你所承受的伤害值的两倍（最大 %d，基于你的精神强度和最大生命值）。\n\t\t分裂几率为你损失生命百分比的 %0.2f 倍。\n\t\t你同时最多只能拥有 %d 只浮肿软泥怪，你所承受的所有伤害会在你和浮肿软泥怪间均摊。\n\t\t每只浮肿软泥怪存在 %d 回合，对非均摊的伤害的抗性很高（%d%% 对全部伤害的抗性），同时生命回复快。\n\t\t%s几率受灵巧加成。","target_preimage_sha256":"a9759fab11a68c059a6f41b4c6cf9e1824830c9e38d85e16a40f24b20e40f914","terminology_snapshot_sha256":"66da49fcce23e27b95027c5aa51dc41afc9211cbc227c05fd9cfa8413ec4d2aa","winner_evidence":{"adjudications_path":"evidence/production-review-v2-lite/batches/batch-35fcb3df1560de7c5b2d/adjudications.jsonl","batch_id":"batch-35fcb3df1560de7c5b2d","evidence_commit":null,"evidence_path":null,"manifest_path":"evidence/production-review-v2-lite/batches/batch-35fcb3df1560de7c5b2d/manifest.json","observation_identity":"23d6ef7715410e8a5aace09a169270d0f89951bbd6d10215267240