{"batch_id":"batch-6b8acfddd3cc0c11f471","catalog_id":"e3b869612116e4b4c4f837e0f0a35017d85f9793fdf80a1109226edf075df753","catalog_manifest_sha256":"80475c4abe48a6c209007d6436e0aacb5c37e58bca5f67448019141f87b55c20","evidence_commit":"b686e1f33b9fbb73fc4e965771b8c01db7645a78","items":[{"call_locator":"5590a1800a8acd923ec59a094b7185be480440588fbe0f722c9e1fd46525fa0a","component":"tome","entry_revision_identity":"ef7d5a43a10dc8eae43e1f4e8f15d7ca626123291c6d722daf5395cf2080324e","fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","logical_entry_identity":"1d1de9379cb014e6b149413439712e5375a34a8726a07fb6f700b3ebb96e2017","normalized_path":"mod-tome.lua","proposed_successor_input":{"call_locator":"5590a1800a8acd923ec59a094b7185be480440588fbe0f722c9e1fd46525fa0a","component":"tome","fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","logical_entry_identity":"1d1de9379cb014e6b149413439712e5375a34a8726a07fb6f700b3ebb96e2017","normalized_path":"mod-tome.lua","parent_entry_revision_identity":"ef7d5a43a10dc8eae43e1f4e8f15d7ca626123291c6d722daf5395cf2080324e","rules_version":"production-review-v2-lite-rules-v2","section":"mod-tome/data/chats/jewelry-store.lua","source":"#LIGHT_GREEN#*He quickly looks at the tome and looks amazed.*#WHITE# This is an amazing find! Truly amazing!\nWith this knowledge I could create potent amulets. However, it requires a special place of power to craft such items.\nThere are rumours about a site of power in the southern mountains. Old legends tell about a place where a part of the Wintertide Moon melted when it got too close to the Sun and fell from the sky.\nA lake formed in the crater of the crash. The water of this lake, soaked in intense Moonlight for eons, should be sufficient to forge powerful artifacts!\nGo to the lake and then summon me with this scroll. I will retire to study the tome, awaiting your summon.","source_tag":"_t","target_preimage_sha256":"553eff702a88b425f9408de7b4316194553f333ec5e588dc0f53897abe1d9c31","terminology_snapshot_sha256":"66da49fcce23e27b95027c5aa51dc41afc9211cbc227c05fd9cfa8413ec4d2aa"},"rules_version":"production-review-v2-lite-rules-v2","section":"mod-tome/data/chats/jewelry-store.lua","source":"#LIGHT_GREEN#*He quickly looks at the tome and looks amazed.*#WHITE# This is an amazing find! Truly amazing!\nWith this knowledge I could create potent amulets. However, it requires a special place of power to craft such items.\nThere are rumours about a site of power in the southern mountains. Old legends tell about a place where a part of the Wintertide Moon melted when it got too close to the Sun and fell from the sky.\nA lake formed in the crater of the crash. The water of this lake, soaked in intense Moonlight for eons, should be sufficient to forge powerful artifacts!\nGo to the lake and then summon me with this scroll. I will retire to study the tome, awaiting your summon.","source_tag":"_t","target_preimage":"#LIGHT_GREEN#*他快速浏览了那本手册，露出了惊讶的表情。*#WHITE# 这真是神奇的发现！太神奇了！\n有了这些知识我就能制造更强大的项链了。不过这需要一个特殊的地方来完成制作过程。\n传言在南部山脉之中有个地方充满能量。有个古老的传说，当冬月与太阳距离太接近的时候它的一部分从空中掉落了下来并融入了大地，使那个地方充满能量。\n在坠落的地方形成了一个湖泊，湖水吸收了万年月光的力量，应该足以锻造出强大的神器。\n去找到那个湖泊，然后使用这个卷轴将我召唤过去，从现在开始我要潜心研修你的这本手册，等待你召唤我的那一刻。","target_preimage_sha256":"553eff702a88b425f9408de7b4316194553f333ec5e588dc0f53897abe1d9c31","terminology_snapshot_sha256":"66da49fcce23e27b95027c5aa51dc41afc9211cbc227c05fd9cfa8413ec4d2aa","winner_evidence":{"adjudications_path":"evidence/production-review-v2-lite/batches/batch-6b8acfddd3cc0c11f471/adjudications.jsonl","batch_id":"batch-6b8acfddd3cc0c11f471","evidence_commit":null,"evidence_path":null,"manifest_path":"evidence/production-review-v2-lite/batches/batch-6b8acfddd3cc0c11f471/manifest.json","observation_identity":"c0737bb144cfca5ba434bfac722e842ba0f83c6b4291aeb2c6501265c9535d2b","publication_commit":"b686e1f33b9fbb73fc4e965771b8c01db7645a78","result_sha256":"d92f790546a3e0580c7ae48dc5e75f950193ca6ab7bcfdb108465a06a03252e6","results_path":"evidence/produc