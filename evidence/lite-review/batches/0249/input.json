  {
   "id": "e5a354d4d872",
   "unit_id": "e5a354d4d872fbe391bdbd1ed3e9b830e1d212f43ab60096190bdedda905e92b",
   "revision_key": "34f61cdcd6425c3af000965c32282c4fbdf365e6d9bacf552514b1fd51664031",
   "translation_file": "mod-tome.lua",
