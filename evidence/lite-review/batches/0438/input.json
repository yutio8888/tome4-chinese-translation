  {
   "id": "4b163d5a87e5",
   "unit_id": "4b163d5a87e5052ad9f40b6480d5a19e88ce091f27ab451d2bc60e725f7cea71",
   "revision_key": "615c0d9406ff04a1f9531fd838214744a3f8d78591e30dddf783110e811afa80",
   "translation_file": "mod-tome.lua",
   "translation_line": 30717,
   "section": "mod-tome/data/talents/techniques/skirmisher-slings.lua",
   "source_tag": "tformat",
   "args_order": null,
   "source": "Fire off a quick sling bullet for %d%% damage at double your normal attack speed, as well as increasing your attack speed by %d%% for 5 turns.\n\t\tEach time you move, the cooldown of this talent is reduced by 1.",
   "target": "发射一枚快速的弹丸，造成 %d%% 伤害，攻击速度是你普通攻击的两倍。增加你攻击速度 %d%%， 持续5回合。\n\t\t移动将会降低技能冷却 1 回合。",
   "source_file": "game/modules/tome/data/talents/techniques/skirmisher-slings.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    90
   ]
  },
  {
   "id": "e060f09382fd",
   "unit_id": "e060f09382fd2f472aa6cd061d6a62995f5108c12cff1fb2657fb479a1eada1e",
   "revision_key": "24d7a3b8ed439ffabdeea18fa21e003ceb0c682ad54867e4f6a4f6543fcdb136",
   "translation_file": "mod-tome.lua",
   "translation_line": 30721,
   "section": "mod-tome/data/talents/techniques/skirmisher-slings.lua",
   "source_tag": "tformat",
   "args_order": null,
   "source": "Take aim and unload up to %d shots for %d%% weapon damage each against random enemies inside a cone. Each enemy can only be hit once (twice for talent level 3 and higher). Using Swift Shot lowers the cooldown by 1.",
   "target": "最多发射 %d 颗弹丸，随机攻击锥形范围内的敌人，每颗造成 %d%% 武器伤害。每个敌人只能被攻击 1 次（当技能等级在 3 级或更高时为 2 次）。使用快速射击技能会降低冷却时间 1 回合。",
   "source_file": "game/modules/tome/data/talents/techniques/skirmisher-slings.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    170
   ]
  },
