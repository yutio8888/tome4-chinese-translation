   "translation_file": "engine.lua",
   "translation_line": 956,
   "section": "engine/engine/dialogs/VideoOptions.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Activates antialiased texts.\nTexts will look nicer but it can be slower on some computers.\n\n#LIGHT_RED#You must restart the game for it to take effect.#WHITE#",
   "target": "启用文字抗锯齿。\n启用该效果会使文字看上去更美观，但游戏在部分电脑上运行速度可能会变慢。\n\n#LIGHT_RED#必须重启游戏才能使更改生效。#WHITE#",
   "source_file": "game/engines/default/engine/engine/dialogs/VideoOptions.lua @ 624a67329fe2 (pinned core)",
   "source_lines": []
  },
  {
