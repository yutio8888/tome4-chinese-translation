   "translation_line": 2814,
   "section": "tome-cults/data/talents/demented/doom.lua",
   "source_tag": "tformat",
   "args_order": null,
   "source": "Utter a prophecy of the impending treachery of your target. For the next 6 turns, they will have a %d%% each turn to waste their turn attempting to attack an adjacent creature for 10%% weapon damage, or even themself if no creature is present.\n\t\tA target can only be affected by a single prophecy at a time.",
