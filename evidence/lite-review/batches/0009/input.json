  {
   "id": "0ac763dca38b",
   "unit_id": "0ac763dca38b1a9bed285d361e2e8960ba357f0fd3fdf21c056d533b1ea25e8c",
   "revision_key": "5f0706988d022888a99b9b22f6e9dcccf6338f2ab6dc6e72018cfbf3b4a4e294",
   "translation_file": "engine.lua",
   "translation_line": 1065,
   "section": "engine/engine/dialogs/microtxn/MTXMain.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Online Store",
   "target": "在线商城",
   "source_file": "game/engines/default/engine/engine/dialogs/microtxn/MTXMain.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [],
