   "section": "engine/engine/dialogs/microtxn/ShowPurchasable.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "For every purchase of #{italic}##GREY#%s#LAST##{normal}# you gain a permanent additional vault slot.\n#GOLD##{italic}#Because why not!#{normal}#",
   "target": "每次购买 #{italic}##GREY#%s#LAST##{normal}#，你都会永久获得一个额外的在线仓库格。\n#GOLD##{italic}#为什么不呢！#{normal}#",
