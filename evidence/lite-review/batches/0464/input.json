   ]
  },
  {
   "id": "ae94864707e6",
   "unit_id": "ae94864707e6de69cc8b5b30fdf9d2fcd881a7fc43e5a504d8efe3dccae06121",
   "revision_key": "0109db3ce7c01964fd4c3a47b3aa4841f56bcd252a80417b94e6da1517db9b8f",
   "translation_file": "mod-tome.lua",
   "translation_line": 8314,
   "section": "mod-tome/data/general/npcs/horror.lua",
   "source_tag": "logSeen",
   "args_order": null,
   "source": "#AQUAMARINE#With Grgglck's death its tentacle also falls lifeless on the ground!",
   "target": "#AQUAMARINE#随着格尔格勒克的死去，它的那些触手也毫无生机地倒在了地上！",
   "source_file": "game/modules/tome/data/general/npcs/horror.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    1047
   ]
  },
  {
   "id": "8e033ac5a8ca",
   "unit_id": "8e033ac5a8ca3a88f5fd79bbb6ca3fa51de3887bfd0caebab8b6ba9f0701dd54",
   "revision_key": "4ab28870dcd98518df5a6f1af04dbf0b80fc95787935c6c47b2b833da8c4436b",
   "translation_file": "mod-tome.lua",
   "translation_line": 26450,
   "section": "mod-tome/data/talents/misc/npcs.lua",
   "source_tag": "tformat",
   "args_order": null,
   "source": "Grapples the target and inflicts %0.2f physical damage. If the target is already grappled, the target will be maimed as well, reducing damage by %d and global speed by 30%% for %d turns.\n\t\tThe grapple effects will be based off your grapple talent, if you have it, and the damage will scale with your Physical Power.",
   "target": "抓取目标并造成 %0.2f 物理伤害。如果目标已被抓取，目标还会被断筋：造成的伤害减少 %d ，全局速度降低 30%% ，持续 %d 回合。\n\t\t抓取效果取决于你已有的抓取技能，伤害受物理强度加成。",
   "source_file": "game/modules/tome/data/talents/misc/npcs.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    2422
   ]
  },
  {
   "id": "ed097c3998f8",
   "unit_id": "ed097c3998f870c91d400097c619c84b5ce2c735895b44fbf3ffd992c9e33ac5",
   "revision_key": "6f299755c150f4323f8dd7f3b6b3fd1290e0b5b294226f40ebc2e7a98b54a8db",
   "translation_file": "mod-tome.lua",
   "translation_line": 26524,
   "section": "mod-tome/data/talents/misc/npcs.lua",
   "source_tag": "tformat",
   "args_order": null,
   "source": "You hit your target, doing %d%% damage. If your attack connects, the target is crippled for %d turns, losing %d%% melee, spellcasting and mind speed.\n\t\tThe chance to land the status improves with Accuracy, and the status power improves with Cunning.",
   "target": "你打击你的目标，造成 %d%% 伤害。如果你击中了目标，目标会被致残 %d 回合，降低 %d%% 近战、施法和精神速度。\n\t\t附加异常状态的几率受命中值加成，异常状态效果受灵巧值加成。",
   "source_file": "game/modules/tome/data/talents/misc/npcs.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    3024
   ]
  },
  {
   "id": "3ab8a621f62d",
   "unit_id": "3ab8a621f62db2324af55a866e61c5fb84e0adf7d771101b6681476c627464f5",
   "revision_key": "7c959a4dcd292f9b1ff0e9198a85ca29f71e3903ee0f2c918cb7bdf212316c61",
   "translation_file": "mod-tome.lua",
   "translation_line": 30236,
   "section": "mod-tome/data/talents/techniques/combat-training.lua",
   "source_tag": "tformat",
   "args_order": null,
   "source": "You learn to maintain your agility and manage your combat posture while wearing robes or light armour.  When wearing armour no heavier than leather in your main body slot, you gain %d Defense, %d%% Armour hardiness, and %d%% reduced Fatigue.\n\t\tIn addition, when you step adjacent to a (visible) enemy, you use the juxtaposition to increase your total Defense by %d for 2 turns.\n\t\tThe Defense bonus scales with your Dexterity.",
   "target": "你学会在身着布甲或轻甲时保持敏捷、调整战斗姿态。当身体栏所穿护甲不重于皮甲时，你获得 %d 闪避， %d%% 护甲强度，减少 %d%% 疲劳值。\n\t\t此外，每当你进入和（可见的）敌人相邻的位置时，你获得 %d 闪避，持续 2 回合。\n\t\t闪避受敏捷加成。",
   "source_file": "game/modules/tome/data/talents/techniques/combat-training.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    154
   ]
  },
