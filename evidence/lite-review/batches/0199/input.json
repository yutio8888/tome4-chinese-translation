   "source_tag": "_t",
   "args_order": null,
   "source": "A tome of lost knowledge. Touching it you feel both sick and yet strangely at peace.",
   "target": "一本有关逝去的古老知识的书。触摸它让你同时感到不适和不知名的安心感。",
   "source_file": "/workspace/tome4-dlcs/cults/tome-cults/data/zones/ft-horrors/objects.lua (unpinned public DLC checkout)",
   "source_lines": [
