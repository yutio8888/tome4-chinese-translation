   "source_tag": "_t",
   "args_order": null,
   "source": "Welcome to Tales of Maj'Eyal - #CRIMSON#Ashes of Urh'Rok",
   "target": "欢迎来到马基·埃亚尔的传说 - #CRIMSON#乌鲁洛克之烬",
   "source_file": "/workspace/tome4-dlcs/ashes-urhrok/tome-ashes-urhrok/overload/data/texts/intro-ashes-urhrok.lua (unpinned public DLC checkout)",
