    "B": false
   }
  },
  {
   "id": "da5fab986a7b",
   "unit_id": "da5fab986a7bb02bd754023e9ff1696b8235332207d4cc4885149c04aa893825",
   "revision_key": "8d7d7622c03bc9e086c4989288059552b1b01b90ae1926e7dd962b97541a79df",
   "translation_file": "mod-tome.lua",
   "translation_line": 5149,
   "section": "mod-tome/data/chats/gates-of-morning-main.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Ah! This is wonderful! Finally a ray of hope amidst the darkness. I will assign my best troops to this. Thank you, @playername@ - take this as a token of gratitude.",
   "target": "太好了！一线希望的曙光终于穿过了黑暗。我会派我最好的军队去那里。多谢你了，@playername@——请收下这份谢礼。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-main.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    242
   ],
   "previously_reviewed": {
