 "entries": [
  {
   "id": "0efdb07b23bd",
   "unit_id": "0efdb07b23bd44b2ba8f61351595a052ffb8f8694ff18997a81fa264b2106da6",
   "revision_key": "8704d51701e5e0ba42dd555f3730a8224bccde4fd2717b1d741107eaffe3fcd4",
   "translation_file": "mod-tome.lua",
   "translation_line": 4993,
   "section": "mod-tome/data/chats/elisa-shop.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Wait, @playername@, you seem to be quite the adventurer. Maybe we can help one another.\nYou see, I #{bold}#LOOOVVVEEEE#{normal}# learning new lore and finding old artifacts of power, but I am not exactly an adventurer and I would surely get killed out there.\nSo take this orb (#LIGHT_GREEN#*she gives you an orb of scrying*#WHITE#). You can use it to talk to me from anywhere in the world! This way you can show me your new shiny findings!\nI get to see many interesting things, and you get to know what your items do. We both win! Isn't it sweet?\nOh yes, the orb will also identify mundane items for you, as long as you carry it.",
   "target": "等等，@playername@，你看起来是个相当了不起的冒险家。也许我们能互相帮助。\n你看，我#{bold}#超——喜欢#{normal}#学习新的传说知识、搜寻古老强大的神器，但我自己可算不上什么冒险家，到外头去肯定会送命的。\n所以拿着这颗水晶球吧（#LIGHT_GREEN#*她递给你一颗鉴定水晶球*#WHITE#）。你可以在世界上的任何地方用它与我通话！这样你就能随时向我展示你新找到的闪亮宝贝了！\n我能见识到许多有趣的事物，而你也能弄清楚物品的用途。我们双赢！这不是两全其美吗？\n而且，只要你随身携带，这颗水晶球还会为你自动鉴定普通物品。",
   "source_file": "game/modules/tome/data/chats/elisa-shop.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    65
   ],
   "previously_reviewed": {
