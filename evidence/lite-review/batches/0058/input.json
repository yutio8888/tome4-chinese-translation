  {
   "id": "d2b33251f6bf",
   "unit_id": "d2b33251f6bf90c9d9bbfd9e488dc7e21ea7f54494c7096e2f7b84eb5cee8139",
   "revision_key": "b981ba85894e0d85b65224ec340d990675e3fe2ef4ce4b7589b7bfee32bc017d",
   "translation_file": "mod-tome.lua",
   "translation_line": 5075,
   "section": "mod-tome/data/chats/gates-of-morning-main.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Well, actually...",
   "target": "呃……事实上……",
