   }
  },
  {
   "id": "47d60bde6919",
   "unit_id": "47d60bde6919e9c373dda532c371529226ead39c65aa4dd40dd399ea0a02e04f",
   "revision_key": "c918c1f4dcded35ee2a0273f84e1c80d8be71561c69a3f78f4d35e49b0111f4b",
   "translation_file": "mod-tome.lua",
   "translation_line": 5185,
   "section": "mod-tome/data/chats/golbug-explains.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "The Orc Pride obeys a master? I see... 'pride' indeed!",
