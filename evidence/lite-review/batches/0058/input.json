   "section": "mod-tome/data/chats/gates-of-morning-main.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Thanks, my lady. I have not been able to find all of the orbs of command in my travels; could you have some of your men search for me?",
   "target": "谢谢，女士。我没能找到所有的指令水晶球；请问你可以让你们的人来帮我寻找一下吗？",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-main.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    79
   ],
   "previously_reviewed": {
