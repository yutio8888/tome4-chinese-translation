  {
   "id": "5d53f56c85e9",
   "unit_id": "5d53f56c85e9f6eae50cb4b314fe9276c456d2ffd09df448f129d5a2604420b2",
   "revision_key": "d6be4ce8ff015b5fcdfcb6f715d7e359abbf31c99d48468e9f4b7545e06aa5f7",
   "translation_file": "mod-tome.lua",
   "translation_line": 5161,
   "section": "mod-tome/data/chats/gates-of-morning-welcome.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Maj'Eyal! For many years have we tried to contact your people. We always failed.\nIn any event, what is your purpose here?",
   "target": "马基·埃亚尔！多年来我们一直尝试与你们的人民取得联系，但都失败了。\n不管怎样，你来这里有何目的？",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-welcome.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    31
   ],
   "previously_reviewed": {
