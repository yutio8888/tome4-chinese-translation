  {
   "id": "11bcf6f131bf",
   "unit_id": "11bcf6f131bf2d23600abb602240a985fff48ab988a465b9317d94b60d64c14b",
   "revision_key": "94753003bdf88b80b714511f541578af50f60ad1dc25ff25e6951c26e9131735",
   "translation_file": "mod-tome.lua",
   "translation_line": 5061,
   "section": "mod-tome/data/chats/gates-of-morning-main.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "@playername@! We thought you had died in the portal explosion. I am glad we were wrong. You saved the Sunwall.\nThe news about the staff is troubling. Ah well, please at least take time to rest for a while.",
   "target": "@playername@！我们以为你在传送门爆炸的时候死了，幸好我们想错了，你拯救了太阳堡垒。\n有关法杖的消息令人担忧。唉，至少请你抽空休息一会儿吧。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-main.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    35
   ],
   "previously_reviewed": {
    "A": false,
    "B": false
   }
  },
  {
   "id": "1a2856b15bf1",
   "unit_id": "1a2856b15bf1b48b92a401bb7189e65f5393e103e210fb20d1c999fe33e0efdc",
   "revision_key": "3258d5df5fd166af0371a30c218c2da05b4424054be6bfebf1d6dda35ec8c7ce",
   "translation_file": "mod-tome.lua",
   "translation_line": 5064,
   "section": "mod-tome/data/chats/gates-of-morning-main.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "I shall, thank you, my lady.",
   "target": "我会的，谢谢你，我的女士。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-main.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    38
   ],
   "previously_reviewed": {
