  {
   "id": "6db5cdca8076",
   "unit_id": "6db5cdca80765524c9bd59ebb9994af62649443de256c8a85b4708687b10fccd",
   "revision_key": "767b8ea4afcbdb13957d2047d6766c7683879d9161ee71e0909eff608e46b404",
   "translation_file": "mod-tome.lua",
