   }
  },
  {
   "id": "f002e5894f0d",
   "unit_id": "f002e5894f0d48d89c05be5febb4ccd2ab45c15117546385de6979fc703c3963",
   "revision_key": "4a022dc3283d32ce88bb9e1f4ede15690c21c36f93f6b3ac9008c45ca9c778ee",
   "translation_file": "mod-tome.lua",
   "translation_line": 5170,
   "section": "mod-tome/data/chats/gates-of-morning-welcome.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Orcs! Ah! Well then this is your lucky day. This whole continent is swarming with Orcs. They have united as the Orc Pride and, according to rumour, their masters are powerful.\nThey roam the lands freely, ever assaulting us.\n@playername@, you have helped one of ours. I grant you access to the Gates of Morning and name you friend of the Sunwall.",
   "target": "兽人！啊！那今天可真是你的幸运日。整片大陆到处都是兽人。他们联合组成了兽人部落，据传言，他们背后的主人十分强大。\n他们在这片土地上肆意游荡，不断袭击我们。\n@playername@，你帮助了我们的一位同胞。我准许你进入晨曦之门，并封你为太阳堡垒之友。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-welcome.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    48
   ],
   "previously_reviewed": {
    "A": false,
    "B": false
   }
  },
  {
   "id": "6cda588b7d65",
   "unit_id": "6cda588b7d65a57aa324c9edb68c5de2ffff02441b257c550f892bd321dd9fe8",
   "revision_key": "ff69ab4510df6356a72ace320eba04e70ccb021e5a8a56ba275c31e5023c6bc0",
   "translation_file": "mod-tome.lua",
   "translation_line": 5175,
   "section": "mod-tome/data/chats/gates-of-morning-welcome.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Thank you, my lady.",
   "target": "谢谢您，女士。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-welcome.lua @ 624a67329fe2 (pinned core)",
