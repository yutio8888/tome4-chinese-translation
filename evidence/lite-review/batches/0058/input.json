    "B": false
   }
  },
  {
   "id": "b24e01a9ac02",
   "unit_id": "b24e01a9ac02249cfe72c3039c5b53dd357b50a225f4fa1a2af8ed3abd0bc5b8",
   "revision_key": "29219450938947eaacf6b9ac6240fa9f71b41628442e7254cbc02f34d48f5ea7",
   "translation_file": "mod-tome.lua",
   "translation_line": 5164,
   "section": "mod-tome/data/chats/gates-of-morning-welcome.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "It seems that I am stranded in these unfamiliar lands. #LIGHT_GREEN#*Tell her about your hunt for orcs and your encounter with Fillarel.*#WHITE#",
   "target": "我似乎被困在了这片陌生的土地上。#LIGHT_GREEN#*向她讲述你追杀兽人并遭遇菲拉瑞尔的经历。*#WHITE#",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-welcome.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    34
   ],
   "previously_reviewed": {
