   }
  },
  {
   "id": "2280e1f1324f",
   "unit_id": "2280e1f1324fb1bd3f94cc73873dbc66d9c687ded7d38011e5c7cccd4b574fff",
   "revision_key": "a854adeef75de29e981a1efad3f1907472106b1068988daf338d778171b125f5",
   "translation_file": "mod-tome.lua",
   "translation_line": 5165,
   "section": "mod-tome/data/chats/gates-of-morning-welcome.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Sun Paladins? What do you mean? We know of no such thing where I come from.",
   "target": "太阳骑士？你是什么意思？在我来的地方，我们从没听说过这种存在。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-welcome.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    35
   ],
   "previously_reviewed": {
    "A": false,
    "B": false
   }
  },
  {
   "id": "ef0e1dd259f7",
   "unit_id": "ef0e1dd259f70be61b3bdec16e3d3bc421c765ebf767ec0f9ae6166255930a29",
   "revision_key": "cc51976f46710b7f9ab8796e3dcf6605a0973be57b738009a944dbb0a3e44dbc",
   "translation_file": "mod-tome.lua",
   "translation_line": 5166,
   "section": "mod-tome/data/chats/gates-of-morning-welcome.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "We are the mighty warriors of the Sunwall, channeling the power of the Sun and merging it with martial training.\nFor hundreds of years, we stood between the Orc Pride and the free people. Our numbers are diminishing, but we will stand firm until our last breath.",
   "target": "我们是太阳堡垒的强大战士，引导太阳之力并将其融入武技训练之中。\n数百年来，我们始终屹立在兽人部落与自由人民之间。我们的人数正在不断减少，但我们将坚守到底，直至咽下最后一口气。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-welcome.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    40
   ],
   "previously_reviewed": {
    "A": false,
    "B": false
   }
  },
  {
   "id": "3df19965de67",
   "unit_id": "3df19965de6783c22b9599bb7d52f8453ce081e3b676e691f17b3bc44588f3e7",
   "revision_key": "8d779354cbc97dd13b6d2c9c5b0f0191bb6dbf41aefa2cbc5101c7377b1f05f5",
   "translation_file": "mod-tome.lua",
   "translation_line": 5169,
   "section": "mod-tome/data/chats/gates-of-morning-welcome.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "You have a noble spirit, my lady.",
   "target": "女士，您的精神令人钦佩。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-welcome.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    43
   ],
   "previously_reviewed": {
