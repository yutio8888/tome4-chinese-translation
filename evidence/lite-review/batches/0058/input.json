  },
  {
   "id": "36b8645043a6",
   "unit_id": "36b8645043a6dbed00ea150502bf67cb5bafda3d5686d7406f9d722c36cffef6",
   "revision_key": "fca996a7e0e42f7473d37988fecada0be571e08a0e5668dcbfaa08a5f5f62946",
   "translation_file": "mod-tome.lua",
   "translation_line": 5139,
   "section": "mod-tome/data/chats/gates-of-morning-main.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "I have heard about that; good men lost their lives for this. I hope it was worth it.",
