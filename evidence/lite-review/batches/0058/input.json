   }
  },
  {
   "id": "edffade387d5",
   "unit_id": "edffade387d518b0406e795a445f5e054e21b6f5fa1a05c3d194fd879910c11d",
   "revision_key": "f2533ecb58259f175d2e121b59c8dce7480672d75e7af7b8544a96c9592ab3d2",
   "translation_file": "mod-tome.lua",
   "translation_line": 5159,
   "section": "mod-tome/data/chats/gates-of-morning-welcome.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "My lady, I am indeed a stranger in these lands. I come from the west, from Maj'Eyal.",
   "target": "女士，在这片土地上我确实是个陌生人。我来自西方，来自马基·埃亚尔。",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-welcome.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    24
   ],
