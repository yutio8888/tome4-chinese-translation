  {
   "id": "bc1a2e7eec6b",
   "unit_id": "bc1a2e7eec6bd726754fdb6520c698f124b6dc0d300ec881c3634d38688f0912",
   "revision_key": "01e916903de21b0483a85d788d08ebb213d716969ffa4f6eaa4d6d447a4fd3d8",
   "translation_file": "mod-tome.lua",
