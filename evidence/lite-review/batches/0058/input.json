  {
   "id": "3d94c3f2d223",
   "unit_id": "3d94c3f2d223af9d5b23fa41436000db94fba94c3e085c062685c72235ce81cb",
   "revision_key": "75ab7bda9ad536787ef33f020a329ca792421a05bce9b86e7567fd64f12119a5",
   "translation_file": "mod-tome.lua",
   "translation_line": 5180,
   "section": "mod-tome/data/chats/golbug-explains.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "#VIOLET#*As you open the door you notice a huge orc in the distance, covered in both flames and ice.*#LAST#\n@playerdescriptor.race@! You should never have come! Your doom awaits!\nThe Orc Pride will never yield to anybody! They have their precious and there is nothing you can do.",
   "target": "#VIOLET#*当你打开门，你注意到远处一个巨大的兽人，周身同时被烈焰与寒冰笼罩。*#LAST#\n@playerdescriptor.race@！你根本不该来这里！你的死期到了！\n兽人部落绝不会向任何人屈服！他们已经拿到了至宝，你什么也做不了。",
   "source_file": "game/modules/tome/data/chats/golbug-explains.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    21
   ],
   "previously_reviewed": {
