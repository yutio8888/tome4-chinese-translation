  {
   "id": "13a8b942a86a",
   "unit_id": "13a8b942a86ad61664794a474995498d1255b3bd1ea179ec222ef7bcc98cab9f",
   "revision_key": "c6ff1e51fe0fa2a772da9aa33e865a979c3774f04a3190ea88456c55dce20a0d",
   "translation_file": "mod-tome.lua",
   "translation_line": 5110,
   "section": "mod-tome/data/chats/gates-of-morning-main.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Ah yes, my men have found that in Gorbat Pride. Here: ",
   "target": "啊，是的，我们的人在加伯特部落找到了这个水晶球。给你：",
   "source_file": "game/modules/tome/data/chats/gates-of-morning-main.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    164
   ],
   "previously_reviewed": {
