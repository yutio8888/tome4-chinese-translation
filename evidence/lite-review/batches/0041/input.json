   "translation_line": 3087,
   "section": "mod-tome/data/birth/classes/rogue.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "I will not hide and I will not sneak - come dance with my blades and we'll see who's weak. Snapping bone and cracking skull, it's the sounds of battle that make life full!",
   "target": "我不会隐藏也不潜行，与我的双刀起舞看看谁才是最终的强者，撕碎骨头敲碎头颅，战斗的声响让生活丰富多彩！",
   "source_file": "game/modules/tome/data/birth/classes/rogue.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
