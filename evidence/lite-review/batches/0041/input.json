   "translation_line": 3050,
   "section": "mod-tome/data/birth/classes/psionic.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "A thought can inspire; a thought can kill. After centuries of oppression, years of imprisonment, a thought shall break us free and vengeance will strike from our darkest dreams.",
   "target": "思想可以鼓舞人，思想也能杀人。历经数个世纪的压迫、数年的囚禁，一个念头终将使我们挣脱束缚，而复仇将从我们最黑暗的梦境中降临。",
   "source_file": "game/modules/tome/data/birth/classes/psionic.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    48
   ],
   "previously_reviewed": {
