   "translation_line": 3061,
   "section": "mod-tome/data/birth/classes/psionic.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "They wield this knowledge to both create and destroy, to invade the minds of others, and to manipulate the dreams of those around them.",
   "target": "他们依靠此理论进行创造和毁灭，侵入他人的思维并操纵他人的梦境。",
   "source_file": "game/modules/tome/data/birth/classes/psionic.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    142
   ],
