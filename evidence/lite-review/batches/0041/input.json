   "translation_file": "mod-tome.lua",
   "translation_line": 3081,
   "section": "mod-tome/data/birth/classes/rogue.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Their use of magic is innate and not really studied; as such they do not naturally regenerate mana and must use external means of recharging.",
