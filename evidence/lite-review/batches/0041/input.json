   "translation_line": 3060,
   "section": "mod-tome/data/birth/classes/psionic.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "The Solipsist believes that reality is malleable and nothing more than the collective vision of those that experience it.",
   "target": "织梦者们相信现实是可以塑造的，它不过是体验它的人们集体想象的产物。",
   "source_file": "game/modules/tome/data/birth/classes/psionic.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    141
   ],
   "previously_reviewed": {
