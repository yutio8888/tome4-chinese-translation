  {
   "id": "0d9a3a48abf8",
   "unit_id": "0d9a3a48abf89deacdb994fcec5100dcb214eba4f3727622d78c282cbf2acecd",
   "revision_key": "52e7fc59a7067dfb29caf808948a8e5c48ccdd8af8b8698637df6fa9312c94c3",
   "translation_file": "mod-tome.lua",
   "translation_line": 6522,
   "section": "mod-tome/data/chats/undead-start-kill.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "But, but, you were my... you...\nYou need me! What do you think you will do on the surface? Everything you will meet will try to destroy you.\nYou are strong but you cannot resist them all!",
   "target": "但……但……你是我的……你……\n你还需要我！你以为自己到了外面能做什么？你遇到的一切都会试图摧毁你。\n你虽然很强，但是你不可能对抗所有人！",
   "source_file": "game/modules/tome/data/chats/undead-start-kill.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    29
   ],
   "previously_reviewed": {
    "A": false,
    "B": false
   }
  },
  {
   "id": "d721d473c7cf",
   "unit_id": "d721d473c7cfe55102b8e30f5796b0b42edaea1e05ce15f8cc730748e9f75e8c",
   "revision_key": "33b08cc5df5adf8631d81ae4d49bb3cc4d93b7800a02e2dd0e7a9c83d0d884ef",
   "translation_file": "mod-tome.lua",
   "translation_line": 6527,
   "section": "mod-tome/data/chats/undead-start-kill.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "So what do you propose?",
   "target": "那你的建议呢？",
