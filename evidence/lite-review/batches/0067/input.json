   "translation_line": 6535,
   "section": "mod-tome/data/chats/undead-start-kill.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Thanks for the information. Now you may die. [kill him]",
   "target": "谢谢你的情报，现在你可以死了。[杀了他]",
