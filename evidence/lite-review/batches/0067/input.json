   "translation_line": 6610,
   "section": "mod-tome/data/chats/yeek-wayist.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "#LIGHT_GREEN#*Before you stands a creature about as tall as a Halfling, covered in small white fur and with a disproportionate head.\nYou also notice he does not wield his greatsword. It seems to float in the air, bound to his will.*#WHITE#\nWhy did you save me, stranger? You are not of the Way.",
   "target": "#LIGHT_GREEN#*在你面前站着一个和半身人一样高的生物，身披细密的白色绒毛，脑袋与身体大小不协调。\n你同时注意到他并没有用手握持大剑，剑正漂浮在空中，仿佛受他的意志控制。*#WHITE#\n你为什么救我，陌生人？你不属于维网。",
   "source_file": "game/modules/tome/data/chats/yeek-wayist.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    25
   ],
   "previously_reviewed": {
