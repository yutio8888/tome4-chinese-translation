   "revision_key": "2755f28eeb5a78c23d236a695d77111631659684c80160e498a9fd66452d9ad2",
   "translation_file": "mod-tome.lua",
   "translation_line": 6615,
   "section": "mod-tome/data/chats/yeek-wayist.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Well, you seemed to need help.",
   "target": "你看上去似乎需要帮助。",
