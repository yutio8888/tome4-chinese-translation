  {
   "id": "1170f0d4f426",
   "unit_id": "1170f0d4f4260fbb0051b6587b473aa081a64c87f95d8b443621bab4765dd95a",
   "revision_key": "7287b363ad81c01241e8e2085f3a0444f5235f4f2bc6879cd8937a18991c6998",
   "translation_file": "mod-tome.lua",
   "translation_line": 6540,
   "section": "mod-tome/data/chats/unremarkable-cave-bosses.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "#LIGHT_GREEN#*A beautiful Elven woman in golden robes stands before you, facing an orc clad in mail.*#WHITE#\nFillarel: \"Abandon this fight, orc! You cannot win: I stand with the power of the Sun and the shadows of the Moons.\"\nKrogar: \"Ha! It's only been one hour and you already look tired, my 'lady'.\"\n#LIGHT_GREEN#*As you enter the room they notice you.*#WHITE#\nFillarel: \"You! @playerdescriptor.race@! Help me defeat this monster or begone!\"\nKrogar: \"Ah, looking for help? Bah. @playerdescriptor.race@, kill this wench for me and I shall reward you!\"",
   "target": "#LIGHT_GREEN#*一个穿着金色长袍的美丽精灵女子站在你面前，另一边是穿着锁甲的兽人。*#WHITE#\n菲拉瑞尔：“罢手吧，兽人！你不会赢的，太阳的伟力、月亮的暗影与我同在。”\n克罗加尔：“哈！才过了一个小时而已，你看上去都很疲惫了，‘女士’。”\n#LIGHT_GREEN#*当你进入房间时他们注意到了你*#WHITE#\n菲拉瑞尔：“你！@playerdescriptor.race@！帮我干掉这只怪物，不然就快离开！”\n克罗加尔：“哦？想找人帮忙？呸，@playerdescriptor.race@，给我干掉这个臭婊子，我会报答你的！”",
   "source_file": "game/modules/tome/data/chats/unremarkable-cave-bosses.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    49
   ],
   "previously_reviewed": {
    "A": false,
    "B": false
   }
  },
  {
   "id": "f70fab03d783",
