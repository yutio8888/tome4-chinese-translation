   }
  },
  {
   "id": "7cf46bb141fc",
   "unit_id": "7cf46bb141fc4932e646fb28bc6aedc1162aac6f7042b06cabfdd7d16fea0925",
   "revision_key": "415a8dcfb787b5766e7d14c1310491fef5cdd31b964a4c06cb00f1320f85a171",
   "translation_file": "mod-tome.lua",
   "translation_line": 6530,
   "section": "mod-tome/data/chats/undead-start-kill.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "I can give you a cloak that will conceal your true nature!\nWith it all people will see when they look at you is a normal average Human. You can go about your business.\nPlease!",
   "target": "我可以给你一件斗篷，它能隐藏你的真实本质！\n穿上它，任何人看到的都只会是一个普通人类，你便可以自由行事。\n求求你！",
   "source_file": "game/modules/tome/data/chats/undead-start-kill.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    43
   ],
   "previously_reviewed": {
    "A": false,
    "B": false
   }
  },
  {
   "id": "82a0b35dddcd",
   "unit_id": "82a0b35dddcdafab0edd2c744e238e60bc20a6ae884ca3425af857fd59447dbd",
