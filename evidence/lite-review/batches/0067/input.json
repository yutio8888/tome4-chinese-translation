   "section": "mod-tome/data/chats/undead-start-kill.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "#LIGHT_GREEN#*He falls to his knees.*#WHITE#\nPlease spare me! I am pitiful. I will not stop you. Let me leave!",
   "target": "#LIGHT_GREEN#*他跪了下来*#WHITE#\n饶恕我吧，饶了我这个可怜的人，我不会再阻止你了，让我走吧！",
   "source_file": "game/modules/tome/data/chats/undead-start-kill.lua @ 624a67329fe2 (pinned core)",
