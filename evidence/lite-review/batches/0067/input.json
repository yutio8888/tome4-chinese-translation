   "translation_line": 6529,
   "section": "mod-tome/data/chats/undead-start-kill.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "ARRGGggg... You are alone! You will be destroyed!",
   "target": "啊啊啊啊噶……你孤身一人！注定走向毁灭！",
   "source_file": "game/modules/tome/data/chats/undead-start-kill.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
