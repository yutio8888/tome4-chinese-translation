  {
   "id": "0e6b240bf016",
   "unit_id": "0e6b240bf016e2ffe508b1a0c9a2185ebf288a662f68a16bd1ff91ae56df3e0f",
   "revision_key": "a297ed468fd2c86f799ed18adebfbe73b28f3310027a31bdbb7b9cd9346d1c00",
   "translation_file": "mod-tome.lua",
   "translation_line": 3848,
   "section": "mod-tome/data/birth/races/yeek.lua",
   "source_tag": "_t",
   "args_order": null,
   "source": "Although they are now nearly unheard of in Maj'Eyal, they spent many centuries as secret slaves to the Halfling nation of Nargol.",
   "target": "尽管如今在马基·埃亚尔几乎无人知晓他们，但他们曾作为纳格尔半身人王国的秘密奴隶度过数百年。",
   "source_file": "game/modules/tome/data/birth/races/yeek.lua @ 624a67329fe2 (pinned core)",
   "source_lines": [
    142
   ],
   "previously_reviewed": {
