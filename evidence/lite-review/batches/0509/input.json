   "translation_line": 22587,
   "section": "mod-tome/data/talents/chronomancy/timeline-threading.lua",
   "source_tag": "tformat",
   "args_order": null,
   "source": "Your Rethread now braids the lifelines of all targets it hits for %d turns.  Braided targets take %d%% of all damage dealt to other braided targets.\n\t\tThe amount of damage shared will scale with your Spellpower.",
   "target": "你的重编时间线技能将目标的生命线编织在一起 %d 回合。\n\t\t受影响的生物将承受其他受影响生物所受伤害的 %d%%。\n\t\t伤害受法术强度加成。",
   "source_file": "game/modules/tome/data/talents/chronomancy/timeline-threading.lua @ 624a67329fe2 (pinned core)",
