    {
      "claim_id": "P02",
      "entry": {
        "function_name": "t",
        "kind": "translation",
        "line": 32144,
        "section": "mod-tome/data/texts/intro-orc.lua",
        "source": "Welcome #LIGHT_GREEN#@name@#WHITE#.\nYou are a member of the feared race of the Orcs.\nBLAH BLAH BLAH\n\nYou have been sent to a remote island on the southwest coast of the Far East to crush an outpost of the Sunwall, the last remaining bastion of men, elves and dwarves on this continent.\n\nA little to the south lies the outpost. Your task: destroy it and bathe in the blood of its people!\n",
        "source_tag": "_t",
        "target": "欢迎你#LIGHT_GREEN#@name@#WHITE#。\n你是令人闻风丧胆的兽人种族的一员。\nBLAH BLAH BLAH\n\n你被派往远东大陆西南海岸外的一座偏远岛屿，摧毁太阳堡垒的一处前哨站——这里是人类、精灵和矮人在这片大陆上仅存的堡垒。\n\n再往南一点就是那个前哨站。你的任务：摧毁它，让那里的人血流成河！\n",
        "args_order": null,
        "special": null,
        "logical_path": "mod-tome.lua"
      },
      "component": "tome"
    }
