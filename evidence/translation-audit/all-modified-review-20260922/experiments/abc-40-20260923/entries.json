  {
    "function_name": "t",
    "kind": "translation",
    "line": 41815,
    "section": "mod-tome/dialogs/GameOptions.lua",
    "source": "Enable Discord's Rich Presence integration to show your current character on your currently playing profile on Discord (restart the game to apply).\n#ANTIQUE_WHITE#If you do not use Discord this option doesn't do anything in either state.",
    "source_tag": "_t",
    "target": "开启Discord实时状态可以让你的朋友在Discord上看见你正在玩什么角色（重启游戏后生效）。\n#ANTIQUE_WHITE#如果你不使用Discord, 那么这个选项就是无效的。",
    "args_order": null,
    "special": null,
    "logical_path": "mod-tome.lua",
    "component": "tome",
    "occurrence": 1,
    "net_changed": true,
