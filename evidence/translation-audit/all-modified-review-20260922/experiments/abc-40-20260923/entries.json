  {
    "function_name": "t",
    "kind": "translation",
    "line": 41241,
    "section": "mod-tome/dialogs/Birther.lua",
    "source": "\n\n#GOLD#This is a locked birth option. Performing certain actions and completing certain quests will make locked campaigns, races and classes permanently available.",
    "source_tag": "_t",
    "target": "\n\n#GOLD#本选项被锁定，完成特定的任务或条件可以永久解锁这个战役，种族，职业。",
    "args_order": null,
    "special": null,
    "logical_path": "mod-tome.lua",
    "component": "tome",
    "occurrence": 1,
    "net_changed": true,
    "audit_id": "entry-03174",
