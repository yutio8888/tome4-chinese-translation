\n\t\t火焰会无视使用者，并吸收 10%% 伤害治疗自身。\n\t\t伤害受精神强度加成。技能可暴击。\n\t\t每点火龙系的技能可以使你增加火焰抗性 1%%。"},{"args_order":null,"call_locator":"cc1a346d6009068492503ffd67107ba2ee65535ff7b407a04102eb3a4e2259be","component":"tome","entry_revision_identity":"dfa441278e5aa7a601317d46187e0e3b4b9e3d09e47a2711531b9f38e1c93ae6","logical_entry_identity":"cba5f4a25bd5f6ee03290f1076b89624892bc6207c55c60f20e9baa74f038356","normalized_path":"mod-tome.lua","source":"Punae's Blade","source_tag":"entity name","target":"普纳之刃"},{"args_order":null,"call_locator":"301d436af07d3617545316506494de6a9a564276efd58c94c8c861a8ba1ea388","component":"tome","entry_revision_identity":"dfa62cefb251bfbca27663b95b9387c58cb57a2589492dc42067a4397558475f","logical_entry_identity":"b584aafd1919d30244eeb46776ef723a4c17ac995c832feae4191807c00a5918","normalized_path":"mod-tome.lua","source":"#{bold}##Source# killed #Target#!#{normal}#","source_tag":"_t","target":"#{bold}##Source#击杀了#Target#!#{normal}#"},{"args_order":null,"call_locator":"9bf20c6cfc28ea41a04ec07dc3e36c2afd799a489f322fefd5f8b039ea8ae651","component":"tome","entry_revision_identity":"dfb12244a25068a42d2a8c05a152190df053c385a103e9a1fcfe9f9995f4d504","logical_entry_identity":"28931bc55bd7b24b7512d34c1ee980f59f432348af7bb80dbcf2befe11699f43","normalized_path":"mod-tome.lua","source":"Stairs can not be used for 5 turns after a kill.","source_tag":"_t","target":"你杀死生物 5 回合内不能使用楼梯。"},{"args_order":null,"call_locator":"bc82d6fe7e5cad3a35080b60f2063122b6a574ddf9d7a45979c814ce0ad44b88","component":"tome","entry_revision_identity":"dfb42a8883167dd53b656a51307b76b83f77be0b83e0c8646849f7a4bc93c3b0","logical_entry_identity":"c0e2f2ed7efd6b099e47742d3d3ada8973d9ecff9838a45db16370441c2a4c24","normalized_path":"mod-tome.lua","source":"fire drake hatchling","source_tag":"entity name","target":"火龙幼仔"},{"args_order":null,"call_locator":"3a6e4d8ef8b3aeb58627eee64ae462fc5366c7e119adde513fa00679835d5a6e","component":"tome","entry_revision_identity":"dfb517b3053044c02dda477e599fae384069aa