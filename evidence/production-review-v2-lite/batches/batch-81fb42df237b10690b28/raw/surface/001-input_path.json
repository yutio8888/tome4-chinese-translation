ity":"d5cb5050a5d52c3d82387132c95e4bcdead9d7063a3c8c595afbdd7ff702d1d1","normalized_path":"tome-orcs.lua","source":"For the Garkul!","source_tag":"_t","target":"为了加库尔！"},{"args_order":null,"call_locator":"ef92073c171706f6d356742c1d755e0e44172fd5b995702b2ebce91f3b855ec2","component":"orcs","entry_revision_identity":"8bae4d236f042ff38ff21ae15a028210267a03359087d25a69efb5e7b4a9d120","logical_entry_identity":"f6ae923119f938d92133e4ddfc9621bd49a96ad30ed898dfa3a7cc3376f5b680","normalized_path":"tome-orcs.lua","source":"Dead Hide","source_tag":"talent name","target":"亡者之皮"},{"args_order":null,"call_locator":"bbd80e88aa278667aa61c8f70b066132ad48c32fbf5d727a0252408456fd91e1","component":"orcs","entry_revision_identity":"8bc71dc40cfec2e2ca6b123b8254cfaa782c623069f46a4076e9515863e793b2","logical_entry_identity":"82c96425a2ddaafb401310a6156a49da020f642013778f026beb81479980e529","normalized_path":"tome-orcs.lua","source":"Pincer Strike","source_tag":"_t","target":"钢爪钳制"},{"args_order":null,"call_locator":"a06a504d673eb11d57acf6edb4520cc4e7ed9d87091ba94bf0f4e2e2f44153f0","component":"orcs","entry_revision_identity":"8bceb9ba22c1883c625686c83c4f67e6bf9e75bb5fa700b3ad5d81af8640b763","logical_entry_identity":"fe9b57ce19824497c8a6c7a75ca062b3171d8fd2f81f8fe80b89332353820723","normalized_path":"tome-orcs.lua","source":"Fall.  Suffer.  Lose the hope that drives you, or whatever brutish instinct suffices for it in your abominable mind.  Feel the pain you caused me, and know that it will never, ever stop...  you can feel it eroding your will to keep going, can't you?\n\nWhen your shattered mind succumbs to the pain you gave me, I will take it for my own.  I'll give you back just a little of the hope and love I took, so when you're a mere passenger in your own body, I can watch that light grow dark, as you watch your own body finding everyone you love and killing them slowly and painfully.  Their last words will be cursing your name, and you will be both powerless to stop it, and all too aware that it's your own fault for not preventing it sooner.\n\nThen, and only then, will you fully understand what you did to me.","source_tag":"_t","target":"沉沦吧。受苦吧。失去驱使你的希望，或者在你可憎的心智中充当希望的野蛮本能吧。感受你施加给我的痛苦，并明白这痛苦永无止境……你能感觉到它正在侵蚀你继续前行的意志，对吧？\n\n当你破碎的心智屈服于你给我的痛苦时，我将把它据为己有。我会把你被我夺走的希望与爱稍微奉还一点，好让你沦为自己躯体中的看客时，我能看着那光芒逐渐黯淡，而你只能眼睁睁看着自己的身躯找到你所爱的每一个人，缓慢而痛苦地将他们残杀。他们的遗言将是对你名字的诅咒，而你既无力阻止，又无比清楚这一切都是你没能早点阻止的罪过。\n\n那时，也唯有那时，你才会真正明白你究竟对我做了什么。"},{"args_order":null,"call_locator":"c41e2436a3d6844360b0d51916fcd548e25dc693ef11ea5b3962d652e4e31799","component":"orcs","entry_revision_identity":"8bd635602cf9037156ac07c03529cd1f53f0e4043b8e0e117e755ea81ca357dd","logical_entry_identity":"c59087991da53e464c585ad481e0c9abd550cad504e446fe7172da606107a9ee","normalized_path":"tome-orcs.lua","source":"Doing so drains their old knowledge and they need to start afresh, gaining considerable strength in the process; for the good of the Prides.","source_tag":"_t","target":"这样做会耗尽他们旧有的知识，必须重新开始，但在此过程中能获得强大的力量；这一切都是为了部落的利益。"},{"args_order":null,"call_locator":"5772e8c3f5609131a83f0d117c0105caccd5bca78b7d39f8d60bc039bb3be80d","component":"orcs","entry_revision_identity":"8c0af7217a0d5cc8a5a7f9ad3b677e36d23b805ee878708f1de2f3c985acaa4a","logical_entry_identity":"111e74576926d28556f040116c8fdd14fe0c5df7240143b674d60a8f53ea4741","normalized_path":"tome-orcs.lua","source":"primal core","source_tag":"entity name","target":"原始之核"},{"args_order":null,"call_locator":"d881081d88a20eb1d36d7fece34d5bb875f8aee51982241dd6d76d0ea77ca329","component":"orcs","entry_revision_identity":"8c0e7930fb0d5d7794ddd1ca50e70ccd6e6d330e0609664bec43c968dcfdcea9","logical_entry_identity":"fabfc266b816ca1220335503754aa2a809c06a20b34a2925ac3231d5e5c737bd","normalized_path":"tome-orcs.lua","source":"Tinker's Master","source_tag":"_t","target":"工匠大师"},{"args_order":null,"call_locator":"c2fc4dc45beefebae269bec8380bd440a7c0cc3e96dd9e65d362fd7f1e28ce8c","component":"orcs","entry_revision_identity":"8c1323adda884d3ade819b656fa7f2c6b31ec020