e9002e9c129a8b088a6f","component":"tome","entry_revision_identity":"a0b02bfa24c5a4e5eca4c6e3513c0b5026c6c15428833b8147bef01290c8f162","logical_entry_identity":"26d9d22ee6a930579686f086a732e989c96f7b003c7c04362e532d71c2a61a35","normalized_path":"mod-tome.lua","source":"This green robe is engraved with icons showing clouds and swirling winds. Its original owner, a powerful mage named Proccala, was often revered for both his great benevolence and his intense power when it proved necessary.","source_tag":"_t","target":"这件绿色长袍上刻有云朵和漩涡。它最初的主人，大法师普偌卡拉，因其善行和力量被人们敬畏。"},{"args_order":null,"call_locator":"b47c40ce9f555d1cffcb1e8dfab31fb1527febb4284b5ed7273405e4db121022","component":"tome","entry_revision_identity":"a0b2fa150e20b2bdba1e18045acdef0a76942f2590353c116e940af8b51d1ef4","logical_entry_identity":"da131df826041dd788555b62935ad630c34da73c01799e2741ab0950734ed725","normalized_path":"mod-tome.lua","source":"normal","source_tag":"_t","target":"普通"},{"args_order":null,"call_locator":"83db7bce66ec0a7d398e7c03b66407143390789b9db7893f9c11c64240ff45b3","component":"tome","entry_revision_identity":"a0b7ab82ba67e74403fdf1b5a131e91b90d400686524eeab380ca7e9036440d0","logical_entry_identity":"fb8bb326fc6bac023da85676990117b8d46501eaa810b1f099e96a636c9bc06a","normalized_path":"mod-tome.lua","source":"Tornado","source_tag":"talent name","target":"龙卷风"},{"args_order":null,"call_locator":"8c075bbc4339d28c72fbe5ad1bd093dfd9806a9e84fa9b7ad7923da75e5e75fc","component":"tome","entry_revision_identity":"a0bcb7e237517990f7ae17aac44445e7c409d4fcd3253e6f298892520d2e86e4","logical_entry_identity":"1078dd9fddd5df67991c805af30b826740e8eaf72346de109bedea7bc77a483b","normalized_path":"mod-tome.lua","source":"Shadow of %s","source_tag":"tformat","target":"%s的影子"},{"args_order":null,"call_locator":"b8621cc929f0c2606d8fef8071d4e1736691c080f37dca743a393daa1daee9e0","component":"tome","entry_revision_identity":"a0c38d65660298aaf23a15de3a38347f624b318800d7ff686df55202da27665c","logical_entry_identity":"5f9aa69c0130aaaad68d207165136cf2eeee258fb8ff0b559e551ec4fc1617ee","normalized_path":"mod-tome.lua","source":"Paradoxology","source_tag":"achievement name","target":"时空悖论"},{"args_order":null,"call_locator":"6501be7d9420519f0703cec663ffef2197adb7dfe77bf61d8427fa00fbffec49","component":"tome","entry_revision_identity":"a0c4eac241b6720387e2f4e6a966b73c494b7b85e59a83a3471895062508e255","logical_entry_identity":"42fe80f69f1cb9f4357cb6dbea543ba3b2118f949ff59aee3c73af3b93ed255e","normalized_path":"mod-tome.lua","source":"Fire and Light damage increased by %d%%.","source_tag":"tformat","target":"火焰和光系伤害增加 %d%%。"},{"args_order":null,"call_locator":"ffc9dfc7c90f2370fdcae52fbaf37719c66e96b94c69914b315fdef66c974ea2","component":"tome","entry_revision_identity":"a0c5a079ba0e49cf1ef820611c6ec78b11b9fb0e627468c110a87a6b98d06cde","logical_entry_identity":"a3314113f3b04cf3013f6c59c6552518a4d0dd8dd5d8999d94f022a82d3a99c3","normalized_path":"mod-tome.lua","source":"Space and time seem to bend around this huge worm.","source_tag":"_t","target":"这只沙虫似乎扭曲了周围的时空。"},{"args_order":null,"call_locator":"647f6033e446d40426870001a0cdb58f2e3af9c5ffbee9b223043afb43eb3c57","component":"tome","entry_revision_identity":"a0c9098645a940819822afcffcda602231a6e6f5e0831c2f49c5d4837f480d7e","logical_entry_identity":"4ecb1d90be38735c2643c856eb7a9bc65569eeba1fb7b3e2e8a929eafe08b2b3","normalized_path":"mod-tome.lua","source":"#Target# no longer has a cursed wound.","source_tag":"_t","target":"#Target#的诅咒创伤消失。"},{"args_order":null,"call_locator":"17ef03d1f2f421e826cc19c8b2c3b6e552bd755d889dc5655c0ad90c5f96000c","component":"tome","entry_revision_identity":"a0cd020542d0a64ca11314c9ef033206dc57e07e01ffa0c2eb58257ff5d37408","logical_entry_identity":"e0d7cb752c79cdcd2affb1225835c2a1493c458effc76635176272e03a8fc624","normalized_path":"mod-tome.lua","source":"Earth, water, fire, air - these are the elements we forge our magic with, and all of these I have seen manifested in the crystals here. But there is something else, something different... There are dark crystals here which seem to posses some new, destructive element - a very twisting of the nature of the other elements, warping them into malign designs.\n\nWhy have I never seen this before?! I must study it, I must understand it - I must comprehend its very nature and hold its power in my own hands... The thirst for knowledge is all-consuming!\n\nI shall name this new element \"blight\".","source_tag":"_t","target":"土、水、火、气——我们以这四种元素铸就魔法，而它们都在这里的水晶中显现出来。但其中还有某种别的、截然不同的东西……这里的黑色水晶似乎蕴含一种全新而极具破坏性的元素。它扭曲了其他元素的本质，使其化为有害而邪异的形态。\n\n为什么我过去从未见过它？！我必须研究它，必须理解它——我必须彻底参透它的本质，把它的力量掌握在自己手中……对知识的渴求吞没了一切！\n\n我要把这种新元素命名为“枯萎”。"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"bf27c7e7d839cafa0a15d65b7933c68e80287e87c3b833fb14755fde1d767140"}}