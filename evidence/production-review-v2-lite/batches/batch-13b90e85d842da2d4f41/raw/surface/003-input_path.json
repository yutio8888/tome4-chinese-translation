y_revision_identity":"edde3dbe0a85d71e27ad479954dabd3a2820c58efae67321fbcfcd6ed6df9003","logical_entry_identity":"b9331ef67d9c8e287842f1f7831aa4ad1dfcb672f6ac9c6a7ac18563826398be","normalized_path":"mod-tome.lua","source":"A ruby-studded ring.","source_tag":"_t","target":"一只镶有红宝石的戒指。"},{"args_order":null,"call_locator":"83d5df7cee32737a2b710432e1dc87a037d115a227127d68c636126bdca3ff2f","component":"tome","entry_revision_identity":"ede35ae159902f6830cb8d166564e6ec4e984e2da02508cb468129610c2880ac","logical_entry_identity":"6dc311e87639194a91d113fcd338d189ca901ab6688ef5414c8dad907e586139","normalized_path":"mod-tome.lua","source":"Blood!","source_tag":"_t","target":"鲜血！"},{"args_order":null,"call_locator":"9b2258b6f4a5e25f29e8f79a1283b09b11864a86d5727e2a3fd9cb0528d5dbf0","component":"tome","entry_revision_identity":"ede3a5125d2c6f7354ee052e2c493a19f1b74c02678693056bbb733ffc2d8849","logical_entry_identity":"ccacc4ef9844dc6fbdc04a592b3c7e50502ff87edc06ef94753a0ac1234432b3","normalized_path":"mod-tome.lua","source":"stone warden's ","source_tag":"entity name","target":"石头守卫的"},{"args_order":null,"call_locator":"38f42bac6232bd517e3316cb94be39ec974cd3e9e1f85ce2c306b11e7b05ef2d","component":"tome","entry_revision_identity":"ede694727f79d9343d284c8ce73656a7d8e1a5417ebdce20b4cfed11caec5c65","logical_entry_identity":"5c5f67ef6f0290d334f91a409d2c870b383294a89d0d068cbcafdb1133cde91a","normalized_path":"mod-tome.lua","source":"ghoul","source_tag":"effect subtype","target":"食尸鬼"},{"args_order":null,"call_locator":"044cf9db965694556e34fe5e00e4445af29ced1edb3c964466d8d74a313fda61","component":"tome","entry_revision_identity":"ede80a450385f463b5cb58114939e75e789009c22e80a777d940fc93871959f2","logical_entry_identity":"5bf2dc5c34e4ff6913d786daf881257aed4f84c9ed7bb3dc4612e579ae9687ea","normalized_path":"mod-tome.lua","source":"My dearest,\n\nI hope this letter finds you well. I worry for you, so close to the city, so vulnerable should they find our base... But I trust in your strength, and I know you will be safe. Yet should anything happen...\n\nI wish you were here with me, able to share in the wonders I have seen. Yet this journey has far more perils. The Ziguranth have been on to us, tracking us relentlessly, spoiling many of my plans. They are truly a force to be reckoned with. But luck is with me - I have managed to capture one and find out the location of their base. Soon we shall prepare an attack that shall put an end to their threat forever.\n\nAh, but there is something more exciting even than that! Near the Charred Scar I have uncovered a truly amazing thing - a mark of the Spellblaze. Oh, how I long for you to be here with me to see its wonders! You of all people know my passions so well, and what delight you would find in what I have discovered here. Here is where our future lies. Here is where we shall gain the power to truly strike out on our own!\n\nLook after our people well, and keep strong our base for when I return. It shall be soon, I hope, and it shall be in glory.\n\nWith passion abound,\nYour dearest love","source_tag":"_t","target":"我最亲爱的，\n\n愿你收到这封信时一切安好。我很担心你：你离城市那么近，一旦他们发现我们的基地，你就太容易遭到袭击了……但我相信你的力量，也知道你会平安无事。可万一发生什么……\n\n真希望你就在我身边，能与我一同分享沿途所见的奇观。可这趟旅程的凶险远多于奇观。伊格兰斯已经盯上了我们，一路穷追不舍，破坏了我的许多计划。他们确实是一股不容小觑的力量。不过幸运站在我这边——我设法抓住了其中一人，并从俘虏口中得知了他们基地的位置。很快，我们便会筹备一场进攻，永远终结他们的威胁。\n\n啊，还有一件事，甚至比这更令人兴奋！我在灼烧之痕附近发现了一样真正惊人的东西——魔法大爆炸留下的痕迹。哦，我多么渴望你能在这里，与我一同目睹这份奇观！所有人中，唯有你最了解我的热情；若能看到我在这里的发现，你该会多么欣喜。我们的未来就在这里。我们将在这里获得力量，真正走出属于自己的道路！\n\n请照顾好我们的人民，也守好营地，等我归来。我希望那一天很快便会到来，而我将携荣耀而归。\n\n满怀炽情，\n你至爱的恋人"},{"args_order":null,"call_locator":"562379d16bbf38f34648340f6b93beac34f08d3b0f95cf4dad48f4524571d11b","component":"tome","entry_revision_identity":"edeb70084f9897898f4fbba3a5f17eea53334f04ddb0ff537d10a298cb0284e2","logical_entry_identity":"00e1e6c223ca7f96b1f2dba36f7ff1acb2050572fe7eb51ca4f71479ff050d27","normalized_path":"mod-tome.lua","source":"+Deep Wounds","source_tag":"_t","target":"+重伤"},{"args_order":null,"call_locator":"b7c0e950cb4d9f64cefd9ab