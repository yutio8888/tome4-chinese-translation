_tag":"_t","target":"瞌睡的 #rng#"},{"args_order":null,"call_locator":"b9ae7f0d5552288a4855c85aaed4e1b8b1bde8947c139041fa992349af92eb80","component":"tome","entry_revision_identity":"a45439416cd719b6201800747cfcff828f8ec31926f4e16573533876da220963","logical_entry_identity":"5b66b16024bcf2c30f388b3920cdeb049e00a77a550c498858fb9b53832d0d5a","normalized_path":"mod-tome.lua","source":"Increases attack, spell, and mind speed by %d%%.","source_tag":"tformat","target":"增加攻击、施法和精神速度 %d%%。"},{"args_order":null,"call_locator":"e5f0bed060cc084d4fc0b9648ea959e63820015ffff7c75ca6b5106507957d25","component":"tome","entry_revision_identity":"a454959d1561e55af7741e1a01358ffe308ba1c388a1460f792f2059ebe1cefd","logical_entry_identity":"613fcc241ecdb96b5cbb8c045c565d7bb68757835456bc1001cec75d5f5d2c4d","normalized_path":"mod-tome.lua","source":"Bodypaint 2","source_tag":"_t","target":"身体彩绘2"},{"args_order":null,"call_locator":"411fc39d0968381391613a41cb35c3c1c95957ffe746bb257f28e91bdff5eebc","component":"tome","entry_revision_identity":"a455bf89d85fcc35252beee964a8bf167996400f448b4603d877f3e7b3980d7e","logical_entry_identity":"3fd337928e86f5507a856b53b9678ccaada9c54305915584b798723742475437","normalized_path":"mod-tome.lua","source":"energize the scales for 16 turns, increasing resistance to %s damage by 15%% just before you are damaged. (This effect lasts 5 turns and only works on one type of damage.)","source_tag":"tformat","target":"为鳞片充能16回合，让你在受 %s 伤害前增加相应抗性15%%，持续5回合，只对一种伤害生效。"},{"args_order":null,"call_locator":"866864638a4ff356e55d29fef21a3ee2c335b3d58b1108208583a5fe504db410","component":"tome","entry_revision_identity":"a4560149ef733ce7cd1856bcd7e761035803139b8270e6cfedee40e526800d51","logical_entry_identity":"46d2efc5ecd5e2910781297a1d04fd312ff3ddcc951654e8c55c739d333aee64","normalized_path":"mod-tome.lua","source":"A pinkish bubble floats here, reflecting the world not as it is, but as it would be in that surreal place that exists only in our dreams.","source_tag":"_t","target":"一个粉红色的气泡漂浮在这里，反映的不是世界的本来面目，而是那个只存在于我们梦中的超现实。"},{"args_order":null,"call_locator":"0be2e396288428f03ad1f6cb0bae56431c80ae8587bdf30f838629d109dbeee7","component":"tome","entry_revision_identity":"a456a98ea7cd01ff0e80ca9dccb6051f4c975a548ea0eae955fc057801fc1749","logical_entry_identity":"8ffe9ff3a2022449a5adb64dc349cd5f632a58dba787087800d8d37bfc2fb796","normalized_path":"mod-tome.lua","source":"Killed the Grand Corruptor, causing him to drop the Rod of Recall.","source_tag":"_t","target":"杀死大腐化者，使他掉落回归之杖。"},{"args_order":null,"call_locator":"6d9691024484892cb7971ebb181a0e54ef74061a77e5685a661bcecff022391f","component":"tome","entry_revision_identity":"a45941388763b419e2582e5132358c6dc0d618899a67b19d621772381893e5f4","logical_entry_identity":"bc822a9445648cfcdd37498f3c667bd92d46497905413e91ea01e1fc118d2c94","normalized_path":"mod-tome.lua","source":"#LIGHT_GREEN#* You have explored the Heart of the Gloom and slain the Withering Thing.#WHITE#","source_tag":"_t","target":"#LIGHT_GREEN#* 你已经探索了黑暗之心并杀死了凋零之物。#WHITE#"},{"args_order":null,"call_locator":"5b221ebe5c8d90ebb3e88681ae12495de93b84b61a83bb1f1885e1ad888f03fc","component":"tome","entry_revision_identity":"a45fab1a7d5619e796576127e8ad1f6a020f4bbb2bab738cef11cab532f12c1e","logical_entry_identity":"e37f42212bcb1dbedf1abd4fbf36c29b7a39bc428dcf7c5a5d33b2c53f7d45b3","normalized_path":"mod-tome.lua","source":"Ruined Earth","source_tag":"talent name","target":"毁灭大地"},{"args_order":null,"call_locator":"bb86f249cf9a846acc421cfd11467674f5d1990832bc0dd3a12e4c631f8b435f","component":"tome","entry_revision_identity":"a46be3dfa1760e1f26409dfad6e4e60134cab97d224539721e783218780fdde0","logical_entry_identity":"906dc674e9df4cc2928d449c7c77371c2eb24816bb1a742650737efc7b3db771","normalized_path":"mod-tome.lua","source":"Anomaly Displacement Shield","source_tag":"talent name","target":"异常：偏转护盾"},{"args_order":null,"call_locator":"27bbea1ddbfb844460b1a42385f752499fb96f49145bf541c313b57bb018210d","component":"tome","entry_revision_identity":"a46d265092e08b866d19c991d3a34b1013d25af2e9876724aace22cf8dc4827d","logical_entry_identity":"d5f05cf8eed0f0054c6c5b8f92c1b7ad3a5bdba409cf92a8ca03ed1781993704","normalized_path":"mod-tome.lua","source":"halfling","source_tag":"entity name","target":"半身人"},{"args_order":null,"call_locator":"40e583c0d778456ff0b56861154311c51c0273173b773439492b7ac406e9dbb3","component":"tome","entry_revision_identity":"a46ea2181baddbb0650120472e0a8cfaf019d560136a657332f7443ca6b1a209","logical_entry_identity":"edc36d309aa7004767004f82cf6a0f1bf765de008259712b77ca611643fa4a47","normalized_path":"mod-tome.lua","source":"I hate Elves anyway...","source_tag":"_t","target":"反正我也讨厌精灵……"},{"args_order":null,"call_locator":"d975f512cc788a9635172b0e6b836836d87c95acd29b3cd3d3c7db2ce3a56ee3","component":"tome","entry_revision_identity":"a46f01cfeec5377ca4a4a66d298a55c043c7687a8d0f2af46b3b8885a2e81792","logical_entry_identity":"a614d4b53e9c34e9a1f46a4fd49636c8b3e42e1e586e0e06165a1145031b2fde","normalized_path":"mod-tome.lua","source":"chilled","source_tag":"_t","target":"被冷冻"},{"args_order":null,"call_locator":"dea773a0e33ae14e1073090202a8b504232d1b5c951deb320fe816657c01b716","component":"tome","entry_revision_identity":"a47199f72cbeef3d23708b7304a174bfa5e66d23bbcd63d5748aadcf1a4d73cb","logical_entry_identity":"84b440be00a556e788d7eb8f20e75a6f5dede8c350b838d9b5d3fdd029fa29e6","normalized_path":"mod-tome.lua","source":"The target's critical strike damage bonus is increased by %d%%.","source_tag":"tformat","target":"目标的暴击系数增加 %d%%。"},{"args_order":null,"call_locator":"2de11fe72d4f919f9cc30848f98a93e2f6074020b41bb5ea14a0dbec8de83b66","component":"tome","entry_revision_identity":"a4727ecb94b0a84310d9c178761f0864fcf0a6f210b3d0c3d7c8631485863a2c","logical_entry_identity":"fc1043c6fc7cd90d6274ea7197dcdf82d11d3f9b4f3b7a7d7b0e91bd6160bf03","normalized_path":"mod-tome.lua","source":"This Fortress is designed as a mobile base for the Godslayers - it can fly.\nIt is also equiped with various facilities: exploratory farportal, emergency containment field, remote storage, ...\nHowever, the Fortress is badly damaged and has lain dormant for too long. Its energies are nearly depleted.\nTake this Transmogrification Chest. It is linked by a permanent farportal to the Fortress. Any item you put inside will be sent to the power core and dismantled for energy.\nThere are, however, unwanted byproducts to this operation: the generation of a metal known as gold. It is of no use to the Fortress and thus will be sent back to you.","source_tag":"_t","target":"这座堡垒被设计为弑神者的移动基地——它能够飞行。\n它还配备了各种设施：探索用远行传送门、紧急遏制力场、远程储藏……\n然而，堡垒损毁严重，又休眠了太久，能量已近乎耗尽。\n拿着这个转化之盒。它通过一座永久远行传送门与堡垒相连。你放入其中的任何物品都会被送往能量核心，拆解成能量。\n不过，这个过程会产生一种不需要的副产物：名为黄金的金属。堡垒用不上它，因此会将它送还给你。"},{"args_order":null,"call_locator":"8a4fdcc0f06642105f71bc6b05c1a1eabdfa2fad35a77ea381b858bf502be6a9","component":"tome","entry_revision_identity":"a4794456b2100007fac8764615482b3267504953e488589ccfaa47f515e860aa","logical_entry_identity":"fab23113026e995ccc640eabb161bcae0b53d94aec1bffe08621a77081e5ef7d","normalized_path":"mod-tome.lua","source":"Gather your will, and brutally smash the target with your mainhand weapon and then your telekinetically wielded weapon, doing %d%% weapon damage.\n\t\tIf your mainhand weapon hits, you will also stun the target for %d turns.\n\t\tThis attack uses 60%% of your Willpower and Cunning instead of Strength and Dexterity to determine weapon damage and accuracy, for both attacks.\n\t\tAny active Aura damage bonusses will extend to the weapons used for this attack.","source_tag":"tformat","target":"凝集你的意念，用主手武器和念动武器狂莽地砸击你的目标，造成 %d%% 武器伤害。\n\t\t如果你的主手武器命中，将震慑目标 %d 回合。\n\t\t此次攻击根据你意志和灵巧的 60%% 取代力量和敏捷，来判定伤害和命中。\n\t\t此次攻击中任何激活光环的伤害附加将会沿用到武器上。"},{"args_order":null,"call_locator":"721d895a3a17eac25ef289f4634a0b57e0d6bc1e6767c045526b67f367104a49","component":"tome","entry_revision_identity":"a47c065d221f1f2bc968987302898d7976b8ac0d7f9279de725ec27993e2d40b","logical_entry_identity":"28982c940da29a96a7ba83529d7617311144bada6f927691945c958ddbfd5d30","normalized_path":"mod-tome.lua","source":"#LIGHT_BLUE#Warning: You have increased some of your statistics or talent. Talent(s) actually sustained: \n %s If these are dependent on one of the stats you changed, you need to re-use them for the changes to take effect.","source_tag":"_t","target":"#LIGHT_BLUE#警告：你改变了你的某些技能或属性。你目前开启的持续技能：\n %s 如果其中某些技能和你改变的属性点相关，你需要重新使用该技能来使新的属性生效。"},{"args_order":null,"call_locator":"12479c78b3bd8fe4ff1c7282b748aaa53ac84b337caf7cd00516f3191af962fe","component":"tome","entry_revision_identity":"a480d134c003ee596472c7c7fbcae03ea255c77cd27ae562c55bf3674d149f7d","logical_entry_identity":"596a0df0a1cce77570e7d18ed499b74eaf78948c13671db9f552ee246a47e14b","normalized_path":"mod-tome.lua","source":"Donated up to 5 euros to Tales of Maj'Eyal.","source_tag":"_t","target":"为马基·埃亚尔的传说捐赠不超过 5 欧元。"},{"args_order":null,"call_locator":"2450318ab4b159232bb72cc4cb9da51aa18ebfef94ae078b14d7eab1afb0bc3e","component":"tome","entry_revision_identity":"a4829653690e23564c2685151d07ff7884c5c324c88869bbb620467fd47dc9a2","logical_entry_identity":"b60991900616cd0a7ac8817182f994081eea98daef4d785fbc2b538d5801d57f","normalized_path":"mod-tome.lua","source":"This rugged jacket is the subject of many a rural legend.\nSome say it was fashioned by an adventurous mage turned rogue, in times before the Spellblaze, but was since lost.\nAll manner of shady gamblers have since claimed to have worn it at one point or another. To fail, but live, is what it means to be untouchable, they said.","source_tag":"_t","target":"这件破旧的夹克是许多乡村传说的主角。有人说，在魔法大爆炸之前的年代，一位转行盗贼的冒险法师制作了它，但此后便遗失了。\n形形色色的神秘赌徒都声称自己曾穿过它。他们说，失败却活下来，这就是“不可触及”的含义。"},{"args_order":null,"call_locator":"88a38c7c32cd954b93d57b99ec7a7c14da2fd67fc7cf8a125b5d398aed28cfd6","component":"tome","entry_revision_identity":"a488729ff5ad6264a6b230aa4ac47e04e73f5cd23a65be87fb56973cd8d56d5c","logical_entry_identity":"cc0f8b6e05eb5c702a040af6cd4ae3bd573559ed2e7458963183a975ce31a430","normalized_path":"mod-tome.lua","source":"The %s fires a bolt of kinetic force!","source_tag":"logSeen","target":"%s发射了一发动能之力！"},{"args_order":null,"call_locator":"435e87389476021e4f57f2fb4e0fd0d0e31697b6781238974e5bc4e40088001a","component":"tome","entry_revision_identity":"a48a5b5be4779dd1896f6a4c4b2a302a84eea1ae03b124e39bbbfcf8acd1613a","logical_entry_identity":"d10fba7e4f39d049e5f61de0951c6bab6d461b4c5bda6037e1c66df4be4c6d1e","normalized_path":"mod-tome.lua","source":"#PINK#Test Dummy#LAST#","source_tag":"_t","target":"#PINK#训练傀儡#LAST#"},{"args_order":null,"call_locator":"28497d9272bbb3869bdb20e57a42f0705b26b7e0e20b0b7f84d586d06441397c","component":"tome","entry_revision_identity":"a492ce9d1ab88526632262278b85768803466c28e43558bea822e9679be536f0","logical_entry_identity":"d57e290e0e1d62d7d94edaac2b112ec7936a5fe3af25464c84be0b504bb8b113","normalized_path":"mod-tome.lua","source":"Anomaly Probability Travel","source_tag":"talent name","target":"异常：次元移动"},{"args_order":null,"call_locator":"589fd1955dda4617616b187590c70534745a044b521c3dfae6ff72a32c16d503","component":"tome","entry_revision_identity":"a49592ed4c44fc41e73d46df2a16f97d81455f2236f52f393e5a64e7f6e4b8e6","logical_entry_identity":"db670ab19f951ddf66116241a2ab26bef9a6efb83ac239334f1006ef0aeef663","normalized_path":"mod-tome.lua","source":"You cannot use Retribution without a shield!","source_tag":"logPlayer","target":"必须装备一面盾牌！"},{"args_order":null,"call_locator":"cfc28f36a8aaa29e00c887291361725bd5bbc23cb384c3d320a2fe9ac205ad55","component":"tome","entry_revision_identity":"a49985a9d65ce66546dfa853ff4714629141719351bb38f5a939130a87779843","logical_entry_identity":"adc3f3eb7d6af9bd8ce8963dde37f35ec3be969ac43d15725b3563c50bc8827f","normalized_path":"mod-tome.lua","source":"augmented striking","source_tag":"talent type","target":"强化打击"},{"args_order":null,"call_locator":"16a49b98b58a2f098496ffc7911a06794bb5a616c214b60cfc31e6155219e77e","component":"tome","entry_revision_identity":"a49caba44168bfcb8de7699caf3ecc0d1a609bcecc2db9205271e9