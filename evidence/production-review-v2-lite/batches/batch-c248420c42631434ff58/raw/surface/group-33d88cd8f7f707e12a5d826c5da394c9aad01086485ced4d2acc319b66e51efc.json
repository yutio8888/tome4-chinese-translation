ith your Spellpower.","source_tag":"tformat","target":"使用奥术力量召唤 %d 颗陨石，陨石会落在距目标 2 格以内的地面上。\n\t\t每颗陨石会轰击半径 2 格内的一切，对除你之外的生物造成 %0.2f 点火焰伤害和 %0.2f 点物理伤害，并使部分地面熔化成熔岩，持续 8 回合。\n\t\t伤害受法术强度加成。"},{"args_order":null,"call_locator":"0001af73b2b0aca70e42ab218647f71cdfa9cf468e72ef02be89d79a004c4568","component":"tome","entry_revision_identity":"9f1ba0ac86427cdf2d1b0b39af18b51a79fc7eff70c289b7d78397778cd2cb9b","logical_entry_identity":"8556a5c1d56ef99b07ef66203a4b4dc6e86c32b3c296bdf2ab3e08b399aa2040","normalized_path":"mod-tome.lua","source":"yaech hunter","source_tag":"entity name","target":"夺魂魔猎手"},{"args_order":null,"call_locator":"ab5a441eea9d34a380aff3429075534f3133c7a0594615346ace38d4ab27f91a","component":"tome","entry_revision_identity":"9f246640a9dbbc974c3dcf831f6c97cf7eba3397276139a26e260f6c682356a9","logical_entry_identity":"7541468ceae73424732f7a05eb81bf2f42d5c648496133c55616dd1d070b8bbe","normalized_path":"mod-tome.lua","source":"Thank you, my lord.","source_tag":"_t","target":"谢谢你，阁下。"},{"args_order":null,"call_locator":"e849b9ef749b4244aa5cdf48f947fecac4c0d0210a41c4bb090b9530d1c9f5ba","component":"tome","entry_revision_identity":"9f27bc18d08c203298f133e3d4039425f4af2178e6c4e6675b708e2b1e74d12b","logical_entry_identity":"e411cf0ae804d1fbbd38d545c06c6f4cfd40bc79ad8fb171156de20c42d90147","normalized_path":"mod-tome.lua","source":"#Target# is no longer attuned.","source_tag":"_t","target":"#Target#不再适应这种伤害。"},{"args_order":null,"call_locator":"263e323ea097b8e5b54ac40bf9382e2bf133fa2cc2a4112b04d5eca3efe57687","component":"tome","entry_revision_identity":"9f2a141acc371654ce6967794796f86d902cc11679e17e458e0bc304bf318290","logical_entry_identity":"c78238c0bf2ede1ec0b97edae20961b86a819eaafaac719ab7604c5562f0aa68","normalized_path":"mod-tome.lua","source":"#GOLD#Category:#AQUAMARINE# %s\n#GOLD#Found as:#0080FF# %s\n#GOLD#Text:#ANTIQUE_WHITE# %s","source_tag":"tformat","target":"#GOLD#分类：#AQUAMARINE# %s\n#GOLD#发现于：#0080FF# %s\n#GOLD#文本：#ANTIQUE_WHITE# %s"},{"args_order":null