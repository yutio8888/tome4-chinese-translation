 years, the Conclave doesn't exist anymore!","source_tag":"_t","target":"等等！战争已经结束了！已经过去了几千年，孔克雷夫早就不复存在了！"},{"args_order":null,"call_locator":"d7a557762a28ad09092ec69553b52e5708e7279108c1fdb2f7a69b7473cace69","component":"tome","entry_revision_identity":"ab03c47046b2259369ff88915033a32592fb87e21055e383e0f77e7077094110","logical_entry_identity":"2312814f1057716aca3b70bb5a3972ec69a81ecf8a27562601aa2ded22c7c9dd","normalized_path":"mod-tome.lua","source":"Press p to use them.","source_tag":"_t","target":"请按 P 键使用它们。"},{"args_order":null,"call_locator":"25d295ba24df513012ed5cb152b82defdad63386bb1188422dc13018a921378a","component":"tome","entry_revision_identity":"ab08453a2bc967e03517aee12b0c9fbfb4a8eced86e55c394109509653206a3e","logical_entry_identity":"d22c6ba8ed19559d183cf5975ad319d415024d1e3ebae1eb5021f7ff5b996bab","normalized_path":"mod-tome.lua","source":"generic slime melee","source_tag":"entity name","target":"通用 近战史莱姆伤害"},{"args_order":null,"call_locator":"7299ede2ae7a3b25024784fdbd32c9c00c7877a04e14f86ac9c18fb7728a29e1","component":"tome","entry_revision_identity":"ab0b1159d84315b891349784a2c7311a81f1299c330eb468fa3ca38a98ba431b","logical_entry_identity":"7447c80b2a853baf07b97c9eac22606dd8f61febae2bdfb83bbb0f034180b2cc","normalized_path":"mod-tome.lua","source":"blighted soil","source_tag":"_t","target":"荒芜之地"},{"args_order":null,"call_locator":"66f3a6a1632915433a3a66482d607d7e898b8adf414521c84699cdc93733f47b","component":"tome","entry_revision_identity":"ab0b41de8704fcedaea839a1d58bbc09cd154bd50c28ba0768c0c423dc1455ab","logical_entry_identity":"0eea08466d82736285c2eb770cd8aa5dce3bce51b6459b35b0c2081a167861b5","normalized_path":"mod-tome.lua","source":"Character's Aura","source_tag":"_t","target":"角色光环"},{"args_order":null,"call_locator":"f474d2a188070484356b73c0ff117ff62eafa41aacb7d2dac3c60fa84b3eb7c4","component":"tome","entry_revision_identity":"ab0baa0f8d0cc0a6c09fe7dc2ae81469f9a90740dbaecfd87ee47d867d52b51b","logical_entry_identity":"2cc126e062fc883358f6e9b