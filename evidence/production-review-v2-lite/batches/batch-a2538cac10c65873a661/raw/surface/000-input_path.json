cca296bc79dbaed1f8631c6a5","component":"ashes-urhrok","entry_revision_identity":"1182b522baf59bf5c599d4ae418eaa767656042099384fb0640bf62dd1a8ce99","logical_entry_identity":"28ffa885261b3d2a6f8b7109c14aff0c802ac3657e95a35a10bee3d15c53d109","normalized_path":"tome-ashes-urhrok.lua","source":"Doomelf","source_tag":"birth descriptor name","target":"魔化精灵"},{"args_order":null,"call_locator":"a70b7d037fa0cbad8c993a9990ea38b2b5591db2624adb7e87b90ccffd625e03","component":"ashes-urhrok","entry_revision_identity":"119af89312a36d7600832a7efc3ccad32e9fd116d081ded65cff5166411e63f0","logical_entry_identity":"7db0ae4daf5b84a43e07ec37d8d8fac7dd2eba0e1536dff053621dc6128eda12","normalized_path":"tome-ashes-urhrok.lua","source":"This demon is dedicated to #{italic}#extracting#{normal}# information from #{italic}#willing#{normal}# subjects.","source_tag":"_t","target":"这个恶魔专心于从#{italic}#志愿者#{normal}#手里#{italic}#获取#{normal}#资料。"},{"args_order":null,"call_locator":"d4693b212e609dd61350a975c84cacff732fd9e2c1b9755f23a06e3e379e813c","component":"ashes-urhrok","entry_revision_identity":"120d3d48def6138fa01a3c4bcfd8a0951444c4c840f8a23638c3ba39c9ee38f0","logical_entry_identity":"9cce98dbc59ab45705fda2017db134979e65a0802d8877a2cfca9691c153331a","normalized_path":"tome-ashes-urhrok.lua","source":"#{italic}#More memories rush into your mind...#{normal}#\n\n\"It's your lucky day, <?=player.name?>,\" your handler says as he leads you to a large, glowing crystal.  \"You're too cooperative to stay in testing any longer.  Today, you're getting promoted to research assistant!\"  You're nearly beside yourself with joy!  \"Now, we'll need to do a short little process first.  Fireproofing wards here, loyalty reinforcement there, standard-issue alteration, but mostly just linking your consciousness to this,\" he says, pointing to the crystal.  \"With this thing, everything you see, hear, smell, taste, or feel gets fed directly into this little ol' beauty.  Not just that, either - whereever you go, and whatever you think, we'll have it saved for future reference.\"  You're going to help them learn so much!  \"Just step on the plate here, and hold your arms like this so I can get the bindings in place...\"\n\nThat crystal.  That crystal is how they're keeping track of you, and it has most of what you helped them discover trapped within it.  If you break it, you'll be able to escape their notice for the first time since you arrived here, allowing you to get away without them finding you again, and as an added bonus you'll undo most of what you helped them accomplish.  You need to destroy it, then flee for your life!","source_tag":"_t","target":"#{italic}#更多记忆涌入了你的脑海……#{normal}#\n\n“记住，这是你的幸运日，<?=player.name?>，”你的“主人”带着你到一块巨大的闪耀水晶面前，“你非常合作，因此你将从一般实验中解放。现在你被提升为研究助理！”闻言，你欣喜若狂！“好了，现在我们需要先做一些事情。火焰防护在这，忠诚强化在那，标准化思维修改，呃，不过主要还是将你的意识链接到这里，”他一边说，一边指着水晶体，“有了这个，你看到的、听到的、嗅到的、尝到的、感觉到的全都能体现在这块美丽精巧的水晶里。不仅如此，不管你去哪，不管你想什么，都能记录下来，以供研究。”你突然发现自己能帮助他们研究如此之多！“站在那里别动，举起胳膊，这样我就能把它放好……”\n\n那块水晶，对，那就是他们追踪你的方式，同时也封存着你帮助他们取得的大部分发现。如果你摧毁了它，你就能避开他们的注意，逃出这里，不被他们发现，并抵消你帮助他们完成的大部分成果。你必须要摧毁它，然后逃跑！"},{"args_order":null,"call_locator":"09374a0a590aa86ff2386e8693d297b058edc8b795617e3cdae09405d1df36bc","component":"ashes-urhrok","entry_revision_identity":"12286b181a8c795c978156c26a8468bf300fc3e071ceae4759ffcc17b1363375","logical_entry_identity":"f5e8ec882b2b27ecacf34a630e062756e7ddd79edd456ef533393ff6d46b96a7","normalized_path":"tome-ashes-urhrok.lua","source":"The Black Boots","source_tag":"entity name","target":"黑之靴"},{"args_order":null,"call_locator":"d945c2c9469010fd47a86b57a1b176bf82c01c4c45ac21cdf504c23020cf241a","component":"ashes-urhrok","entry_revision_identity":"12c3c45f81bdf4d981fef66a1e7df1fcef2e3da1d42e153350b255b078ed4a84","logical_entry_identity":"342896ca0bce148c6ffa996423b92ab805cf46842bf7968fc606a008066eac79","normalized_path":"tome-ashes-urhrok.lua","source":"A demon with 3 arms, ready to mutilate you. For experiment. Not for fun. Nope.","source_tag":"_t","target":"一个长着三只手的恶魔，准备切割你。不是娱乐，而是实验。"},{"args_order":null,"call_locator":"3828f367a3f53c48b8a361cc686d2dc1081a4fd5f32b103cdeb91198f7fe8e1b","component":"ashes-urhrok","entry_revision_identity":"1334d489f7ac3890ae7de5275da8ad05ac236efda5720b56998a1e17564ebd00","logical_entry_identity":"88c601e4574c3c817e10d116fb0075f6c6c3a8d4510584f6a74d33085b471a41","normalized_path":"tome-ashes-urhrok.lua","source":"+Burn","source_tag":"_t","target":"+燃烧"},{"args_order":null,"call_locator":"15a4bd9bac9b84ad4659a88dbe1e057cc10a3a4006399e5aa5d9ca31d2aa9a33","component":"ashes-urhrok","entry_revision_identity":"136746c8c0fa70f80df55e8d3103b7e4be5d0f71f2c0178cf7e0e10886f2507b","logical_entry_identity":"48084ec6f406b04da1e5388a1c5d9c05d7c7149f523cf2790974edd5a23788d1","normalized_path":"tome-ashes-urhrok.lua","source":"Oppression","source_tag":"talent type","target":"压制"},{"args_order":null,"call_locator":"ed4152383a28f569a0e308402b110342ecca2f3e419950427ba552705f449928","component":"ashes-urhrok","entry_revision_identity":"1383c01a31274ea8f44d692d7bacfe57128cfc0c5461a68dd2595dba7a9b4c67","logical_entry_identity":"aeaaafbf755928a1c94990842ec4ad6f1e1e71004ff4c96b2ae769e7ee885000","normalized_path":"tome-ashes-urhrok.lua","source":"Doomed Nature","source_tag":"talent name","target":"自然末日"},{"args_order":null,"call_locator":"0a33d3bcea4a8dd2c3503dfcb5602b322b46fb33156c65a3d0e945f5abf75df5","component":"ashes-urhrok","entry_revision_identity":"1397a34aed23bef52bc5c944938f71367364a559c5b64d14bde2bf4671c660a1","logical_entry_identity":"ffa12b2141c4729ebf21269d04a23df8efe7dfa3c605c5b1756a4fff5272e800","normalized_path":"tome-ashes-urhrok.lua","source":"Demonic Tatoos 3","source_tag":"_t","target":"恶魔纹身3"},{"args_order":null,"call_locator":"0a2841f53cbf6fdc48976c10bba88d7de576d6c8979ed144bacf63e899a2cec6","component":"ashes-urhrok","entry_revision_identity":"14908c0f7a6ad0953771f2d85a6866a7412e06c82ca78641b3403ffd98200316","logical_entry_identity":"622d550321230b326566d7f7f359652f69c7c85ec6b89ece82215c90085f0345","normalized_pa