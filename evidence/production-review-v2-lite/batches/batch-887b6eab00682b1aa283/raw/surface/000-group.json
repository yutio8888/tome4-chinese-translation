entity":"1bd4f715f1c1b37a174dc59300276918db968fcd8ac6ccabe8fea1753df89900","logical_entry_identity":"8a7a0f118f0b4f7fb789428d8a8d5279a1613fb762e0602f4e5fccfc4d50e7ec","normalized_path":"mod-tome.lua","source":"Their way of life is well represented by their motto 'We stand betwixt the Sun and Moon, where light and darkness meet. In the grey twilight we seek our destiny.'","source_tag":"_t","target":"他们的生活方式集中体现在他们的座右铭中：我们站在太阳与月亮之间，光暗交替之界。在灰色的黎明中寻找我们的使命。"},{"args_order":null,"call_locator":"e7e2d3d97a340454d9afc46496530a1e9b08b82f3a610159e8ca57d1dd9844e9","component":"tome","entry_revision_identity":"1bd69a2b762d68d4cf2c87eccfd968b734a1dae939c70b02e72283f8eb33f1fc","logical_entry_identity":"094b7ededf7f80c63ceae90cde66b1c70c33d26823b2f1f34572a86646e98554","normalized_path":"mod-tome.lua","source":"A true understanding of the arcane is needed to release its full power.","source_tag":"_t","target":"只有理解奥术才能完全使用它的力量。"},{"args_order":null,"call_locator":"67d29b30c686bf19048e99dc53d6fc1ac646fa1e4785ef18fbf14bf38223862c","component":"tome","entry_revision_identity":"1bd8beaf9d5008f3ee28a35e783b685de01a45283722bbe51d4122fd344d3707","logical_entry_identity":"0bbcba13b431233598c994d1d8bab2f8ed5a1a296b2ed90077bbc3a140561f4c","normalized_path":"mod-tome.lua","source":"%s is writhing in agony, suffering from %d to %d damage over %d turns.","source_tag":"tformat","target":"%s 陷入挣扎，遭受 %d 至 %d 伤害持续 %d 回合。"},{"args_order":null,"call_locator":"ff87966082af717f07527491fd3f0d82b5e990164391a80466b6c3b1e4194052","component":"tome","entry_revision_identity":"1be093c3d8bce192126ea666be4b57a3fbd587fb40ab891b9b00bca5234405bb","logical_entry_identity":"3d9cd6710d87a7e6c9a2a194d1667c077e2c3a4e49e81f450e45a31df3169078","normalized_path":"mod-tome.lua","source":"Pull all foes within radius 10 1 grid towards you.","source_tag":"tformat","target":"将 10 格内所有敌人往身边拉 1 格。"},{"args_order":null,"call_locator":"ebae43b9a3afb10ec7001dd12e1f58ab44ade9f061b2b2c83891ffe6fbc67c9f","component":"tome","entry_revision_identity":"1be51fed40043f7708129ee0c2549db7788c9d263746a17b218fd37f798ab34a","logical_entry_identity":"473d4f8f60698595300e7ee31f6416ec2ab71f702e4611e62de4946cd9acbcb7","normalized_path":"mod-tome.lua","source":"Breezy elf","source_tag":"entity name","target":"活泼的精灵"},{"args_order":null,"call_locator":"01f20145de74556ed05c5f50ced6e6a6075a093f4f5eb6c7e8add912ea4e5c23","component":"tome","entry_revision_identity":"1be7c85f8a19b292703e4c74c85f6847c02ccc49b688ebc18efbed33a69301fe","logical_entry_identity":"b1a8c72f95c1b102a9c659b7242ea300205ad797417fe3d05e053998962be480","normalized_path":"mod-tome.lua","source":"-Congeal Time","source_tag":"_t","target":"-时间凝固"},{"args_order":null,"call_locator":"2dc0b5558498e6d31c32af1f9f91bd1145104ee51d93d74058936272ac18f23d","component":"tome","entry_revision_identity":"1be8956493e1787d556ff4f5664a474fa3c9e32478d2214a6129371ce9314183","logical_entry_identity":"848fb67975f7866bfc6c417baef2e222b663fc4ce67dc7beb369602c1aa98dfc","normalized_path":"mod-tome.lua","source":"Farian was King Toknor's captain, and fought by his side in the great Battle of Last Hope.  However, when he returned after the battle to find his hometown burnt in an orcish pyre, a madness overtook him.  The desire for vengeance made him quit the army and strike out on his own, lightly armoured and carrying nought but his sword.  Most thought him dead until the reports came back of a fell figure tearing through the orcish encampments, slaughtering all before him and mercilessly butchering the corpses after.  It is said his blade drank the blood of 100 orcs each day until finally all of Maj'Eyal was cleared of their presence.  When the final orc was slain and no more were to be found, Farian at the last turned the blade on himself and stuck it through his chest.  Those nearby said his body shook with convulsions as he did so, though they could not tell whether he was laughing or crying.","source_tag":"_t","target":"法瑞安曾是图库纳国王的指挥官，在最后希望的伟大战役中跟随国王并肩作战。然而，当战争结束，凯旋归来之时，他却发现故乡处处燃烧着兽人的火焰，无边的怒火吞噬了他。复仇的欲望使他离开军队，孤身一人踏上了征程，他除了护甲之外只带了一柄剑。大多数人认为他已经死了。直到有消息称有一个毁灭者般的身影正在摧残兽人的营地，他屠杀了所有见到的兽人并残忍的肢解对方的尸体。据说他每天要用100个兽人的鲜血来祭刀直到杀光马基·埃亚尔的兽人。当最后一个兽人被杀死并且没有发现更多的时候，法瑞安最终把利刃转向了自己——那把剑刺穿了他的胸膛。那些在附近的目击者说，当法瑞安这样做的时候身体伴随着阵阵痉挛，他们说不清他到底是哭是笑。"},{"args_order":null,"call_locator":"f6c32a9d55293196bbaaa2171300335d3ffd072f67559e2b5f79311c84fa78db","component":"tome","entry_revision_identity":"1bea938b51ba226001a29ffa3e55a299263c33564320a2ee455b562cf214231e","logical_entry_identity":"fb88c792bc14533a27ce952c644a9d9d54254cb1918c7cbb56e5b907f4d04df1","normalized_path":"mod-tome.lua","source":"You don't want to think about what sort of creature this lamprey-like horror was feeding on to grow so large.  Its skin pulsates and writhes, like things are moving underneath...","source_tag":"_t","target":"你不想知道这个像七鳃鳗一样的恐魔是吃什么才能长这么大的。它的皮肤不停的扭动，就像有东西在下面移动一样……"},{"args_order":null,"call_locator":"6a12de597d0d0472fd70b1e32fdf539d870165795d39e7532d6e057ab25f632d","component":"tome","entry_revision_identity":"1beb374d3824ddd9d274ac2780405e138cf4ed1ebaa2725c2057cba938be2da0","logical_entry_identity":"108138094afcb98bbd94ae7f8cd61e19302b8efa1dacf34bf25ead1f5084ee17","normalized_path":"mod-tome.lua","source":"sticky pitch","source_tag":"damage type","target":"粘性沥青"},{"args_order":null,"call_locator":"8373674ce14b5eaa8614036deb28bbeaf4d06e775764c38c74b83171dda96909","component":"tome","entry_revision_identity":"1bf26b43f299f58db9689d144c9dccfc21f68fb4fd490b2f1a0442d4d5503b45","logical_entry_identity":"a77cc2690c5ffdb3376d29822249047c947cc1d1a052d84975e100ffa512aff9","normalized_path":"mod-tome.lua","source":"Infects the target with a corrosive worm for 6 turns that reduces blight and acid resistance by %d%% and feeds off damage taken.\n\t\tWhen this effect ends or the target dies the worm will explode, dealing %d acid damage in a 4 radius ball. This damage will increase by %d%% of all damage taken while infected.\n\t\tThe damage dealt by the effect will increase with spellpower.","source_tag":"tformat","target":"用腐蚀蠕虫感染目标 6 回合，降低目标 %d%% 酸性枯萎抗性。\n\t\t效果结束或者目标死亡时会产生爆炸，在 4 码半径内造成 %d 酸性伤害。同时，感染期内目标受到的伤害将以 %d%% 比例增加至爆炸伤害中。\n\t\t伤害受法术强度加成。"},{"args_order":null,"call_locator":"bf2c1ed6d52ddeec5e34fc8728f898b7dab1a3602c77cc247e6e0f62c8b56858","component":"tome","entry_revision_identity":"1bfaf7d30d55c2305432dc548c32baa8237f99053a0e639a5357c15e3f993a83","logical_entry_identity":"92971127c6b9633d49ef2a706c4ed7d47c6e53cf530b16652cfbce82305e69a1","normalized_path":"mod-tome.lua","source":"insignia ring","source_tag":"_t","target":"荣誉之戒"},{"args_order":null,"call_locator":"33e3469144a2974a9fd5c5ed81f97f8e34e23e94ed01cd10466bd52a875a6763","component":"tome","entry_revision_identity":"1c004a9f8f6d475106b67323b4aa6e4901aafa548b52a393a3a69cc0ef005eba","logical_entry_identity":"5f3e6e9489b3a48b794f1c86ed7d367763c6ad88c3b45782a4a87956da1f2851","normalized_path":"mod-tome.lua","source":"Look, I appreciate the offer, but I don't know you.","source_tag":"chat","target":"听着，我感谢你的好意，但我根本不认识你。"},{"args_order":null,"call_locator":"ac6d1ee54be1988f3c372b531fa2128e74c6c4371f0b0944d756e18a3cd27ebe","component":"tome","entry_revision_identity":"1c00cf762e7ceea3785be00e01c763f21a652205932641ee6b32b84eeee9aa7c","logical_entry_identity":"dd435462d67dd566e1b53e089f08fab67f66fe319d8d416a8f4dc99e4d0c8559","normalized_path":"mod-tome.lua","source":"Increases weapon damage by %d%% and physical power by 30 when using exotic weapons.","source_tag":"tformat","target":"使用特殊武器时，增加 %d%% 伤害，增加 30 物理强度。"},{"args_order":null,"call_locator":"3dc63e0f456bf6ecb6785c2495b2c8e64059ff8445f82f8c8a5b5cd92600c083","component":"tome","entry_revision_identity":"1c03a915350592b8aef722aac91d139e33c7816ffc01a3a5001689b92b1cf380","logical_entry_identity":"d745f9ad7862396f65897700872123f99c1e5e057aa2bbda48ac61c4c83436cf","normalized_path":"mod-tome.lua","source":"#CRIMSON##Source# reflects damage back to #Target#!","source_tag":"delayedLogMessage","target":"#CRIMSON##Source#将伤害反射回 #Target#！"},{"args_orde