{"candidate_identity":"4c9f108e232c53c3e08f2cd1b3efc9583191cba70e29f4d69e8d666540532195","payload":{"contract":"translation_surface_screen_v1","entries":[{"args_order":null,"call_locator":"f53c195df42d00e8b5335a9f336b6717aed6e9fb057b9e216cc44ba213c675b6","component":"tome","entry_revision_identity":"3bfd9b240d7179043786b1daf56d74d3d2b4421370d312032a712372aa173b9f","logical_entry_identity":"ded7d420da9c78f31463a6eb90f870739752eaa33c195025a6a3867fdd98375c","normalized_path":"mod-tome.lua","source":"There is already a character with this name, do you want to overwrite it?","source_tag":"_t","target":"已经有一个这个名称的角色了，你要覆盖这个角色吗？"},{"args_order":null,"call_locator":"3f4920378f9e9de76d14a58e55eb108cf5ab1d9551c35cd9dd0e53241f274e2a","component":"tome","entry_revision_identity":"3c04b46230b3b35a885ef9c8a29f4cfaa6875ee367418b9c27c9312ac74bbbeb","logical_entry_identity":"fe46f0da8ffb1f31066231addb3545c81e544f9413f36a6eaa5b2c0100c6fbee","normalized_path":"mod-tome.lua","source":"Gone? Wait, this face.. you are @playername@! We thought you died in the naga portal explosion!\nThanks to your courage the Gates of Morning still stand.\nYou should go there at once.","source_tag":"_t","target":"离开了？等一下，这张脸……你是 @playername@！我们都以为你在娜迦传送门爆炸的时候死了！\n因你的壮举，晨曦之门依然屹立不倒。\n你应该马上去那里。"},{"args_order":null,"call_locator":"3f0ea13cfd058420834e190d50d067a01e61e84fc6397d29152707475f452aa6","component":"tome","entry_revision_identity":"3c0512c0e4ece11b643a1ca5b361c61d048231300ce1956761aad435780ea5f4","logical_entry_identity":"9100cf74d24453206271ccec2d6ad171a15ed213084702f6f839e0e0196d7ea8","normalized_path":"mod-tome.lua","source":"#GREEN#The seasons no longer feel balanced.","source_tag":"logPlayer","target":"#GREEN#四季不再平衡。"},{"args_order":null,"call_locator":"2d716d42fe923183808a365dd103492d2117a3c7ff9219d3a09a503760c104a5","component":"tome","entry_revision_identity":"3c05c916c9729b8b34e66f7e4ee00ed54fe9badc974ead0c61e6accd4c82aba5","logical_entry_identity":"6eb1d46c0aab73391dd0e5246fdb5059fde28d86cde541d92f659efe32e8da05","normalized_path":"mod-tome.lua","source":"#WHITE#I see. I will be waiting... #YELLOW#But not for long.","source_tag":"_t","target":"#WHITE#我明白了。我会等你……#YELLOW#不过不会很久。"},{"args_order":null,"call_locator":"27cf4f09b78f411ecfe975f755cbf08c75c87c84f8719f782f2bed6cb59112c5","component":"tome","entry_revision_identity":"3c07116dc888773f6970e91d5e1e34e1e9e0b67644c46060e75ed15ed64c00c2","logical_entry_identity":"5fc01b541906977acf125e33a1f7f7ddf6aeb2a6efc9469e37ce435eac7b309a","normalized_path":"mod-tome.lua","source":"detrimental status effect","source_tag":"_t","target":"负面状态效果"},{"args_order":null,"call_locator":"a6d68df39e07a02c9c3cb4d8ecb37e115396f8c442bcfce200861d4f686c3a77","component":"tome","entry_revision_identity":"3c12c5b602cc939a818cba40818bf561e038f0b5084caf0c3e17d8fd891734bd","logical_entry_identity":"85540fc16c37d6d73b065739fbbdfe4e9583fc423c3f56c6f5ce32195cc92455","normalized_path":"mod-tome.lua","source":"Crush 5 alchemist gems into dust to mark impassable terrain next to you. You immediately enter it and appear on the other side of the obstacle, up to %d grids away.","source_tag":"tformat","target":"使用 5 块宝石的粉末标记一块不可通过区域，你可以立即越过障碍物并出现在另一端。\n\t\t有效范围 %d 码。"},{"args_order":null,"call_locator":"78541120c0a8ef7609749f44d68ffd5e3f3a6e843a2c73cbd46520448d1cbc74","component":"tome","entry_revision_identity":"3c19501928389f08042acc89afbf3db33a5938fe69dbada0109990aa7453223c","logical_entry_identity":"476d437e99f75f620dbca4cd38b509d331f05c608190993cbfb1c8c8f38a4487","normalized_path":"mod-tome.lua","source":"Maximum life: ","source_tag":"_t","target":"生命上限："},{"args_order":null,"call_locator":"ce977ef0cdcb05a4fa91fb1cfaaf03397923eae49c4fc64a0a1d2941f703987c","component":"tome","entry_revision_identity":"3c1f7a4a23984c4986cafea4f05db5caa84e533759cbeab2a6f5ec18f542d7ae","logical_entry_identity":"4243ee60c9109c51039c8cb7288ed83e1cb5b4210d01918ac13b2d7671e6188f","normalized_path":"mod-tome.lua","source":"Spikes of Decrepitude","source_tag":"talent name","target":"破碎尖刺"},{"args_order":null,"call_locator":"2e5bafcfcc0bad27740403433dd334f43392d341571b777d2a6138dbf37c7ebb","component":"tome","entry_revision_identity":"3c256d73e7059555ad548d3beba72715b8d173ff67f4bfb95cad4d64212fe5e0","logical_entry_identity":"d3029c01d9deaed23c653886a6fe504ba7c7a199c31d2af8cbe00a1810005288","normalized_path":"mod-tome.lua","source":"and swallowed whole","source_tag":"_t","target":"并被整个吞下"},{"args_order":null,"call_locator":"cd26053b52c62e2d8d0e0891794b4ba8b0731d9be1fc1668cd3ecaa7ecd88e77","component":"tome","entry_revision_identity":"3c285f1ee99afe73c1671368eecd61e00fee5fa5825fa427b1efb95a31ce299c","logical_entry_identity":"fde5a89dd686bb06c905a59d93e73057ca031a4a272640385dfe668a28fa6e72","normalized_path":"mod-tome.lua","source":"The forces binding this skeleton together are resilient enough to let it hold a shield and swing a weapon as well as it could have in life.  It's still wearing its old armor, in rusty but servicable condition.","source_tag":"_t","target":"施展在这只骷髅身上的魔法已经足够强大，足以让它像还活着的时候那样严阵以待，挥动武器。它仍然穿着它原来的那件老盔甲，锈迹斑斑却值得信赖。"},{"args_order":null,"call_locator":"38ae95e3d28a410b8c1fb0f791dd9120941641991ea39fdbbdfca31ff9057e43","component":"tome","entry_revision_identity":"3c311e07fff5e26347e98dd24a95546788fdbffea3aae15b48c87709a33523ea","logical_entry_identity":"3320a34964a4643f6e9a70d1fc4ff146dde50e3b019f802329f4249937cc1c0e","normalized_path":"mod-tome.lua","source":"Blasts creatures in a radius 1 shockwave around your target for %0.2f to %0.2f physical damage (based on Strength).","source_tag":"tformat","target":"在目标周围制造半径 1 的冲击波，轰击范围内的生物，造成 %0.2f 到 %0.2f 物理伤害（基于力量）。"},{"args_order":null,"call_locator":"1a39735fffc7b75cb73a88659cb8a1649609155f12d99ed43a7bc87d9f672871","component":"tome","entry_revision_identity":"3c35d10c283c08ede054132065c3e55f2ed180620c74d7be0e98aeb08f33a7b2","logical_entry_identity":"245635e67d487e712c422b28d0ca429a78a90965129c897e2ad45ebe83c89377","normalized_path":"mod-tome.lua","source":"It's quiet down here. And dark... very dark. I suppose I should have brought a lantern. Our motto is to bring light into dark places, but I guess I should have thought about that in practical terms. I've cleared out pretty much all of this area, and there's not much left to explore beyond this last room.\n\nThis adventuring stuff is quite lonely, I must say. I guess keeping this journal helps a bit. I miss home a lot now. I miss... I miss Falia. Maybe I should have said something to her about how I feel... but I guess running away on an adventure seemed easier. Pah, how brave of me...\n\nI'm not cut out for this paladin work. Here I am, alone in a horrible dark dungeon in an unknown land, without a single sound to keep me company beyond the scratchings of my own quill. Hmm, except for--","source_tag":"_t","target":"这里真安静。一片黑暗……好黑啊。我应该带个灯笼来。我们的座右铭是给黑暗之地带来光明——看来我真该好好想想这句话的字面意思。这片区域差不多都被我清理干净了，只剩最后这个房间可以探索。\n\n冒险可真是孤独。我想写日记确实让我好受了一些。我现在非常想家。我想……我想念法丽雅。也许我早就该告诉她自己的感受……但我想，逃出来冒险似乎容易得多。呸，我可真勇敢……\n\n我根本不适合当圣骑士。如今我独自待在陌生土地上一座可怕的黑暗地牢里，除了自己鹅毛笔的沙沙声，连一点陪伴我的动静都没有。嗯，除了——"},{"args_order":null,"call_locator":"c78e0ecced37351eef83a55b7b960b866f3607e7368dbb7ba9b3c1f95fd2907a","component":"tome","entry_revision_identity":"3c3881ab304b04c033c82711064a452efb3781bf9a54d1d9d7be7abdd2123ef8","logical_entry_identity":"b8744e5568657a73746aa2e3e1e3da238c7a3f2f1d0e9bdec1d1a5c39f45acc9","normalized_path":"mod-tome.lua","source":"Summons three to six dust storms.","source_tag":"tformat","target":"召唤三到六个尘土风暴。"},{"args_order":null,"call_locator":"7da1d6275807bca4483f6c329a2a3ea34f02ff418de6b6a50b46aba93ab418f6","component":"tome","entry_revision_identity":"3c3a9a5e2d30ea0311033094a7ddd92184e59def65df7f2935a5676e7398e031","logical_entry_identity":"7fae17a206949663d53f51b3118e7b849a3020c950c07165342fc62c7e92ca2f","normalized_path":"mod-tome.lua","source":"Quality Leather","source_tag":"entity name","target":"高级皮甲店"},{"args_order":null,"call_locator":"6063a3e7c53419b9f21da3f73884b082df6a6030d7f4661deae5765b