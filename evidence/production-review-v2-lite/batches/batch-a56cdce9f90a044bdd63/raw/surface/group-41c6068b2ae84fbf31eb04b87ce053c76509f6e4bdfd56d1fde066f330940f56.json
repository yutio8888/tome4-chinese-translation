99f468b328ad7956987fae50f4923d347fc710764dab4c5f76","normalized_path":"tome-orcs.lua","source":"Throw a tremor engine on the battlefield that will trigger after 2 turns.\n\t\tFor 5 turns after triggering, it will constantly shake the ground and stun, pin, or disarm any creature in radius %d for %d turns.\n\t\t#{italic}#The ground is mere paper to you!#{normal}#","source_tag":"tformat","target":"在战场上投掷一枚 2 回合后触发的巨震引擎。\n\t\t触发后的 5 回合内，它会持续震动地面，使半径 %d 格内的任意生物被震慑、定身或缴械 %d 回合。\n\t\t#{italic}#你脚下只是纸张，并非大地。颤抖吧！#{normal}#"},{"args_order":null,"call_locator":"00ae19b280d0ee01bc010944d79de0fbc3e0f68c44a01742e2a47bcb59ad426c","component":"orcs","entry_revision_identity":"6d904603d8c1e458cb58a87b9419316d289c0857a198c82de4905d64c162f217","logical_entry_identity":"c403f210494657be60c7f1a8a11dbaeafd430e9ba5e032da55f1845a6db76be8","normalized_path":"tome-orcs.lua","source":"%s thunderclap coating","source_tag":"tformat","target":"%s 霹雳涂层"},{"args_order":null,"call_locator":"dbaa95f2000cc802d5aeef55cd491152c8b6bb16ca358752b9d5837ef556fa34","component":"orcs","entry_revision_identity":"6d9de33df02b3c68b57c1bc3c050bec755eb03f68c736f0fc67b2e809c6da854","logical_entry_identity":"abaa88745ee99f17ec3fcaa0febcf5e2cec325e6c7ff6e97dc3dd874f983fdb5","normalized_path":"tome-orcs.lua","source":"Smogscreen","source_tag":"_t","target":"蔽目毒云"},{"args_order":null,"call_locator":"606f24a1b8b68268cadaeaeff55b082eb3331772b2072b172c50380c2591520c","component":"orcs","entry_revision_identity":"6da7111c39b05b1eb388f7a389aad3536ce0bfaee8b4c703037cb8845b9fd7c9","logical_entry_identity":"cce5a956ea2ad318f33e16a02122caa15fa73f076d47f6472ace77c38fa957b8","normalized_path":"tome-orcs.lua","source":"%s tosses %s %s!","source_tag":"logSeen","target":"%s投掷了%s%s！"},{"args_order":null,"call_locator":"ccd64ed813609f09a513c61cff835e98d627517f8c341bbb3db6bb370eca3774","component":"orcs","entry_revision_identity":"6dbf5e5f7bbd8b4d5b9c51890cbfad2005de5d0516d9dc531eeb60ce2c347690","logical_entry_identity":"53925aaef6ab52