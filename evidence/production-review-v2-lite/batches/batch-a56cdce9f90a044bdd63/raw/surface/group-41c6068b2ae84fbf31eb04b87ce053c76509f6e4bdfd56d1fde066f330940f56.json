lua","source":"schematic: Payload","source_tag":"entity name","target":"配方：有效载荷"},{"args_order":null,"call_locator":"05645b6da7fb2ddd50118734d10a4d92a696b51da92a53b8180a67c6a51131be","component":"orcs","entry_revision_identity":"71582762e716c0f954dd0f340f2079d8e0ab2e589918aa7c09e5291f86e24fc2","logical_entry_identity":"ee8a4a25b1f51c74c798c0f661358df1d2b2aea2bb7245e367006567bad075bb","normalized_path":"tome-orcs.lua","source":"#GOLD#Before she falls, Aeryn manages to cast a powerful shield!","source_tag":"saySimple","target":"#GOLD#在她倒下前，艾琳召唤出强力的护盾！"},{"args_order":null,"call_locator":"4ab28b4d28b126bce21380b7e4657b0d83234ae671589c17a5ba8b9baf0ed467","component":"orcs","entry_revision_identity":"71ca3576e5a1bd8ddf8d3522da6d4f7ee3ebc78df851656d355c05dad9c747b2","logical_entry_identity":"e754c821c376e331610b909946ed6e83948049a685bae8c99112ad368524d422","normalized_path":"tome-orcs.lua","source":"missing reqs","source_tag":"_t","target":"条件不足"},{"args_order":null,"call_locator":"c6c108d4c9896a190a22b8ffee5bf28d01cda090c5f0f842ff2c0a455c2dfc7f","component":"orcs","entry_revision_identity":"71e4463e38889cc1379d731e690d3cdc7d589a786d8674e9d2705c0849e51837","logical_entry_identity":"8ef27fdd608bc68d48adc3785db0c4e5835ed2df3f2bf678e22db42011eb0554","normalized_path":"tome-orcs.lua","source":"A shadowy embodiment of hate.","source_tag":"_t","target":"一团由恨意具现成的阴影。"},{"args_order":null,"call_locator":"542b357bd15317453197e864a563691967f0a80c3c0a75472b4bc7f848a23720","component":"orcs","entry_revision_identity":"71e611de78f1bb96a6538231a846fd4e9bf3af4912ab7a0b9aeff6376476d365","logical_entry_identity":"398d8e463d4f2cbeebe73bfdc5676ea80f4c3ecc1ef22e9c15a8731fcb576305","normalized_path":"tome-orcs.lua","source":"titan vile spewer","source_tag":"entity name","target":"泰坦呕吐魔"},{"args_order":null,"call_locator":"502e07b6e62b7a33e3c0f0d0fe1c701897c409e41662cbbc7b1dc280172432ff","component":"orcs","entry_revision_identity":"72178cb021d1bb3ea56e93e9309eb7e1cc21c3fb453ee6e9281598daa6dc6