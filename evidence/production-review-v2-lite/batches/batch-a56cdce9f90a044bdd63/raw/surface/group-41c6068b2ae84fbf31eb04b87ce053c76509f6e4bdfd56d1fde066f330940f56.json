s","entry_revision_identity":"700ee05bd7b873accd74a45c92929c35043b127d8ef7c15c6a02e949aee83b22","logical_entry_identity":"30982a39435933477cc8291ee6a77ef5db1dea8610c6325d706480357e3c4e2a","normalized_path":"tome-orcs.lua","source":"market stall","source_tag":"_t","target":"市场摊位"},{"args_order":null,"call_locator":"f072a4a4d89fcb981b68de730e1ab7f6e7803c247c351070e27d4c2e061e51a9","component":"orcs","entry_revision_identity":"70230ee170d9be1c9511a7f59aa2467e60d10040b1a95d628e26febcfbc7b48a","logical_entry_identity":"276b0ff57bf5902af52d0f371aff729ee9717b32790641aa376b75c94b251442","normalized_path":"tome-orcs.lua","source":"Life in the Flames","source_tag":"talent name","target":"浴火而生"},{"args_order":null,"call_locator":"32c1ffbae03da0f6c49f8e25b6ffee1f5d57462a409ef43cc6457e6c51bfc824","component":"orcs","entry_revision_identity":"70349db4017ed12dcbf347e73fc8cd2ceee1f97f4329c0c5cee4dd09a7585477","logical_entry_identity":"8416169ac41300375fa24ff597edfb69e28c10d9f0b28ea463ab33f34810583c","normalized_path":"tome-orcs.lua","source":"You fire a special explosive shot with your steamgun(s) at a spot within range.\n\t\tWhen each shot reaches its target, it does normal steamgun damage and explodes within radius %d, which does %0.2f physical damage.\n\t\tThis talent does not use ammo as it is the ammo.","source_tag":"tformat","target":"你使用蒸汽枪在射程内制造一场特殊的爆炸。\n　　当每一个弹片击中它的目标，造成正常蒸汽枪伤害和半径 %d 码内的爆炸，造成 %0.2f 的物理伤害，\n　　这个技能不使用弹药。"},{"args_order":null,"call_locator":"3d402dc9a10da8819810ffa47c8e4faf05416334a902381d2b8a92d9d158b772","component":"orcs","entry_revision_identity":"70456b4cf414f6dfe1dc55fb847983bcdab4174635e75d86c5aae858e077af9e","logical_entry_identity":"431ce549471f41d939f403a3179b9bc4892903be591ec24e4112e81475b33037","normalized_path":"tome-orcs.lua","source":"tools","source_tag":"_t","target":"工具"},{"args_order":null,"call_locator":"698586893b1c387cf7d9455ca81853b6b62f66e162e6e8bcf535206c8d7309d4","component":"orcs","entry_revision_identity":"7048f8eb48fa8be2d81f77ce2a