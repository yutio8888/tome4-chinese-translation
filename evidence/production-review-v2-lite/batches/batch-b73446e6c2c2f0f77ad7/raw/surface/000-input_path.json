cal_entry_identity":"eb02b01798fcc71d468891212028c802b513b01d096921ea9df9b5aeaead8d07","normalized_path":"mod-tome.lua","source":"#GOLD#Life per level:#LIGHT_BLUE# +2","source_tag":"_t","target":"#GOLD#每等级生命加值：#LIGHT_BLUE# +2"},{"args_order":null,"call_locator":"1d7fd7aba7bebd51f888fbc1816ca9aed2267ce432db030f3d1bfebd3ae5f2f9","component":"boot","entry_revision_identity":"1a6bad616973cafe2702da2aa500969a732c503ce4e9b30e8fdc95c30ff84631","logical_entry_identity":"79137a7c90930dd764f03885f9aa986d8071a2cd4d07e35c2b54c76b85592738","normalized_path":"mod-boot.lua","source":"Welcome to #LIGHT_GREEN#Tales of Maj'Eyal#LAST#!\n\nBefore you can start dying in many innovative ways we need to ask you about online play.\n\nThis is a #{bold}#single player game#{normal}# but it also features many online features to enhance your gameplay and connect you to the community:\n* Play from several computers without having to copy unlocks and achievements.\n* Talk ingame to other fellow players, ask for advice, share your most memorable moments...\n* Keep track of your kill count, deaths, most played classes...\n* Cool statistics for to help sharpen your gameplay style\n* Install official expansions and third-party addons directly from the game, hassle-free\n* Access your purchaser / donator bonuses if you have bought the game or donated on https://te4.org/\n* Help the game developers balance and refine the game\n\nYou will also have a user page on #LIGHT_BLUE#https://te4.org/#LAST# to show off to your friends.\nThis is all optional, you are not forced to use this feature at all, but the developer would thank you if you did as it will make balancing easier.","source_tag":"_t","target":"欢迎来到#LIGHT_GREEN#马基·埃亚尔的传说#LAST#！\n\n在你开始尝试这个游戏里无数有趣的死法之前，我们想问你一下有关在线游戏的事情。\n\n马基·埃亚尔的传说是一个#{bold}#单人游戏#{normal}#，但也提供了丰富的在线功能，可以增强你的游戏体验，并让你和游戏社区建立联系：\n* 在多台电脑上游玩，而不需要复制游戏解锁和成就。\n* 与其他玩家在游戏内聊天，寻求建议，分享难忘的时刻…\n* 记录你的击杀数量，死亡次数，以及玩得最多的职业…\n* 用有趣的统计数据帮你打磨自己的游戏风格\n* 在游戏里直接安装官方扩展包和第三方插件，免去手动安装的麻烦\n* 如果你购买了游戏或是在 https://te4.org/ 上进行了捐助，你可以获得你的购买者/赞助者独享权益\n* 帮助游戏开发者调整游戏平衡，让这个游戏变得更好。\n\n你也会获得一个 #LIGHT_BLUE#https://te4.org/#LAST# 上的用户页面，可以用来向你的朋友炫耀。\n这一切都是可选的，你可以自愿使用或者关闭这些功能。如果你愿意开启它们，开发者会感谢你的，因为这会让平衡调整变得更简单。"},{"args_order":null,"call_locator":"e46f25c86446589630354dc0c3f2bae6f0fcd8034420853744b69ea4c45c4396","component":"boot","entry_revision_identity":"1d44b8c48eb536e057b6906dc4bbe88ba58a0467d27b5e64d53629424ac9e11e","logical_entry_identity":"fd1c1e0b535d860af774f2affdc54515d602df982f45c050de89d9fc3a98dace","normalized_path":"mod-boot.lua","source":"#LIGHT_RED#WARNING: #LAST#Loading a savefile while in developer mode will permanently invalidate it. Proceed?","source_tag":"_t","target":"#LIGHT_RED#警告：#LAST#在开发者模式下读取一个存档将会不可逆地将其标记为作弊存档。确定吗？"},{"args_order":null,"call_locator":"91d571d7fa0379c99be042604cbf84067066b7455cc7166a457401a6d466907a","component":"tome","entry_revision_identity":"26225ffa1e0b3ee45644426f0d66d6ca4550c333dd447d2a795dec2cded7440b","logical_entry_identity":"db4173f4c651f4664b348eecc06d1d833621c0dfc147559cb45ab45e72772e21","normalized_path":"mod-tome.lua","source":"#GOLD#Life per level:#LIGHT_BLUE# +0","source_tag":"_t","target":"#GOLD#每等级生命加值：#LIGHT_BLUE# +0"},{"args_order":null,"call_locator":"23b046ec0cf968993cc696ec06807638c1a2845f3c0041c99be9ab60faf47bda","component":"tome","entry_revision_identity":"2c6b6a1a3cd398a215e162636ec6ce1b8022b20e8e0c348b1955519c08a6a1fb","logical_entry_identity":"f765b68bac05396c04e5ba2bc5eaaafc6fdb64252d8c5dfe9211cd6c76d00755","normalized_path":"mod-tome.lua","source":"#GOLD#Life per level:#LIGHT_BLUE# 13","source_tag":"_t","target":"#GOLD#每等级生命加值：#LIGHT_BLUE# 13"},{"args_order":null,"call_locator":"2f89d2e50623df456429e1e1a7812ab0726a82e0e3485d0c522272e36dc7bfff","component":"boot","entry_revision_identity":"2d1d6c5815a94f506170f0735054ce7a385334b96aa227177deb68656faf5ce7","logical_entry_identity":"f86adc86770a844864bc0d64c680a381b9d3f859f94700c4c33f4ada735c8ed0","normalized_path":"mod-boot.lua","source":"You can get new ad