GREEN#风暴系技能#WHITE# 的元素法师角色。\n\n技能：\n- #YELLOW# 闪电新星：#WHITE# 对你的四周施放闪电新星，对周围生物造成闪电伤害并带有眩晕效果。\n- #YELLOW# 闪电之击：#WHITE# 发射一道快速的闪电箭，眩晕目标\n- #YELLOW# 风暴之怒：#WHITE# 召唤风暴攻击你眩晕的目标，产生围绕他们的闪电对其造成伤害。\n- #YELLOW# 无尽风暴：#WHITE# 掌握无尽风暴，甚至能穿透目标的闪电免疫。\n"},{"args_order":null,"call_locator":"6cec26129962330f89da039af26582a1f274ce2b5a20f2de7edbfa6b38be57d8","component":"tome","entry_revision_identity":"16fb14226e490b1b6122cb17f93e7eb087f61ee8c854c59f32fb29a2a85e1038","logical_entry_identity":"286e67648fd47f99c75be7dcfd4867659a26171093138970ce313d588b33dd64","normalized_path":"mod-tome.lua","source":"steel amulet","source_tag":"entity name","target":"钢项链"},{"args_order":null,"call_locator":"2c43eddccc6358081852a15b8112c7420afafb2efe37c51cf24d11965f1706c4","component":"tome","entry_revision_identity":"16fb7c7cf7345a97e5f5819ca6c5e2eaf718051dc6ab7adc10fd6f36fd1eaa2f","logical_entry_identity":"506d4afff37238710796fc69bf09e3ff54b535ead1ed3aeb4b31f34c7e6cc939","normalized_path":"mod-tome.lua","source":"@Source@ envelops @target@ with poison.","source_tag":"_t","target":"@Source@用毒素覆盖@target@。"},{"args_order":null,"call_locator":"974f465062854c21c567735580da6a035423443f906f5d487302dae4e9b54df3","component":"tome","entry_revision_identity":"16fd5227b5432f7f828d99d271e167466c1f5814a76dd9b25bef3d493e8f4a08","logical_entry_identity":"797db33db0fa2ee50e628c2c203a7e95585791b5b89e304535cdeaa208b2734a","normalized_path":"mod-tome.lua","source":"Toggle automatic talent usage","source_tag":"_t","target":"切换自动技能使用"},{"args_order":null,"call_locator":"54fd47ed811de07fd14b6608454c1c003bb1af368ac5705fdca2b43e83ed6a6c","component":"tome","entry_revision_identity":"17064507283f030d00143c018d8c67b08d0fa6b4da63f943a9322d19c2d7d476","logical_entry_identity":"b3ec8616fe15edcb63e76fa7f75fb65f4cf8b31c69433e54514972641f436690","normalized_path":"mod-tome.lua","source":"Shaloren elves have close ties with the magic of the world, and produced in the past many great mages.","source_tag":"_t","target":"永恒精灵与魔法世界有着很强的联系，