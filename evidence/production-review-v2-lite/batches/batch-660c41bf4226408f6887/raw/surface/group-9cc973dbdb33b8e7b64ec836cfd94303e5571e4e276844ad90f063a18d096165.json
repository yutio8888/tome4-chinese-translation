{"group_identity":"88a442d2c59dc46402973f94193d68683e809543e170b556104cb99c835e2f9a","payload":{"attempt":1,"contract":"translation_surface_screen_v1_lane_group","cycle":0,"group_id":"group-000","lane_boundaries":[{"index":1,"length":20,"offset":0},{"index":2,"length":20,"offset":20},{"index":3,"length":20,"offset":40},{"index":4,"length":20,"offset":60}],"lane_count":4,"lanes":[{"candidate_identity":"23430512763fe480fd89466f758d3016942319648862bf3e73d6d9d7330f6c2c","dispatch_id":"lane-000-0","index":1,"input_path":".ai/task/batch-660c41bf4226408f6887/SURFACE-SCREEN-ENVELOPE-lane-000-0.json"},{"candidate_identity":"4af24a20388b9fa5e9b5e82747653985ed7e7d48340096df5310b6f620aee20d","dispatch_id":"lane-000-1","index":2,"input_path":".ai/task/batch-660c41bf4226408f6887/SURFACE-SCREEN-ENVELOPE-lane-000-1.json"},{"candidate_identity":"9609191457efaf69d908f3159a2cdb68bca8abe18ca254f3d542b6a6f2f1e8fb","dispatch_id":"lane-000-2","index":3,"input_path":".ai/task/batch-660c41bf4226408f6887/SURFACE-SCREEN-ENVELOPE-lane-000-2.json"},{"candidate_identity":"e04eb086ff5e6068593f7f0957ba01c1f90303cc1454f579c3741984a369f188","dispatch_id":"lane-000-3","index":4,"input_path":".ai/task/batch-660c41bf4226408f6887/SURFACE-SCREEN-ENVELOPE-lane-000-3.json"}],"review_phase":"REVIEW","task_id":"batch-660c41bf4226408f6887","workset":{"entries":[{"args_order":null,"call_locator":"f7aed4f0c682f392b46d23b062eb6edb06149e79ff416d9d8c155ca1efdf6e50","component":"tome","entry_revision_identity":"259b2f202ec715ce1d6c4136fe23984501df425b3dc11f38287e77f407b3ab22","logical_entry_identity":"f7764df1af1ada3d9e63aff3e93b3e1d3a87f25b1166985822a9e0122bfab47e","normalized_path":"mod-tome.lua","source":"The target is infused with the power of nature, reducing all blight damage taken by %d%%, increasing spell saves by %d, and granting immunity to diseases.","source_tag":"tformat","target":"目标得到了自然的力量，减少所有枯萎伤害 %d%%，提升法术豁免 %d，并使其对疾病免疫。"},{"args_order":null,"call_locator":"4ee64b2f74f344c331597a05a10d05eca69fb60b2d3bd6caa652d69507d76d9b","component":"tome","entry_revision_identity":"259b5c9586a432ea7f5d38b930141d121237423e7ee8e8fa1fb5cdce5fb7efdf","logical_entry_identity":"76dc4997df60d3314c526181b75f5ba27c29fbfc7b0f5f02342896cae4b826b7","normalized_path":"mod-tome.lua","source":"#{bold}#\nMatthew the Brawler\n#{normal}#101 - 122#{italic}#\nKilled in a ring of blood\n#{normal}#","source_tag":"_t","target":"#{bold}#\n格斗家马修\n#{normal}#101 - 122#{italic}#\n在鲜血之环中被杀\n#{normal}#"},{"args_order":null,"call_locator":"7a3039682881b447b86cec657ff844a00df5caa1c7fe76d0afa3a17797c10a41","component":"tome","entry_revision_identity":"259f4e70a7f0a137c6efa1b27c764459b9b6fe92748c156eec1c6468a09d34b0","logical_entry_identity":"b4548ea10ed5fe7446773ad97eda5fc5f08455fb303b89c92e31300587586952","normalized_path":"mod-tome.lua","source":"crystalline hourglass","source_tag":"_t","target":"水晶沙漏"},{"args_order":null,"call_locator":"5020292e637790a676dcfb0ae55b8a8c26a197d815fb8927c7b0c11b3d925857","component":"tome","entry_revision_identity":"25a21871dd2deb58a0b1a96d54fa54e928ee54c175893b9e4c55144a2403c1fe","logical_entry_identity":"d8d9a322e138c76572e4c181d93610412f35c731defa52a992346cdade5f2afa","normalized_path":"mod-tome.lua","source":"Rename","source_tag":"_t","target":"重命名"},{"args_order":null,"call_locator":"b0733608c7551c8c6663c4190127feba4f7ba85f778e08dfcda8f3fffc1bd42b","component":"tome","entry_revision_identity":"25a7180e7ae108c16141a4ce4d2bb1127517acc033273718f6fa5ccb07bc5845","logical_entry_identity":"467ae6d2684e4d71684d284a1c899007ee51cab4dce66144ff1b7edf2a112e45","normalized_path":"mod-tome.lua","source":"Form a map of your surroundings in your mind in a radius of %d","source_tag":"tformat","target":"通过意念探测周围地形，有效范围：%d 码。"},{"args_order":null,"call_locator":"f587ec1ce3d471d98efa55ee1f250161d78c1a842f89d7cb378f795abdac294f","component":"tome","entry_revision_identity":"25a882583e56643693c19817a9fb6e9ab2bbac6aa8dc48a6f7fabe328df6a01b","logical_entry_identity":"f131457068cde21ee511123e52c03806de5a74f63fa82e6ecc217c6a129d7d5a","normalized_path":"mod-tome.lua","source":"Move to a spot within range, bounding around, over, or through any enemies in the way.\n\t\tThis maneuver can surprise your foes and improves your tactical position, improving your physical critical chance by %d%% for 1 turn.","source_tag":"tformat","target":"移动到范围内的指定位置，绕过、跃过或穿过沿途的任何敌人。\n\t\t这一动作可能令敌人措手不及，并让你占据更有利的战术位置，使物理暴击率提高 %d%%，持续 1 回合。"},{"args_order":null,"call_locator":"b9376d64bb6fcb0f9d0801e9baaf155acdccd1c74a0eb6f89dc06ae740e94c94","component":"tome","entry_revision_identity":"25a9c482c05aef777301d59884b68c4db92c5a5926d5ee7bbd6bfdc784a6890a","logical_entry_identity":"099ae48df76845f402cece5154106597ef5d6d4f78519e03a2ae9941fd718f26","normalized_path":"mod-tome.lua","source":"heavy dwarven-steel armour","source_tag":"_t","target":"重型矮人钢护甲"},{"args_order":null,"call_locator":"1b8d431311822581ca7639e7bdaedbeeff2f096ba5b591e762766f36e50cb352","component":"tome","entry_revision_identity":"25ab171e86922c11f9b6e51c7d249745a4d04065047dc26af9ba787543fd237f","logical_entry_identity":"34f67a042a735a96b164cfe272a570dba7ceaef492929b0d633edbf09a4662aa","normalized_path":"mod-tome.lua","source":"A mature multi-hued drake, armed with many deadly breath weapons and nasty claws.","source_tag":"_t","target":"一条成年七彩龙，拥有许多致命的吐息和锋利的爪子。"},{"args_order":null,"call_locator":"faba5c58dd5e81350247ece2c7adf153f07f1f672750d7e7ba842e3e3ab151f9","component":"tome","entry_revision_identity":"25b263e9fde57cbdd262cc5a7bcdda92b551223d0856b0eeb1449ef3f0b7fbc2","logical_entry_identity":"f5aa04b3811686f4f029e93bfb4e332f9a9037b451d1be343db201d1a345dfb4","normalized_path":"mod-tome.lua","source":"%0.2f Energy Stored","source_tag":"tformat","target":"存储能量：%0.2f"},{"args_order":null,"call_locator":"7e2d3965a1d133ae899ff9e51c414067863d3d2451dfbc12c6e4c8c683624b23","component":"tome","entry_revision_identity":"25b65365852e087320a80f5c9717b3ee473978c74916c01a899e2b89ff65fdbd","logical_entry_identity":"960fd2ef257460b3b25cb9a1c05cb674fc955776a883064a507db0d4b120481e","normalized_path":"mod-tome.lua","source":"#GREEN#You have aided %s in creating an %s.#WHITE#","source_tag":"tformat","target":"#GREEN#你帮助%s制造了%s。#WHITE#"},{"args_order":null,"call_locator":"28c67ea3469ae67d94764ca99ec2189162e83c95d2eb524405e78b33e2916a54","component":"tome","entry_revision_identity":"25b678195fbb4de66c4fc972c035a3d185444e5080ee07706a3f18fca1bf2532","logical_entry_identity":"2f9a3bcd6a5646f0b7293a0a2884796eb8f245dcd46a1fb8d7ddcc37a076f7fc","normalized_path":"mod-tome.lua","source":"The flow of battle invigorates you, allowing you to press your advantage as the fight progresses.\n\t\tUp to once each per turn, while dual wielding, you may:\n\t\tRiposte -- If a melee or archery attack misses you or you parry it, you instantly restore %0.1f stamina and gain %d%% of a turn.\n\t\tRecover -- On performing a critical strike with your offhand weapon, you instantly restore %0.1f stamina.","source_tag":"tformat","target":"战斗鼓舞着你，让你在战斗中获得优势。\n\t\t每回合一次，若你双持武器，你将：\n\t\t反击 -- 如果你闪避或抵挡了近战或弓箭攻击，你立刻回复 %0.1f 体力并获得 %d%% 额外回合。\n\t\t回复 -- 副手武器暴击时回复 %0.1f 体力。"},{"args_order":null,"call_locator":"4bf777ac4d1de2fc618cdd0fd5c78858161944d06fbdaabd581555ea94d9e6ee","component":"tome","entry_revision_identity":"25b7c7460735b1de75d3d1527077eb9434699c4d8c11543fded36320e9ee38e1","logical_entry_identity":"5da24e526a01bd7783b01cccbf9c06a3269e48f6be0c036252b926d5d3fbc46c","normalized_path":"mod-tome.lua","source":"*#LIGHT_GREEN#The creature glares at you with intensity. You 'see' images in your head.\nYou see titanic wars in an age now forgotten. You see armies of what you suppose are Sher'Tuls since they look like the shadow.\nThey fight with weapons, magic and other things. They fight gods. They hunt them down, killing or banishing them.\nYou see great fortresses like this one, flying all over the skies of Eyal - shining bastions of power glittering in the young sun.\nYou see the gods beaten, defeated and dead. All but one.\nThen you see darkness; it seems like the shadow does not know what followed those events.\n\nYou shake your head as the vision dissipates, and your normal sight comes back slowly.\n#WHITE#*\n","source_tag":"_t","target":"*#LIGHT_GREEN#那个生物集中精神注视着你，你“看到”了脑海中的影像。\n你看到了发生在一个早已被遗忘的时代里的浩大战争。你看到一支支军队，猜想他们是夏·图尔人，因为他们的外形与堡垒之影相似。\n他们用武器、魔法和其他事物作战。他们与众神交战，追猎众神，将其杀死或放逐。\n你看到一座座与这里相似的宏伟堡垒飞遍埃亚尔的天空——这些力量强大的璀璨堡垒在尚且年轻的太阳下熠熠生辉。\n你看到众神都被击败、杀死，除了一个。\n随后你看到了黑暗；似乎堡垒之影并不知道那些事件之后发生了什么。\n\n你摇了摇头，驱散了脑海中的影像，眼前慢慢恢复了现实的景象。\n#WHITE#*\n"},{"args_order":null,"call_locator":"5a537846e98130e65a7d20809e9b03247366be145c1b779d7561980fc036636a","component":"tome","entry_revision_identity":"25c43cec7982e5b0b0824abb38903c27979a43d9df37c566fac8d60427f0aca5","logical_entry_identity":"2f86670713c3424a3989c3641fb9aad614c91fded6d905fd3c8dfe55f80ac0d1","normalized_path":"mod-tome.lua","source":"When gaining a combo point, you have a %d%% chance to gain an extra combo point.  Additionally, your combo points will last %d turns longer before expiring.\n\t\tThe chance of building a second combo point will improve with your Cunning.","source_tag":"tformat","target":"当获得 1 个连击点时有 %d%% 概率\n\t\t额外获得 1 个连击点。\n\t\t此外你的连击点持续时间会延长 %d 回合。\n\t\t额外连击点获得概率受灵巧加成。"},{"args_order":null,"call_locator":"a6b1227d0e0de3d03b03e7a6759d8ce6648f0d0c79aa827acdb19c33e970e6d0","component":"tome","entry_revision_identity":"25cb95ef761322ecebd9ab4781e275a7844efd7a8fe518f09832cbac915f4823","logical_entry_identity":"58d09da14410e6fe930b333a6a6203bb18a282e853d3f51fc6702e52bf5b2fb0","normalized_path":"mod-tome.lua","source":"and brought back to Vargh for experimentation","source_tag":"_t","target":"并被带去瓦尔弗成为实验对象"},{"args_order":null,"call_locator":"4ca914876aa69ea17016c9c1bb771365686523f481468c50a834f423515918e8","component":"tome","entry_revision_identity":"25cf3b12a875e9d21f7fe4ec4616e592828cb52c20a88c8986ee8ae288cb45b9","logical_entry_identity":"bfd556f6b99f740fd7686595c65f20a7877a9eac61c2cebfd6cb68b4a2af45fb","normalized_path":"mod-tome.lua","source":"Only one life, unless ways to self-resurrect are found in-game.","source_tag":"_t","target":"只有一条命，除非你在游戏内找到自我复活的方法。"},{"args_order":null,"call_locator":"5f7ff779c21c624e7527091b46242adc64bb8b57844fb4f2f61b186e4d2a01d5","component":"tome","entry_revision_identity":"25d390ebac55758cbb60b792983a8de40da0383b765be6915a8c9fed1cf9338b","logical_entry_identity":"447e2748bcf12dbd79a9523df4ce0dfd50cbc0a2ce88dc63bf613fd4ac5ff720","normalized_path":"mod-tome.lua","source":"Forge a bowman, clad in leather armor, from your thoughts.  The bowman learns Bow Mastery, Combat Accuracy, Steady Shot, Crippling Shot, and Rapid Shot as it levels up, and has +%d Strength, +%d Dexterity, and +%d Constitution.\n\t\tActivating this talent will put all other thought-forms on cooldown.\n\t\tThe stat bonuses will improve with your Mindpower.","source_tag":"tformat","target":"你从脑海里召唤出一位身穿皮甲的精神体弓箭手。当精神体弓箭手到达对应等级时可习得弓术掌握、强化命中、稳固射击、致残射击和急速射击，并且可增加 %d 点力量、%d 点敏捷和 %d 体质。\n\t\t激活此技能会使其他思维形态技能进入冷却。\n\t\t属性增益受精神强度加成。"},{"args_order":null,"call_locator":"de02864ce2277df3828cc8f5edbda2153432c7c94d63c3645f9b45fcd3794aa2","component":"tome","entry_revision_identity":"25d992cef180c32f2a3ff4a61458db03bc56b6f1e943675bf0f54f04a29f5b24","logical_entry_identity":"d0d01f57affb8d0c238e8e9425ca9ed084f37e0ee9d3849613791832073d0249","normalized_path":"mod-tome.lua","source":"Stay there","source_tag":"_t","target":"步步为营"},{"args_order":null,"call_locator":"fb43191096c62e5d5257e26b3ab8973792ff94d6c1a472d43ffd6e513b88e7c3","component":"tome","entry_revision_identity":"25da0d29b163d8ac731318cff2d2eee4fcc44b3752412d0b62286fd4e2aa3b63","logical_entry_identity":"34b165c610712ae6faeec2d6b701d937fdb510594219bd36689cde5d0a79e148","normalized_path":"mod-tome.lua","source":"#GOLD#Spell saving throw#LAST#\nIncreases chance to shrug off magically-induced effects.  Also reduces duration of detrimental magical effects by up to 5% per point, depending on the power of the opponent's effect.\n","source_tag":"_t","target":"#GOLD#法术豁免#LAST#\n增加你摆脱法术效果的几率，此外，基于目标强度判定后，每超过1点减少5%不良法术状态持续时间。\n"},{"args_order":null,"call_locator":"50baae4fb84cf9aa4996a5249075b3167c773205ca06ed62135792c9f538e262","component":"tome","entry_revision_identity":"25dc04938f1592bf9563b06626190b210a5ad2bddf861906a46e0719742e3bb8","logical_entry_identity":"d7b2807bb5e27ddc8e7fcea877081f35c61bafb2168ee66b4ced30dfed3853ae","normalized_path":"mod-tome.lua","source":"#LIGHT_GREEN#* You have explored the Rhaloren camp and killed the Inquisitor.#WHITE#","source_tag":"_t","target":"#LIGHT_GREEN#* 你已经探索了罗兰精灵营地并杀死了检察官。#WHITE#"},{"args_order":null,"call_locator":"2d0bf2f50eaf4265652418ebf5cdf40411c1fa0b772699b90d46dc54b409f9d1","component":"tome","entry_revision_identity":"25dc3afb7963c3056cd7e39a06415e9fdd57ff3d8dcb1cfc13913237622c7200","logical_entry_identity":"8f0681b0dc2c7f17f32fd25d42df4fefd7c7c9edd0b6937b570db6be5eb702f8","normalized_path":"mod-tome.lua","source":"Ah, my dear Borfast, welcome to your glorious undeath! Your armour a cage, your hopes despair, your axe enslaved to my will, your soul mine to feast upon. How does it feel? Rather lovely I like to imagine! You were a valiant opponent, and though you were little threat to me I do like to honour you with this special treatment. And you do like honour, don't you? I know you wished to honour your people by defeating me and destroying my tower, but I'm sure you realise now that it was a rather vain endeavour.\n\nI apologise for what happened to that lovely suit of plate. I know it got a little... worn... during the treatment. But I'm afraid I really did need to find out the locations of your companion, and certain pressures had to be applied. You weren't very talkative, now were you? But I soon made you sing, oh yes. Of course, I could have just used a little divination magic to find out what I wanted, but I do so enjoy a good torture... And my, how joyous your screams were whenever the acid splashed against your beard! Hoh, we did chortle, did we not? But no matter, I've had my best skeletal smiths work on fixing your armour, fit to be worn by my new champion.\n\nI hope you enjoy your new work. Approach it with gusto, that sort of thing. I know in life you always dreamed of being a mighty hero of legend. But, well, what can be more glorious than this? You will live forever as my servant, destined to defend my throne for all time! You will be the envy of all the lesser ghouls that shamble about my halls. Well, until you get slain by some dumb intruding adventurer, of course... But that's the beauty of you heroes - one comes in, makes a mess, and then I get a new plaything to toy with. I wonder who shall replace you, eh?\n\nUntil then, do enjoy the work, try to keep the place clean, and remember - I own you forever.\n\n- The Master","source_tag":"_t","target":"啊，吾亲爱的波法斯特，欢迎迎接汝荣耀的不死新生！汝的护甲成了牢笼，汝的希望化作绝望，汝的斧头受吾意志奴役，汝的灵魂则归吾享用。感觉如何？想必相当美妙！汝曾是英勇的对手，虽然对吾构不成多少威胁，吾仍愿以这番特殊待遇来向汝致敬。汝的确喜欢荣誉，不是吗？吾知道汝曾想通过击败吾、摧毁吾的高塔来荣耀自己的人民；不过如今汝想必明白，那不过是徒劳之举。\n\n吾对那套可爱的板甲所遭遇的事深表歉意。吾知道它在处置过程中有一点……磨损……但吾实在需要查出汝同伴的下落，只得施加一定的压力。汝当时不太健谈，是不是？可吾很快就让汝开口高歌了，没错。当然，吾大可以用一点占卜魔法得到想要的答案，但吾实在太享受一场精彩的拷问了……而且，每当酸液溅上汝的胡须，汝的尖叫何等悦耳！呵，我们当时笑得很开心，不是吗？不过无妨，吾已命最优秀的骷髅铁匠修好汝的护甲，让吾的新勇士穿上它。\n\n吾希望汝能享受这份新差事。拿出些干劲来，诸如此类。吾知道汝生前总梦想成为传说中的强大英雄。不过，还有什么能比这更加荣耀？汝将作为吾的仆从永远活下去，注定永世守卫吾的王座！那些在吾厅堂里蹒跚游荡的低等食尸鬼都会嫉妒汝。嗯，当然，只到汝被某个闯进来的蠢冒险者杀掉为止……但这正是汝等英雄的妙处：一个英雄闯进来，搞得一团糟，然后吾又有了一个新玩物。下一个取代汝的会是谁呢？\n\n在那之前，好好享受差事，尽力保持此处整洁，并且记住——吾永远拥有汝。\n\n——领主"},{"args_order":null,"call_locator":"bf4833f343bd47c7c653e129f0609a7af93966873bd2e36939e65177f5492701","component":"tome","entry_revision_identity":"25dc70c219fafc99aba9b7963ba505bab74f5b15e6b79a3e3f6035c09838741a","logical_entry_identity":"33cdf42ed3eb20237bcc8082841f0dfdee01c5d405eda5ad149b31b9cab1dd29","normalized_path":"mod-tome.lua","source":"I will keep that in mind!","source_tag":"_t","target":"好的，我记住了！"},{"args_order":null,"call_locator":"ca2b3d2d6e324a0fe45f61ffac95c75c98cb2c34d61ff4fc99b571442a24c9f7","component":"tome","entry_revision_identity":"25dd9a8614dfcd338754901