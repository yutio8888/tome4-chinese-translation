c71f5112cb5a5ff49d79e296ca814ad44db54af35793acd6","component":"tome","entry_revision_identity":"1470fbc1fc3a8823711c1ac7532356bcc52457ee0725a9881e8bbe3f8b75d2f2","logical_entry_identity":"4f268f862e908c0b70975c2dd4d99f4625887b20fb1b827058975ff172441ec0","normalized_path":"mod-tome.lua","source":"#GOLD#Linaniil concentrates her formidable will to restore her body!","source_tag":"saySimple","target":"#GOLD#莱娜尼尔集中了她强大的意志，复原了她的身体！"},{"args_order":null,"call_locator":"d157cf377f4800321f0f25c02b882f40d490e30b086a7e56572e64eee135777d","component":"tome","entry_revision_identity":"147128f5a434f722d72cedb8f99b299c309b4659212df2fd49a0c03ffe7411ee","logical_entry_identity":"b0cd087a70adc195bd824022959c92865bfa7558caeed64b868d3218dc8859a4","normalized_path":"mod-tome.lua","source":"How may I be of service, good @playerdescriptor.race@?","source_tag":"_t","target":"我能为你提供什么服务？我亲爱的 @playerdescriptor.race@？"},{"args_order":null,"call_locator":"55c8d048577375321999f90e2530997611a63c4e225cc29fad0e5d0d3a91d43c","component":"tome","entry_revision_identity":"1472ec81b76250d8d28f0125a84066f7a269a2afe937edcb73a89c8d9297f792","logical_entry_identity":"f774579b301d1b3fcc39a6b07fc276a91df6afa7f4321908fbeca9f8186da96f","normalized_path":"mod-tome.lua","source":"#{bold}#Sodelost, Dwarf Rogue#{normal}#\nCan't believe I agreed to this expedition. I suppose it's because I've known Relle for a while. We've crossed paths many times at Derth's trading post. I even gave her a special rate for my services. Sentimental fool! All it's got me is boots filled with snow and a light coinpurse. I still don't understand why these Kingdom types are so enamoured with drakeskin... makes superior armour they say. Pah! If you can't handle metal armour, what business do you have even wearing armour? Leather has about as much use as a halfling tied to a... noises up ahead, must stop writing.","source_tag":"_t","target":"#{bold}#矮人盗贼，苏达罗斯特#{normal}#\n真不敢相信我居然答应参加这次远征。大概是因为我和瑞丽相识已久吧。我们曾多次在德斯镇的贸易站碰面，我甚至还给她的雇佣费打了折。多愁善感的蠢货！结果只换来满靴子的雪和空瘪的钱袋。我还是不明白联合王国那些人为什么如此迷恋飞龙皮……他们说能制成上好的护甲。呸！连金属护甲都承受不了，还有什么资格穿护甲？皮革的用处就跟一个被绑在……前面有动静，得停笔了。"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"9c5578a9655e6dd80db73e1cd996c97dce1bee4abd5e219636a19c81f80a7672"}}