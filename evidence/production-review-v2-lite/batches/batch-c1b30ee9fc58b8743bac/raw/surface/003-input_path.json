839dce7ea9759a9d4ef23dd50c823d99f47e4dbe045cbd34eadab19d","logical_entry_identity":"9496a5fd4fa8d0cfa0671e75eb39caf2ff0e348af4e05a51c9c2f596ee9116c0","normalized_path":"mod-tome.lua","source":"-Woeful Darkness","source_tag":"_t","target":"-恐怖黑暗"},{"args_order":null,"call_locator":"875abd37438480690385cc8cb3cf231c79e749a6aa6a2ad6da47329bf0ae0d06","component":"tome","entry_revision_identity":"dc834efbcf10133ece96e8c584047813d5431817fac1c0df43663f25284050d1","logical_entry_identity":"2b7bcec52f3dd2207cbbb66f452132a270040b32671536c46414b5c96cd3cd46","normalized_path":"mod-tome.lua","source":"Healer Astelrid","source_tag":"entity name","target":"孔克雷夫治疗师亚斯特莉"},{"args_order":null,"call_locator":"2f736bac97d45b1b2c42aca0d7c4e8bf4c394b339984f47a9565cd36914174d3","component":"tome","entry_revision_identity":"dc8cc4f1fbc5b88285a619da5939c5f653a6decbf958cddab92d2313710ea08c","logical_entry_identity":"a6bcfd726ac56fe5e8900d3cb8a9a1ea46485bfe956096651de148f9b5f3f0b6","normalized_path":"mod-tome.lua","source":"As much as I would like to help, our forces are already spread too thin; we cannot provide you with direct assistance.\nBut I might be able to help you by explaining how the Pride is organised.\nRecently we have heard the Pride speaking about a new master, or masters. They might be the ones behind that mysterious staff of yours.\nWe believe that the heart of their power is the High Peak, in the center of the continent. But it is inaccessible and covered by some kind of shield.\nYou must investigate the bastions of the Pride. Perhaps you will find more information about the High Peak, and any orc you kill is one less that will attack us.\nThe known bastions of the Pride are:\n- Rak'shor Pride, in the west of the southern desert\n- Gorbat Pride, in a mountain range in the southern desert\n- Vor Pride, in the northeast\n- Grushnak Pride, on the eastern slope of the High Peak","source_tag":"_t","target":"我真的很想帮助你，不过我们的军队已经十分分散而且薄弱，我们无法直接给你提供军事援助。\n但是我尽我所能，告诉你兽人部落的组成结构。\n最近我们听说部落里在谈论一位新的主人，也可能不止一位。你那根神秘法杖背后的主使，很可能就是他们。\n我们相信，他们的力量中心就是巅峰，在这个大陆的中部区域。不过它被某种护罩保护无法进入。\n你必须调查兽人部落的各个基地，或许你能找到更多有关巅峰的线索，而且你每杀死一个兽人，我们就少了一个攻击我们的敌人。\n已知的兽人部落有：\n- 拉克·肖部落，在南部沙漠的西面。\n- 加伯特部落，在南部沙漠的群山之中。\n- 沃尔部落，在东北方。\n- 格鲁希纳克部落，在巅峰的东坡上。"},{"args_order":null,"call_locator":"69754f452adee7e1616bf816775c00aebb292bd0d970a23e9c679df04f7af8be","component":"tome","entry_revision_identity":"dc95b85d844ded89a331b38566191bb120f6e8acfffe5edc2f120f77fe77392f","logical_entry_identity":"2031287818d6498511914ebd87c255a37991b929646cd7031654e7d4a424f035","normalized_path":"mod-tome.lua","source":"Tutorial Human","source_tag":"birth descriptor name","target":"教程人类"},{"args_order":null,"call_locator":"27d1fe396b13db67a49e523eb96eecc9ad1967ea02e27eb1ecea9c68afbb1745","component":"tome","entry_revision_identity":"dc996550a6ebbb34ec652d60df75dbf2a7339c72ed36f3492e349db79ccee8f2","logical_entry_identity":"b60048b3d51225d71744ebb9113f87c3930b09f16ea35cfbe84ebaa7117fbdc8","normalized_path":"mod-tome.lua","source":"Combined Small","source_tag":"_t","target":"生命值条+小框架"},{"args_order":null,"call_locator":"716d14ac263347f456d9646a626b8c044dfc35532f088ae9be1c4daa105c9f5e","component":"tome","entry_revision_identity":"dc9a9f11c4d6b3f6da57f800ea841bc8c0706deafd0f78e68a84d1dcc9177f74","logical_entry_identity":"a7f50503bea9705f3ced97facd820771b46afafd94a12f4458ca645fa856f033","normalized_path":"mod-tome.lua","source":"throat","source_tag":"entity keyword","target":"伤喉"},{"args_order":null,"call_locator":"62f13d4c7639f6e2d73169c5172f581bd7dfc946f57b1220d41f80f348eab077","component":"tome","entry_revision_identity":"dc9dbb99858c659ef4b5dd2b95449bf92b151b4b7d5ca61cb316c118810f42c7","logical_entry_identity":"7d8527aef399a4d1a6ea44c3430dc0f4404e6db703d3c1de27d46e04240f3f9e","normalized_path":"mod-tome.lua","source":"short length of rope","source_tag":"_t","target":"一截短绳"},{"args_order":null,"call_locator":"2b781c3d8e1cb647be4b0735f82be20dcdc04bd66c4cb8c00f56e8b406f25369","component":"tome","entry_revision_iden