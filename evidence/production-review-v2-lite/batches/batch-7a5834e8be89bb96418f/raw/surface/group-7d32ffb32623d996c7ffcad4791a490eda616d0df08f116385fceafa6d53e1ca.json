nt":"tome","entry_revision_identity":"34207667e9e16595693629d3d0340997bb91d8ae605d56cdd88b5935c4dcc549","logical_entry_identity":"7e2df69a1822a11954a8d364e0a9a2860d637a04807c9e8a6712230e412d2f4b","normalized_path":"mod-tome.lua","source":"#F53CBE#%s harrows %s!","source_tag":"logSeen","target":"#F53CBE#%s惊扰%s！"},{"args_order":null,"call_locator":"72f70370cfd8720c64860a78dab44ee152a826c578ecdef3f1d21de290df612c","component":"tome","entry_revision_identity":"34293cd47cfb3266200ab2224bcc1156947b1a160f258cf3ae94e9930cd8adca","logical_entry_identity":"ff00295cc85d4f2283c163c059cc8eb1527c6fe2d8a39a16dab8ce4fda3a627e","normalized_path":"mod-tome.lua","source":"Hymn of Shadows","source_tag":"talent name","target":"暗影圣诗"},{"args_order":null,"call_locator":"8b827372b0375da7737770e78197bd071821b994fdb1a3c34bf51954adb8fbe7","component":"tome","entry_revision_identity":"342afebb000d823aa8fd0c97a4b00abe88999974dfa5dfb5a8786c938e989f73","logical_entry_identity":"e54365ab7520acaa11d4a20d154c7238a8d65c91677ee871f558941f6590fd18","normalized_path":"mod-tome.lua","source":"OVERKILL","source_tag":"_t","target":"超杀"},{"args_order":null,"call_locator":"1c61bdf75d987eb2059bebf717c3e943bd140335eb7a6b6ac735621c1cb144c7","component":"tome","entry_revision_identity":"342bdf9e04c3649e8db42b3d3f8c55d832be559a21486f9cc430995534b02271","logical_entry_identity":"0f03ee178d63f9a71105b74cdd425f22a3cf30c80df963dbe4ab8f6d7ec47d8f","normalized_path":"mod-tome.lua","source":"Call Shadows","source_tag":"talent name","target":"召唤阴影"},{"args_order":null,"call_locator":"d1719ca7773f14a26a0ee129ab6bfee0a8fe769c2c2aeebbc583ff8c95bf812a","component":"tome","entry_revision_identity":"34308e5a7280df939526b13983c7671ebd3c4700fd98ac5e0d351f78ed7d105c","logical_entry_identity":"9368c4ebc855035693c9be3ddfb955aea019b2705aaabaee10c006fadb79d298","normalized_path":"mod-tome.lua","source":"A Paradox Mage studies the very fabric of spacetime, learning not just to bend it but shape it and remake it.","source_tag":"_t","target":"时空法师研究时空的结构本身，不仅要学会扭曲它，还要塑造它、重塑它。"},{"args_order":null,"call_locator":"f2763b2325f41f320198adb0c016ed3fefaec9f6b1887f3b6ed5b91051498c27","component":"tome","entry_revision_identity":"3433015143fcfb241e16eebe005812841b69f7ca97d48c2ab918e3a6314020cf","logical_entry_identity":"e10bfedc818b94d957207c8f05776b3b4beef9d0faf28003416e54b6022142ef","normalized_path":"mod-tome.lua","source":"nothing","source_tag":"_t","target":"没有东西"},{"args_order":null,"call_locator":"a124e9ea98f4f545009e9b5a6172acaab98e379c048ede2df3e8c4ff4f9b3a0a","component":"tome","entry_revision_identity":"3436da35ee3edd9669c10a2a7a7c6ae46f902aadffa548fd52f37fdfa4fa212d","logical_entry_identity":"e8ec03807b6c5492a2ff0a3859f4922e191a82a7429f4f62f9abacfc63730d77","normalized_path":"mod-tome.lua","source":"Welcome #LIGHT_GREEN#@name@#WHITE#.\nYou died ages ago, but that did not stop you. You were raised as an undead ghoul.\n\nYour Necromancer master has plans for you, but something is wrong: you seem to have kept your free will.\nGet rid of this evil mage and try to find a place in the world.\n\nYou have been raised in a place called the Blighted Scar, on the northern border of the Shaloren lands. Escape this forsaken pit and try your luck in old forgotten places.\n","source_tag":"_t","target":"欢迎你 #LIGHT_GREEN#@name@#WHITE#！\n你早已死去，但死亡没能阻止你。你被唤醒为一个亡灵食尸鬼。\n\n你的死灵法师主人对你另有安排，但出了点问题：你似乎保留了自由意志。\n摆脱这个邪恶法师，努力在世界上找到自己的容身之处。\n\n你在永恒精灵领地北部边境一处名为荒芜之痕的地方被唤醒。逃离这个被遗弃的深坑，到那些遭人遗忘的古老之地碰碰运气。\n"},{"args_order":null,"call_locator":"f1ff60c5e3f0e12a3b0865b23d3962945b81e4ccfcbc66dc97e4f127767da392","component":"tome","entry_revision_identity":"343727bbca1d41c4a6b7deab9d2071d986ec668265abbcf3db432778854613a2","logical_entry_identity":"4a6a37eebaa0a36cc0c3539a4c139e14a0d717f71c09e159f71cbdf84cb2cffa","normalized_path":"mod-tome.lua","source":"#GOLD#Heightened Senses#LAST#\nSpecial vision (including infravision) that works even in the dark, but only creatures can be seen this way.  Only the best ability is used.\n","source_tag":"_t","target":"#GOLD#强化感知#LAST#\n特殊的视觉范围（包括暗视），即使黑暗处也有效，只能发现生物。不同类型视觉取最大值。\n"},{"args_order":null,"call_locator":"f3794bd783b6077839dc6784fdc9236c85a4d8b060e05a0037ee46333e66b07b","component":"tome","entry_revision_identity":"343a4bb839945822f36be0bfffc5f375a1ad256ff642449cb4290f9b835d03be","logical_entry_identity":"a65cbb34bf73f7305942c53f436782c24b2bf04228791652b265fd6d630bd9f4","normalized_path":"mod-tome.lua","source":"orc necromancer","source_tag":"entity name","target":"兽人死灵法师"},{"args_order":null,"call_locator":"313633b0f1c414f7741dfa475fc61ea4fb987ba4f23140d7ad416da0c922053a","component":"tome","entry_revision_identity":"343ba4e62516f097715d6081aafae5127f80f5c03908681c4d9487ed85245af9","logical_entry_identity":"535ae18a5d698f0572b3035ce9f6ca59f4dcb1e390863be2f76020f1d936802c","normalized_path":"mod-tome.lua","source":"Worldly Knowledge","source_tag":"_t","target":"渊博学识"},{"args_order":null,"call_locator":"a689098b1dca62a99ad768c18a2a92e60c862eee986c152b41c8f97a58a3a138","component":"tome","entry_revision_identity":"343cf71ea926def0cbbf48d49e042cfd209dd2762a5837d79a25dad7a75486ce","logical_entry_identity":"8b8fa76f2ed84febd708817ccb934389247f8ac232e4d8f8dc62fe7a5cd07208","normalized_path":"mod-tome.lua","source":"Sorry, it seems I lack some stuff. I will be back.","source_tag":"_t","target":"抱歉，我去拿点材料，马上回来。"},{"args_order":null,"call_locator":"f209abf5af576484418d9058b105261f52cea4e0a34248c05b78196b56cfd500","component":"tome","entry_revision_identity":"343d5c563663ab4aa0daf2ba0581ea5e61ad03e69a67ae614696cd9ed8f89194","logical_entry_identity":"96b5d7ca9787aa161ed62a63d39bf2acd204760f61a6f7af46cbe92d6b8bbeff","normalized_path":"mod-tome.lua","source":"windy gem","source_tag":"_t","target":"微风环绕的宝石"},{"args_order":null,"call_locator":"19290dffcc7a6c71357b2f6091a05aaf5e0d1450faa128b3a8c48e70d4825328","component":"tome","entry_revision_identity":"343e33048638c01597662e423dc57eebd6420a4ee548649d766435e1481a2fc4","logical_entry_identity":"24fc548a944a014a173102520877966b1a7780c496c57bfce8e942449718282c","normalized_path":"mod-tome.lua","source":"You tried to kill yourself to prevent you from doing something, or going somewhere... you were not very clear.\n","source_tag":"_t","target":"你尝试杀掉自己，以免他做什么你不知道的事或者到某个……你也不清楚的地方。\n"},{"args_order":null,"call_locator":"13671dd04898944cd1024424a4ac66c9cd33d6e948e9f350dae85512cc5fd2e4","component":"tome","entry_revision_identity":"343ec476dcf60e2b4ee3265a0e067cd45c2418df835f4b1680ca11b53109e05c","logical_entry_identity":"2405f0e883b928559a45d30833964a78a214972281815ad20c52e625506099f2","normalized_path":"mod-tome.lua","source":"You prime your Hidden Blades to cause bleeding and facilitate the Assassinate ability, which allows you to strike twice for %d%% unarmed damage, hitting automatically while ignoring armor and resistance.","source_tag":"tformat","target":"你的隐匿刀锋会触发流血效果，并启用暗杀技能；暗杀会以 %d%% 徒手伤害攻击两次，必定命中且无视护甲和抗性。"},{"args_order":null,"call_locator":"adf528fa08115ada4e97f3ae062189612d1737877adf4795e5bf42980e8da6e7","component":"tome","entry_revision_identity":"344580ae8c5c023ae1a97fc68c7fa62bc8115967c300b927c845eeaa79f9ccd0","logical_entry_identity":"c7cd507bad6eb9794336d452d64035605f6daee7e1592bc22666bd03aebe335f","normalized_path":"mod-tome.lua","source":"From death comes life!","source_tag":"_t","target":"我的牺牲将带来永生！"},{"args_order":null,"call_locator":"0fc5794cb35e7588f029648b58f9e5ad5a57ec16efbb06689eacf2b44e757451","component":"tome","entry_revision_identity":"3446c624a2756cc530c063672094ce5aa9013b266180bf3f0e7d135c74370ee4","logical_entry_identity":"cf67a85d983fe59b59177a02ac99e943cc828dba02880b83076675b227922d5e","normalized_path":"mod-tome.lua","source":"dremling","source_tag":"entity name","target":"德瑞姆亚种"},{"args_order":null,"call_locator":"977755d9b743c446bc2335283ac0cde8454d173bda383ec89209cb199bbfd424","component":"tome","entry_revision_identity":"3447323fb9b62802592ca3851bdf89a34a012671258f95ae1a8a716a838b9e6a","logical_entry_identity":"2db6dee5d7a5b1039f97ae53cb3a757366fadab59a74ee0efcb700f345765877","normalized_path":"mod-tome.lua","source":"The Shade","source_tag":"entity name","target":"暗影骷髅"},{"args_order":null,"call_locator":"d813eac432771687ae910afae21ff4936843e9528475069f42f60b052d7bc3a5","component":"tome","entry_revision_identity":"34475db9b1986168e05f451ac28eedc01384085c5af842806e8cf246669675c8","logical_entry_identity":"7e9f1189f4484b6d03372af293a63c3577b546083739a79dbab2a608b0e16934","normalized_path":"mod-tome.lua","source":"Well, it's like this, one of my wife's friends has gone missing. A young alchemist in training, called Celia. Thing is, her husband died recently, and the grief done drove her mad. She used to go out to his grave every day, until one day she didn't come back. Personally I don't think she was able to live without him; the two were inseparable. If you get a chance on your travels, could you pass by the mausoleum to the east and check... well, you get the idea.\n\nIt's strange what death can do to people, how it can take over their minds. Sometimes they forget it's the living that matter... See she gets a proper burial - treated respectfully, eh?","source_tag":"_t","target":"好吧，事情是这样的，我老婆的一个朋友最近失踪了。她是一个实习炼金术士，叫做塞莉娅。最近她的丈夫去世了，这件事让她悲痛欲绝。她每天会到她丈夫的坟墓那里去，直到有一天她一去不回。我个人认为她没了她丈夫活不下去。他们两人形影不离。要是你途经东边的墓园的话你能不能去查看一下……你懂的。\n\n我很奇怪死亡到底会对别人产生什么影响，它又是怎样占据人的内心世界的。有时候他们甚至忘了那些活着的人才是最重要的……请确保她得到妥善安葬——要体面地对待她，好吗？"},{"args_order":null,"call_locator":"3c165e452861b177d4d1ddb247c10b1cf4f86412d3e13df7a99fcc555bd8fc59","component":"tome","entry_revision_identity":"344b1a06a34de338418f93679d9f672dc9ed18a70011849f201f17a563e9b712","logical_entry_identity":"10c173465d843d3c63b4f210546d2e5f289a567674bad83bf375cf0a27b32f77","normalized_path":"mod-tome.lua","source":"dwarven-steel shield","source_tag":"entity name","target":"矮人钢盾"},{"args_order":null,"call_locator":"c14e29788dd8795e97bafa4d2e95629c18644a44b5d326c37d157549b093101a","component":"tome","entry_revision_identity":"344ea3f421396cc00d089460da54e508268370f30b0a7b6209bd8bafcc6924b5","logical_entry_identity":"4e790a9ab3d530c7b1ece5f93b3c730790323576d683b61a1f06134252f2898c","normalized_path":"mod-tome.lua","source":"It's yellow and it's oozing.","source_tag":"_t","target":"又黄又粘的软泥怪。"},{"args_order":null,"call_locator":"60c37e36fa73f80736950d2068aaa832035d897c67d5098df4b43c89bc2e2581","component":"tome","entry_revision_identity":"345142905e42ff6303002f59a41b4031a4be63ff54ba9b87006007cf360eea81","logical_entry_identity":"c68d3db724470b13404b440b071a62eda32a05c5b600316c79650b3af09ba753","normalized_path":"mod-tome.lua","source":"You convert %d%% of all non-temporal damage you receive into temporal damage spread out over %d turns.\n\t\tThis damage will bypass resistance and affinity.","source_tag":"tformat","target":"你转化所有受到的 %d%% 的非时空伤害为持续 %d 回合的时空伤害释放出去。\n\t\t造成的伤害无视抗性和伤害亲和。"},{"args_order":null,"call_locator":"7983c84a462c66d969976553b6b46ae3009f9eb7a909d1e46181b6e4e20c9ca3","component":"tome","entry_revision_identity":"34587689d96ddc38b839733db9d680660929e3ffa683fd2e89644e883eb95143","logical_entry_identity":"d9153ec5e63fbf285fe755c3e0cc74b47802ab657e4c5cd6ad11626edfd3ce03","normalized_path":"mod-tome.lua","source":"There are creatures that could be watching you; you cannot take the risk of teleporting to Angolwen.","source_tag":"log","target":"有生物可以看见你，你不能冒这个险传送安格利文。"},{"args_order":null,"call_locator":"afc82816090f29610d069948469d38347df161b641f25de7069fd5224fc00b1d","component":"tome","entry_revision_identity":"3458cf588bd44e9e21cbafce2bb585fe93b0b595da7ff9b968a51893b62d45e2","logical_entry_identity":"ca329de2543473ff9ffab0b76d98401822c0c7122148c526f53f778f21ec4919","normalized_path":"mod-tome.lua","source":"All known spells that can be used with Arcane Combat.","source_tag":"_t","target":"所有可以被奥术格斗施放的技能。"},{"args_order":null,"call_locator":"04c11affd20b8635ce9a5782db6f6facbff141909701fd68885662e0b4c61065","component":"tome","entry_revision_identity":"3459dc7ee4d0fdf21b9ea19285a5a962029ba88c5624b8610ee0d71c8243b0cb","logical_entry_identity":"7d2d0eb9f7a62787b173cf63ee0af5298cf32db445a23eb336d19c9d06c78a9f","normalized_path":"mod-tome.lua","source":"Thaloren-Tree Longbow","source_tag":"entity name","target":"精灵树长弓"},{"args_order":null,"call_locator":"9741c72e8fbc2815103294ba91345dbc3c58f7dd0850e52435c456579ac314c8","component":"tome","entry_revision_identity":"3464f08fb97ff89af08c5e6bcd078274dfa274717e19bc5e0e6f367065b8c6e3","logical_entry_identity":"97b624e5874834e6bde5c8045b53af7ad6c32f45f2cb57334054e7795b341991","normalized_path":"mod-tome.lua","source":"age of allure","source_tag":"newLore category","target":"厄流纪"},{"args_order":null,"call_locator":"f4c8409845507910a0acf6368b8dde7c17d5e3425686af71a145aedf17ef9299","component":"tome","entry_revision_identity":"34682b3669d39d022b95c01ffd21beb64130340bcde0b56407b67b64a1750168","logical_entry_identity":"24ffa583796c9d781caecc578d0254f12abe1e971127877a6f37344d6752267e","normalized_path":"mod-tome.lua","source":"#Target# is stunned further! (now %d turns)","source_tag":"tformat","target":"#Target#被进一步震慑了！(现在%d回合)"},{"args_order":null,"call_locator":"01dbefafc94b7b308c4ecc39937a1112581246755246fe08f9dffbef6692404f","component":"tome","entry_revision_identity":"346a51b19cfef4b847f37da24905fcd2c777fb47e7fae85cab81b6203176dce8","logical_entry_identity":"3d58830ca8b784a741ea6d2b4ab31adafd9a6aaa5bc3e9dbc76f6a40ea74ad5b","normalized_path":"mod-tome.lua","source":"Destabilizes the target, inflicting %0.2f temporal damage per turn for 10 turns.  If the target dies while destabilized, it will explode, doing %0.2f temporal damage and %0.2f physical damage in a radius of 4.\n\t\tIf the target dies while also under the effects of continuum destabilization, all explosion damage will be done as temporal damage.\n\t\tThe damage will scale with your Spellpower.","source_tag":"tformat","target":"使目标所处的时空出现裂隙，每回合造成 %0.2f 时空伤害，持续 10 回合。如果目标在被标记时死亡，则会产生 4 码半径范围的时空爆炸，造成 %0.2f 时空伤害和 %0.2f 物理伤害。\n\t\t如果目标死亡时处于连续紊乱状态，则爆炸产生的所有伤害会转化为时空伤害。\n\t\t伤害受法术强度加成。"},{"args_order":null,"call_locator":"03e53c67b544f05448e8747b530d0f7498ca51fc41ba299c47ae0bcf5b1042e1","component":"tome","entry_revision_identity":"346b9d5ac15e9a84a68b201b9e30c1c7198ecb7d80e0df23169275e76a8ddc44","logical_entry_identity":"b416f8e7bada07dabc5375e5e1d6d4be76d13b005b9e33c230327f467485f8aa","normalized_path":"mod-tome.lua","source":"sacrificing %s for the sake of the world","source_tag":"tformat","target":"%s为了世界牺牲了自己"},{"args_order":null,"call_locator":"5af3c1e4b08aa409183e36ffb145b40ba187737cc0de041ee2fa7984450aefa3","component":"tome","entry_revision_identity":"346bdcff015992d91fa4ce1b42aa85a697c3a0611e7ebfb517a046a98358aa56","logical_entry_identity":"04faeba4819dc00e1033f952dc491eb8bc761455d84e812e8b5ae5b5cc1e2efb","normalized_path":"mod-tome.lua","source":"Weakness Disease","source_tag":"_t","target":"衰弱疫病"},{"args_order":null,"call_locator":"220f915d64865b97591f01613355760f1aee98141fb537715f7dcacff72f06b3","component":"tome","entry_revision_identity":"3472441ffdb53ba02a3b6bc627938af53cae5d9472dbd63070aee7dc2d7af5be","logical_entry_identity":"0d9fcdf059c76f542c08cc4354d6c3addc7e4b6e8f362f6aa499a12f52632d3f","normalized_path":"mod-tome.lua","source":"Travel speed: ","source_tag":"_t","target":"飞行速度："},{"args_order":null,"call_locator":"c459dbb1b0085528159c19694c74cae2db41ecef50ffb88d6040c1278d3e1ef4","component":"tome","entry_revision_identity":"3472a67231002a6442be2ee833832ff83872f6e0106702fa3506ef43cca5cf67","logical_entry_identity":"f0fb54b265f780dc80fd08b72d0cb8510b95d96f0cf8d346ecd77a2f328686e7","normalized_path":"mod-tome.lua","source":"a gray and gold pendant","source_tag":"_t","target":"一个灰金相间的垂饰"},{"args_order":null,"call_locator":"32d382c0910c5929357ad8105a70df9257ddb4bdba7eeef87b268faf1ec9b7d8","component":"tome","entry_revision_identity":"34769779e895f81d1eb796d447dfcf11b987098c367e6c41a2115f3776578708","logical_entry_identity":"61415c65d2ed01f56e9b4da87aefbcb24848f9d1f37d5888807690944866276a","normalized_path":"mod-tome.lua","source":"%s says: '%s'","source_tag":"logSeen","target":"%s说道：“%s”"},{"args_order":null,"call_locator":"3853474a0a19adf1741b4b8f80ee26689c48df37919183004e4835fe1a348f95","component":"tome","entry_revision_identity":"347741664dfbdeba2c6cff4ebcda23e72ef1eed99a830cc78444575c529be381","logical_entry_identity":"87b17e59979b3064cd2e8ceefd883c1ec8b990c742d49ad85b00c7b36b83c85c","normalized_path":"mod-tome.lua","source":"Windblade","source_tag":"talent name","target":"剑刃风暴"},{"args_order":null,"call_locator":"ea5199a99ab436f63620c7e3bc0ec68e5acff87743bc8445a84aa02f362f1562","component":"tome","entry_revision_identity":"347d19060a28797e1bd4f02beaf5a1bc275c4a5e6f9e48b4d7586448230c7c8a","logical_entry_identity":"9f28d20c3d955b55a20b739bdceb653607892789c60a1768ace458a3d2325139","normalized_path":"mod-tome.lua","source":"+Unraveling","source_tag":"_t","target":"+解体"},{"args_order":null,"call_locator":"31cb10712e81d1c60e24b703b60519708bcdc92e03c91932be00473e9a2b7ee6","component":"tome","entry_revision_identity":"3483acbd787763b9089aa4ed8e02dfe511ee7213864b878f823c22a67c091cc3","logical_entry_identity":"34a4754454cbadfb35b65994acae217a78bbdea93a952645cba31837daf0746d","normalized_path":"mod-tome.lua","source":"Phoenix","source_tag":"entity name","target":"不死鸟"},{"args_order":null,"call_locator":"9612c985e9b426ce82ee26606abd4aa1688444b2b96018bb7f0ddcd22143c0e3","component":"tome","entry_revision_identity":"3484a96d4d669c82b48b6690530d76d0e385d0822debe50d3af77317efa392b7","logical_entry_identity":"4cc112bb4028c79691c8a9714708e4c1bf96fe03526bf25c86c856a3abe7a6a2","normalized_path":"mod-tome.lua","source":"My dragons bring news. They witnessed humans upon the High Peak, speaking of their mastery over our prides. They did not heed my dragons, unwitting of their ability to communicate with me. Now I possess this information, I must think deeply on how to proceed regarding our \"masters\". Many of my finest wyrmics wish to rise up against our deceivers, see them consumed in wyrmfire. Even some of my dragons have divulged this wish to me. Sadly, this must wait.\n\nVor's insolence will be tolerated no longer! His claims that his pride's mastery over the elements surpasses that of the dragons is insult enough, but this...! Some of my finest dragons, my glorious multi-hued wyrms, have been captured and held within their armouries in the hopes that they can further their twisted mockeries of fire and ice! This will not stand! I must ignore the plots of our human deceivers for the moment, for Vor requires my full attention.","source_tag":"_t","target":"我的巨龙带来了消息。它们在巅峰上目睹了人类，正谈论着对我们各个兽人部落的统治。他们没有防备我的巨龙，根本不知道它们能与我沟通。如今掌握了这情报，我必须深思该如何应对我们那些“主人”。我手下许多最精锐的龙战士都渴望起事反抗那些骗子，亲眼看着他们被龙火吞噬。甚至连我的一些巨龙也向我吐露过这一愿望。遗憾的是，这必须暂缓。\n\n沃尔的傲慢无礼绝不能再容忍了！他声称自己的部落对元素的掌控超越了巨龙，这已是奇耻大辱，但现在竟然……！我的一些最顶尖的巨龙，那些光辉灿烂的七彩巨龙，竟被他们捕获并关押在军械库中，妄图借此推进他们对冰火之力的扭曲亵渎！这绝不能容忍！我必须暂时将人类骗子的阴谋放到一边，因为沃尔需要我全力应对。"},{"args_order":null,"call_locator":"69b7ee1eb66163d93563d0c70c52be30bca439eefd52a4edafd3c82bf12aa3a3","component":"tome","entry_revision_identity":"3489a9d20a46f3a1bf0f040168bdba415c4909b87bbd334f91fb842ca5efaf98","logical_entry_identity":"5849d40fc24f676066ed05ecb81d0b78fac64f1452385238b7252bb7e0cc63f8","normalized_path":"mod-tome.lua","source":"You brought back the diamond and athame to Tannen who asked you to check the tower of Telmur, looking for a text of portals, although he is not sure it is even there. He told you to come back in a few days.","source_tag":"_t","target":"你把共鸣钻石和仪式匕首带回给泰恩；他让你去泰尔玛之塔寻找一本有关传送门的典籍，尽管他也不确定那里是否真有。他让你过几天再回来。"},{"args_order":null,"call_locator":"0811b69836d0883ec9b6fe52b70b7f6f12db89787839852ad3b65ba1134fe77f","component":"tome","entry_revision_identity":"348f097c2816e9f8a7112d2780d7a4cf9737336f00af4e0a13bbbbbd44a3f757","logical_entry_identity":"e7f83208bf6c329ca5f486b0cb55e110c86c643547269a5f9e00bf44b41fea43","normalized_path":"mod-tome.lua","source":"Secrets of Telos","source_tag":"talent name","target":"泰勒斯之秘"},{"args_order":null,"call_locator":"148ec914be979191eab09fcde5adac1bd3700b438e13827378fe2085a041cc9a","component":"tome","entry_revision_identity":"3491121ffe0fc241ac581ece942561373dd300c94b41fbb21adaf4fd909ebc0e","logical_entry_identity":"1214c9bd0919acb602d8013f0025f59c0f4b3a01f36de727a845a1559295bd32","normalized_path":"mod-tome.lua","source":"blinding powder","source_tag":"damage type","target":"致盲粉"},{"args_order":null,"call_locator":"0c6693c62f1531c7eec82864e85c93d8f5c9f2eb89f9c83dcca220e074878a4b","component":"tome","entry_revision_identity":"34915242e123ee8e68aae9edb587e5fe07a14c73b1ff491e056a13956639a45c","logical_entry_identity":"386114f90edbcf102be17430a41d6a15e76fb3f0c233aad03f73460a0ee7ec8c","normalized_path":"mod-tome.lua","source":"Casting beam spells has become so instinctive for you that you can now easily weave in other spells at the same time.\n\t\tAnytime you cast a beam spell there is a %d%% chance to automatically cast an offensive spell that you know.\n\t\tBeam spells duplicated by the Orb of Thaumaturgy can also trigger this effect.\n\t\tThis can only happen once (or twice with Orb of Thaumaturgy) per turn.\n\t\tThe additional cast will cost mana but no turn, will not active its cooldown and can trigger on spells currently on cooldown.\n\t\tDuring Aether Avatar only compatible spells are used.\n\n\t\tEligible spells: %s","source_tag":"tformat","target":"释放射线类法术对你来说如此自然，以至于可以和其他法术穿插释放。\n每当释放射线类法术时，你有 %d%% 几率自动释放一个已习得的其他攻击类法术。\n奇术之球复制的射线类法术也能触发这一效果。\n该效果每回合只能触发一次（有奇术之球时最多触发两次）。\n额外施放会消耗法力，但不消耗回合，也不会触发法术的冷却；即使法术当前处于冷却中也可以触发。\n以太之体状态下，只会释放以太之体下能释放的技能。\n\n可触发法术：%s"},{"args_order":null,"call_locator":"9af8327f54e8166cffa992a23c45015e198602a307398568d5ac92bf8a790b97","component":"tome","entry_revision_identity":"349263c346bcb5326277668a246e65130b05757467e603902222c90500b97f52","logical_entry_identity":"56459d8c22c7effd7cf58653c877c311e875d5ed6dc2fa253ae71980b8d7adea","normalized_path":"mod-tome.lua","source":"pile of tendrils","source_tag":"_t","target":"一堆卷须"},{"args_order":null,"call_locator":"c8ec6dc9ed7e6cd0d92287f272d98a7