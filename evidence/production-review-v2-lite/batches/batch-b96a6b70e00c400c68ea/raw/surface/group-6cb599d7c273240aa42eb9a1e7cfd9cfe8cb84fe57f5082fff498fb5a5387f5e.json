entry_revision_identity":"bafd7b00adfab1262419e5496a78041e4e643b022237efdd94bbd95e8be9cf7b","logical_entry_identity":"0522bd80179046eb75c65531161ef04aaf0d58a0ebd54ceb317792c3786f6cdb","normalized_path":"mod-tome.lua","source":"Breach","source_tag":"_t","target":"破防"},{"args_order":null,"call_locator":"0c34739e79ba8d591408802c1e6d8ef7b7e2a51f88e610d8ed6a8d2e3ec66026","component":"tome","entry_revision_identity":"bb003611a0893ff9a8d2bd3410a3f6a0ca2b8065325a4de2fe206591298e7f06","logical_entry_identity":"789aaa8c9c5681595b69c61bc94daf637cd1988ffb7e55d62ae5ba9077dac6d8","normalized_path":"mod-tome.lua","source":"Chronolith Twin","source_tag":"entity name","target":"双生琼纳里斯"},{"args_order":null,"call_locator":"de877925be092250794cce9cfb4fad90bd1bdedf1de1c0697060b4378ce81584","component":"tome","entry_revision_identity":"bb00681b54866291ab151dcfdb04bd1592d6aff4d6500e5348fcb578f2e1372d","logical_entry_identity":"7e6b3acb88baec4362640e959cc05e95266aa221f3a642c03f02080b6b9b6961","normalized_path":"mod-tome.lua","source":"Redux","source_tag":"talent name","target":"时空回响"},{"args_order":null,"call_locator":"be837210ae01a05727f74b6ee886e0454f86aa86c928b3e90d8cf380c5ed1061","component":"tome","entry_revision_identity":"bb011472810985738e4e5bd56fbed9585408b4741c87392db6e047fc781e5999","logical_entry_identity":"5f4a9f2865b2c71eca43651defaed60f3c128c3b128526c19a0117820d899089","normalized_path":"mod-tome.lua","source":"Excellent. Now then, I've three elixirs I'm working on. I'll burden you with only one at a time, since I've learned the hard way about the hazards of overloading an adventurer's brain. Here are your options: the elixir of the fox, which makes you as nimble and cunning as a fox; the elixir of avoidance, which sharpens your natural inclinations to get out of the way of incoming harm; or the elixir of precision, which grants intuitive understanding of an enemy's most sensitive spots. Which would you like to aid me with?","source_tag":"_t","target":"太好了。那么，我目前正在研制三种药剂。我每次只交给你一项，毕竟我曾吃过苦头，深知让冒险者的大脑负荷过重有多危险。以下是你的选择：狡诈药剂，能让你如狐狸般敏捷狡黠；闪避药剂，能磨砺你躲避来袭伤害的本能；或是精准药剂，能让你凭直觉洞悉敌人最脆弱的要害。你想协助我制作哪一种？"},{"args_order":null,"call_locator":"dfa8239ac91c49a75ce993be1ead252407ce2331ad47563d35d16bede1814dd3","component":"tome","entry_revision_identity":"bb059e37514ba5cc19a942c31bad0de6deeb9b2603f666c8b3985f4feedf4628","logical_entry_identity":"c3de1b1de0759ddf2fceb5f03245b9bc007ed5f7651fb715c15f65fab2136a15","normalized_path":"mod-tome.lua","source":"Grim Shadow","source_tag":"talent name","target":"冷酷阴影"},{"args_order":null,"call_locator":"4d4cc633be8f4bba7d045a01dc526f17beab2ca9488c0ab0371c054b30380ff1","component":"tome","entry_revision_identity":"bb094d0305f13bd186a95402393d445cdbfbf04b6d1235c6ac6ea094f12689a6","logical_entry_identity":"200a0c2937ce572c1d39ec7f48b5e9613c6322f40ce6b6dfc0153fb32f5bb40b","normalized_path":"mod-tome.lua","source":"stone","source_tag":"talent type","target":"石"},{"args_order":null,"call_locator":"6d9a5943839006edc188a6c823357c3245e676efbb0d5fda526f8590f668360f","component":"tome","entry_revision_identity":"bb095f72a07e8bc1abf4b5605e2743c5c2e1445040565e49e4107ca6cac31aa4","logical_entry_identity":"4aecec0e39b843457087aa3c0a2350de5cfc0c0ab46f5b3e656acdf2058f5e35","normalized_path":"mod-tome.lua","source":"#LIGHT_RED#EXTERMINATE THIS FOE#LAST#\n%s","source_tag":"tformat","target":"#LIGHT_RED#歼灭这个敌人#LAST#\n%s"},{"args_order":null,"call_locator":"8e12391aa2a2c5692ccf3a3bce0d7e0c334a10843e1bf713d70f79982777bc23","component":"tome","entry_revision_identity":"bb0aa211ac3ed7f82957d50ca8dc2ee0baa8b0549df50fad42a0713c6a8cf145","logical_entry_identity":"060ae24ff908c1def08943a77bf3dc71ba49c4d2b2312afb30e2fe4d04000e50","normalized_path":"mod-tome.lua","source":"Object can be used.","source_tag":"_t","target":"物品可以使用。"},{"args_order":null,"call_locator":"28fd87546acde6f585f9281e3660985b5f1cbcf5d0d868daed088b907d6cce12","component":"tome","entry_revision_identity":"bb0ee40cbd58330d31da0a8ce4cb78531529454d74dd3019e24b5f0c84437a0c","logical_