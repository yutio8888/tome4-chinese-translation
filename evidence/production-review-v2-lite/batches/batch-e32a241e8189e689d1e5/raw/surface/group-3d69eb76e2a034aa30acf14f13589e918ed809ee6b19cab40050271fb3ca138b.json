:"tome","entry_revision_identity":"deb2a18bf888405ce53787d0cb4ddb6388218c6a0b3b32d0104b11a1e4ef7217","logical_entry_identity":"924e5ac765d3d5b49f97f1caab11de96283fdc6c1ad953c600c1fe0640720be7","normalized_path":"mod-tome.lua","source":"High Peak (%d)","source_tag":"tformat","target":"巅峰 (%d)"},{"args_order":null,"call_locator":"b31fff6eae5adf0455697c489909a0f6ca9d18e57853ca1818484d42b7f257e7","component":"tome","entry_revision_identity":"deb2c9c3a7c1f1edb30c2c981c79be67bc27191fa93f6ddbd689b8820b8b1961","logical_entry_identity":"8a6ff23e6a461d9e0d442c22133c6b748f69096e29c656f64553735eb98b8609","normalized_path":"mod-tome.lua","source":"Feed from the essence of your enemy. Draws %0.1f hate per turn from a targeted foe, as long as they remain in your line of sight.\n\t\t\tIf you aren't already feeding this will be automatically applied to the nearest enemy.\n\t\tHate gain improves with your Mindpower.","source_tag":"tformat","target":"吞噬敌人的精华。只要目标仍在你的视野中，每回合便从其身上汲取 %0.1f 仇恨值。\n\t\t如果你尚未以任何目标为食，此效果会自动施加到最近的敌人身上。\n\t\t仇恨值获取量随精神强度提高。"},{"args_order":null,"call_locator":"db6ee32b4736a7667cda0bf89d56a72eeeec9358da9321e205f3cb56a99b79c8","component":"tome","entry_revision_identity":"debe6b92f623e60c7e7dd9f77c26ac88aafb0d23000d44cd965df47a96be546d","logical_entry_identity":"880bec4a898c1f7638b41e1369005489d4ba136aa75cfd3b1058eeb3a1d863d9","normalized_path":"mod-tome.lua","source":"Make the impure blood of all creatures around you in radius %d boil.\n\t\t\t\tEach enemy afflicted by a disease, poison, or wound will have one removed at random dealing %0.2f blight damage, healing you for %d, and slowing them by %d%% for 5 turns.\n\t\t\tThe damage will increase with your Spellpower.","source_tag":"tformat","target":"使你周围半径 %d 内生物的不纯净的血液沸腾。\n\t\t被疾病、毒素或伤口影响的敌人将会随机移除一个上述效果，受到 %0.2f 枯萎伤害，使你恢复 %d 生命值，并被减速 %d%% 5 回合。\n\t\t伤害受你的法术强度影响。"},{"args_order":null,"call_locator":"fa56c266da02252f979331aa880f65a26550ab8fba3e02c0a3761db90851fe7b","component":"tome","entry_revision_identity":"debf3d0e4dc1f22aa06b7f48f5ec4212d5f21b1233641f01308491dc9e9b4f0a","logical_entry_identity":"1ce30078305d645c90518a9069b6034f769fd224f4ceeeda6cf77dbf3e0dece1","normalized_path":"mod-tome.lua","source":"Golden crystals","source_tag":"_t","target":"金色水晶体"},{"args_order":null,"call_locator":"f4f4920f04a6b1e318410afe229d682fce63e4d138414cc03dc46035103aa826","component":"tome","entry_revision_identity":"debf5c2dcf9b67b5aaab121a33cf4d8e9aa52357b5ee67ff9ef5c2f5cbf0a7cb","logical_entry_identity":"7dfd143d43806f9996a199e1a2b09d094783d654dc1da96605ef7c1eebb90958","normalized_path":"mod-tome.lua","source":"#Target# starts to attract all creatures around!","source_tag":"_t","target":"#Target#开始吸引周围的所有生物！"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"bf27c7e7d839cafa0a15d65b7933c68e80287e87c3b833fb14755fde1d767140"}}}