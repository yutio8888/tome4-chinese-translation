ision_identity":"d1a8c6d0a28b8e22b6ba86722c43de29afd67252c3e89ff39c02d4b91d7987d6","logical_entry_identity":"e14fa74cde5f1a27a680435e87c9c9d8c78d67ab9a5a1ff97b0f73d4db3ff3cf","normalized_path":"mod-tome.lua","source":"#GOLD#Physical Power#LAST#\nYour physical power represents how overwhelming your physcial abilities are. It is usually improved by Strength, but may be modified by your weapon.  It is opposed by your opponent's physical save.\nIn addition, when your physical attacks inflict temporary detrimental effects, every point your opponent's save exceeds your physical power will reduce the duration of the effect by 5%.\n","source_tag":"_t","target":"#GOLD#物理强度#LAST#\n你的物理强度代表了你的物理能力，该属性受力量加成，但也受到你武器的影响。敌人用物理豁免对抗你的物理强度。\n另外，当你造成基于物理强度的负面效果时，敌人的相应豁免每超过物理强度一点将减少5%持续时间。\n"},{"args_order":null,"call_locator":"81bc61267756fff749b2982bd3542a32de03d31ebf216c6e9c20dd737c9b2876","component":"tome","entry_revision_identity":"d1ab936b593ab1c31ec8bc677a45d846b006d01af364f7f24fc32be073a3cddc","logical_entry_identity":"fba82c07abfad7a0fd6eae89afbb69e179adf2ddcbb06a68a761f15b1d108165","normalized_path":"mod-tome.lua","source":"#PINK#The shadows converge on #Target#!","source_tag":"logCombat","target":"#PINK#阴影被集中至 #Target#！"},{"args_order":null,"call_locator":"03dd088e7420beb32ac009a8b360dba17b0cb6c645346347b6bf2b05201345b0","component":"tome","entry_revision_identity":"d1ad1292573cb115bbdbffa7f2251bc33c627f150a00ca7d881130ff87214e54","logical_entry_identity":"4bf7df1796b6fbc62b68d986190e57c306f24796e72f4bd638081499a3dc629d","normalized_path":"mod-tome.lua","source":"Level 20","source_tag":"achievement name","target":"20级"},{"args_order":null,"call_locator":"d1d4d222af353eeb0fff3fd7c3914a7097f09fab8bf05e3f04f1dfb9a58c24bb","component":"tome","entry_revision_identity":"d1adda65ee02a2548773f3b020c0d8e2b88332cc11587efba7c6072cfd621abe","logical_entry_identity":"24ef927935261ec18a723b9c8768a5293855c9ce5b8c9951d3d16f998d8f784a","normalized_path":"mod-tome.lua","source":"generic resi