321bc79f81dae475bcf33c592741758d25051a8","logical_entry_identity":"be3b371a2d25aaed9812b7be7b03e7397c214e944e1017884a888f6445decb8f","normalized_path":"mod-tome.lua","source":"phys atk","source_tag":"entity name","target":"武器命中"},{"args_order":null,"call_locator":"0e575f17ff5f2984e7255b0fb730afcd9f83e47d2b1b0f59c9252f518e781cdc","component":"tome","entry_revision_identity":"1affcf3a2c37a2b8a25bd8c859a50505a416fe93ffbb481bb538cd88c222ea01","logical_entry_identity":"a3a5e13694156218844320784159bc48939b12dcd10e451b9a7de2b3dbdf59e3","normalized_path":"mod-tome.lua","source":"#GOLD#Damage affinity: specific#LAST#\nAll damage of this type that you receive, through any means, also heals you for this percentage of the damage.\nImportant: Affinity healing happens after damage has been taken, it can not prevent death.\n","source_tag":"_t","target":"#GOLD#伤害亲和：指定#LAST#\n任何方式对你造成的此类型伤害，都会按此比例治疗你。\n注意：伤害亲和的治疗在伤害结算之后才生效，不能防止死亡。\n"},{"args_order":null,"call_locator":"d745db0bdff07cc38290fd9e0d3247868b36590e87a4a926182a2b9ad9d77e95","component":"tome","entry_revision_identity":"1b01de45ffe966a34a4af71c8a58e2647bfdcf93062afe7bd5989e6115af6de4","logical_entry_identity":"65055bfddcb8998314097b0d122cdbc0f8bdced17d204a7140811b2540d684fb","normalized_path":"mod-tome.lua","source":"The target is struggling against immense gravity, all damage it does is reduced by %d%%.%s","source_tag":"tformat","target":"目标正在抵抗强大的重力，造成的所有伤害减少%d%%。%s"},{"args_order":null,"call_locator":"0e09410908aec064fa499f349a262121823d17a3841872a604a6ce3701abacb3","component":"tome","entry_revision_identity":"1b02778ca6d67ae820edb5ac311c98158e0d8822cb991ef8129f6b226cfa3f1d","logical_entry_identity":"0c3da58bb528bf40b3ae834172bf6f29b3ad051a799c912d711efa1f9dc404c1","normalized_path":"mod-tome.lua","source":"He shall come!","source_tag":"_t","target":"他终将降临！"},{"args_order":null,"call_locator":"d43cf5bc5b175846193e4ab03d9c764a2d6306619991bd012ed513bd3c685144","component":"tome","entry_revision_identity":"1b03006dd68a79b62f2c85cf44f57c69c682e4145012f94ff305e53e80bc6ef4","logical_entry_identity":"7f48c9794fe5636e39464e5835c7ede7048ed9bfa22b37ca1984664a566e63b1","normalized_path":"mod-tome.lua","source":"#{bold}#240: #{normal}#Market forecasts recovering better than expected. Increasing expansion in external trade areas.\n#{bold}#490: #{normal}#Orcish attacks have become much worse - seem to be using higher magic and some demonic forces. Potential threat to resources.\n#{bold}#581: #{normal}#Several key cities overwhelmed from underground by attacks from orcs and strange horrors. Have collapsed lower caverns to prevent further penetration. Working on continued resource protection measures.\n#{bold}#711: #{normal}#Developed key strategic agreements with outside races to help contain orcish threat to resources and infrastructure. Relations with Toknor of the humans are seen to be especially important - have sent him some of our best armour and weapons to ensure a good return on our investments. In hindsight we should have charged more for these.\n#{bold}#713: #{normal}#Orcish threat eliminated. Profits beginning to soar due to increased external trade relations.\n","source_tag":"_t","target":"#{bold}#240：#{normal}#市场预测的恢复好于预期。继续扩大对外贸易领域。\n#{bold}#490：#{normal}#兽人的袭击愈发严重——他们似乎正在运用高等魔法和某些恶魔力量。可能威胁资源。\n#{bold}#581：#{normal}#兽人与怪异的恐魔从地下发动袭击，攻陷了数座重要城市。已使下层洞穴坍塌，以阻止其继续深入。继续制定资源保护措施。\n#{bold}#711：#{normal}#与其他种族达成关键战略协议，协助遏制兽人对资源和基础设施的威胁。与人类图库纳的关系尤其重要——我们已将一些最好的护甲和武器送给他，以确保投资获得良好回报。现在想来，我们本该多收些钱。\n#{bold}#713：#{normal}#兽人威胁已消除。对外贸易关系扩大，利润开始飙升。\n"},{"args_order":null,"call_locator":"579b8a870212d0608ee6c03d7f250c77854d3851668035461f1b462ad1ce8fd4","component":"tome","entry_revision_identity":"1b064369ca8b6d82613060e5bab32c79e4767f439bb3641aaf102b36743438de","logical_entry_identity":"0d3a09305ec4cfc6d95d75a5ecaaa6418ec688de41550f9f04536fdf1a56a408","normalized_path":"mod-tome.lua","source":"magic teaching","source_tag":"entity subtype","target":"魔法教学"},{"args_order":null,"call_locator":"fcbbf4b52