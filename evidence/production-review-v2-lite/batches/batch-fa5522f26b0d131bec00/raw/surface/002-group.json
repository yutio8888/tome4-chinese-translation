me","entry_revision_identity":"1b02778ca6d67ae820edb5ac311c98158e0d8822cb991ef8129f6b226cfa3f1d","logical_entry_identity":"0c3da58bb528bf40b3ae834172bf6f29b3ad051a799c912d711efa1f9dc404c1","normalized_path":"mod-tome.lua","source":"He shall come!","source_tag":"_t","target":"他终将降临！"},{"args_order":null,"call_locator":"d43cf5bc5b175846193e4ab03d9c764a2d6306619991bd012ed513bd3c685144","component":"tome","entry_revision_identity":"1b03006dd68a79b62f2c85cf44f57c69c682e4145012f94ff305e53e80bc6ef4","logical_entry_identity":"7f48c9794fe5636e39464e5835c7ede7048ed9bfa22b37ca1984664a566e63b1","normalized_path":"mod-tome.lua","source":"#{bold}#240: #{normal}#Market forecasts recovering better than expected. Increasing expansion in external trade areas.\n#{bold}#490: #{normal}#Orcish attacks have become much worse - seem to be using higher magic and some demonic forces. Potential threat to resources.\n#{bold}#581: #{normal}#Several key cities overwhelmed from underground by attacks from orcs and strange horrors. Have collapsed lower caverns to prevent further penetration. Working on continued resource protection measures.\n#{bold}#711: #{normal}#Developed key strategic agreements with outside races to help contain orcish threat to resources and infrastructure. Relations with Toknor of the humans are seen to be especially important - have sent him some of our best armour and weapons to ensure a good return on our investments. In hindsight we should have charged more for these.\n#{bold}#713: #{normal}#Orcish threat eliminated. Profits beginning to soar due to increased external trade relations.\n","source_tag":"_t","target":"#{bold}#240：#{normal}#市场预测的恢复好于预期。继续扩大对外贸易领域。\n#{bold}#490：#{normal}#兽人的袭击愈发严重——他们似乎正在运用高等魔法和某些恶魔力量。可能威胁资源。\n#{bold}#581：#{normal}#兽人与怪异的恐魔从地下发动袭击，攻陷了数座重要城市。已使下层洞穴坍塌，以阻止其继续深入。继续制定资源保护措施。\n#{bold}#711：#{normal}#与其他种族达成关键战略协议，协助遏制兽人对资源和基础设施的威胁。与人类图库纳的关系尤其重要——我们已将一些最好的护甲和武器送给他，以确保投资获得良好回报。现在想来，我们本该多收些钱。\n#{bold}#713：#{normal}#兽人威胁已消除。对外贸易关系扩大，利润开始飙升。\n"},{"args_order":null,"call_locator":"579b8a870212d0608ee6c03d7f250c77854d3851668035461f1b462ad1ce8fd4","component":"tome","entry_revision_identity":"1b064369ca8b6d82613060e5bab32c79e4767f439bb3641aaf102b36743438de","logical_entry_identity":"0d3a09305ec4cfc6d95d75a5ecaaa6418ec688de41550f9f04536fdf1a56a408","normalized_path":"mod-tome.lua","source":"magic teaching","source_tag":"entity subtype","target":"魔法教学"},{"args_order":null,"call_locator":"fcbbf4b52558ad5d792bb5a4187929c6e12cd8dc32a73b71312f7c893df949da","component":"tome","entry_revision_identity":"1b0b6c723131ecad05f014d59d7bd9b98883a7ba2235035880d919e5caa538f5","logical_entry_identity":"1841868855c47e050db59fe97c802bf0f66740952a6b59dfb0431ea0dd17da81","normalized_path":"mod-tome.lua","source":"glass door","source_tag":"entity name","target":"玻璃门"},{"args_order":null,"call_locator":"60fa3fd7882b7d72c81e009f8ea99db9bd23f098714763bcdb03aaf921717d16","component":"tome","entry_revision_identity":"1b0c5e05ddf10b65098e25259296df4d389b08dafd614f9a4d4ee8415c4f81e4","logical_entry_identity":"afb3e9a4294086b79faf84a430a9827383e9aba9ad2c702c83fc93b3d4c0d23b","normalized_path":"mod-tome.lua","source":"When used:","source_tag":"_t","target":"当使用时："},{"args_order":null,"call_locator":"1c0386925830ef61d0637226146fa68855e60c2ce4aff6ee22dd2d18f1751d00","component":"tome","entry_revision_identity":"1b10153d729edeed76f518dba6f70d1b2977ebda6cc3d421a2bb89fc35bdff69","logical_entry_identity":"39177090e2e5f08b9bd15fd26da17236f2ae88667d0548cf84427b68bee52c05","normalized_path":"mod-tome.lua","source":"Feint","source_tag":"talent name","target":"佯攻"},{"args_order":null,"call_locator":"4717e191bde2ed314d2479ce2101d56eb7758b0d898d9588988e59b5a2368dea","component":"tome","entry_revision_identity":"1b116d961e920fc1493f25076cda62df514af7e1dd5ed1f9e6635192fd5980d8","logical_entry_identity":"58063f942b865d00eaa9608cfc6dea5020df88e268789366cc0b1df54bf634df","normalized_path":"mod-tome.lua","source":"Opened a portal to the Far East from Maj'Eyal.","sou