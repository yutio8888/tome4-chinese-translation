":null,"call_locator":"a9727b5a445487faf7ede131f64c692c9822cadd3b16e48bf522cba4cf8d75f4","component":"tome","entry_revision_identity":"1ed68371deb07d56ff9d7fb7b65f67487eb68d9d83a09f8f6109f09395098470","logical_entry_identity":"ec96e7ad8b8a41e387f5ae9ee7a245619291200aca1c751a9a5dd523ef277312","normalized_path":"mod-tome.lua","source":"Inflict maximum pain to specific places on your enemies.","source_tag":"_t","target":"向指定位置射出弹药造成大量伤害。"},{"args_order":null,"call_locator":"0cfe7e7bb7c11b4dd96ccac783502dc31dd432f1005ea25de8df62f158fd1e5b","component":"tome","entry_revision_identity":"1ed9a45e2b7bcb1849cba8d261c0aa8a9d395657ccff26d7da1981348a6ae6c0","logical_entry_identity":"99c4b98cdcacd0f3b02ab77d8f2e6d638748c133dbebdf99e2e9cd017bbb1689","normalized_path":"mod-tome.lua","source":"pulsing mindstar","source_tag":"entity name","target":"脉动灵晶"},{"args_order":null,"call_locator":"b5e1df9eac2fb6b414b7803599a6a9114fdf20541092f247c8c6beaa55aefd80","component":"tome","entry_revision_identity":"1edae2a1b31da2077c3e6092e04c636bc9957a01ace8f30ed1097b53ab088105","logical_entry_identity":"c7c73e9b19dadbe95b787d7a30267584a28228211a27bef1cdb7649af2d27a96","normalized_path":"mod-tome.lua","source":"Good. Before your... untimely arrival we were preparing an attack on the Ziguranth main training camp, on the southern beach of the sea of Sash.\nCome with us; let's destroy them!\nI will open a portal to Zigur and the massacre shall begin!","source_tag":"_t","target":"很好。在你这……不合时宜的造访之前，我们正准备进攻位于萨希之海南岸的伊格兰斯主要训练营地。\n跟我们来，让我们彻底消灭他们！\n我将开启通往伊格的传送门，屠杀即将开始！"},{"args_order":null,"call_locator":"79e0269fe582caf5be27d378746e52578a1e3828838c22ecc0de629eab8737ba","component":"tome","entry_revision_identity":"1edd96bd61cd62ce43e456637712862f1e9d8a4c96709180c6dc67af35a1de75","logical_entry_identity":"0559183f3717580a24618ce5c357464aece97da211a6dcec4e041207e33d0aaf","normalized_path":"mod-tome.lua","source":"This robe was formerly owned by Callister the Psion, a powerful Psionic that pioneered many Psionic abilities. After his wife was murdered, Callister became obsessed with finding her killer, using his own hatred as a fuel for new and disturbing arts. After forcing the killer to torture himself to death, Callister walked the land, forcing any he found to kill themselves - his way of releasing them from the world's horrors. One day, he simply disappeared. This robe, soaked in blood, was the only thing he left behind.","source_tag":"_t","target":"这件长袍曾被灵能者卡利斯特拥有，他是一名强大的灵能者，开创了许多灵能能力。在他的妻子被谋杀之后，卡利斯特执着于寻找凶手，用自己的仇恨作为燃料，创造了令人不安的技术。让杀手折磨自己致死后，他行走在地上，迫使任何他发现的人自杀——这是他从世界的恐怖中给予人解脱的方式。有一天，他消失了。这浸泡在血液中的长袍，是他留下的唯一物品。"},{"args_order":null,"call_locator":"a28d7816e04659cc4a4c81374b670eabc50e7dc47596f40be04f4f4fd16dea2f","component":"tome","entry_revision_identity":"1ee2e7d84f700c8fbbf3d298a225b7b576b21aa6a28b0cd581fadca572fd66a7","logical_entry_identity":"fd4928361ca502565d6e6ba430330e0f3e9f81b84f3e11b0cbe34b6d0004b86a","normalized_path":"mod-tome.lua","source":"Entrance to a dark crypt","source_tag":"_t","target":"通向阴影地窖之路"},{"args_order":null,"call_locator":"0ea4252032e89026e8fa9f2f0843feeeaa9cc18433f396f0739b4437c2738ee5","component":"tome","entry_revision_identity":"1ee301f429c82e0b5b63a6ecefa4736c52b1ead705028434181696d61f7eb301","logical_entry_identity":"9bc5c2d765ab18ee1def34a05a369ff683d4076845d230033d4c4a39ddae11f1","normalized_path":"mod-tome.lua","source":" of the nighthunter","source_tag":"entity name","target":"暗夜猎手之"},{"args_order":null,"call_locator":"9e4b47aa0300035910f33dfa0724773c923a696a31c51a7361c4da512d7c46bd","component":"tome","entry_revision_identity":"1ee451a752f1d0b1f65057814caf92fc0229e17e29029700ac438ca190114e22","logical_entry_identity":"67f7209a78d4b3d68d351891323103eddbcfe26309a4d8a81a58a153a0776191","normalized_path":"mod-tome.lua","source":"Sling Sniper","source_tag":"talent name","target":"投石大师"},{"args_order":null,"call_locator":"00892f19c5e57456278ea4ed51f09973c9612c51b8114ec4c34a06e77649cf8f","component":"tome","entry_revision_identity":"1