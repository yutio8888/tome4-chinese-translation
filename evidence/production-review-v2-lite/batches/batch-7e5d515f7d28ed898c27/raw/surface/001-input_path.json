_order":null,"call_locator":"3f1daf010c54825026b980f307352a0ea6b75015c5777d3347b767266665b637","component":"tome","entry_revision_identity":"48cd0500926cf239dcbc19b1c6abcf2f64cb6ae24108272ecb369c11b3e67072","logical_entry_identity":"79a39bca96334741cc5e1e96de2e1061cdd277dd4e14829f33acfc702b277a67","normalized_path":"mod-tome.lua","source":"The target is poisoned, doing %0.2f nature damage per turn and restoring life to the attacker equal to the damage dealt.","source_tag":"tformat","target":"目标中毒，每回合受到 %0.2f 自然伤害，并为施毒者提供等量治疗。"},{"args_order":null,"call_locator":"ddf9825990b9e275b47742683de5556d989758fb3152d8a4ff59f5c4aa235ddc","component":"tome","entry_revision_identity":"48d0af7faa2b54cc7a32f8cbc522eea0b7c6c9dc13d12bea030686d3ba6dc047","logical_entry_identity":"1d5864a8b9fcf5f173cf0549542ae76cd7b4632c09419d57721cfce00b69bf61","normalized_path":"mod-tome.lua","source":"%s%% chance to %s","source_tag":"tformat","target":"%s%% 几率触发 %s"},{"args_order":null,"call_locator":"7464430bdeeb0be485715fcca02496ea3e63421a7f851959f2f34512696dc18d","component":"tome","entry_revision_identity":"48db70c869c8e65c3a99016b6bf0e01c423b4a11cb71ef84afebe3d35c2138fe","logical_entry_identity":"c923cf47a728a0e1280d294ada35d423f93c8378a77a34e755b6cc30550ae1d5","normalized_path":"mod-tome.lua","source":" of the guardian","source_tag":"entity name","target":"守护者之"},{"args_order":null,"call_locator":"e723030a26b40a35eacfc218e11a93636e600555d3d645da586088298f03dd7d","component":"tome","entry_revision_identity":"48ed60e96297cfd63cc3027514ea74ce7f8dddc60366b1eeab20571ef886baa7","logical_entry_identity":"ebfb17f57cee7b2b7322322f003a9f123c6031e9c5e04a83d131ab250c767e8a","normalized_path":"mod-tome.lua","source":"During the Age of Haze, the nine Godslayers set out to destroy the gods.\nThe god Ralkur, while trying to escape one of the Godslayers, created the Infinite Dungeon.\nHe retreated there, but the Godslayer followed, and each time he would reach the god, Ralkur would create a new level.\nIt is said the hunt continues even now, deep, very deep within the dungeon.\n\nYou have unlocked the secret of the Infinite Dungeon and can now create new characters in a new campaign: #LIGHT_GREEN#Infinite Dungeon#WHITE#.\n\nThe Infinite Dungeon is a set of ever-increasing levels filled with terrible foes.\nCampaign features:#YELLOW#\n- No quests, plots, friendly creatures or ways out: only you against all odds.\n- No win condition: you WILL die in the dungeon, but you can prove your worth by going as deep as possible.\n- Pure hack and slash MAYHEM!#WHITE#\n","source_tag":"_t","target":"在混沌纪，九位弑神者出发去消灭众神。\n神祇瑞尔克在试图逃离一位弑神者时，创造了无尽地下城。\n他退入其中，但弑神者紧随其后；每当弑神者追上这位神祇，瑞尔克就会创造新的一层。\n据说这场追猎直到现在仍在地下城深处、极深处继续着。\n\n你解锁了神秘的无尽地下城，现在你在创建新人物时可以选择进入一个新的战役模式：#LIGHT_GREEN#无尽地下城#WHITE#。\n\n无尽地下城由一层层不断增加、充满可怕敌人的楼层组成。\n战役特点：#YELLOW#\n- 没有任务、剧情、友善生物或逃生途径：只有你独自面对一切逆境。\n- 不存在最后取胜的情况：你最终会在地城中死去，不过你进入的层数越深说明你的水平越高。\n- 尽情砍杀吧！#WHITE#\n"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"9c5578a9655e6dd80db73e1cd996c97dce1bee4abd5e219636a19c81f80a7672"}}