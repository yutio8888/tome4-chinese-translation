{"candidate_identity":"5ae5a25cc62f4f5be20d971cee06cdaac4cd5f3741fe7036b047f03d54f0e62f","payload":{"contract":"translation_surface_screen_v1","entries":[{"args_order":null,"call_locator":"eac5e22f3b34e9713063ecfdb66b1b71c9fc63eacae554b265e632b7946bb21b","component":"tome","entry_revision_identity":"4893c2d975dbf994d71bd47279fbb169aee3a57a7f83bc2344fe3a2fdaa337e5","logical_entry_identity":"94f7d018c0eae0db37df7dd0c6b3d856a5eaf21c320217c5fd631078d083cbea","normalized_path":"mod-tome.lua","source":"This potent elixir extracted from a powerful wyrm can grant the power to repel arcane forces.","source_tag":"_t","target":"这种强大的药剂提取自一头龙的龙胆，可以给予你对抗魔法的力量。"},{"args_order":null,"call_locator":"d7ec04239cdb15ad4c31c112cdd5c93faa8e18405371041c9d1cf632037e6995","component":"tome","entry_revision_identity":"489b745da7b9306f295a8a31359708be2490989fd8bb41b1d07cf7cdc3e9ba8a","logical_entry_identity":"7a18fc1d608fa5f1bb2ad20a452c2f4134048942282817b2e82cf60be4820f45","normalized_path":"mod-tome.lua","source":"#{italic}#47th of Haze, Year of Pyre 710#{normal}#\nRations low. Men demoralised. Winterhaze wind is making conditions unbearable. The fortress is holding, but each night they pick off some of our troops. It is but a matter of time before we no longer have the strength to resist.\n\nI can hear their blasted trumpets again. Accursed swine! We have no rest or sleep, not the slightest sojourn without their braying, howling, jeering, taunting, insufferable cantations! It is driving me from my wits! But I must remain strong... I must put on a brave face for the men. They are relying on me, and though the burden feels close to crushing me I must bear it with the dignity of a king.\n\nIt is getting dark again. Who will die this night? I am so very afraid... but I cannot show it...","source_tag":"_t","target":"#{italic}#烈火纪710年，混沌月47日#{normal}#\n口粮见底。士气低落。寒冬的风让这里苦不堪言。要塞尚能守住，可他们每晚都会袭杀我们几名士兵。我们失去抵抗之力只是迟早的事。\n\n我又听见他们那该死的号角了。该死的猪猡！他们没完没了地号叫、咆哮、讥笑、嘲弄，吟唱着不堪入耳的调子，我们连片刻安宁都没有，更别提休息和睡眠！我快被逼疯了！但我必须坚强……必须在将士面前装出无所畏惧的样子。他们都指望着我；这重担虽几乎要将我压垮，我仍必须以国王的尊严扛住它。\n\n夜幕又将落下。谁又会在今夜死去？我真的非常害怕……但我绝不能表现出来……"},{"args_order":null,"call_locator":"c5dbb1e5f8bd55214f4dc44a7cbcb44ada7fcc7cb37993a00215bdb817aa3ddd","component":"tome","entry_revision_identity":"48a223d2bb8c51c882e73984a299937dc5c0fc084cb9faaf7df274beb6376d0f","logical_entry_identity":"0d3d2368b63bb6a567e582070f1e3ec0da39d1a2c3f1ed827fe88b5063486f6f","normalized_path":"mod-tome.lua","source":"fighting","source_tag":"talent type","target":"格斗"},{"args_order":null,"call_locator":"c83b4cb0410e483cb50603fd0097b4397fbfabde9118a633c3b595029c8ae170","component":"tome","entry_revision_identity":"48a298827df65747711b01133e0e5e303930fe2f81eb6ceb511b5c50f09ae36f","logical_entry_identity":"ae6c7f30bff9583bb3430254d27a861e10524079dd802e2e8cc8c691647dfdc7","normalized_path":"mod-tome.lua","source":"broken fearscape invasion portal","source_tag":"_t","target":"被破坏的恶魔空间入侵传送门"},{"args_order":null,"call_locator":"7f5cf8c1d883f9d803db38bcd28f7196c7c57ca5e7c23ea6afcd1bbeefa981ba","component":"tome","entry_revision_identity":"48a6a90907fa568e58baa84bea0012f3e9e08429b309d88517b9191b2f70f634","logical_entry_identity":"6eeac922175374a0d6fbc1fb7202e72b3dd1ca7c0e222ceb51259f690fb932d7","normalized_path":"mod-tome.lua","source":"red crystalline sword","source_tag":"_t","target":"红色的水晶剑"},{"args_order":null,"call_locator":"4874baa79dc35c07b9e9df4f157f8e8f836e6a330ffa97ed289ff90c82d6ec3a","component":"tome","entry_revision_identity":"48ac018875f2124f43dacda90374d4e60b6d559dbd0929820cc9191d2b0e92d2","logical_entry_identity":"dccbb99225ef745b777315730b220406632e21c1c343e9e89314da5e74322d0a","normalized_path":"mod-tome.lua","source":"A vial of churning orange fluid.","source_tag":"_t","target":"一瓶浑浊的橙色液体。"},{"args_order":null,"call_locator":"b4f384da090978807b925eab94a8eb4c1fc2c1f81b72d23c035fb857d389aff3","component":"tome","entry_revision_identity":"48add4e36e31bf551275f0b097ca2f178ce4cb8db74394c4cec19d4131353f7d","logical_entry_identity":"45a87