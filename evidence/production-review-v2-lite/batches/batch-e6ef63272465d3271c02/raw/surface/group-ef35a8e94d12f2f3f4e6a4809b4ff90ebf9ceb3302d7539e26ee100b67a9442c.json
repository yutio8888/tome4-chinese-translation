77d30415534ba6bc15baf6f844deeb74e6432dd130","component":"tome","entry_revision_identity":"5688e342d4afca968797905891ca5921e71461a184cb7dc366e224f005ec8dff","logical_entry_identity":"cfe67744d3234ce3d19092df736bc0739e6b3253423886b8fff8b03f08502dc8","normalized_path":"mod-tome.lua","source":"So you can infuse amulets in this place?","source_tag":"_t","target":"据说你可以给项链附魔？"},{"args_order":null,"call_locator":"24cfc94ba9cd326b10c83de8f932d5b6fb6274e9e13143133a7b843f5af8aaec","component":"tome","entry_revision_identity":"5694e5329be1286b6443d5af10d0fbc877930ed83bc8035533d2eb61288c5723","logical_entry_identity":"0efdb07b23bd44b2ba8f61351595a052ffb8f8694ff18997a81fa264b2106da6","normalized_path":"mod-tome.lua","source":"Wait, @playername@, you seem to be quite the adventurer. Maybe we can help one another.\nYou see, I #{bold}#LOOOVVVEEEE#{normal}# learning new lore and finding old artifacts of power, but I am not exactly an adventurer and I would surely get killed out there.\nSo take this orb (#LIGHT_GREEN#*she gives you an orb of scrying*#WHITE#). You can use it to talk to me from anywhere in the world! This way you can show me your new shiny findings!\nI get to see many interesting things, and you get to know what your items do. We both win! Isn't it sweet?\nOh yes, the orb will also identify mundane items for you, as long as you carry it.","source_tag":"_t","target":"等等，@playername@，你看起来是个相当了不起的冒险家。也许我们能互相帮助。\n你看，我#{bold}#超——喜欢#{normal}#学习新的传说知识、搜寻古老强大的神器，但我自己可算不上什么冒险家，到外头去肯定会送命的。\n所以拿着这颗水晶球吧（#LIGHT_GREEN#*她递给你一颗占卜水晶球*#WHITE#）。你可以在世界上的任何地方用它与我通话！这样你就能随时向我展示你新找到的闪亮宝贝了！\n我能见识到许多有趣的事物，而你也能弄清楚物品的用途。我们双赢！这不是两全其美吗？\n而且，只要你随身携带，这颗水晶球还会为你自动鉴定普通物品。"},{"args_order":null,"call_locator":"da29bd5f66bc21e6ab9e6036d05dea41426d5b5d700e3737acef504fd808f783","component":"tome","entry_revision_identity":"569654f65e29715f2addca61623a9ec08ec474fd9b07c46955b83cccb879373a","logical_entry_identity":"df92cabb72ac6e0ccd9223860862ef4c17d71175795674df77e4d6143b692640","normalized_path":"mod-tome.lua","source":"It seems the threads of time and space have been disrupted...\nI will try to send you to safety.","source_tag":"_t","target":"时空之线似乎已被扰乱……\n我会尽力将你送到安全的地方。"},{"args_order":null,"call_locator":"4a8be74c19f1f9877fca8368d67d5ea37da69662019d082007b219d0ae0ddbb1","component":"tome","entry_revision_identity":"5697c2553cf4da0ba7b1b336b73b5c1b00a0c7b63227bd73f8d154d305f34cdf","logical_entry_identity":"5e028886e9aad4b0799153d3ed6542e3346a19cd0e03855e89f797b3d6236380","normalized_path":"mod-tome.lua","source":"You have no %s talent points left!","source_tag":"tformat","target":"你没有足够的%s技能点！"},{"args_order":null,"call_locator":"30c4019e93e5dc3f119b7135a83e8a2bdffa8d64f2a942a5ea5a24090198c73b","component":"tome","entry_revision_identity":"569db67dcf2b57c5dea920b21957003a0efe9d8c39780423d27cffa394723a4c","logical_entry_identity":"e46d30908e11f83d5b82855b424163f636eeb05c2c8185dedace12bd9fea6d4c","normalized_path":"mod-tome.lua","source":"living","source_tag":"entity keyword","target":"生命"},{"args_order":null,"call_locator":"6f432dbfa33cc5406fbb82b0673ae7fa90151e6aff8ac9a853eb0f9a70de5657","component":"tome","entry_revision_identity":"569f288dc7bb502c70ceb25e505eeb69d5a671d18bdf6b62ff7f8f4312948499","logical_entry_identity":"a5c55f0e3715b4efedebe8a5537769f66dbb26e5d28f37048dbf04d03350a775","normalized_path":"mod-tome.lua","source":"#GOLD#Item's appearance change (Shimmering)#WHITE#","source_tag":"_t","target":"#GOLD#改变物品外观（幻化）#WHITE#"},{"args_order":null,"call_locator":"e9b6b2461f610c6c0726740033f9cedec67b0f51d59c733b7febd388c3a8a08f","component":"tome","entry_revision_identity":"56a4f6fe1c6c7f10041b374fee07331da300312d99883117ceee160d3d453518","logical_entry_identity":"b7e57be650a4ce71838d02034f45580ab1ea886692c837efe4d9bddd46c09fae","normalized_path":"mod-tome.lua","source":"You sap the target's energy and add it to your own, placing up to %d random talents on cooldown for %d turns.\n\t\tFor each talent put on cooldown, you reduce the cooldown of one of your talents currently on cooldown by %d turns.","source_tag":"tformat","target":"你吸收目标的能量并化为己用，最多使 %d 个随机技能进入 %d 回合冷却。\n\t\t每使一个技能进入冷却，你可以减少你处于冷却中的技能的冷却时间 %d 回合。"},{"args_order":null,"call_locator":"733cd4a25db47bbda3cd0068521ac21cbcfe5c75cd1e6aa401a4403e2091f77a","component":"tome","entry_revision_identity":"56a5c1f58b1f94cfec6d7b003ce7aa4d8cb7d37843e64ecd9959ef87a9fd85ca","logical_entry_identity":"8a4b75a9bf741d69a30905473ab30039c4a181a20d27a97ad560c5ede8842655","normalized_path":"mod-tome.lua","source":"The energy is too low. It needs to be at least 15.","source_tag":"_t","target":"能量过低，至少需要15点能量。"},{"args_order":null,"call_locator":"2a319a13f37bf4f2315df098175e7f693014e20cf14231eafedd43733315a0aa","component":"tome","entry_revision_identity":"56a69b0803d325a4fe5be9cfe1694739d399cd4cc3a83bd3ad279c074179c489","logical_entry_identity":"1dbb534cda99c86abcd70dff77d6a6615a273f677457787d0614933ccde77509","normalized_path":"mod-tome.lua","source":" of illumination","source_tag":"entity name","target":"照明之"},{"args_order":null,"call_locator":"c2dcceaadf0149ab328ec074d29a3bcdc7d76c06fcffb73a1ce1b127d8cbdf4c","component":"tome","entry_revision_identity":"56a9b3983ff861646772043064a1ea9584c8ca5eb5b9e2d391842df341592f8c","logical_entry_identity":"b5e3e67eace2cde2293f86e8ac66e45e56a5e59d0199b3931b6d3fa782732256","normalized_path":"mod-tome.lua","source":"Look at me, I'm playing a roguelike!","source_tag":"achievement name","target":"看！我正在玩Roguelike！"},{"args_order":null,"call_locator":"1edd8293afcfbfbeccfd8c7da0b5f8393dc43ce4c7bfde047d365e45b4e5d053","component":"tome","entry_revision_identity":"56b2a96c764c8ac8f20885cab0e85604bbf54b0403504395ee32a92464bf0c9a","logical_entry_identity":"e8935d75d8fdc7c6cdfbc97f818565e2e416fd7d97b5238b8ff7771b2c7234b0","normalized_path":"mod-tome.lua","source":"generic dark retribution","source_tag":"entity name","target":"通用 暗影反击伤害"},{"args_order":null,"call_locator":"3b0555be9bda320ae5ab061643f41e5ca586901ce7fa58ce9b69f7958953d22a","component":"tome","e