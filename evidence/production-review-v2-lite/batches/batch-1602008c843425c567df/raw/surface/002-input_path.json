ision_identity":"55d258d6f3bb3ee739af11ddc4ddb17872ef4e634a91e3c697dda870fd571b16","logical_entry_identity":"bab23190caf960be07d715388dadfaa680aa7825042a409f49a65efd745a881a","normalized_path":"mod-tome.lua","source":"#LIGHT_BLUE#%s has spawned a dream projection to protect its mind!","source_tag":"logSeen","target":"#LIGHT_BLUE#%s产生了一个梦境投影来保护自己的心智！"},{"args_order":null,"call_locator":"7188ab35f3f1f0677deb2559e0f31ca6ef2688a42071dd9445bb0e8b191e794b","component":"tome","entry_revision_identity":"55d907e857b8723779e89583e5bf6a7309b2aa3e7bb5c691b6310e2e03b2b62b","logical_entry_identity":"3323cfacd7240ed1c0f8b1057f7b608805011ccabb9b07f78e4f27fae71668f8","normalized_path":"mod-tome.lua","source":"Emblem of Evasion","source_tag":"entity name","target":"闪避徽记"},{"args_order":null,"call_locator":"2497e5c2e1d9caa51dd2d6557129980e0e19ac75fc1a95282d9767023599aa23","component":"tome","entry_revision_identity":"55dd97e6f913e052761cb6b5492fa617614f95ffe20bb6906ceae9e06cabfe11","logical_entry_identity":"b96b4c9d2b3615e8b68624cf43557134d1579845a8aee77e00caef6aed7d5b25","normalized_path":"mod-tome.lua","source":"When attacking in melee, deals 15 light damage and lights tiles in radius 1.","source_tag":"_t","target":"近战攻击时，在1码半径内造成15光系伤害并照亮区域。"},{"args_order":null,"call_locator":"8a99b3fa2971880903702be20dc4f4ca9e0238ac2382c88565ddbf19aaffe17b","component":"tome","entry_revision_identity":"55e3b53b6b6b394fdfb576f75c0bd09eb1794ed78fcc3cedede7973ce0f62d21","logical_entry_identity":"9311f1fc858b5a08c7fa62f6fd2cde00a877f3b562da3e94a8033f8814df5b13","normalized_path":"mod-tome.lua","source":"armour smith","source_tag":"entity name","target":"护甲店"},{"args_order":null,"call_locator":"8426b5532d9c1a7e53023368be92b913eb572cdebe4a24a737f1dd014620acd2","component":"tome","entry_revision_identity":"55e4fe25abbc6a055f584550edbc9e97eb142da401b846d41f1157c5057046b4","logical_entry_identity":"a5920096e18bb2f8eebaf02f981d953044c3806236a0e5beb2ddae9727d52aac","normalized_path":"mod-tome.lua","source":"#{bold}#Tract of Destruction#{normal}#\n\nThough armies would fall before the Spellblaze's might, though forests were razed and the skies bled red with fire, they always felt that the earth would endure. It seemed eternal, unmoving. Not even the fury of the Spellblaze could hope to destroy it.\n\nHow wrong they were. The Nalorën people, long secluded, were prepared to fend off any attacks on their land, but how could they hope to stop the land itself crumbling? Seeing their home literally tearing itself apart, plains and forests tumbling into the seas... For one brief, terrible moment, they beheld the true extent of the Spellblaze's power. Not only was it destroying the people of the world, but the world itself.\n\nThe lands of the Nalorën had sunk beneath the waves.","source_tag":"_t","target":"#{bold}#毁灭之源#{normal}#\n\n尽管在魔法大爆炸强大的力量面前，军队眨眼覆灭，森林片刻消失，天空满是流火，但他们总认为大陆会安然无恙。它看起来永恒不变。甚至狂怒的魔法大爆炸都无法摧毁它。\n\n但他们错了。这些与世隔绝了很久的纳鲁精灵，以为他们的土地可以抵抗任何的攻击，但他们怎能指望陆地去阻止它自身的崩溃？当看到房屋倒塌，海啸来袭——这一刻，他们才真正见识了魔法大爆炸的力量。它不仅毁灭了世上的人，也毁灭了这个世界。\n\n纳鲁大陆缓缓沉入海底。"},{"args_order":null,"call_locator":"d3acc91c4399d95c226f56fa191bcc8fe891aa15e769b7bfe0303a11f375226b","component":"tome","entry_revision_identity":"55eea3258f87623d71c3ca8b87bc2ce570f5777e8986b5eb3e17e2fb9d43ec41","logical_entry_identity":"d8060008f57d8c7b4eb314ff3eff16fd03deeb23b8776b07b4ae0bd63a444baa","normalized_path":"mod-tome.lua","source":"Explore the Dungeon of Adventurer Enlightenment to learn about ToME's combat mechanics.","source_tag":"_t","target":"探索冒险者启蒙地下城，学习 ToME 的战斗机制。"},{"args_order":null,"call_locator":"de56c80ea3eb637bbe90e7c24c9ede74c1b0bd69d8d7bf258bae34e19953acd2","component":"tome","entry_revision_identity":"55f2860c6b70a168442d5ad0ddd4a1ff197173c31b3540081c3530ea0c158a81","logical_entry_identity":"89e8f7c6c5ae2ae06109f1695363b425247b14c9d620ce9728b9bc80e31383aa","normalized_path":"mod-tome.lua","source":"skeleton mage skull","source_tag":"ingredient name","target":"骷髅法师头骨"},{"args_order":null,"call_locator":"86d66cdd