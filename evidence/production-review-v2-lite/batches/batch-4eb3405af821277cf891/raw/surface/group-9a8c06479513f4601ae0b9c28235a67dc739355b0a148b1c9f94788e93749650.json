7aff42363a8edee6b9e881b6077aa96c1c6f3f6eb","normalized_path":"mod-tome.lua","source":"When you rush, the creature you rush to is marked. If you kill it in the next two turns then your rush cooldown is reset.\n\t\tEach time that this effect triggers you gain a stacking +20%% damage buff, up to 100%%.\n\t\tRush now only costs 2 stamina.","source_tag":"tformat","target":"当你使用冲锋时，冲锋目标会被标记。在接下来两轮之内杀掉冲锋对象，则冲锋技能会冷却完毕。\n\t\t每当此技能触发时，你获得 1 个增加 20%%伤害的增益效果，最大叠加至 100%%。\n\t\t冲锋现在只消耗 2 点体力。"},{"args_order":null,"call_locator":"56824d8abef7858da3faaf520dbc13e287e900087ed676fc9670413f51276670","component":"tome","entry_revision_identity":"cafe29ef66af97d9a8728199fc883674f3dbbec3e77a4e7d09d9cb0f97078230","logical_entry_identity":"2bac46aa1ec83ec6117092b039991e063d7cd1995bda593224906c1065d78194","normalized_path":"mod-tome.lua","source":"@Source@ throws a concussive punch.","source_tag":"_t","target":"@Source@打出震荡拳。"},{"args_order":null,"call_locator":"74f912717ac0716d5600c99691fdbbbafb077780a635c69a9b0cecebd4b8a7f1","component":"tome","entry_revision_identity":"cb0a16c020875c0277c07e6f8edc064fb98eb17efd99135ad32adbd5640b198a","logical_entry_identity":"4ec82eb80c89631f1cb1c7bee693a8a8b2598997a8eaddb7055509329edfb367","normalized_path":"mod-tome.lua","source":"disengage","source_tag":"entity keyword","target":"脱离"},{"args_order":null,"call_locator":"318fb569a36cb79d96980e9d6be380fb61d28256120626b0822e0bb161065d5c","component":"tome","entry_revision_identity":"cb0b5bdc4b30e7786338333d985676ce6a16cdd7bbd4e9fe410ed87bf299c762","logical_entry_identity":"89c5226d73404b3e4516941675b901d0e4d8c479d11ffd3ac77a1699cbdae504","normalized_path":"mod-tome.lua","source":"potent ","source_tag":"entity name","target":"强效的"},{"args_order":null,"call_locator":"579e2aad6a200014d80747be82640449ee69b036fb0f28ded3e92ac2f730dc61","component":"tome","entry_revision_identity":"cb0e996d9ac04db82bb4b61a89292d76c637fb7a9f8e6ea54a16af99fe93228d","logical_entry_identity":"1e5b8abb6453b500cb655895d9a1ffd9805f1604b