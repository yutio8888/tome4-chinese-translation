{"candidate_identity":"7fc6c1552e2e9915803b4097b0ddb5a94dc931c7dead41477ce1888a5973b6f2","payload":{"contract":"translation_surface_screen_v1","entries":[{"args_order":null,"call_locator":"df26553fbe59c5f1f536287974cabeb53c4ff6f92995c5d5b876f09d43ceca27","component":"tome","entry_revision_identity":"45a725125e8605cfaab74b1fff9d3a79e87bdd99f2bee66297e7ac5033043260","logical_entry_identity":"e9115c454939a3ff27d87128fb8c8d320f62523c0731e2d84f52208a24120895","normalized_path":"mod-tome.lua","source":"Belts are worn around your waist.","source_tag":"_t","target":"腰带戴在腰间。"},{"args_order":null,"call_locator":"2d7455a8f9c7180fc9831058e1fe56947349c67919f3c4188e37a0b5055761d4","component":"tome","entry_revision_identity":"45ac08aa3312ccb9ebfbbe1be63247741cd92b3e3e0baac628b0df5c052ea6d8","logical_entry_identity":"8f79680b9f084a4cea4925502e0376610b03fef4dd23cb870c124d9865dd776f","normalized_path":"mod-tome.lua","source":"Rush toward a target enemy with incredible speed and perform a melee attack for 120%% weapon damage that can daze the target for 3 turns if it hits.\n\t\tYou must rush from at least 2 tiles away.","source_tag":"tformat","target":"快速冲向敌人，并造成 120%% 基础武器伤害。如果此次攻击命中，那么目标会被眩晕 3 回合。\n\t\t你必须从至少 2 码以外开始冲锋。"},{"args_order":null,"call_locator":"88d95011f8832bbd18dc0dad513765a6ef900f6ab5d6b8c9cf76ac836bd38b9d","component":"tome","entry_revision_identity":"45b54f8900f4935285f10821710eebae37ad4fc3002cd9094c36064c83fb59da","logical_entry_identity":"d6c0f2f1ed276701edbb2c0fab0993481fd5a0cbacacb45d24d56cd2c4c68838","normalized_path":"mod-tome.lua","source":"#GOLD#Damage resistance: by speed#LAST#\nAll damage you receive, through any means, is decreased by this percentage, which increases as your total movement speed (global times movement) decreases.\nThis is applied after normal damage type resistances.\n","source_tag":"_t","target":"#GOLD#伤害抗性：速度#LAST#\n所有类型任何方式对你造成的伤害按此值减免，随着你的总体移动速度减少而增加。\n该效果在常规伤害抗性后生效，不受抗性穿透影响。\n"},{"args_order":null,"call_locator":"744cb1479ab1604ba7ea