l_locator":"5fbbb3d15b22a00057ca45a39b265c67a3c7822e4f5a8fa4c5b690d7ff28dc3d","component":"tome","entry_revision_identity":"270aeb3d3046ac7688092365a51422dd8f60466047e091c054408e796f7e9dac","logical_entry_identity":"60e88e6e67cf4c56609121206952e3cfc864dfc31cdcad743bb20f1d0d666be4","normalized_path":"mod-tome.lua","source":"#DARK_RED#Blood of Life","source_tag":"_t","target":"#DARK_RED#生命之血"},{"args_order":null,"call_locator":"ba50a4df4b9780d1391ed2868473f10617bacc165ad4d3264060f72ef596c388","component":"tome","entry_revision_identity":"270ba2cb289dc86b9fcc588070234bae02eb38bb010c4e378d4797b6f8e689b3","logical_entry_identity":"f701a0b3e162c33b95d3ac06286858281d8cdca626ca8dc6c34c40a5a1039321","normalized_path":"mod-tome.lua","source":"stralite plate armour","source_tag":"entity name","target":"斯莱特板甲"},{"args_order":null,"call_locator":"6c5bb911aae68f8d011f1b5782f2b229b70bd347d6b876a0a8e420feffc680a4","component":"tome","entry_revision_identity":"270cd0a1f93d5726292e63e8bd7aa275df0bc41588f16e749a4583d46e2406c8","logical_entry_identity":"9f332fa299d4b19b2fce28758151a656d738b00fa48556d74bcfc9092546ab46","normalized_path":"mod-tome.lua","source":"Last Will and Testament of Rolf Two-Axes\n\nI have failed. Oh by the great wyrm's maw, I have failed! The beast Weisman set out to slay was dead already by another's hand, but its corruption remained still. When I arrived in its chamber, Weisman was already half-gone; he was hacking away at foes only he could see. When I tried to stop him, he turned his axe on me... I am beaten and broken, hiding in some crevasse away from... from my own friend, who through the corruption in this place has been perverted into a monstrosity my axes were unable to fell. I hold no doubt that this is the last time I shall put quill to parchment, as even now I can hear my old friend's perverted voice.. calling to me. I bequeathe my belongings to any who slay ...\n#{italic}#(the ink blotch seems to indicate Weisman had caught up to his old friend, one-half of that abomination)#{normal}#","source_tag":"_t","target":"双斧罗尔夫的遗嘱\n\n我失败了。啊，以巨龙之巨口起誓，我失败了！威斯曼此行本要猎杀的那头野兽，早已死在他人之手，但它的腐化仍然残留于此。当我赶到它的巢穴时，威斯曼已经神智尽失；他正朝着只有他自己看得见的敌人挥斧乱砍。我想要阻止他，可他把斧头转向了我……我遍体鳞伤、心力交瘁，只能躲进某道裂隙中，躲开……躲开我自己的朋友，他已被此地的腐化扭曲成我的双斧无法放倒的骇人怪物。我毫不怀疑这是我最后一次提笔，因为此刻我已能听见老友那扭曲的声音……在呼唤着我……我之财物将赠予任何能杀死…\n#{italic}#（这点点污渍似乎叙说着威斯曼最终抓住了他的老朋友，他们以这种怪物的形式永远地团聚在了一起）#{normal}#"},{"args_order":null,"call_locator":"7d1b2580c2047cfe09b27fe6a1f0ad2bbe5e800be6dc757a8ff1a9bb9a7cb145","component":"tome","entry_revision_identity":"270e822f703e68e6f81f082e3d817ecea8194f4b59dd0eb32af98595f090db09","logical_entry_identity":"7c11b9c71c9c1e22b7e82f10ae4c7b05fa1a85feb16fc5ed1daa630006c297ca","normalized_path":"mod-tome.lua","source":"Eldritch Infusion","source_tag":"talent name","target":"奥术充能"},{"args_order":null,"call_locator":"e30baca9f055cb41c98b990b4ac8fa9eec75cb9f90cf516612bf45b4e044febf","component":"tome","entry_revision_identity":"271311a3119af1aa3cc9e08c62ee34017de1fcf2bc695a77870561587993e26b","logical_entry_identity":"835f1d4627605ef640f81a002244599e9a5160b2c67fb327bbd4bc5d10e49ce6","normalized_path":"mod-tome.lua","source":"creative ","source_tag":"entity name","target":"创造力的"},{"args_order":null,"call_locator":"03b5518df3f3078c08c9e7d036e765fc27a43beba9980cdd48e8145ec1e00c73","component":"tome","entry_revision_identity":"2713257cc9317ecaf36b3734d011cf7c13f7d5155044e89c4ccb66c058ca8380","logical_entry_identity":"5f869322d5868bb522450d5ad73ec59824cc8ee280bb146683738d6d98f65366","normalized_path":"mod-tome.lua","source":"+Temporal Restoration Field","source_tag":"_t","target":"+时间恢复场"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"9c5578a9655e6dd80db73e1cd996c97dce1bee4abd5e219636a19c81f80a7672"}}