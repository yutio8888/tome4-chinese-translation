_locator":"7c1b4a8bb543853f84198ec5971f27a3c1c485e61a943fc7a009da03252c1f2a","component":"tome","entry_revision_identity":"a53eb3dc736315a5a49787ef940db5dd1924bd28207d70198411015026ae7654","logical_entry_identity":"2e34a0b78e5f47c18025a815a5a1e36dc859a6202a0419cf1063e9afbece88c4","normalized_path":"mod-tome.lua","source":"A farportal is a way to travel incredible distances in the blink of an eye. They usually require an external item to use. You have no idea if it is even two-way.\nThis one seems to go to an unknown place, seemingly out of this world. You dare not use it.","source_tag":"_t","target":"传送门是可以在眨眼间将你传送出很远距离的工具。它们通常需要一件关键道具来激活。你不知道这道门是否为双向的。\n 这道门似乎通向未知之地，似乎为世外之地，你不太敢使用它。"},{"args_order":null,"call_locator":"8c95619857cd9d10fb7081f21728de3378d0092fae1cf7365cd38f86bce03acd","component":"tome","entry_revision_identity":"a5419c1348d61e745760a5f1c3022fb372020e5dffcfcf85937b799d940c6017","logical_entry_identity":"de82804cc4f4f54a9e1cbb5642c445ccbc05240cfadbd1c95bb552c157042a95","normalized_path":"mod-tome.lua","source":"Spellhunter's Guide part 2: How to Battle a Magic-User","source_tag":"_t","target":"魔法猎手指南第二部分：如何与施法者战斗"},{"args_order":null,"call_locator":"0b3bff0a600b4b49a44729ba18e9a67feaa8d7acc0b3b29fea69461154c773db","component":"tome","entry_revision_identity":"a54584e09c6433eb1e7df0f2efba3cf82d5d817c73e33f49caf12434509f6578","logical_entry_identity":"6757b71c380ade04a190cf2e65bbdeb8b77dd7c8691aca5618fcc021fc0d6748","normalized_path":"mod-tome.lua","source":"dragon turtle","source_tag":"entity name","target":"龙龟"},{"args_order":null,"call_locator":"373eb9d24aa494f0566e22e135a8b96edc5a2a40686af3fd6464b3468bd0a413","component":"tome","entry_revision_identity":"a5464947aee33623d2e7b4f58c955eee5090cf79f0c3a801fc5998cfeb85024d","logical_entry_identity":"1709b3cf42fb5c80b6756199d2586fb99f8093c694b65ce491455a1b982ebdf5","normalized_path":"mod-tome.lua","source":"Flawed Design","source_tag":"_t","target":"不完美设计"},{"args_order":null,"call_locator":"13cafb4059ef