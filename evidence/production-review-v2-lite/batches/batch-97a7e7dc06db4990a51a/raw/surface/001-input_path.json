_identity":"5c581e811e18c48fa87438952e7b70947d64267c93fb830c6725b8ced2377bfc","logical_entry_identity":"9e7943de208b9e8a1b9eea3c4066f610e0d802d1954953b9995a8b5d191045f8","normalized_path":"mod-tome.lua","source":"flat","source_tag":"effect subtype","target":"固定伤害减免"},{"args_order":null,"call_locator":"3f7df23baacab86c58a462c20e385b4a32b444ce4457a42c092764faae792338","component":"tome","entry_revision_identity":"5c5c5b9fdb5c98dae0ac5e8e1355afffefb1164900bf16c4fa9398fe9f6fb7d1","logical_entry_identity":"ee8e5f90a706671750cc3e88486d97741a8ef30aafd2fa55c4bfcee81669c1ab","normalized_path":"mod-tome.lua","source":"You attach %s to your %s.","source_tag":"logPlayer","target":"你将%s附着于%s。"},{"args_order":null,"call_locator":"f008d0c8bd2654a1a167ba127513e902b2477edcc115aa042494914f6bfb4fe8","component":"tome","entry_revision_identity":"5c5fb5887b9d1483645db0c3d2da44b246895664eeee8a05cbe0158d29b70828","logical_entry_identity":"abffec0aed64633eafd00f7d445be5c8d7c4596089e3ef144b04e0a0d80f03db","normalized_path":"mod-tome.lua","source":"It's a large red ant, wreathed in flames.","source_tag":"_t","target":"一只巨大的红色蚂蚁，全身燃烧着火焰。"},{"args_order":null,"call_locator":"c0ff16ea77d312bc47e5507bc4be217bf5945a19107bcc9b16d17079995cc260","component":"tome","entry_revision_identity":"5c66914b084ff5254c55c2b9cc8a8d8dfbfce9d29513ed9da033ae30f3c6305a","logical_entry_identity":"05900e608d50dc05bd29b46759b6cbade44a78c2955d7476121f836d8c05c3b7","normalized_path":"mod-tome.lua","source":"I fell into a trance, I know not how. Were it the rich blossoms or the oppressive heat? I swooned into the grass and the mists swirled over my face, playing out fantastic shapes before my eyes. Dancing ladies strode across the skies, and a row of dwarves stood laughing as their beards flew into the wind. Then I felt a Shadow near, and the ladies scattered and the dwarves in terror screamed, their mouths yowling and spilling black petals. I tried to move, but I couldn't, and frozen in fear I saw the Shadow above me, looking down upon my countenance. It grunted and lurched away. I passed out then, and have just recovered.\n\nI am not sure what to make of this. I wish to leave, but I do not know the way. Only by escaping this mist shall I have a clear view of the land. Yet each path seems to wind unexpected, each step takes me closer to the centre, not further. I must make haste from this place.\n","source_tag":"_t","target":"我不知怎么陷入了恍惚。是繁茂的花朵，还是逼人的酷热？我昏倒在草丛里，雾气在我脸庞上方打着旋，在眼前演出种种奇景。起舞的女子跨过天空，一排矮人放声大笑，胡须迎风飞扬。随后我感觉一道阴影逼近，女子四散而逃，矮人惊恐尖叫，张开的嘴里一边哀号，一边涌出黑色花瓣。我想动，却动弹不得；我吓得僵在原地，看着那道阴影悬在上方，俯视我的面孔。它哼了一声，踉跄着离开。之后我便失去了意识，刚刚才醒来。\n\n我不知道该如何理解这一切。我想离开，却不知道路在何方。只有逃出浓雾，我才能看清这片土地；可每条路都出人意料地迂回曲折，每一步都把我带向中心，而不是远离它。我必须尽快逃出这里。\n"},{"args_order":null,"call_locator":"18269af1b4e1bbfc49dbc5e9bd142e4ca6967cdebeaec3f65e6fb5b4f1b511bd","component":"tome","entry_revision_identity":"5c688ccf82ae50e529106eca70b32fd5c4ecd818c1e64ecb7801944459fef90d","logical_entry_identity":"6ecc3a015b66d50c06b0e8e710d4a70bde771b0167bb68de130395114a993c91","normalized_path":"mod-tome.lua","source":"Frenzied Focus","source_tag":"_t","target":"灵能狂热"},{"args_order":null,"call_locator":"2fa883e7bcffd2a576a86c8ea2948fd916b66fe49c3aebc00c6a7b41dfcc36d5","component":"tome","entry_revision_identity":"5c6bdcaf6c60b16baa0c45f21a4383e69ab9cbce2bdf76ea3fb43372bd066995","logical_entry_identity":"0bd154bdc75901ea3b0c6bb19b2e3afc95b5227575eeedfe9284f8226e796ac2","normalized_path":"mod-tome.lua","source":"Thought-Forms","source_tag":"talent name","target":"思维形态"},{"args_order":null,"call_locator":"fc5899b49dfee207d0ab00ef55f591faed8c3d5e866cf60da389bb850a42ae8a","component":"tome","entry_revision_identity":"5c6c72214eef639ee1b39ad4645b118050a65f49530e3350852c3c5fd7984d5a","logical_entry_identity":"417aa63279a46b3dc2719c9a5377ca60304253b890229c1c349ee29823ac271c","normalized_path":"mod-tome.lua","source":"#LIGHT_BLUE#Psionic Focus","source_tag":"_t","target":"#LIGHT_BLUE#念力武器"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22