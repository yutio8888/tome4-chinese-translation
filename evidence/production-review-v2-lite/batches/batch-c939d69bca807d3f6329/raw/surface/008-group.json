 %d 回合。\n\n每造成 1 点光系伤害，目标便会减速 %0.2f%%，持续 %d 回合；减速上限为 %d%%，造成 %d 点伤害时达到上限。\n暗影伤害会在目标所在格产生一个持续 %d 回合的效果，每回合造成该次伤害的 %d%%。在微光回响生效期间，只要目标继续受到此效果或其他来源的伤害，该地块效果就会刷新；剩余伤害和新伤害会一并分摊到新的持续时间内。"},{"args_order":null,"call_locator":"e971d1cb2c22fdb6452b66801b56dde904738dfdce76ceeb2470380a66a0a0e9","component":"orcs","entry_revision_identity":"bb696441fc5ed418a25ade1e4fb9b474313273c4c17b3751c0f6265010edf28a","logical_entry_identity":"c0d77af23a0bfa350354debcea0b17ff978a929c6b93016c8d65da554df854dd","normalized_path":"tome-orcs.lua","source":"steamtech","source_tag":"effect subtype","target":"蒸汽科技"},{"args_order":null,"call_locator":"894d2dc9bb487163e1eeca807c851d66989ff07c76f12ab998b99fe34ef986c5","component":"orcs","entry_revision_identity":"bf3ba19e80f04c36e5b28c807c73a6f42d36c2de214b419b7aafb0c4eab6bb9b","logical_entry_identity":"921bd6999dcde1ad2f0bdd6f9133ba3cc5aa584a364939d27eb8cb01a127212c","normalized_path":"tome-orcs.lua","source":"Hair 2","source_tag":"_t","target":"发型2"},{"args_order":null,"call_locator":"17f7e97f8c8f8837311cdac767e6d8adac5f635837b6ff00990547928650e395","component":"orcs","entry_revision_identity":"bff8fe424a39140bf183cef163e34a458dba916613b4b4ef0d56ea5941d6110e","logical_entry_identity":"800eda7a085e11f820d730ed12b8665e24e863f21e725c00076141e0aec83e87","normalized_path":"tome-orcs.lua","source":"floor","source_tag":"entity name","target":"地板"},{"args_order":null,"call_locator":"a565646eba537c5ea2f99866e02a9b52b56f20528005203d11893368f8d646a0","component":"orcs","entry_revision_identity":"c212d0dad2b90b3a9e74f37d592350ea61b8a4a1e21dd00639729f2504f40ab0","logical_entry_identity":"f5648d2910489f8faef8831890873562fddb319d85bc9b626d1d1fe1812e5c99","normalized_path":"tome-orcs.lua","source":"This door seems to have been sealed off. You think you can open it.","source_tag":"_t","target":"这扇门似乎被封住了，你觉得你可以打开它。"},{"args_order":null,"call_locator":"21da55ea583ae14615d4b8bed621623038bbb5adb562bb9db105785f13ddfb02","component":"orcs","entry_revision_identity":"c3d2a