locator":"8b0e7cbe4b90377ef5d04fa6e945e74776590fbe3a2db539528ee2ba4b3cfd5a","component":"tome","entry_revision_identity":"925306da8e3881a3d812aa706ffa2f27fc443807c2eb489f5795e3c21a7e7ad4","logical_entry_identity":"4f0502caf96c06d6663de854265740aca7514f79e7d5fabd62c9dc9c36b0c2f1","normalized_path":"mod-tome.lua","source":"The target is silenced, preventing it from casting spells and using some vocal talents.","source_tag":"_t","target":"目标被沉默，无法施放法术或使用部分发声类技能。"},{"args_order":null,"call_locator":"05f25ed883313d9aea7fae9ce32638c105363b0bfbcbd9b22dc1fa6a97203d5b","component":"tome","entry_revision_identity":"925b54f5ff791cbf16e05902dcbdab6bc2d03a772e90a37d08eedb8c59e1807e","logical_entry_identity":"046621939acc64bd7d83de63ceab605aee247d21bee06d26cc93c97171d14996","normalized_path":"mod-tome.lua","source":"activates","source_tag":"_t","target":"启用了"},{"args_order":null,"call_locator":"f20c436e8e3d046a76f495d0bf64cbf2fd81291b4582bd5fe834de802a7ae5a2","component":"tome","entry_revision_identity":"9265c423965861158f172d1c9f3cabec395d2799c6dadb7e14bde38c17508fd7","logical_entry_identity":"accc330c0e6a5712132a56e7bd32b036b6dbdd2934c9b8a2f6c50b683c0dd314","normalized_path":"mod-tome.lua","source":"green dragon-scale cloak","source_tag":"_t","target":"绿色的龙鳞斗篷"},{"args_order":null,"call_locator":"f73fb534f582f221141e329b0a85457ec49fe8b3cd69704e3412c5b9609870dd","component":"tome","entry_revision_identity":"9266cba76625b966dddb47855422de55ef6b175f148a66cbd5446f6339922322","logical_entry_identity":"bee41e68e4ed83fa3ed83fda89226641b1a6e1ffacd68d27c669997b48259cfe","normalized_path":"mod-tome.lua","source":"#LIGHT_GREEN#*The gate opens, revealing a mature human woman in crimson robes.\n#LIGHT_GREEN#She looks at you with a wide smile*\n#WHITE# My, my, what a fine @playerdescriptor.race@ you are. What was your name again, @playername@? I am soo delighted to be your rival today.\n#LIGHT_GREEN#*She speaks quietly as if telling a secret* #WHITE#You know, so few get past the little one as of late, it's such a bore.#LIGHT_GREEN#*She giggles*#WHITE#\nSo! I am Riala, the Crimson. I came directly from Angolwen. Despite, you know, the whole thing with the Spellblaze, people still enjoy a few magic tricks!\n#LIGHT_GREEN#*She snaps her fingers, and then flames start dancing around her!*#WHITE#\nFryjia told me about you, the poor thing, so I will not underestimate such a promising aspirant #LIGHT_GREEN#*She smiles warmly* #WHITE#So, let's make haste my dear!\nThere is a battle to fight here!","source_tag":"_t","target":"#LIGHT_GREEN#*大门开启，一名身着深红长袍的成年女子出现在门后。\n#LIGHT_GREEN#她灿烂地微笑着看向你*\n#WHITE# 哎呀，哎呀，多出色的一位 @playerdescriptor.race@ 啊。你叫什么来着，@playername@？今天能成为你的对手，我可真是太高兴了。\n#LIGHT_GREEN#*她压低声音，仿佛在说一个秘密* #WHITE#你知道吗，最近能闯过那个小家伙的人实在太少了，真是无聊透顶。#LIGHT_GREEN#*她咯咯轻笑*#WHITE#\n那么！我就是绯红里娅拉，刚从安格利文赶来。虽说嘛，魔法大爆炸闹出了那些事，但人们还是喜欢看点魔法把戏！\n#LIGHT_GREEN#*她打了个响指，火焰随即在她周围起舞！*#WHITE#\n弗里嘉已经跟我说过你了，可怜的孩子。所以，我绝不会低估你这样前途无量的挑战者。#LIGHT_GREEN#*她温暖地微笑着* #WHITE#那么，亲爱的，我们赶快开始吧！\n这里还有一场战斗等着我们！"},{"args_order":null,"call_locator":"a4b6dede20b3330b02fb54d45facc5a4f485b1a02260d06db2b78b3dffef215d","component":"tome","entry_revision_identity":"926d166627394205715e2e9fee61d7598939cd5685683fc2bf8000f5e939eca3","logical_entry_identity":"758da2165b11fe030d91003fdb101e240bcf5679594c50da4088c226348d6728","normalized_path":"mod-tome.lua","source":"deeprock","source_tag":"talent type","target":"深岩形态"},{"args_order":null,"call_locator":"fd6329d921679e1cba77b6911bbeb147d8efebbbd20a17c11d632b36834fcf5b","component":"tome","entry_revision_identity":"927097b4b99a60e6c77f903c1ed6582d8046ba499e92a0fd27f6485c6c40930f","logical_entry_identity":"ea792fa59f4eabc6a585f3b7edfb04a2b5a2681d83520b10074a53782d735ba6","normalized_path":"mod-tome.lua","source":"clue (ruined dungeon)","source_tag":"_t","target":"线索（地城废墟）"},{"args_order":null,"call_locator":"f1cc885f58d58ced1859104e9c50d343f1ad6a82054584751461e8478600f26f","component":"tome","entry_revision_identity":"927ad3c70a05605a98054820c683960e096439b7c294cc18ad81283d65