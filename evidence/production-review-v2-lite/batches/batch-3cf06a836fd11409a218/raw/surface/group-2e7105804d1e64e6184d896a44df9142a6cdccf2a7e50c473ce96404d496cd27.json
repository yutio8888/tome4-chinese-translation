l_entry_identity":"3f7d2edb792dbe84f119ae2f13146b014ee6afbf4a95e660cab020ac12d88205","normalized_path":"mod-tome.lua","source":"#rng# the Invader","source_tag":"_t","target":"入侵者#rng#"},{"args_order":null,"call_locator":"d889f392969106cefec4754e3b43633a2ea8c86c22ba2f64318ec3b9e44cb89d","component":"tome","entry_revision_identity":"96afebb1ee65e96e7e7162f01fc0d9b732c4a28f8a5697b30072e076db917773","logical_entry_identity":"fc4207a8123da5aa42cc973265b16e088a54d022e5232f32fe6a09a31b086197","normalized_path":"mod-tome.lua","source":"deep black lantern","source_tag":"_t","target":"深黑色的灯笼"},{"args_order":null,"call_locator":"3c42c16b34c02fc68b6316fc373d08636a11604d32e2fafcac729df9413b7928","component":"tome","entry_revision_identity":"96b5eb591bdde0854e534ae2ac7048219fc5eae3dd35566687a77f6153017ba1","logical_entry_identity":"6ebc15b9c706fcfa88f77e266705daa9e1e0f0e20912ff564d1e52786a42358e","normalized_path":"mod-tome.lua","source":"It was fun, bone giant!","source_tag":"_t","target":"打得痛快，骸骨巨人！"},{"args_order":null,"call_locator":"7060b3155b14dde4330b32b57ff8a0673c904f4d3a5650b523b4d1a4997a6543","component":"tome","entry_revision_identity":"96b7f6a18ee54db0f92d7faa2aed9bcd86cd537e676cb01ab1adc1aec6366d49","logical_entry_identity":"47aa84d9a6402656c6845e3090776f47400010b71fcdd83a788062b738941c0f","normalized_path":"mod-tome.lua","source":"metal whip","source_tag":"_t","target":"合金鞭"},{"args_order":null,"call_locator":"0491dedf6e93d9bb84a80187e7aa0218f9fe111c884d5a0ebcdc1be27de5c5a8","component":"tome","entry_revision_identity":"96b984d6171b3c94855ba903a211345e12d5f2aa9e00d2636ecb063d299a879e","logical_entry_identity":"2e6d30497c521db5e4073762eef8ed6ac50b7f13bb887894a2a8e54e26e868a7","normalized_path":"mod-tome.lua","source":"From the dust of decay a %s forms!","source_tag":"logSeen","target":"从灰烬中诞生了一只%s！"},{"args_order":null,"call_locator":"4fec8a7f8ff220eafb07bba4903c0df275294332ff7c7c54f438da47b9a4ca29","component":"tome","entry_revision_identity":"96c09fe198898e9432d07ed627a56542374bda6666b92192523d147ec0c4d0df","logical_entry_identity":"d435ae0a429c7db2f98aae1975933a933148319c94b6e7cb8b84c073c72d8b9c","normalized_path":"mod-tome.lua","source":"Rune: Shatter Afflictions","source_tag":"talent name","target":"符文：粉碎痛苦"},{"args_order":null,"call_locator":"993ec6f3c9b50bdfff630a707b951674387484cd6a2b8a7c4f651bdbf5ce88d0","component":"tome","entry_revision_identity":"96c111e36f0a8fbb38cca56662a43545ca3d6a853cc7dd4e6c6008c1fb812e58","logical_entry_identity":"eaca74ef4eb88b9bceaa9fc23375e15a666aac3e8fcfe1f091521440b7d908f0","normalized_path":"mod-tome.lua","source":"Very well. I will say that this is disappointing, but it is your choice. Farewell.","source_tag":"_t","target":"好吧，不得不说我有点失望，不过这是你自己的选择，再见。"},{"args_order":null,"call_locator":"5eb4a224e9ee5fd6b44435a317bd0a1f3d1466f18450a9cf39bcff0ecc6729a8","component":"tome","entry_revision_identity":"96c7152faa0ea997e42456d07cd9f445681c1a2e2929a50d7b0428090e88d1cf","logical_entry_identity":"9b5f92695234449401637d2fe4735a240ca62bc6003caae6553e494198fa5ab0","normalized_path":"mod-tome.lua","source":"This small orc has a malicious and greedy look in its eyes. Its veins pulse with new life and it moves with surprising speed. Though not fully developed you can still see the muscles forming on its long limbs, leading to clawed fingers and toes.","source_tag":"_t","target":"这只小兽人的眼里透露着怨恨和贪婪。它有着旺盛的活力并能以惊人的速度移动。虽然还没完全长大，但是你能看到他全身上下微微隆起的肌肉。"},{"args_order":null,"call_locator":"914c28ee6a1dcfc20d32e9c6f597e911ce422d0846e9e2e947585d1e6afd9d55","component":"tome","entry_revision_identity":"96c7353ee57a680ae0e7f01dcae90dae333b69f1d2f3d0665cd3b34c30155219","logical_entry_identity":"bc9bdc8c6f28dc0471a9ee62d2c986f456c1a547602687e7a278d9df0a0b2956","normalized_path":"mod-tome.lua","source":"Designed by a slightly quirky Paradox Mage, this robe always appears to be stylish in any time the user finds him, her, or itself in. Crafted to aid Paradox Mages through their adventures, this robe is of great help to those that understand what a wibbly-wobbly, timey-wimey mess time actually is. Curiously, as a result of a particularly prolonged battle involving its fourth wearer, the robe appends a very long, multi-coloured scarf to its present wearers.","source_tag":"_t","target":"被有些古怪的时空法师设计出来，无论穿戴者在哪个时代，这袍子都显得格外时髦。它为协助时空法师冒险而制作。这件法袍对擅长摆弄那团乱糟糟、缠来绕去的时间的人来说有着巨大的作用。有趣的是，由于它第四任主人参与了一场相当漫长的战斗，长袍上附带了一条很长的多彩围巾。"},{"args_order":null,"call_locator":"0aacbc81429f5d14f6bdfa25cac5e140099985ac3e4e1d423bdbf9c09726ff7c","component":"tome","entry_revision_identity":"96cbd967c483c2538f963935526a016cfd7e1b6613ee1298f41a734684ec20b6","logical_entry_identity":"ee9e03acb675ef8894dbf2e9aa1a5a2e89176b3252a43957f7d80cdf714a032a","normalized_path":"mod-tome.lua","source":"%s resists the worm rot!","source_tag":"logSeen","target":"%s抵抗了腐肉虫！"},{"args_order":null,"call_locator":"fe9b805b4cedc173e79f9e7a1edda2c341cafd33c669c27e08824897528414c7","component":"tome","entry_revision_identity":"96cdb8a4d8247480dde4da9b10f3ce5e2ce5c074a982f36b88b9ad0350df1ae7","logical_entry_identity":"0a48723408e643ab89ae9b622db1ab8ebea292bcd9bf2cdbeed9af6c53a3e228","normalized_path":"mod-tome.lua","source":"While this effect holds you can decide recent history did not happen the way it did.","source_tag":"_t","target":"该效果持续时你可以改变现实历史使其不会发生。"},{"args_order":null,"call_locator":"8111ab2b661dcd771caddd178924b164530c29448a9d2056f3af71b685f55b16","component":"tome","entry_revision_identity":"96d59c88ebe75dec257304530e5e381e3996b5ed58d7741bf6cfeb87949da9d1","logical_entry_identity":"a44383556e821c3c6ef41217e4f2cbdf7c0a4b98e1b4a74e78bcd0aea33dabb6","normalized_path":"mod-tome.lua","source":"%d nature damage, %d%% healing reduction","source_tag":"tformat","target":"%d 自然伤害，受到的治疗降低 %d%%"},{"args_order":null,"call_locator":"d259078d6bae22f0525b2eae3044719d934401c349c013093f915e3a1d971187","component":"tome","entry_revision_identity":"96d652d78b29916157a57c46cfc78b17e8188e857eeeaca2580301906a9917f9","logical_entry_identity":"5120e6960