离受力量值加成。"},{"args_order":null,"call_locator":"0e353740f9ec3b0fbe80f2a6899d30208e44006f3dbbe1e3ce4db931814e37a2","component":"engine","entry_revision_identity":"eadb94546f88b0b537469304341f26a4521974086c8dda9bc70af24b4b2138e1","logical_entry_identity":"8f21cf5dab5f3766a37616d09d1bbf5063fea26a805b824ba3d7a8f4f2406e93","normalized_path":"engine.lua","source":"%s fails to disarm a trap (%s).","source_tag":"logSeen","target":"%s 拆除陷阱（%s）失败。"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"9c5578a9655e6dd80db73e1cd996c97dce1bee4abd5e219636a19c81f80a7672"}}