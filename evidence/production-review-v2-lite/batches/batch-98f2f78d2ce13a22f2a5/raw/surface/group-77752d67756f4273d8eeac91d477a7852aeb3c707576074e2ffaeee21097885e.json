order":null,"call_locator":"2174d0c5bbb58d4fbded692d789ed02a455a7f35cdfe87b6f7011b5c7a75e3d3","component":"tome","entry_revision_identity":"32c7e1cc845d8fdad620d1e0368052e8a641d8d824658f530ca61afdc16cb061","logical_entry_identity":"d67409faf0d8ddc9655cfcbbe47d38b87a2a1fd0d91580f2f2b7203e74414128","normalized_path":"mod-tome.lua","source":"Slasul","source_tag":"entity name","target":"萨拉苏尔"},{"args_order":null,"call_locator":"f0761411c9c029827f1cb93c82e782307ea72687a35d474776eda972b53290ed","component":"tome","entry_revision_identity":"32cc31a78bf7337473d63c0e2d5afba9cbdf5041bec38fc6ccdf1c9fbd319cdc","logical_entry_identity":"658e9004a2c8bc1a8bb837c5cfa384db2846918eaadad9f145b6a59f0e8f18e3","normalized_path":"mod-tome.lua","source":"Tranquil Meadow","source_tag":"_t","target":"宁静的草地"},{"args_order":null,"call_locator":"07acdb27d4771fb7af1dd7901f9c9101fea8f775ec366ed6f16dd977722c542e","component":"tome","entry_revision_identity":"32cf3e7773c3b3a9800f97ab0b2b3b3d85b7e1602bd00d6acc7f0276833dd414","logical_entry_identity":"e3fbd3474a99ff2f46f59d9da8586535a4957ca5d8d81a20fca851b349b627ee","normalized_path":"mod-tome.lua","source":"I *WILL* stop you! The world will not end today!","source_tag":"_t","target":"我一定会阻止你们！世界不会在今天灭亡！"},{"args_order":null,"call_locator":"19af1901dd1faaca9b10cb777bcc1e32a40cdb310142be21fe170ba3dcccdeb6","component":"tome","entry_revision_identity":"32d24502a8a187ed62d7846b247874850c69bb9e662d3c85a07924ccf0843c54","logical_entry_identity":"90143824549f9d7afc6dd853113248cd96953f980dbd17e99f9d2ed4b6c01bcf","normalized_path":"mod-tome.lua","source":"Surround yourself with a shield that will absorb %d%% of any physical/acid/nature/temporal attack, up to a maximum of %d damage per attack.\n\t\tEvery time your shield absorbs damage, you convert some of the attack into energy, gaining one point of Psi, plus an additional point for every %0.1f points of damage absorbed, up to a maximum %0.1f points each turn.\n\t\tAt talent level 3, when you de-activate the shield twice the absorbed damage (if any) in the last 3 turns is released as a full psionic shield (absorbing all damage).\n\t\tThe maximum amount of damage your shield can absorb and the efficiency of the psi gain scale with your mindpower.\n\t\tYou can only have two of these shields active at once.","source_tag":"tformat","target":"用护盾环绕自己，吸收 %d%% 物理、酸性、自然、时空伤害，每次最多吸收 %d 伤害。\n\t\t每次你的护盾吸收伤害时，将部分攻击转化为能量，获得 1 点灵能值；每吸收 %0.1f 点伤害，还会额外获得 1 点灵能值，每回合最多获得 %0.1f 点灵能值。\n\t\t技能等级达到 3 时，关闭护盾会将此前 3 回合吸收的伤害（若有）的两倍转化为一个全效灵能护盾（吸收所有伤害）。\n\t\t护盾每次最多能吸收的伤害以及获得灵能值的效率随精神强度提高。\n\t\t你同时只能维持两个此类护盾。"},{"args_order":null,"call_locator":"04832eee8f9b85ed761a7706d887b2511c6cf3ba3ac24e3ed87080df166d87e5","component":"tome","entry_revision_identity":"32d52ec72216ea67b18fe3d8d94dbcc55421090a0272ce704b6e9945b3ee53cf","logical_entry_identity":"892af4715692cd70a06e0dca1aa79f1808563e3c8acc260e336690635b3a1fa2","normalized_path":"mod-tome.lua","source":"%d%% of all damage is redirected to a random shadow.","source_tag":"tformat","target":"%d%% 的总伤害被转移至随机某个阴影。"},{"args_order":null,"call_locator":"e9fbb63cd078ee97f10c5c11e6fb46d6f34bc1d6ffa9c2dad52d96ad4ba833a7","component":"tome","entry_revision_identity":"32db791a8c8a1735253474d258370cd39a4000fb84a610d24ee353bd96ac1532","logical_entry_identity":"bc35e341786303c1e0d337d430c5e2cd2114bb3f40d3c48fc8968f40aa83f797","normalized_path":"mod-tome.lua","source":"cosmetic","source_tag":"damage type","target":"外观"},{"args_order":null,"call_locator":"7ad14bb79f0e79beb10cf2474da6f7d236428a379f2a4d8757e6963143e73ff7","component":"tome","entry_revision_identity":"32e8c161ad6b6860f6033542411c2011dc2668f2285fb7173bd9a89790fc5425","logical_entry_identity":"f3312392a262ed75be49f66494a88f47cc2b7a14d793abba034cb6f372009e81","normalized_path":"mod-tome.lua","source":"Nagas are invading the slazish fens. The Sunwall cannot fight on two fronts; you need to stop the invaders before it is too late.\n Locate and destroy the invaders' portal.","source_tag":"_t","target":"娜迦正在攻击斯拉伊什沼泽，太阳堡垒不能同时两线作战，你必须抓紧时间阻止那些侵略者，以免为时过晚。\n 找到并摧毁侵略者的传送门。"},{"args_order":null,"call_locator":"548350601f3e098fda0ecf42cc8bc995125ed67fba281efa8ecb2f8427937464","component":"tome","entry_revision_identity":"32e8c20f30eea0873b2fa05b4d8aa50305fadd3e929d593dc4b1b32fa5812c54","logical_entry_identity":"0fa193ad2ad2ed90b03a206fc05e613381e39a082c6712a06097d24cd8df13c2","normalized_path":"mod-tome.lua","source":"A finishing uppercut that deals %d%% damage, and attempts to stun your target for %d to %d turns, depending on the amount of combo points you've accumulated.\n\t\tThe stun chance will improve with your Physical Power.\n\t\tUsing this talent removes your combo points.","source_tag":"tformat","target":"以一记终结性的上勾拳对目标造成 %d%% 伤害，并尝试将其震慑 %d 至 %d 回合（取决于你积累的连击点数）。\n\t\t震慑概率受物理强度加成。\n\t\t使用此技能会消耗当前的所有连击点。"},{"args_order":null,"call_locator":"6b549cb168b474d2f4320259491f06444fb677a8e269ef620382fce79f101ef1","component":"tome","entry_revision_identity":"32e90f04cc7d4e77925a79764c0d8b02928331af811520554352d134991b57b2","logical_entry_identity":"3aadf3ae4d31863f10a28904a5417a19b788a6b9d38248e2092a55a7f8df26f4","normalized_path":"mod-tome.lua","source":"#GOLD#Lives#LAST#\nHow many lives you have and how many you lost.\nYour total number of lives depends on the permadeath setting you choose.\nYou may find other ways to save yourself but they are not considered extra lives.\n","source_tag":"_t","target":"#GOLD#生命数#LAST#\n你的生命数以及你的死亡次数。\n你的总生命数取决于你的死亡模式设定。\n你可以获得其他的复活机会，但这不视为额外的生命数。\n"},{"args_order":null,"call_locator":"0da90d4a6dca07e8a0f5a070135ee4b708e497453a4ce9e1bf6a0be8cf2bf43d","component":"tome","entry_revision_identity":"32eccadebefc1d5d37e809643bb8c8f2bfd920f868a53bdd372e234ad594f130","logical_entry_identity":"b9359b7b8250bffafef9d6630475b731c03f6da321aebb4f5ce6c893f27a9f71","normalized_path":"mod-tome.lua","source":"Mana represents your reserve of magical energies. Most spells cast consume mana and each sustained spell reduces your maximum mana.","source_tag":"_t","target":"法力值代表你存储的魔法能量。大部分法术都要消耗法力值，持续法术技能会降低你的最大法力值。"},{"args_order":null,"call_locator":"bf7ae3c23ebc9fc22e1730098db2eb8214c12e7aee17e607f221883fa8eb804c","component":"tome","entry_revision_identity":"32ee581f84fe72b93db62fb880de61b9d8c99d370d276ab69904fe82725117b8","logical_entry_identity":"ff1b2236621cb45133f041209ee1e6968f9c0305de2a09b6f3e01e9d71a503ac","normalized_path":"mod-tome.lua","source":"You enter an aggressive battle stance, increasing Accuracy by %d and Physical Power by %d, at the cost of -10 Defense and -10 Armour.\n\t\tWhile berserking, you are nearly unstoppable, granting you %d%% stun and pinning resistance.\n\t\tThe Accuracy bonus increases with your Dexterity, and the Physical Power bonus with your Strength.","source_tag":"tformat","target":"进入狂暴的战斗状态，以减少 10 点闪避和 10 点护甲的代价增加 %d 点命中和 %d 点物理强度。\n\t\t开启狂暴时你无人能挡，增加 %d%% 震慑和定身抵抗。\n\t\t命中受敏捷值加成；\n\t\t物理强度受力量值加成。"},{"args_order":null,"call_locator":"ade5009c668621bdf1788eca1a1f87552bfd476013ed8640e05ce2f8e447a4c9","component":"tome","entry_revision_identity":"32f0f842db5451a759747bcdd6159ab3cef297e3d28b6ae05f5c8efefee71012","logical_entry_identity":"463857bb2ed3a7f846a2d0327dcbe7967956fd4bdfd9444bf9cb9016f4e6272e","normalized_path":"mod-tome.lua","source":"Fire an arrow tipped with a smoke bomb inflicting %d%% damage and creating a radius %d cloud of thick, disorientating smoke. Those caught within will have their vision range reduced by %d for 5 turns.\nThe distraction caused by this effect reduces the cooldown of your Concealment by %d turns. If the cooldown is reduced to 0, you instantly activate Concealment regardless of whether foes are too close.\nThe chance for the smoke bomb to affect your targets increases with your Accuracy. This requires a bow to use.","source_tag":"tformat","target":"发射一个带着烟雾弹的箭头造成 %d%% 伤害并制造一个半径为 %d 的烟雾。被困在内的人将减少视野 %d 格 5 回合。\n此效果将减少你隐匿技能 %d 回合冷却时间。如果冷却时间减到 0, 无论敌人是否太近，都可立即激活隐匿。\n烟雾弹影响目标的几率受命中值加成。该技能需要弓来使用。"},{"args_order":null,"call_locator":"1072b9874d9a112d0d08db63d3af399ae22165b11ca2497fc106183ff9e3b88c","component":"tome","entry_revision_identity":"3300874905146af7e18c638fb816b2a5490256ec272ae11f944020ded36d3424","logical_entry_identity":"e40bcf161fdcac73d28304a361dc2ec43f9f9984439a2372a86e9ae859b636eb","normalized_path":"mod-tome.lua","source":"You summon your future self to fight alongside you for %d turns.  At some point in the future, you'll be pulled into the past to fight alongside your past self after the initial effect ends.\n\t\tThis spell splits the timeline.  Attempting to use another spell that also splits the timeline while this effect is active will be unsuccessful.","source_tag":"tformat","target":"你召唤未来的自己和你一起战斗，持续 %d 回合。当技能结束后，在未来的某个时间点，你会被拉回到过去，协助你自己战斗。\n\t\t这个法术会使时间线分裂，所以其他同样能使时间线分裂的技能在此期间不能成功释放。"},{"args_order":null,"call_locator":"16ad1af6b067dd3fc08f897bd9d9de80d8e71107466fab881ca83d408bd07cb2","component":"tome","entry_revision_identity":"3302af6da51a9a21cda51a167d96756b6311e25f907362736ae0ecba4882ee56","logical_entry_identity":"03cffe6c9ad897b35bc9b8de1868d7ce4124d66940eabe18a573ecc28444f26c","normalized_path":"mod-tome.lua","source":"Toggles between a bottom or side display for tactial healthbars.#WHITE#","source_tag":"_t","target":"血条位置切换：侧边或者底部#WHITE#"},{"args_order":null,"call_locator":"6361a2fa37d431700e9e905bb687789290023aa522ba631d29ec37d62c6efcb9","component":"tome","entry_revision_identity":"33093b8aa810a054856a85b577edde2af7126f54b150075cd046f367f8ce505b","logical_entry_identity":"a11e7902283b59de1945d34f18c14ea1488563c4f89224fdf14c05056fb9000a","normalized_path":"mod-tome.lua","source":"yew wand","source_tag":"entity name","target":"紫杉魔杖"},{"args_order":null,"call_locator":"eb054f78cb1e79247d2bcbc17efc0e9ec12b4af31e1af3cfb870d5ed07de676f","component":"tome","entry_revision_identity":"330eb6d8e5a2857c74dd6874d6a035eaeb4e258b478e2bb729c550840b18871d","logical_entry_identity":"4e4dd22fba7ca8bdbdd1b8d8a4b59f8ee8d32f3b9b60f94e3ae189af1d2d21af","normalized_path":"mod-tome.lua","source":"A strange brown growth on the dungeon floor.","source_tag":"_t","target":"地板上的奇特棕色植物。"},{"args_order":null,"call_locator":"abc7e209af6e9d05d09892be5f7616573022f055eea3a8ba6d54779c9a06adcd","component":"tome","entry_revision_identity":"33130fa235b7b86d5aef5a562c2952dd2f0e67ac0a41e73f1fc67d47d0d1f1d1","logical_entry_identity":"21bda04e9956615dae55fc0f0a5188274837a8cbfaa225dcb339d8d39f94f801","normalized_path":"mod-tome.lua","source":"The unhallowed morass is the name of the 'zone' surrounding Point Zero.","source_tag":"_t","target":"混沌之沼是零点圣域周围区域的名字。"},{"args_order":null,"call_locator":"1164d6b1d4a6c7abe72de07a82bb647aa0b5e8fab5b0b245fa339ae1f40b026a","component":"tome","entry_revision_identity":"33180befcf18599c1ceb21f79e71ee212b301c9e650f4e51fc706c0ebd5ddbad","logical_entry_identity":"442eb33cedb755c8683a771886e286b81dc49c0784625cd6c10c723cf5e2f333","normalized_path":"mod-tome.lua","source":"Boulder Rock","source_tag":"talent name","target":"岩石投掷"},{"args_order":null,"call_locator":"2c151757e87781006b046c500b5030e4cb9b5f6dc87f63b0358a8e1838cd2835","component":"tome","entry_revision_identity":"331a0364486917e266b1abf05b8ae9df2e7e9ec5e352bea9642ea2724528d74a","logical_entry_identity":"d5d32d3d0b8cf1be31d91e89c46e815f84cb2418b170432158040e2075e0b65f","normalized_path":"mod-tome.lua","source":" #GOLD#All Artifacts#LAST#","source_tag":"_t","target":" #GOLD#所有神器#LAST#"},{"args_order":null,"call_locator":"772dcf14fc5b43f928228ae627a947572637fad3c32020833626b05151b12495","component":"tome","entry_revision_identity":"331a20a01d03d53c198f3e56ef92936d3ed008adf72ae5723fc75bb632adb246","logical_entry_identity":"530888d60257dd90232c523c0edda0636dcf753e7c3ec2e9ddd6e490785e2ad7","normalized_path":"mod-tome.lua","source":"raked","source_tag":"_t","target":"被抓伤"},{"args_order":null,"call_locator":"42be6df39f136f68ce75bfcb7257862bf66d07dfdea9e67c774be810d7c6b230","component":"tome","entry_revision_identity":"33276b27c8d97184ce2bd5bd1d60fdf0cc4ebf47414ca372b860998d236ce318","logical_entry_identity":"