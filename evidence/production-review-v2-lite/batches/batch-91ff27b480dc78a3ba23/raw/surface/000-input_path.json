，持续 3 回合，你的物理穿透增加 %d%%。\n同时只能装备一种弹药。\n毒素伤害、护甲和豁免削减受物理强度加成。"},{"args_order":null,"call_locator":"2b2798691d4c247f949af7715f1ec864ce95e28594bbcbda5083ec3b247257e8","component":"tome","entry_revision_identity":"04353a43d829e7b3fdcbf889a28492de5a7d8b75fe4a4ce3ce562baf675782a5","logical_entry_identity":"6f706207473714d05083cd2ec7230fae0bfb5e7dfea67619e0f6dfa57f3c0e1c","normalized_path":"mod-tome.lua","source":"misc","source_tag":"talent category","target":"杂项"},{"args_order":null,"call_locator":"f38428b4ef4b88406923409f1b52c3549f089b59a8cd7734f6d64eb95a10cbff","component":"tome","entry_revision_identity":"0439832fab183f56ee0f5f018c623ff744503a9ff18f1794035af5d81b9f85ea","logical_entry_identity":"8741c7f17e16a0977f5f34e57191ea63f5bf2a53ea09a945e3adf27d0aa72ddb","normalized_path":"mod-tome.lua","source":" of wizardry","source_tag":"entity name","target":"巫术之"},{"args_order":null,"call_locator":"c674c678c50d351746f960e60a71e65e6891f1c754ecb850841dd38e7214fb08","component":"tome","entry_revision_identity":"043ac747cd605c1708a9e8e737927b64476b3b1a0fde700e0d8aafacfb8f37d8","logical_entry_identity":"e5257de20210ab35d9c0f28193842ab365cac2072316691e7b8b46023cb95576","normalized_path":"mod-tome.lua","source":"Orcish Triumph","source_tag":"_t","target":"兽人凯旋"},{"args_order":null,"call_locator":"a13db000d05660f415a5d6412729583efc7cced9d7016e008821b7f74972e6fe","component":"tome","entry_revision_identity":"043b021f5f4fe7f316d1376f050f4ff593f5a1822bbc9aa5f475ec8242d64a4b","logical_entry_identity":"bb1547188c45adaf99351376a54bbbc91c60d8b48124934e8c60bcafe37d68a9","normalized_path":"mod-tome.lua","source":"Congeal Time","source_tag":"_t","target":"时间凝固"},{"args_order":null,"call_locator":"eb49b49081fa03bdef9974681c5735e7daf2974e058aa6a4dc702d7b597ea4b8","component":"tome","entry_revision_identity":"043b236201a23883d3fae2ef172417252e5bf8ecb997f6a8f83e35edb16285b6","logical_entry_identity":"e26ded4a44157f8a58272a4f4c8907555e22f5493a4243dae4c074a3347e1bbc","normalized_path":"mod-tome.lua",