f9fcfec5945dc","component":"tome","entry_revision_identity":"09e69387b6f6f7adf041f1461f797fcf6cbef35d718c25a4b3977c6c45bcaa4e","logical_entry_identity":"95dbdfb3a2a1c203a95ac087d2e1072bc959921d74926b81626fac4ea38799b4","normalized_path":"mod-tome.lua","source":"Thaloren have an affinity for natural elements, allowing them to heal for a portion of damage taken from them.\n\t\tYou gain %d%% Nature and Acid damage affinity.","source_tag":"tformat","target":"自然精灵对自然元素有亲和力，这让它们在受到伤害时可以获得一定的治疗。\n\t\t获得 %d%% 自然和酸性伤害亲和。"},{"args_order":null,"call_locator":"c04d83110764067608ff62bf11f55c4cb84c5b17bcb9025e741685d73b8e6cfc","component":"tome","entry_revision_identity":"0aa0f69a04aa0a8e283ec135bd23da429bab4ca71079d96dd43ee98366568a21","logical_entry_identity":"518359e7cf47b9a20849eb986bde51a2ff7a2abd152c91a169488a6e9f1a83a2","normalized_path":"mod-tome.lua","source":"Your body has become a mass of living corruption, increasing your blight and acid resistance by %d%% and blight affinity by %d%%.\nOn taking damage greater than 15%% of your maximum health, the damage will be reduced by %d%% and a carrion worm mass will burst forth onto a nearby tile, attacking your foes for 5 turns.\nYou can never have more than 5 worms active from any source at a time.\nWhen a carrion worm dies it will explode into a radius 2 pool of blight for 5 turns, dealing %0.2f blight damage each turn and healing you for 33%% of that amount.","source_tag":"tformat","target":"你的身体已经腐败，增加 %d%% 枯萎和酸性抗性 , %d%% 枯萎伤害亲和。\n\t\t每次生命值损失大于 15%% 时，伤害将减少 %d%%，同时在相邻的格子生成蠕虫，攻击你的敌人 5 回合。\n\t\t你同时只能拥有 5 只蠕虫。\n\t\t蠕虫死亡时将爆炸，产生半径 2 的枯萎毒池，持续 5 回合，造成 %0.2f 枯萎伤害并治疗你 33%% 伤害量。"},{"args_order":null,"call_locator":"293221da8a3db4b02db2f7c387d2390787512ee0c54e7849b8079af18850521e","component":"tome","entry_revision_identity":"0e473fe6f9e6e5cf5ca9c3f337ecf46666f0f284f82120dd168056df45a02db6","logical_entry_identity":"520667c05ac512ed24851de624e91ee0811da6b054bdd7d937d80cd59db67f43","normalized_path":"mod-tome.lua","source":"#GOLD#Life per level:#LIGHT_BLUE# -4","source_tag":"_t","target":"#GOLD#每等级生命加值：#LIGHT_BLUE# -4"},{"args_order":null,"call_locator":"b6c0dbc0f08bfca4a8458236f97e7407a78b95c7a451c2cd7a60475c620deacd","component":"tome","entry_revision_identity":"0e492276b652e3b70c4002092cc5518ee8b663df818118b2d70d8a4dbae0d2d9","logical_entry_identity":"2ac06b36ef8e12ce5a416c28b20c71df039425a5cae8a8b19199174bd3b72dc8","normalized_path":"mod-tome.lua","source":"Your golem's skin shimmers with eldritch energies.\n\t\tAny damage it takes is partly reflected (%d%%) to the attacker.\n\t\tThe golem still takes full damage.\n\t\tDamage returned will increase with your golem's Spellpower.","source_tag":"tformat","target":"你的傀儡皮肤闪烁着艾尔德里奇能量。\n\t\t所有对其造成的伤害有 %d%% 被反射给攻击者。\n\t\t傀儡仍然受到全部伤害。\n\t\t伤害反射值受傀儡的法术强度加成。"},{"args_order":null,"call_locator":"0bccc5d9d17149ace0fb943529dcc49d3f5d1dcf4ffc833143ceb88c7beeb996","component":"tome","entry_revision_identity":"0e4bff39b0f32b5eea27a22cb899c3a14217c1898d3f75f91d9172a4bfe92305","logical_entry_identity":"adb131fd5593fd86f21dbf33d48629fa09edb3831d5e450f224f34854123701b","normalized_path":"mod-tome.lua","source":"Give the target a good old-fashioned shove, knocking it back a square.","source_tag":"tformat","target":"给目标一个老式的击退攻击，将它击退一格。"},{"args_order":null,"call_locator":"007a62d370f1fbcb31baf8d480ecd8ba33c310e86c5454c1d8c073defebc45f8","component":"tome","entry_revision_identity":"0e562d9f0cc7ee8ef57893a677c602bf687ebbc48464cecceeac3bc4d9165df4","logical_entry_identity":"20fefc2f2bc275110ec101fa5d7f2c66a2a47a159273d1432124a69a26176f6d","normalized_path":"mod-tome.lua","source":"#VIOLET#It seems you already knew all the elixir could teach you.","source_tag":"logPlayer","target":"#VIOLET#似乎你已经学会了它能教你的一切。"},{"args_order":null,"call_locator":"40619ddf4d38e529787a4a7788a9273095a297c61969728b6699bc53dcf12c4a","component":"tome","entry_revision_identity":"0e591c18526e7d7ee34fe069f0d43175872b4a2e627018be0d1f72c735c93ba6","logical_entry_identity":"e750d26c5c4c66a3f2453dc1