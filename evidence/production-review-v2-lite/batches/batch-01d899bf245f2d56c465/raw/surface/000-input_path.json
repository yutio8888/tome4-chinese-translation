cator":"c1e5a776389c53ee8fe73d0dcdc895d60e6fa21289fc95222c38df48cb3e0811","component":"tome","entry_revision_identity":"58b1e1f3999099eb3c5488907fe097137ba6592de23a090a1ae75c9aa64769c4","logical_entry_identity":"9a1ce87b2de3813dc6ec0401acd441fbeef751985442cb3c949b62eed45ad492","normalized_path":"mod-tome.lua","source":"No sorry, I need to go.","source_tag":"_t","target":"不行，抱歉，我得走了。"},{"args_order":null,"call_locator":"59652105cacfe6cb6c7cd0a6d121bf8079fb0a1ec669a011bbb700a8215269bd","component":"tome","entry_revision_identity":"58b20e34867d6c7834051fc53da5e59b36b32c92eddf5f8a07dd7c7f555215e4","logical_entry_identity":"35589e5d1f7e14dc6ed7664ca0c249c55c5f9d530efa73a1d0b12ee5f6695ccf","normalized_path":"mod-tome.lua","source":"A clean-looking Halfling resident of Last Hope.","source_tag":"_t","target":"一位穿着整洁的最后希望半身人居民。"},{"args_order":null,"call_locator":"16c6ffc6d57f28a6e95ba8d05bf79a2c70d4aa16ae6bf98bb7e7d4637dd2312a","component":"tome","entry_revision_identity":"58b8937e9d36173889285d6264e708055c8a263a58175763abbe43011ec5de71","logical_entry_identity":"798a6ae1cfe484d958843a60e096bb8ade36cf84dc830f6a01e800e06a1451ef","normalized_path":"mod-tome.lua","source":"Point Zero Guardians","source_tag":"faction name","target":"零点圣域守卫"},{"args_order":null,"call_locator":"306cde54d43029354681f2946d3f908f68d8f43cf8ab7b13e3cc13cfa1ccff3d","component":"tome","entry_revision_identity":"58b8d411e040c56db0ab2ffa4c03db37b6acf7a3a263d764a36db9087df1e8dc","logical_entry_identity":"86d15175d4e0b4360017c4ee535977ec48b097c1db0b95112ebdac6d2fdd5f89","normalized_path":"mod-tome.lua","source":"A belt rumoured to have been worn by the Conclave healers.","source_tag":"_t","target":"传说这条腰带曾被孔克雷夫的治疗师们佩戴。"},{"args_order":null,"call_locator":"8a5dd6e8791ebd2e9642942ee958cecf176c7c4a2c4de779ae1c454225381c75","component":"tome","entry_revision_identity":"58b9ace949142feac83d7c8b9e65499e46e3552136a99b5e54e002ba15c018a0","logical_entry_identity":"63a226ebeac7b0a58982c505026ec6686eab03b0de7412e049795b4837b14ca8","normalized_path":"mod-tome.lua","source":"Essence of the Dead","source_tag":"_t","target":"亡者精华"},{"args_order":null,"call_locator":"7fc28626bfa4fbf66f336f8b080d3f45243c7408ee7210cb0937b7160feb5cc1","component":"tome","entry_revision_identity":"58bb8a7155a6667b4cc84a555aa2aa13590f3959ca86d54a9a6846b2e322aa91","logical_entry_identity":"ed20c2f9cd04463bbfcbf345a0d8e60a7a8caa98ece7200b8ded7a6143627776","normalized_path":"mod-tome.lua","source":"Spit poison on your foes, doing %d damage over a few turns.\n\t\tThe damage will increase with your Willpower.","source_tag":"tformat","target":"向敌人喷射毒素，在数回合内造成 %d 伤害。\n\t\t伤害受意志加成。"},{"args_order":null,"call_locator":"da623e77ec40d8bca3b82706df9693176cb59a79223e54b6d0bc88732ac47dde","component":"tome","entry_revision_identity":"58c0369ef676121693067b054d149bab76d71b6d7914d5e107a7db12224b281e","logical_entry_identity":"20e9a5067100e28bb2d06ab680576c10d6b3d2c7050dd49a9e663daa32218ee5","normalized_path":"mod-tome.lua","source":"As you tread softly down the stairs a large stone slab slides into place behind you, blocking all retreat. The air is still and stuffy, and in this tight space you feel as if in a coffin, buried alive.\n\nAdding to your unease is a rising feeling of dread, overwhelming fear in fact. A hall of doors lies ahead, and behind each you sense a power of great malevolence and unholy horror. At the end of the corridor you see a faint light beneath a large black door, and you have a vague sense that the other doors are enslaved to this one - obedient, subservient, and waiting...\n\nYou hear the sound of a woman sobbing, and every now and then it turns into a fit of pained moans and screams. They echo round the dark chamber and through the darkest parts of your mind, reminding you of every black deed and vile sin you have ever committed. Guilt, horror and terror flood through your thoughts, each competing for stronger control of your psyche. Your only clear thought is of escape, by whatever means you can find.","source_tag":"_t","target":"当你蹑手蹑脚地走下楼梯时，一块巨大的石板在你身后滑入原位，堵住了所有退路。空气凝滞而闷热，在这狭小的空间里，你感觉自己仿佛被活埋进了棺材。\n\n更令你不安的是不断攀升的恐惧感，事实上是压倒性的恐惧。前方是一排门厅，每扇门后你都能感觉到巨大的恶意和不洁的恐怖。走廊尽头，一扇巨大的黑色门下透出微弱的灯光，你隐约感到其他门都臣服于这扇门——顺从、恭顺，静静等待……\n\n你听到一个女人的哭泣，时不时还夹杂着一声痛苦的哀嚎和尖叫。声音在密室里回荡并且通过黑暗传入了你的大脑，提醒你所犯的每一项罪过。内疚、恐怖和害怕如潮水般袭来，它们每个都紧紧抓住了你的灵魂。你唯一的想法便是逃离此地，不择一切手段。"},{"args_order":null,"call_locator":"6630b211dfdd4193c1bacb07c1721b6759f4b01c6ec7887a3e54a80166030530","component":"tome","entry_revision_identity":"58c1875f4bd7573d85d9c381a60ed41e9efd1d091045c5997ee1f24a3939544e","logical_entry_identity":"5c2b254922653d63b4b895c30f1c86aae885e48279426eb9bbdcad468d034de8","normalized_path":"mod-tome.lua","source":"Haste","source_tag":"talent name","target":"加速"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"9c5578a9655e6dd80db73e1cd996c97dce1bee4abd5e219636a19c81f80a7672"}}