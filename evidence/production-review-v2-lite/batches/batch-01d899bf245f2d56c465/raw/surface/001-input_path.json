dentity":"58de59b77126285ecc82dbab048c710396c7a24c7397aa27518ca2312e7cbdde","logical_entry_identity":"32c22a4a77c56ad40e4ba0dbae3d24aa511c5ec48032b328881449465f09b71d","normalized_path":"mod-tome.lua","source":"Equilibrium represents your standing in the grand balance of nature. The closer it is to 0 the more balanced you are. Being out of equilibrium will adversely affect your ability to use Wild Gifts.","source_tag":"_t","target":"失衡值代表你在自然宏大平衡中的位置。失衡值越接近 0，你就越平衡；失衡会对你使用自然系技能的能力产生不利影响。"},{"args_order":null,"call_locator":"9a38501a7755a5fd3df571a9c26e5f1ec8880ceff6629c0862c5cd1ddd38ad61","component":"tome","entry_revision_identity":"58de9062c02771a7805e3868fb4371d1d9ead03ddc74a35a29fb92267eba89f3","logical_entry_identity":"3451fcb94e5541aead067e374497e8f36f49c5aa85e6dece4e277cf120e3f0e1","normalized_path":"mod-tome.lua","source":"This crystalline tree branch is remarkably rigid, and refracts light in myriad colors. Gazing at it entrances you, and you worry where its power may have come from.","source_tag":"_t","target":"这根水晶树枝异常坚硬，折射出万千色彩的光芒。凝视着它会让你入迷，同时你会担心它的力量究竟来自何处。"},{"args_order":null,"call_locator":"dfb5f77ad301fcca8b2bebbc9c45d4f0883454b6aecfd7fb1e4f13967a415f13","component":"tome","entry_revision_identity":"58e4b30706703c165c0eeb16c38fab4ad8926da5dfeca2ba01e739c84a91a9e7","logical_entry_identity":"03593f8339a48065ae6479ae03c83df4a24f3e77261cc3da877c1854a5893358","normalized_path":"mod-tome.lua","source":"Mitosis","source_tag":"talent name","target":"有丝分裂"},{"args_order":null,"call_locator":"ff1207bc7497c0c520c22cfcf85bf4559e0159d9b447c10933d46d937cde930c","component":"tome","entry_revision_identity":"58e4b462625a9d01715e867420cdd8144022ed27585d6ceb7d078827921ab6a5","logical_entry_identity":"50b2262744fcd0f9860f5c51a9dcd1de5c462ed1fa896e08fbd5754517f40e49","normalized_path":"mod-tome.lua","source":"#Target# is no longer terrified","source_tag":"_t","target":"#Target#摆脱了惊恐。"},{"args_order":null,"call_locator":"2f477f96a7f6ed87eb3eec2ceab278b6b20d0035a42392f8bf345fe6baada300","component":"tome","entry_revision_identity":"58ea3de3adfcdbf28b4d08fccfc98a909cc3577d25968e2386f906f8bf8f60f1","logical_entry_identity":"fb91d84256bb9c7cab50f0542a5de0b13d551c7d309a2163527ee20428a27f6d","normalized_path":"mod-tome.lua","source":"Beckon","source_tag":"talent name","target":"引诱思维"},{"args_order":null,"call_locator":"ed47ecd34c06393c26d0937038a88a5f208a07731705f20eb6b08253099ec211","component":"tome","entry_revision_identity":"58eb4520f6f02d5902e7ee08d13f3b955573e984af04ae54732c38b2e7f0f7ce","logical_entry_identity":"4a8f42a6b64f47f684cb4d5c02922f481c3bd3155032c8d835adf0ebb63fc7f2","normalized_path":"mod-tome.lua","source":"Teaches the player 'Confusion'.","source_tag":"_t","target":"可习得技能“混乱”。"},{"args_order":null,"call_locator":"6b1815fd697e2e30c741bf4d743a3d6090dec11e03bf119d978b4924366b0a00","component":"tome","entry_revision_identity":"58f310cacb7ca20bbe9ba81f66245bda333f78a7b8215f3f457ee29dabe33a5c","logical_entry_identity":"f46b78d0bf981e78574b4a186fa0ef0445ff1f5518b4f08dda1f506007b083bc","normalized_path":"mod-tome.lua","source":"#{bold}#Relle, Cornac Fighter and Expedition Leader#{normal}#\nIt knows we're here.  Xann's gone, and I have to assume the worst.  Too late to run.  One option left, a contraption Sodelost ensured us he'd be able to use to get the kill...  shame he didn't leave instructions behind with it, it's unclear how to arm it, and I don't want to add \"being charred to a crisp\" to my list of troubles today.\nI might not know a great deal about artifice, but I know how wild animals work, and for all the praise they get, dragons are no better.  I don't need to know how to rig this device so it goes off when the beast steps on it - I just need to put it inside something it'll eat whole...\n#{italic}#Judging from this note's intact state and delicate placement next to a sack covered in assorted animal viscera, the dragon not only avoided setting off the trap, but has kept it as a trophy.  Inside the sack is a disarmed trap featuring a few recognizable alchemical flasks, and a means of mixing them in the right proportion when a pressure plate is triggered to produce a blast of dragonsfire. Figuring out how to arm it is almost as easy as figuring out how to make more traps like it.#{normal}#","source_tag":"_t","target":"#{bold}#探险队队长，科纳克人战士瑞丽#{normal}#\n那条龙知道我们在这里。希安失踪了，我只能作最坏的打算。逃跑已经太迟。只剩一个选择：苏达罗斯特向我们保证，他能用这套装置杀死那条龙……可惜他没把说明留在装置旁边，没人知道该如何启动它，而我可不想让今天的麻烦清单再多出“被烧成焦炭”这一项。\n\n我或许不太懂机关术，却知道野兽会怎么做。龙尽管备受赞颂，在这一点上也不比其他野兽高明。我无需知道怎样把装置设成野兽踩中时触发——只须将它放进某种会被一口吞下的东西里……\n#{italic}#从纸条完好无损的状态，以及它被小心摆放在一个沾满各种动物内脏的袋子旁边来看，那条龙不仅没有触发陷阱，还把它当作战利品收藏了起来。袋中有一个已解除的陷阱，装有几只尚能辨认的炼金药瓶；压力板触发时，机关会按正确比例混合其中的药剂，爆发出龙火。弄清如何启动它，几乎与弄清如何制作更多同类陷阱一样简单。#{normal}#"},{"args_order":null,"call_locator":"d5e0c4b82241b2b0e90145efbd9fbecef3321f18413f492977bd95c23bc40af3","component":"tome","entry_revision_identity":"58fc9559ab6f368c4ebe6cf0a9a2a4f04833a35de3186f1e10ecc0df788165fe","logical_entry_identity":"ebca4a749beba9e12e2a124f9255bd42732822326db3b9c0af635488b8e8aee7","normalized_path":"mod-tome.lua","source":"-Battle Cry","source_tag":"_t","target":"-战斗怒喝"},{"args_order":null,"call_locator":"97184cffa41830fcdeb60c3c2f9e5904402783bc8d47cc30bb153fbbf0728040","component":"tome","entry_revision_identity":"59001e2861bf36d082d6705cc92ae052d670a31d79d847669b875054dc286116","logical_entry_identity":"fb5e0067423eb3e3aadfc65779c8c9edbda520aa125d3b8a93281fc8c5687a25","normalized_path":"mod-tome.lua","source":"#LIGHT_GREEN#*The man smiles in approval*#WHITE#\nExcellent! A great fighter is always willing to head into battle.\nYou certainly won't regret meeting us, indeed...\nSo, are you ready to fight?\n","source_tag":"_t","target":"#LIGHT_GREEN#*男人赞许地微笑起来*#WHITE#\n好极了！伟大的斗士总是愿意投身战斗。\n遇见我们，你肯定不会后悔……确实如此。\n那么，你准备好战斗了吗？\n"},{"args_order":null,"call_locator":"32b2f966d7bb61d07097e56fa55a7b3372b5ceec42b6a09cb017dab740f814b2","component":"tome","entry_revision_identity":"5901ed58d3a3a22d08b9434a386827654803e2d13c101b532448434424db16bf","logical_entry_identity":"89247ec0a37553b2c594ca4199d162a463e19da3bfea02453d398de2d7cb62c0","normalized_path":"mod-tome.lua","source":"#Source# strikes #Target# in the darkness (%+d%%%%%%%% damage).","source_tag":"delayedLogMessage","target":"#Source#在黑暗中打击了#Target#(%+d%%%%%%%% 伤害)。"},{"args_order":null,"call_locator":"789e9818dec40b6790a7e2703050ca637a3fa9a8865e4716d5bbfcb5fbe11e23","component":"tome","entry_revision_identity":"5902cf0a604a8ca9afccb90f08db9cd0468b93f96e672ea42decbb82111e3594","logical_entry_identity":"139481bd319e27a9fdc38d6ce5134f5a8a3e545d76b3b8d3260724b318c5b21a","normalized_path":"mod-tome.lua","source":"Master's Gem Golem talent too low for this gem","source_tag":"_t","target":"主人宝石傀儡等级过低，无法使用该宝石"},{"args_order":null,"call_locator":"84fadeeaf6c4973654a01cad3ba477e6fe1a03e2bf2d908be5feda237136806d","component":"tome","entry_revision_identity":"59034afda6e8ae8b3d867b606de6d4f6288644231aa8d47987c9459df041843e","logical_entry_identity":"a198d0a9c6556aa19b0ca12290d8c28c7647deb8bb5165ca6931de8dbbfcc63a","normalized_path":"mod-tome.lua","source":"something on the floor","source_tag":"_t","target":"地板上的某物"}],"fixed_source_identity":"commit:624a67329fe2ad440c5b344785a9c73fcf22ae63","rendered_briefing":"WP2-Lite surface screen; review only","rules_version":"production-review-v2-lite-rules-v2","terminology_snapshot":"9c5578a9655e6dd80db73e1cd996c97dce1bee4abd5e219636a19c81f80a7672"}}