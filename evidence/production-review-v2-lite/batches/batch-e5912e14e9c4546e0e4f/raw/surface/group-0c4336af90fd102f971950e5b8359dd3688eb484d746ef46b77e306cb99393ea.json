ry_identity":"d291c5ecac18699f6293c539c2851b28459110f90e36ec6a8d5035ce386531bb","normalized_path":"mod-tome.lua","source":"#YELLOW#Disable talent confirmation","source_tag":"_t","target":"#YELLOW#禁用技能使用确认"},{"args_order":null,"call_locator":"2b4c6c8b4ad5f8b54666cf157c4eab0c8bbff9fe36239af39bfff8ec6d03da0b","component":"tome","entry_revision_identity":"d9d1a1250c041ff7c3dde50e6d288efd8cfeca1ed9648599c45b4613924e6df6","logical_entry_identity":"56290a1b4f9ce77ced685c73b3e0ec1dbf7ffe7e35d8e024e81e50024c91cd63","normalized_path":"mod-tome.lua","source":"This bright violet gem exudes a calming, focusing force. Holding it, you feel protected against outside forces.","source_tag":"_t","target":"这颗明亮的紫色宝石渗透出宁静、专注的力量，当你紧握它时，你可以感受到它保护你与外界力量隔绝。"},{"args_order":null,"call_locator":"93cb1aee14563fb5a2a0c14d419ce96979ca1fdb29c2bed248444e81310f0cb7","component":"tome","entry_revision_identity":"d9d246190d4eee7d02a1c512e4e1d0c223db81ff983ac45e6f19d0b06d46f767","logical_entry_identity":"4fa72400f7fd3811633dba97df1dc3b5a5fa8bbf307184bacabd5f60652bb8fc","normalized_path":"mod-tome.lua","source":"I do not know yet, my father won't let me out until I'm fully healed. I've always wanted to do so many things.\nThat is why I got stuck in that crypt, I want to see the world.\nMy father gave me some funds so that I can take my future into my own hands. I have some friends in Derth, maybe I will open my own little shop there. ","source_tag":"_t","target":"我现在还不知道，在我完全康复之前我父亲都不准我出门。我一直想做很多事情。\n这也是为什么我会被困在那个地宫里，我想去看看外面的世界。\n我父亲给了我一笔钱，让我能够自己把握未来。我在德斯镇有几个朋友，也许我会在那里开一家属于自己的小店。"},{"args_order":null,"call_locator":"48e4bc505a60abb65f51fa002606b51d4ae24842f74402fdd00b1bb0b8c1b952","component":"tome","entry_revision_identity":"d9d3196728a51a83a071a8afdd9a96372a564a79c0e7428d09c9b51be0973db8","logical_entry_identity":"10b3a1b69314f87a0fc8af7c82d6740e1326cd4d9308c3ba1084f9627228909b","normalized_path":"mod-tome.lua","source":"storming ","source_tag":"entity name","target":"风暴的"},{"args_order":null,"call_l