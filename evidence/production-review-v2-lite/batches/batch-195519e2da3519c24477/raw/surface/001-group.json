nt":"tome","entry_revision_identity":"02cf495916c30eba20124f25d3aab5a5363645cbc5d857ece3d217250ff45b79","logical_entry_identity":"303873bd62eddf39958d316c813a333516a71da01e83faa640366e4f73f4059d","normalized_path":"mod-tome.lua","source":"Adrenaline Surge","source_tag":"_t","target":"肾上腺素"},{"args_order":null,"call_locator":"a68866dcf1f0de72594a18eb6ab55b8300c7092bf539c74b7217f5ccad4a043b","component":"tome","entry_revision_identity":"02d6f734b9b3636320e333ad06244b2e7e75a0e87c55615f25aa5ec146f33aef","logical_entry_identity":"ca3c69022414c24dad4af9027c0a99eece3b5d00e9c4b835699bfc7611777a09","normalized_path":"mod-tome.lua","source":"You must dual wield to perform an Offhand Jab!","source_tag":"logPlayer","target":"你只有在双持状态下才能使用这个技能！"},{"args_order":null,"call_locator":"b530a80b7df324b648a97ef0591d9f2f3330055a941aa119cb96c55dc41db34a","component":"tome","entry_revision_identity":"02d7fc3ab03cb5338bee1e724db0e87f880c253dfb0435dee372a379dd7f4f15","logical_entry_identity":"64070dd89a114a461958b570dd231d7f391504e00c33988cd245a9f78228cde0","normalized_path":"mod-tome.lua","source":"#Target# is cut deeply.","source_tag":"_t","target":"#Target#身受重伤。"},{"args_order":null,"call_locator":"6047b5c712788b17847f1f3254bfe919122ed5fb8675199f8b7588a87689bc35","component":"tome","entry_revision_identity":"02dd693193a54ae306fb28d76bf4626983bdd1149224ca8b96d1f306e2b43479","logical_entry_identity":"fbc63de5e7917aa1649720ef06640a1be1e5c61bda4df142f45b0f61aa8de0c6","normalized_path":"mod-tome.lua","source":"The target's combat damage is improved by %d.","source_tag":"tformat","target":"目标战斗伤害值提高 %d。"},{"args_order":null,"call_locator":"b8b38db9ac6d84c964dcbea48c06ce578f1e64a91e4ae66f002728f1cbf07e22","component":"tome","entry_revision_identity":"02e02c448287b049ceebc409a557b3bc7b1b84e0ff91c141732433300690fe85","logical_entry_identity":"e45e1d20dfc18421a80c12a76228db88abcb8811b8ae5f7b05d3e1ffc8e0b9b7","normalized_path":"mod-tome.lua","source":"staff","source_tag":"_t","target":"法杖"},{"args_order":null,"call_locator":"5f7a7e986a314b0892769ee1aabb5de656e697c237161db01f90929e45491c66","component":"tome","entry_revision_identity":"02e0da818dfc6d95336854b1da52de8320849f07d3cbbf3efdde8f2820ff634b","logical_entry_identity":"f16a6ccebf69c5399b41955198d565a10cedee7067426ea8dd6c666d0e6b0f18","normalized_path":"mod-tome.lua","source":"#Target# overcomes the dismay","source_tag":"_t","target":"#Target#恢复了理智。"},{"args_order":null,"call_locator":"770416e97a6ebd59586769bd615ea404ca3d9c5e5b285a6046505e20d0b50afd","component":"tome","entry_revision_identity":"02e3f05a90f96200659f045300573ad0f0d45100f049e22e30c05fdc05f11235","logical_entry_identity":"a921814269f28e6d2ff48fe4101fe335a4e21ca4fc225028af97211add1f4fb6","normalized_path":"mod-tome.lua","source":"Wrathroot","source_tag":"entity name","target":"狂怒树精"},{"args_order":null,"call_locator":"be5b0c08a8cba475a2179cbf3c343715681dcaab9005d02d3ce69e4758592405","component":"tome","entry_revision_identity":"02efd960ec96781998d8c4047088b0202d9b920349acd4c996fb6cc1d1055bc7","logical_entry_identity":"ff2c27383ac8f28322665e3bf6080bead1993be45306ad10492acea872d8599c","normalized_path":"mod-tome.lua","source":" * You have learned the real threat comes from a rogue Archmage, a Tempest. You have been shown a secret entrance to his stronghold.","source_tag":"_t","target":" * 你得知真正的威胁来自于一位叛逃的元素法师，也就是一位风暴法师。有人为你指出了通往他秘密据点的一条隐秘通道。"},{"args_order":null,"call_locator":"a00156bc9324f4bda6a8bfb141a4c8deab9c6ba5e9421d7fbe382161b706f62e","component":"tome","entry_revision_identity":"02f04489a9431e98e51ad2aa9bf8920d52a761ef5aff2006ec802aae235b76c1","logical_entry_identity":"0e70824bb0124190aad2e6b97660fcdb449198bdfeb302cffbb1d036929605e2","normalized_path":"mod-tome.lua","source":"Removes up to %d magical effects (good effects from foes, and bad effects from friends) from the target.\n\t\tAt level 3, it can be targeted.\n\t\t","source_tag":"tformat","target":"驱散目标身上的 %d 种魔法效果（敌方单位的增益状态和友方单位的负面状态）。\n\t\t在等级 3 时可以选择目标。"},{"args_order":null,"call_locator":"a02981ea0e9970960458c8dfa030ffcc736be8600222ca1120649de422e4428b","component":"tome","entry_revision_identity":"02f762c45c67d7aee44f0492133968bf9487ebf7ded8603fddabd3e2c2abae7b","logical_entry_identity":"970a8bad0d9a6244efd5b3ace996d94bd03129e140c85708a7ead74f17c8646e","normalized_path":"mod-tome.lua","source":"I can see it now, I can see so clearly... The forces at work here are not of this world. They are a result of the Spellblaze, from the tearing of the fabric of our world. And from outside that fabric... something else, something truly powerful, trying to force its way in. I feel I can almost reach out and touch it! Such awesome power it is... could this even rival the renowned powers of the Sher'Tul?\n\nThe crystals are a corruption of the elements of Maj'Eyal. These outside forces are changing the very make-up of the matter of our world. This cavern is truly a garden of delights, a font of growth and energy. Who knows how far this garden of wonders could spread if we encourage it more? Perhaps the whole of our world could be enveloped in this scintillating glory, a grand corruption for all Eyal!\n\nI have begun to train myself in controlling this \"blight\". It takes much energy, draining my very vim, but I can feel the tremendous power behind it. I must tap into it more...","source_tag":"_t","target":"我如今看见了，看得如此清楚……在这里运作的力量并不属于这个世界。它们源自魔法大爆炸，源自我们世界织构上被撕开的伤口。而在织构之外……另有某种真正强大的力量，正试图强行挤进来。我几乎觉得自己伸手就能触碰到它！何等可畏的力量……它甚至能与夏·图尔闻名于世的伟力抗衡吗？\n\n这些水晶是马基·埃亚尔诸元素遭到腐化的产物。来自世界之外的力量正在改变我们这个世界中物质本身的构成。这座洞穴真是一片愉悦的花园，是生长与能量的源泉。若再推它一把，谁知道这座奇迹花园能蔓延多远？也许整个世界都能被这闪耀的荣光包裹，让整个埃亚尔迎来一场宏伟的腐化！\n\n我已经开始训练自己控制这种“枯萎”。这会消耗大量力量，甚至不断抽干我的活力值，但我能感受到它背后的无穷威能。我必须从中汲取更多……"},{"args_order":null,"call_locator":"57f270bdb86899cefac8614cf26252164d2299cdace782a2416b8c4355602d3f","component":"tome","entry_revision_identity":"02f79fca3c4e4b81ae28f0bc88f55ea9bfe0e8580fddc52fbdab9f7f34355547","logical_entry_identity":"8532abb9180573480195a8173600c60b210c554184b69aefe4355405b5658934","normalized_path":"mod-tome.lua","source":"#{italic}#Touching the conch makes it emit a sound. As you put it to your ear you hear a charismatic and commanding voice emanating from within:#{normal}#\n\n\"My fellow nagas! I do not envy you on your journey so far from our great Temple. But you have been chosen for a glorious mission, to establish a new outpost for invasion against the landwalkers. These are the cousins and descendants of those who abandoned us and left our race for dead. Whilst we have hidden beneath the waves for centuries, they prance about worshipping the sun! Well, their nightfall comes soon, and the dawn will rise with us as rulers of land and sea.\n\n\"Do not despair that we are attacking this outpost instead of the orcs. My stratagem is carefully planned, and the Sunwall is too great a threat to my designs to be allowed to stand any longer. The orcs... will have their uses in the short term. But be assured, when our time comes there shall be none who can stand as equals against us. Our greatness cannot be quelled or submerged! Our long history of suffering will finally bring forth redemption!\n\n\"Your immediate mission is clear, my friends. Ensure the farportal is correctly set up and secured, but take care, as the Sher'Tul magics used are still experimental. Then scout out the area and begin to fortify the surroundings, but do so in secret. When your job is done well I, your humble leader Slasul, shall be honoured to join you on the front line. Until then, swim safely my brothers and sisters, and do not forget our glory.\"\n\n","source_tag":"_t","target":"#{italic}#触摸这只海螺会让它发出声音。当你将它贴近耳边时，一道富有魅力而又威严的声音从中传出：#{normal}#\n\n\"我的娜迦同胞们！我知道，这趟远离我们伟大神庙的旅程绝非美差。但你们获选执行一项光荣的使命：建立一座新的前哨站，以此作为入侵陆行者的据点。他们正是那些抛弃我们、任我们种族自生自灭之人的同族与后裔。我们在海浪下隐匿了数个世纪，他们却在岸上招摇地崇拜太阳！哼，他们的黑夜很快就要降临，而新的黎明将见证我们统治陆地与海洋。\n\n\"不要因为我们攻击的是这座前哨站而不是兽人就感到失望。我的谋略经过了周密筹划，太阳堡垒对我的大计威胁太大，绝不能再让它继续存在。兽人……短期内还有他们的用处。但请放心，等我们的时代来临，世上将再无人能与我们平起平坐。我们的伟业不会被压制，也不会被淹没！我们漫长的苦难史终将换来救赎！\n\n\"朋友们，你们眼下的任务很明确。确保远行传送门正确架设并得到保护，但务必小心，所用的夏·图尔魔法仍处于试验阶段。然后侦察这一地区，着手巩固周边防御，同时必须秘密行事。等你们出色完成任务后，我——你们谦逊的领袖萨拉苏尔——将荣幸地前往前线与你们会合。在那之前，兄弟姐妹们，愿你们一路游得平安，也别忘记我们的荣耀。\"\n\n"},{"args_order":null,"call_locator":"567b1d75bc617dd8a48de0ff8d48bc192d4088093680cfce6c76ba6230edb801","component":"tome","entry_revision_identity":"02fade2289191f323de8a21168229589fa3689386f56e245e99b16fed04d96ba","logical_entry_identity":"e003165343b11a12757f76ccc474f6938dd6f7e43c7c75cce4847b22433c5ecf","normalized_path":"mod-tome.lua","source":"umbral horror","source_tag":"entity name","target":"暗影恐魔"},{"args_order":null,"call_locator":"a5f722e7030d46b9b33b06d4df0f6cdfe6af2b3bd9c9cfcbee3ab9c59c3c02ea","component":"tome","entry_revision_identity":"02fea5fe142487f4e19c69d1c145ff8b501f3707317fb9b63ea7c1c4ba879238","logical_entry_identity":"f9d1fe57a95f20826163eb3cca2e08f7bbe5df7900b2df40030f21c2b612e892","normalized_path":"mod-tome.lua","source":"@Source@ summons a Fire Drake!","source_tag":"_t","target":"@Source@召唤了一只火龙！"},{"args_order":null,"call_locator":"6dd9ba1729906b76f0fe03e09e02bcbb8533de6fcdf081be0900620c75777ca9","component":"tome","entry_revision_identity":"030289ec8401ff93b354fde091e52089dcb05934b797e6f48af65a1d2f0d7929","logical_entry_identity":"1bfb87d7431b0a9a92a969fd9d93f1cbac772dc32fc13d64372e2aa33a437891","normalized_path":"mod-tome.lua","source":"Crown of Eternal Night","source_tag":"entity name","target":"永夜王冠"},{"args_order":null,"call_locator":"ee66c09ac1d31ac0ee7c57efe1eb37a4a6fd20c1b08091661108b5d5f8aa8040","component":"tome","entry_revision_identity":"0302d85bfd00251304acadfec2e3b8d0fb378835f14e87bfc55ff8dec12e0ae2","logical_entry_identity":"dc6ec39be11b9f8fc6a7f95c004d6d384a70542ccf388695c90200df57900245","normalized_path":"mod-tome.lua","source":"#Target# is no longer resonating.","source_tag":"_t","target":"#Target#不再与伤害共鸣。"},{"args_order":null,"call_locator":"6bfe7e4363648c7874b5d383551cedc3ee434a3541775f22a3d1cb01f9dba987","component":"tome","entry_revision_identity":"03031ac3a4a6085780654c45bd12c78075a7c8