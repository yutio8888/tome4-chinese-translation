,"target":"#Target#不再发光。"},{"args_order":null,"call_locator":"fb695462a411c169cfcf9122f525234d612660a95df3544d4e51f4b301b05432","component":"tome","entry_revision_identity":"5038425bf368cfefc8ef174612eaae0390c14cef7b7f3a657df7692c1dfb8141","logical_entry_identity":"4d8e6ea1c6aa4792a455d06a74b6d8744f6cdb8e0569ee4b2712f701f4b3a381","normalized_path":"mod-tome.lua","source":"Increases weapon damage by %d%% and physical power by 30 when using swords, axes, maces, knives, or bows.\n\t\tYou now also use your Magic in place of Strength when equipping weapons and ammo as well as when calculating weapon damage.\n\t\tThese bonuses override rather than stack with weapon mastery, dagger mastery, and bow mastery.","source_tag":"tformat","target":"当使用剑、斧、权杖、匕首或者弓箭时，增加武器伤害 %d%%，物理强度30。\n\t\t当装备武器、弹药或者计算武器伤害时，你使用魔法取代你的力量属性进行计算。\n\t\t这个技能的奖励伤害取代武器掌握、匕首掌握和弓箭掌握的加成。"},{"args_order":null,"call_locator":"08ea7c18f689206840b3483d5649f22bff8bbe422e37ed483d0d24d0cbe20c53","component":"tome","entry_revision_identity":"5038a18d77841ebfabb1623b75a901b0199df73214d7fe963218f7c9a47c6800","logical_entry_identity":"c04856d97f1f972a71fd92241e1024904afcada41d6465577185d1964d0ef8a7","normalized_path":"mod-tome.lua","source":"temple of creation","source_tag":"newLore category","target":"造物主神庙"},{"args_order":null,"call_locator":"74a5378344d3d8079cc29ba5457dfe95503de037c1757a65cda5f71015e9221f","component":"tome","entry_revision_identity":"503a63cbced86aa2724c49388806993c068fef477c6667f7a6b06402da88e402","logical_entry_identity":"fb3e4f68adf9c31431d676e76e783714119e4a32937358778433f66e8c5a5e06","normalized_path":"mod-tome.lua","source":"Force enemies into a deep sleep.","source_tag":"_t","target":"使敌人进入昏睡。"},{"args_order":null,"call_locator":"fa8bb206da62577d2746648207d7e063ef2075f0508a36f4da2b939641b12bc6","component":"tome","entry_revision_identity":"503be218242b002da78be99130f4098a255d18e502679475a2239660b1d0f56c","logical_entry_identity":"4f1c20cc00accbbced322436497b51d8815f4a4aebfb1be368db7a2dc6910